<UserControl x:Class="Raphael.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Raphael.Desktop.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
             xmlns:minus="clr-namespace:Raphael.Desktop.Converters"
             xmlns:rep="clr-namespace:Raphael.Desktop.Views.Reports"
             xmlns:converters="clr-namespace:Raphael.Desktop.Converters"
             xmlns:services="clr-namespace:Raphael.Desktop.Services"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             helpers:HelpAssist.TopicId="desktop/reports/overview"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Convertidores -->
        <BooleanToVisibilityConverter x:Key="StandardBoolToVis" />
        <minus:MinusConverter x:Key="Minus"/>
        <converters:AviataInverseVisibilityConverter x:Key="AviataInverseVisibilityConverter" />

        <!-- Style for individual FundingSource items -->
        <Style x:Key="MultiSelectComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <CheckBox Content="{Binding Name}" 
                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"  
                                  Margin="10,2"
                                  HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RE-088: the same tick list, dimming what has nothing in the dates of the report. -->
        <Style x:Key="ProductivityFilterItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource MultiSelectComboBoxItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasData}" Value="False"><Setter Property="Opacity" Value="0.45"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GenerateButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <TabControl>
            <!-- Production Report Tab -->
            <TabItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.TabProduction]}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FILTROS LATERALES (SIDEBAR) -->
                    <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,10,0" BorderBrush="#DDD" BorderThickness="1">
                        <DockPanel>
                            <!-- RE-088: on a small screen the filters scroll and the buttons stay in sight. -->
                            <StackPanel DockPanel.Dock="Bottom">
                            <Separator Margin="0,10"/>

                            <Button Command="{Binding PreviewProductionReportCommand}"
                        Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.Preview]}" 
                        Style="{StaticResource GenerateButtonStyle}" 
                        Background="#673AB7"/>

                            <Button Command="{Binding GenerateProductionReportCommand}" 
                        Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.SaveExcel]}" 
                        Style="{StaticResource GenerateButtonStyle}" 
                        Background="#2E7D32" Margin="0,10,0,0"/>

                            <ProgressBar IsIndeterminate="True" Margin="0,10" 
                             Visibility="{Binding IsGenerating, Converter={StaticResource StandardBoolToVis}}"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.ProductionFilters]}" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,20"/>

                            <CheckBox Content="{Binding TextShowCancelled}" IsChecked="{Binding ShowCancelled}" Margin="0,0,0,14"/>

                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.DateRange]}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding StartDate}" materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.StartDate]}" Margin="0,5"/>
                            <DatePicker SelectedDate="{Binding EndDate}" materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.EndDate]}" Margin="0,5"/>

                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.FundingSources]}" FontWeight="SemiBold" Margin="0,15,0,5"/>

                            <!-- Master CheckBox -->
                            <CheckBox Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.AllSources]}" 
                          IsChecked="{Binding IsAllSelected}" 
                          FontWeight="Bold" Margin="2,0,0,5"/>

                            <!-- Multi-selection ComboBox -->
                            <ComboBox ItemsSource="{Binding AllFundingSources}" 
                          ItemContainerStyle="{StaticResource MultiSelectComboBoxItemStyle}"
                          materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.FilterItem]}"
                          SelectedItem="{Binding SelectedFundingSource}"/>

                            <!-- Debajo del ComboBox de Funding Sources -->
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.Routes]}" FontWeight="SemiBold" Margin="0,15,0,5"/>

                            <!-- Master CheckBox para Rutas -->
                            <CheckBox Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.AllRoutes]}" 
                              IsChecked="{Binding IsAllRoutesSelected}" 
                              FontWeight="Bold" Margin="2,0,0,5"/>

                            <!-- Multi-selection ComboBox para Rutas -->
                            <ComboBox ItemsSource="{Binding AllVehicleRoutes}" 
                                ItemContainerStyle="{StaticResource MultiSelectComboBoxItemStyle}"
                                materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.FilterRoute]}"
                                SelectedItem="{Binding SelectedVehicleRoute}"/>

                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.Drivers]}" FontWeight="SemiBold" Margin="0,15,0,5"/>
                            <CheckBox Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.AllDrivers]}"
                              IsChecked="{Binding IsAllDriversSelected}"
                              FontWeight="Bold" Margin="2,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AllDrivers}"
                                ItemContainerStyle="{StaticResource MultiSelectComboBoxItemStyle}"
                                materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.FilterDriver]}"
                                SelectedItem="{Binding SelectedDriver}"/>

                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.Vehicles]}" FontWeight="SemiBold" Margin="0,15,0,5"/>
                            <CheckBox Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.AllVehicles]}"
                              IsChecked="{Binding IsAllVehiclesSelected}"
                              FontWeight="Bold" Margin="2,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AllVehicles}"
                                ItemContainerStyle="{StaticResource MultiSelectComboBoxItemStyle}"
                                materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.FilterVehicle]}"
                                SelectedItem="{Binding SelectedVehicle}"/>

                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.TripId]}" FontWeight="SemiBold" Margin="0,15,0,5"/>
                            <TextBox Text="{Binding TripIdFilter, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.TripIdHint]}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- AREA DE PREVISUALIZACIÓN (PREVIEW) -->
                    <Border Grid.Column="1" Background="#F0F0F0" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <!-- Placeholder si no hay reporte listo -->
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding IsPreviewReady, Converter={StaticResource AviataInverseVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="FileDocument" Width="60" Height="60" HorizontalAlignment="Center" Foreground="#BDBDBD"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.EmptyProduction]}" HorizontalAlignment="Center" Foreground="#9E9E9E"/>
                            </StackPanel>

                            <!-- WebView2 para mostrar el PDF generado (Opcional si quieres previsualizar antes de Excel) -->
                            <wv2:WebView2 x:Name="ProductionWebView" 
                              Source="{Binding PreviewFilePath}"
                              Visibility="{Binding IsPreviewReady, Converter={StaticResource StandardBoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- RE-081: Fleet productivity (office staff; the API refuses anyone else) -->
            <TabItem x:Name="ProductivityTab" Header="{Binding Productivity.TitleText}" Visibility="{Binding IsNotDriver, Converter={StaticResource StandardBoolToVis}}">
                <!-- F1 topic on the content, never on the TabItem: every header exists at once. -->
                <Grid Margin="10" DataContext="{Binding Productivity}" Loaded="ProductivityGrid_Loaded" helpers:HelpAssist.TopicId="desktop/reports/productivity" helpers:HelpAssist.FollowMouse="True" Background="Transparent">
                    <Grid.Resources>
                        <!-- A DataGrid column is not in the visual tree: headers reach the ViewModel through a proxy. -->
                        <helpers:BindingProxy x:Key="ProdProxy" Data="{Binding}"/>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,10,0" BorderBrush="#DDD" BorderThickness="1">
                        <DockPanel>
                            <!-- RE-088: on a small screen the filters scroll and the buttons stay in sight. -->
                            <StackPanel DockPanel.Dock="Bottom">
                            <Separator Margin="0,10"/>
                            <Button Command="{Binding GenerateCommand}" Content="{Binding GenerateText}" Style="{StaticResource GenerateButtonStyle}" Background="#673AB7"/>
                            <Button Command="{Binding SavePdfCommand}" Content="{Binding PdfText}" Style="{StaticResource GenerateButtonStyle}" Background="#1E3A8A" Margin="0,10,0,0"/>
                            <Button Command="{Binding SaveExcelCommand}" Content="{Binding ExcelText}" Style="{StaticResource GenerateButtonStyle}" Background="#2E7D32" Margin="0,10,0,0"/>
                            <ProgressBar IsIndeterminate="True" Margin="0,10" Visibility="{Binding IsBusy, Converter={StaticResource StandardBoolToVis}}"/>
                            <TextBlock Text="{Binding ErrorText}" Foreground="#C62828" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding WarningsError}" Foreground="#C62828" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding TitleText}" FontSize="18" FontWeight="Bold" Foreground="#007ACC"/>
                            <TextBlock Text="{Binding IntroText}" TextWrapping="Wrap" Foreground="#5B6B7C" Margin="0,4,0,8"/>
                            <!-- RE-092 -->
                            <Button Command="{Binding OpenLegendCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#673AB7" Padding="2,0" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldAlertOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LegendText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding DateRangeText}" FontWeight="SemiBold"/>
                            <DatePicker SelectedDate="{Binding StartDate}" Margin="0,5"/>
                            <DatePicker SelectedDate="{Binding EndDate}" Margin="0,5"/>

                            <TextBlock Text="{Binding DriversText}" FontWeight="SemiBold" Margin="0,15,0,0"/>
                            <ComboBox ItemsSource="{Binding Drivers}" ItemContainerStyle="{StaticResource ProductivityFilterItemStyle}"
                                      materialDesign:HintAssist.Hint="{Binding AllHintText}" Margin="0,4,0,0"/>
                            <DockPanel Margin="0,4,0,0" Visibility="{Binding HasDriversTicked, Converter={StaticResource StandardBoolToVis}}">
                                <Button DockPanel.Dock="Right" Command="{Binding ClearDriversCommand}" ToolTip="{Binding ClearTicksText}"
                                        Style="{StaticResource MaterialDesignIconButton}" Width="24" Height="24" VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="CloseCircleOutline" Foreground="#673AB7" Width="16" Height="16"/>
                                </Button>
                                <TextBlock Text="{Binding DriversTickedText}" TextWrapping="Wrap" Foreground="#673AB7" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="{Binding VehiclesText}" FontWeight="SemiBold" Margin="0,15,0,0"/>
                            <ComboBox ItemsSource="{Binding Vehicles}" ItemContainerStyle="{StaticResource ProductivityFilterItemStyle}"
                                      materialDesign:HintAssist.Hint="{Binding AllHintText}" Margin="0,4,0,0"/>
                            <DockPanel Margin="0,4,0,0" Visibility="{Binding HasVehiclesTicked, Converter={StaticResource StandardBoolToVis}}">
                                <Button DockPanel.Dock="Right" Command="{Binding ClearVehiclesCommand}" ToolTip="{Binding ClearTicksText}"
                                        Style="{StaticResource MaterialDesignIconButton}" Width="24" Height="24" VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="CloseCircleOutline" Foreground="#673AB7" Width="16" Height="16"/>
                                </Button>
                                <TextBlock Text="{Binding VehiclesTickedText}" TextWrapping="Wrap" Foreground="#673AB7" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- RE-092: shifts with no Pull-in have no row; they are said here -->
                        <Border Grid.Row="3" helpers:HelpAssist.TopicId="desktop/reports/warnings" Background="#FBE3E1" BorderBrush="#F3B4AF" BorderThickness="1" CornerRadius="5" Margin="0,10,0,0"
                                Visibility="{Binding HasOpenShifts, Converter={StaticResource StandardBoolToVis}}">
                            <Expander Background="Transparent" materialDesign:ExpanderAssist.HorizontalHeaderPadding="14,9">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AlertOctagonOutline" Width="18" Height="18" Foreground="#B3261E" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding OpenShiftsTitle}" Foreground="#7A1A14" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="18,0,18,12">
                                    <TextBlock Text="{Binding OpenShiftsHint}" Foreground="#7A1A14" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding OpenShifts}">
                                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#1E2A36" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- RE-082: the grand total under the list, where the eye ends; administrators only -->
                        <Border Grid.Row="2" Background="#4527A0" CornerRadius="8" Padding="16,10" Margin="0,10,0,0" helpers:HelpAssist.TopicId="desktop/reports/productivity-pay"
                                Visibility="{Binding HasPay, Converter={StaticResource StandardBoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GrandTotalText}" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Totals.AmountSub}" Foreground="#D1C4E9" Margin="14,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Totals.AmountText}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- The period at a glance: one card per figure, with what it is and how it is worked out (RE-092) -->
                        <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,0,-10,12" Visibility="{Binding HasRows, Converter={StaticResource StandardBoolToVis}}"
                                      helpers:HelpAssist.TopicId="desktop/reports/productivity">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="12" BorderThickness="1" Margin="0,0,10,0" Height="117">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#E3E8EF"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsPay}" Value="True"><Setter Property="BorderBrush" Value="#B39DDB"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.10" Color="#0F1E2E"/></Border.Effect>
                                        <!-- The figure in the very middle; its name above and what it means below, with the same height so every card lines up -->
                                        <Grid Margin="12,5">
                                            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="33"/></Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0">
                                                <Border Width="28" Height="28" CornerRadius="14" Background="{Binding Fill}" Margin="0,0,8,0">
                                                    <materialDesign:PackIcon Kind="{Binding Icon}" Width="16" Height="16" Foreground="{Binding Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Label}" Foreground="#4B5A69" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <rep:InfoDot Key="{Binding Key}" Example="{Binding Example}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,-4,0"/>
                                            <Viewbox Grid.Row="1" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Value}" FontSize="27" FontWeight="Bold" Foreground="{Binding Ink}"/>
                                            </Viewbox>
                                            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Line1}" Foreground="#6B7886" FontSize="12" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding Line2}" Foreground="#6B7886" FontSize="12" TextAlignment="Center">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Line2}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="1" Background="White" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1">
                            <Grid>

                                <!-- One line per driver and day; a click opens its breakdown -->
                                <!-- Exactly the Home trips grid: same base style, centred headers, banded rows, accent
                                     bar on hover and selection. Named one by one, as Home does: MaterialDesign sets
                                     these on the element, so a derived style's setters would not apply. -->
                                <DataGrid x:Name="ProductivityGrid" ItemsSource="{Binding RowsView}" AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single" SelectionUnit="FullRow" AlternationCount="2" Cursor="Hand"
                                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                          Style="{StaticResource CustomDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                          RowStyle="{StaticResource ContentRowStyle}"
                                          CellStyle="{StaticResource TripSelectionCellStyle}"
                                          RowDetailsVisibilityMode="VisibleWhenSelected" PreviewMouseLeftButtonDown="ProductivityGrid_RowClick">
                                    <!-- MinWidth on every one (RE-088): a grouped grid can be measured with no room yet, and columns
                                             without a floor then stay at 20 pixels, with no headers. -->
                                        <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Date, StringFormat=MM/dd/yyyy}" Width="112" MinWidth="112">
                                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColDate, Source={StaticResource ProdProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Driver}" Width="*" MinWidth="140">
                                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColDriver, Source={StaticResource ProdProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Vehicle}" Width="*" MinWidth="140">
                                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColVehicle, Source={StaticResource ProdProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding ShiftText}" Width="136" MinWidth="136">
                                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColShift, Source={StaticResource ProdProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding PaidText}" Width="82" MinWidth="82">
                                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColPaid, Source={StaticResource ProdProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding MilesText}" Width="90" MinWidth="90">
                                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColMiles, Source={StaticResource ProdProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding LoadedText}" Width="112" MinWidth="112">
                                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColLoaded, Source={StaticResource ProdProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding Trips}" Width="60" MinWidth="60">
                                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColTrips, Source={StaticResource ProdProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                        <!-- RE-082: the rate in force that day and what the day pays; administrators only -->
                                        <DataGridTextColumn Binding="{Binding RateText}" Width="90" MinWidth="90"
                                                            Visibility="{Binding Data.HasPay, Source={StaticResource ProdProxy}, Converter={StaticResource StandardBoolToVis}}">
                                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColRate, Source={StaticResource ProdProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                        <DataGridTemplateColumn Width="100" MinWidth="100" SortMemberPath="Data.PayAmount"
                                                                Visibility="{Binding Data.HasPay, Source={StaticResource ProdProxy}, Converter={StaticResource StandardBoolToVis}}">
                                            <DataGridTemplateColumn.Header><TextBlock Text="{Binding Data.ColAmount, Source={StaticResource ProdProxy}}"/></DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" Foreground="#4527A0" ToolTip="{Binding PayTip}" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="112" MinWidth="112">
                                            <DataGridTemplateColumn.Header><TextBlock Text="{Binding Data.ColReliability, Source={StaticResource ProdProxy}}"/></DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="9" Padding="8,2" HorizontalAlignment="Center" ToolTip="{Binding ReliabilityTip}" Background="{Binding ChipFill}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Width="13" Height="13" VerticalAlignment="Center" Kind="{Binding ChipIcon}" Foreground="{Binding ChipInk}"/>
                                                            <TextBlock Text="{Binding Reliability}" FontWeight="SemiBold" Foreground="{Binding ChipInk}" Margin="4,0,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>

                                    <!-- RE-082: one block per driver; its header carries the subtotal -->
                                    <DataGrid.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F6F2FD" BorderBrush="#D1C4E9" BorderThickness="0,0,0,1" Padding="12,7" Cursor="Arrow">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Border Width="26" Height="26" CornerRadius="13" Background="#EDE7F6" Margin="0,0,10,0">
                                                                <materialDesign:PackIcon Kind="Steering" Width="15" Height="15" Foreground="#673AB7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name.Title}" FontWeight="Bold" FontSize="13" Foreground="#311B92"/>
                                                                <TextBlock Text="{Binding Name.Line}" Foreground="#5B6B7C" Margin="12,1,0,0"/>
                                                                <TextBlock Text="{Binding Name.RateText}" Foreground="#673AB7" Margin="12,1,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                                        Visibility="{Binding Name.HasPay, Converter={StaticResource StandardBoolToVis}}">
                                                                <TextBlock Text="{Binding Name.SubtotalLabel}" Foreground="#5B6B7C" Margin="0,1,8,0"/>
                                                                <TextBlock Text="{Binding Name.AmountText}" FontWeight="Bold" FontSize="14" Foreground="#4527A0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </DataGrid.GroupStyle>

                                    <DataGrid.RowDetailsTemplate>
                                        <!-- Focusable off on every button here: on the first click the grid takes the focus back for its cell,
                                             the button loses the mouse and the click never happens (RE-092). -->
                                        <DataTemplate>
                                            <!-- The day, opened: a card under its row. Hours as a stacked bar of the six buckets
                                                 that make the paid shift; miles as the odometer split loaded / empty; and what the
                                                 reliability mark is about. -->
                                            <Border Margin="12,4,12,14" Padding="18,16" Background="White" CornerRadius="10" BorderBrush="#E3E8EF" BorderThickness="1" HorizontalAlignment="Left"
                                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource Minus}, ConverterParameter=62}" MinWidth="1080"
                                                    TextElement.FontWeight="Normal" TextElement.Foreground="#1E2A36" Cursor="Arrow">
                                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="1" Direction="270" Opacity="0.12" Color="#0F1E2E"/></Border.Effect>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="1"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="1"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Resources>
                                                        <!-- One legend line: colour, name, h:mm or miles, share -->
                                                        <DataTemplate x:Key="LegendLine">
                                                            <Grid Margin="0,3" Width="360">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                                <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Color}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Label}" Foreground="#3B4856" VerticalAlignment="Center"/>
                                                                    <rep:InfoDot Key="{Binding Info}" Example="{Binding Example}" Margin="4,0,0,0"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding Share}" Foreground="#7A8794" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                        <!-- A figure beside the bar: the same card for hours and for miles -->
                                                        <DataTemplate x:Key="FactCard">
                                                            <Border Background="#F6F8FA" CornerRadius="8" Height="52" Margin="4">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                        <TextBlock Text="{Binding Label}" Foreground="#5B6B7C" FontSize="11.5" VerticalAlignment="Center"/>
                                                                        <rep:InfoDot Key="{Binding Info}" Example="{Binding Example}" Margin="4,0,0,0"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Value}" FontWeight="Bold" FontSize="14" Foreground="{Binding Ink}" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                        <!-- A segment of a stacked bar -->
                                                        <DataTemplate x:Key="BarSegment">
                                                            <Border Width="{Binding Width}" Height="14" Background="{Binding Color}" ToolTip="{Binding Label}"/>
                                                        </DataTemplate>
                                                        <ItemsPanelTemplate x:Key="BarPanel"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </Grid.Resources>

                                                    <!-- HOURS -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" Width="360" Background="Transparent" helpers:HelpAssist.TopicId="desktop/reports/productivity-hours">
                                                        <DockPanel Height="30" Margin="0,0,0,8">
                                                            <Button Focusable="False" DockPanel.Dock="Right" Command="{Binding OpenShiftCalculationCommand}" ToolTip="{Binding ShiftCalcTip}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#673AB7" BorderBrush="#B39DDB" Height="28" Padding="10,0"
                                                                    Visibility="{Binding CanCalculate, Converter={StaticResource StandardBoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="Calculator" Width="15" Height="15" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding CalcText}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ClockTimeFourOutline" Width="18" Height="18" Foreground="#673AB7" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding HoursTitle}" FontSize="14" FontWeight="Bold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                                <rep:InfoDot Key="h.shift" Example="{Binding ShiftExample}" Margin="5,0,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <DockPanel Height="40">
                                                            <TextBlock Text="{Binding PaidText}" FontSize="28" FontWeight="Bold" Foreground="#673AB7" VerticalAlignment="Center"/>
                                                            <TextBlock Foreground="#5B6B7C" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"><Run Text="{Binding PaidFromLabel, Mode=OneWay}"/> <Run Text="{Binding PaidStartText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1E2A36"/> <Run Text="{Binding PaidToLabel, Mode=OneWay}"/> <Run Text="{Binding PaidEndText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1E2A36"/></TextBlock>
                                                        </DockPanel>
                                                        <Border CornerRadius="7" Margin="0,10,0,10" Height="14" Background="#EEF1F5">
                                                            <Border.OpacityMask><VisualBrush><VisualBrush.Visual><Border Width="360" Height="14" CornerRadius="7" Background="Black"/></VisualBrush.Visual></VisualBrush></Border.OpacityMask>
                                                            <ItemsControl ItemsSource="{Binding HourSegments}" ItemTemplate="{StaticResource BarSegment}" ItemsPanel="{StaticResource BarPanel}" Height="14"/>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding HourSegments}" ItemTemplate="{StaticResource LegendLine}"/>
                                                        <ItemsControl ItemsSource="{Binding HourFacts}" ItemTemplate="{StaticResource FactCard}" Margin="-4,10,-4,0">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <Border Grid.Column="1" Background="#E3E8EF"/>

                                                    <!-- MILES -->
                                                    <StackPanel Grid.Column="2" Margin="24,0" Width="360" Background="Transparent" helpers:HelpAssist.TopicId="desktop/reports/productivity-miles">
                                                        <DockPanel Height="30" Margin="0,0,0,8">
                                                            <Button Focusable="False" DockPanel.Dock="Right" Command="{Binding OpenMilesCalculationCommand}" ToolTip="{Binding MilesCalcTip}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#673AB7" BorderBrush="#B39DDB" Height="28" Padding="10,0"
                                                                    Visibility="{Binding CanCalculate, Converter={StaticResource StandardBoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="Calculator" Width="15" Height="15" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding CalcText}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Speedometer" Width="18" Height="18" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding MilesTitle}" FontSize="14" FontWeight="Bold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                                <rep:InfoDot Key="m.general" Example="{Binding MilesExample}" Margin="5,0,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <DockPanel Height="40">
                                                            <TextBlock Text="{Binding MilesText}" FontSize="28" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding OdometerRange}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><rep:InfoDot Key="m.odometer" Example="{Binding OdometerExample}" Margin="5,0,0,0"/></StackPanel>
                                                        </DockPanel>
                                                        <Border CornerRadius="7" Margin="0,10,0,10" Height="14" Background="#EEF1F5">
                                                            <Border.OpacityMask><VisualBrush><VisualBrush.Visual><Border Width="360" Height="14" CornerRadius="7" Background="Black"/></VisualBrush.Visual></VisualBrush></Border.OpacityMask>
                                                            <ItemsControl ItemsSource="{Binding MileSegments}" ItemTemplate="{StaticResource BarSegment}" ItemsPanel="{StaticResource BarPanel}" Height="14"/>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding MileSegments}" ItemTemplate="{StaticResource LegendLine}"/>
                                                        <ItemsControl ItemsSource="{Binding MileFacts}" ItemTemplate="{StaticResource FactCard}" Margin="-4,10,-4,0">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>

                                                    <Border Grid.Column="3" Background="#E3E8EF"/>

                                                    <!-- RELIABILITY -->
                                                    <StackPanel Grid.Column="4" Margin="24,0,0,0" MinWidth="220" Background="Transparent" helpers:HelpAssist.TopicId="desktop/reports/warnings">
                                                        <StackPanel Orientation="Horizontal" Height="30" Margin="0,0,0,8">
                                                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18" Foreground="#0F766E" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ReliabilityTitle}" FontSize="14" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            <rep:InfoDot Key="r.reliability" Margin="4,0,0,0"/>
                                                            <TextBlock Text="{Binding ReliabilitySummary}" Foreground="#5B6B7C" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Border Background="#DCF2E3" CornerRadius="8" Padding="10,8" Visibility="{Binding IsReliable, Converter={StaticResource StandardBoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" Foreground="#1B7F3B" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ReliableLine}" Foreground="#14532D" Margin="6,0,0,0" TextWrapping="Wrap" MaxWidth="240"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding IssueLines}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#FFF4E5" CornerRadius="8" Padding="10,7" Margin="0,0,0,6" BorderBrush="#FBD38D" BorderThickness="1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                            <materialDesign:PackIcon Kind="AlertOutline" Width="16" Height="16" Foreground="#C2410C" VerticalAlignment="Top" Margin="0,1,6,0"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#7C2D12" TextWrapping="Wrap" MaxWidth="260"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    <!-- RE-092: the day's warnings, each opens its cases -->
                                                    <ItemsControl ItemsSource="{Binding WarningItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="White" CornerRadius="8" BorderBrush="{Binding Line}" BorderThickness="1" Margin="0,0,0,8">
                                                                    <StackPanel>
                                                                        <Button Focusable="False" Command="{Binding ToggleCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="{Binding Fill}" Height="Auto" Padding="12,9"
                                                                                materialDesign:ButtonAssist.CornerRadius="7" HorizontalContentAlignment="Stretch">
                                                                            <DockPanel>
                                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ToggleText}" Foreground="#673AB7" FontWeight="SemiBold"/>
                                                                                <materialDesign:PackIcon Kind="{Binding Icon}" Foreground="{Binding Ink}" Width="18" Height="18" VerticalAlignment="Center"/>
                                                                                <Border DockPanel.Dock="Right" Background="White" CornerRadius="9" Padding="8,1" Margin="6,0,10,0" VerticalAlignment="Center" Visibility="{Binding HasBadge, Converter={StaticResource StandardBoolToVis}}">
                                                                                    <TextBlock Text="{Binding Badge}" Foreground="{Binding Ink}" FontSize="12" FontWeight="Bold"/>
                                                                                </Border>
                                                                                <TextBlock Text="{Binding Title}" Foreground="#1E2A36" FontWeight="SemiBold" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                                                            </DockPanel>
                                                                        </Button>
                                                                        <StackPanel Margin="14,10,14,12" Visibility="{Binding IsOpen, Converter={StaticResource StandardBoolToVis}}">
                                                                            <TextBlock Text="{Binding Why}" TextWrapping="Wrap" Foreground="#3B4856"/>
                                                                            <TextBlock Foreground="#5B6B7C" Margin="0,3,0,8"><Run Text="{Binding WhenLabel, Mode=OneWay}"/>: <Run Text="{Binding When, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                                                                            <TextBlock Text="{Binding Message}" Foreground="#5B6B7C">
                                                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                                            </TextBlock>
                                                                            <rep:ShiftPicture Shift="{Binding Shift}" Margin="0,2,0,10"/>
                                                                            <ItemsControl ItemsSource="{Binding Cases}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Border BorderBrush="#EEF1F5" BorderThickness="0,1,0,0" Padding="0,6">
                                                                                            <DockPanel Background="Transparent">
                                                                                            <Border DockPanel.Dock="Left" Background="#EEF1F5" CornerRadius="9" MinWidth="20" Padding="5,0" Margin="0,0,8,0" VerticalAlignment="Top" Visibility="{Binding HasNumber, Converter={StaticResource StandardBoolToVis}}">
                                                                                                <TextBlock Text="{Binding Number}" FontSize="11.5" FontWeight="SemiBold" Foreground="#4B5A69" HorizontalAlignment="Center"/>
                                                                                            </Border>
                                                                                            <materialDesign:PackIcon DockPanel.Dock="Right" Kind="MapMarkerDistance" Width="16" Height="16" Foreground="#A99BC9" VerticalAlignment="Top" Visibility="{Binding HasPlace, Converter={StaticResource StandardBoolToVis}}"/>
                                                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                                                                                <DockPanel.ToolTip>
                                                                                                    <ToolTip Background="White" Foreground="#1E2A36" BorderBrush="#D1C4E9" BorderThickness="1" Visibility="{Binding HasPlace, Converter={StaticResource StandardBoolToVis}}">
                                                                                                        <StackPanel>
                                                                                                            <Canvas Width="340" Height="120" Background="#F7F7FB">
                                                                                                                <Ellipse Canvas.Left="148" Canvas.Top="38" Width="44" Height="44" Fill="#DCF2E3" Stroke="#1B7F3B" StrokeDashArray="3 2"/>
                                                                                                                <Line X1="170" Y1="60" X2="{Binding MarkX}" Y2="{Binding MarkY}" Stroke="#C2410C" StrokeThickness="2" StrokeDashArray="4 3"/>
                                                                                                                <Ellipse Canvas.Left="164" Canvas.Top="54" Width="12" Height="12" Fill="#673AB7"/>
                                                                                                                <Ellipse Canvas.Left="{Binding MarkDotX}" Canvas.Top="{Binding MarkDotY}" Width="12" Height="12" Fill="#C2410C"/>
                                                                                                                <TextBlock Canvas.Left="8" Canvas.Top="6" Foreground="#1E2A36"><Run Text="{Binding StopText, Mode=OneWay}" Foreground="#673AB7" FontWeight="SemiBold"/>  <Run Text="{Binding MarkText, Mode=OneWay}" Foreground="#C2410C" FontWeight="SemiBold"/></TextBlock>
                                                                                                                <TextBlock Canvas.Right="8" Canvas.Top="6" Text="{Binding DistanceText}" Foreground="#C2410C" FontWeight="Bold"/>
                                                                                                            </Canvas>
                                                                                                            <TextBlock Text="{Binding PictureNote}" FontSize="11" Margin="0,4,0,0"/>
                                                                                                        </StackPanel>
                                                                                                    </ToolTip>
                                                                                                </DockPanel.ToolTip>
                                                                                            </DockPanel>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                            <TextBlock Text="{Binding TotalText}" FontWeight="Bold" Foreground="#4527A0" TextWrapping="Wrap" Margin="0,6,0,0">
                                                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding TotalText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"><Run Text="{Binding DoLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="#5B6B7C"/><Run Text=": " Foreground="#5B6B7C"/><Run Text="{Binding DoText, Mode=OneWay}"/></TextBlock>
                                                                            <WrapPanel Margin="0,8,0,0">
                                                                                <Button Focusable="False" Background="#673AB7" BorderBrush="#673AB7" Foreground="White" Height="30" Padding="12,0" Margin="0,0,8,6"
                                                                                        Command="{Binding Data.CorrectOdometerCommand, Source={StaticResource ProdProxy}}" CommandParameter="{Binding}"
                                                                                        Visibility="{Binding CanCorrect, Converter={StaticResource StandardBoolToVis}}">
                                                                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="{Binding CorrectText}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                                                                </Button>
                                                                                <Button Focusable="False" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#673AB7" BorderBrush="#B39DDB" Height="30" Padding="12,0" Margin="0,0,8,6"
                                                                                        Command="{Binding Data.OpenOdometerHistoryCommand, Source={StaticResource ProdProxy}}" CommandParameter="{Binding}"
                                                                                        Visibility="{Binding CanSeeHistory, Converter={StaticResource StandardBoolToVis}}">
                                                                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Speedometer" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="{Binding HistoryText}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                                                                </Button>
                                                                                <Button Focusable="False" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#673AB7" Height="30" Padding="8,0"
                                                                                        Command="{Binding Data.OpenLegendCommand, Source={StaticResource ProdProxy}}" CommandParameter="{Binding Code}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ShieldAlertOutline" Width="17" Height="17" VerticalAlignment="Center"/><TextBlock Text="{Binding LegendText}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                                                                            </WrapPanel>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                        <Button Focusable="False" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#673AB7" Padding="4,0" Height="28" HorizontalAlignment="Left"
                                                                Command="{Binding Data.OpenLegendCommand, Source={StaticResource ProdProxy}}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ShieldAlertOutline" Width="17" Height="17" VerticalAlignment="Center"/><TextBlock Text="{Binding Data.LegendText, Source={StaticResource ProdProxy}}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                                                    </StackPanel>

                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGrid.RowDetailsTemplate>
                                </DataGrid>
                                <!-- RE-088: over the grid, never instead of it. A grouped grid that is born collapsed
                                     gets its columns at the 20-pixel minimum, with no headers, now and then. -->
                                <Border Background="White" CornerRadius="5" Visibility="{Binding HasRows, Converter={StaticResource AviataInverseVisibilityConverter}}">
                                    <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center" Foreground="#9E9E9E"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- GPS Report Tab -->
            <TabItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.TabGps]}" Visibility="{Binding IsNotDriver, Converter={StaticResource StandardBoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section for Report Parameters/Filters -->
                    <Border Grid.Row="0" Background="#F7F7F7" CornerRadius="5" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.Options]}" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.PickDate]}" VerticalAlignment="Center" Margin="0,0,10,0" Width="120"/>
                                <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.PickRoute]}" VerticalAlignment="Center" Margin="0,0,10,0" Width="120"/>
                                <ComboBox ItemsSource="{Binding AllVehicleRoutes}" 
                                          SelectedItem="{Binding SelectedVehicleRoute}"
                                          DisplayMemberPath="Name"
                                          Width="200"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section for the Generate Button -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Command="{Binding GenerateGpsReportCommand}"
                                Style="{StaticResource GenerateButtonStyle}">
                            <TextBlock Text="{Binding GenerateGpsButtonText}"/>
                        </Button>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.GpsHint]}" 
                                   Foreground="Gray" 
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Trip2 PDF Report Tab -->
            <!--<TabItem Header="Trip2 PDF Report" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F7F7F7" CornerRadius="5" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Trip2 PDF Generation" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.PickDate]}" VerticalAlignment="Center" Margin="0,0,10,0" Width="120"/>
                                <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Command="{Binding GenerateTrip2PdfCommand}"
                    Style="{StaticResource GenerateButtonStyle}">
                            <TextBlock Text="{Binding GenerateTrip2ButtonText}"/>
                        </Button>
                        <TextBlock Text="Export the Daily Trip Log to a PDF file." 
                       Foreground="Gray" 
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>-->

            <!-- Manifest Report Tab (formerly Trip2 PDF Report) -->
            <TabItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.TabManifest]}" Visibility="{Binding IsNotDriver, Converter={StaticResource StandardBoolToVis}}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FILTERS SIDEBAR -->
                    <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,10,0" BorderBrush="#DDD" BorderThickness="1">
                        <DockPanel>
                            <!-- RE-088: on a small screen the filters scroll and the buttons stay in sight. -->
                            <StackPanel DockPanel.Dock="Bottom">
                            <Separator Margin="0,10"/>

                            <Button Command="{Binding PreviewTrip2ReportCommand}" 
                        Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.Preview]}" 
                        Style="{StaticResource GenerateButtonStyle}" 
                        Background="#673AB7"/>

                            <Button Command="{Binding SaveTrip2ReportCommand}" 
                        Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.SavePdf]}" 
                        IsEnabled="{Binding IsTrip2PreviewReady}" 
                        Style="{StaticResource GenerateButtonStyle}" 
                        Background="#2E7D32" Margin="0,10,0,0"/>

                            <ProgressBar IsIndeterminate="True" Margin="0,10" 
                             Visibility="{Binding IsGeneratingTrip2Preview, Converter={StaticResource StandardBoolToVis}}"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.ManifestFilters]}" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,20"/>

                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.DateRange]}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding Trip2StartDate}" materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.StartDate]}" Margin="0,5"/>
                            <DatePicker SelectedDate="{Binding Trip2EndDate}" materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.EndDate]}" Margin="0,5"/>

                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.FundingSources]}" FontWeight="SemiBold" Margin="0,15,0,5"/>

                            <!-- Master CheckBox -->
                            <CheckBox Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.AllSources]}" 
                          IsChecked="{Binding IsTrip2AllSelected}" 
                          FontWeight="Bold" Margin="2,0,0,5"/>

                            <!-- Multi-selection ComboBox -->
                            <ComboBox ItemsSource="{Binding AllFundingSources}" 
                          ItemContainerStyle="{StaticResource MultiSelectComboBoxItemStyle}"
                          materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.FilterItem]}"
                          SelectedItem="{Binding SelectedFundingSource}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- PREVIEW AREA -->
                    <Border Grid.Column="1" Background="#F0F0F0" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <!-- Placeholder -->
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding IsTrip2PreviewReady, Converter={StaticResource AviataInverseVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="FilePdfBox" Width="60" Height="60" HorizontalAlignment="Center" Foreground="#BDBDBD"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.EmptyManifest]}" HorizontalAlignment="Center" Foreground="#9E9E9E"/>
                            </StackPanel>

                            <!-- WebView2 Preview -->
                            <wv2:WebView2 x:Name="Trip2PdfWebView" 
                              Source="{Binding Trip2PreviewFilePath}"
                              Visibility="{Binding IsTrip2PreviewReady, Converter={StaticResource StandardBoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Facility Report (formerly Aviata Report) -->
            <TabItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.TabFacility]}"  Visibility="{Binding IsNotDriver, Converter={StaticResource StandardBoolToVis}}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FILTROS -->
                    <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,10,0" BorderBrush="#DDD" BorderThickness="1">
                        <DockPanel>
                            <!-- RE-088: on a small screen the filters scroll and the buttons stay in sight. -->
                            <StackPanel DockPanel.Dock="Bottom">
                            <Separator Margin="0,10"/>
                            <Button Command="{Binding PreviewAviataReportCommand}" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.Preview]}" Style="{StaticResource GenerateButtonStyle}" Background="#673AB7"/>
                            <Button Command="{Binding SaveAviataReportCommand}" Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.SavePdf]}" IsEnabled="{Binding IsPreviewReady}" Style="{StaticResource GenerateButtonStyle}" Background="#2E7D32" Margin="0,10,0,0"/>

                            <ProgressBar IsIndeterminate="True" Margin="0,10" Visibility="{Binding IsGeneratingAviata, Converter={StaticResource StandardBoolToVis}}"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.FacilityFilters]}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.StartDateLabel]}" Margin="0,10,0,5"/>
                            <DatePicker SelectedDate="{Binding StartDate}"/>

                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.EndDateLabel]}" Margin="0,15,0,5"/>
                            <DatePicker SelectedDate="{Binding EndDate}"/>

                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.FundingSourcesLabel]}" Margin="0,15,0,5"/>

                            <!-- Master CheckBox (Select All) placed above the ComboBox -->
                            <CheckBox Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.AllSources]}" 
                                      IsChecked="{Binding IsAllSelected}" 
                                      FontWeight="Bold" Margin="2,0,0,5"/>

                            <!-- Multi-selection ComboBox -->
                            <ComboBox ItemsSource="{Binding AllFundingSources}" 
                                      ItemContainerStyle="{StaticResource MultiSelectComboBoxItemStyle}"
                                      materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.FilterItem]}"
                                      SelectedItem="{Binding SelectedFundingSource}"/>

                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.DriversLabel]}" Margin="0,15,0,5"/>
                            <CheckBox Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.AllDrivers]}"
                                      IsChecked="{Binding IsAllFacilityDriversSelected}"
                                      FontWeight="Bold" Margin="2,0,0,5"/>
                            <ComboBox ItemsSource="{Binding FacilityDrivers}"
                                      ItemContainerStyle="{StaticResource MultiSelectComboBoxItemStyle}"
                                      materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.FilterDriver]}"
                                      SelectedItem="{Binding SelectedFacilityDriver}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- PREVIEW -->
                    <Border Grid.Column="1" Background="#F0F0F0" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding IsPreviewReadyAviata, Converter={StaticResource AviataInverseVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="FilePdfBox" Width="60" Height="60" HorizontalAlignment="Center" Foreground="#BDBDBD"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[reports.Empty]}" HorizontalAlignment="Center" Foreground="#9E9E9E"/>
                            </StackPanel>
                            <wv2:WebView2 x:Name="PdfWebView" 
                                  Source="{Binding AviataPreviewFilePath}"
                                  Visibility="{Binding IsPreviewReadyAviata, Converter={StaticResource StandardBoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
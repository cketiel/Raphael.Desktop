<UserControl x:Class="Raphael.Desktop.Views.Reports.ImpossibleAppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Raphael.Desktop.Converters"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StarWidthConverter x:Key="StarWidthConverter"/>
        <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}"/>
    </UserControl.Resources>

    <Grid Margin="10" helpers:HelpAssist.TopicId="desktop/reports/impossible-appointments">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Background="#4527A0" CornerRadius="8" Padding="16,10">
            <DockPanel>
                <materialDesign:PackIcon DockPanel.Dock="Left" Kind="CalendarAlert" Foreground="White" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="{Binding TitleText}" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding L[feasrep.Hint]}" Foreground="#D1C4E9" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <WrapPanel Grid.Row="1" Margin="0,10,0,0">
            <DatePicker SelectedDate="{Binding StartDate}" Width="140" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding EndDate}" Width="140" Margin="0,0,8,0"/>
            <Button Content="{Binding L[feasrep.Generate]}" Command="{Binding GenerateCommand}" Background="#673AB7" BorderBrush="#673AB7" Margin="0,0,12,0"/>
            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="FundingSource" Width="220" Margin="0,0,8,0"
                      materialDesign:HintAssist.Hint="{Binding L[feasrep.AllSources]}" materialDesign:TextFieldAssist.HasClearButton="True"/>
            <ComboBox ItemsSource="{Binding Origins}" SelectedValue="{Binding OriginFilter}" SelectedValuePath="Key" DisplayMemberPath="Name" Width="170" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding Kinds}" SelectedValue="{Binding KindFilter}" SelectedValuePath="Key" DisplayMemberPath="Name" Width="150" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding States}" SelectedValue="{Binding StateFilter}" SelectedValuePath="Key" DisplayMemberPath="Name" Width="150" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding Verdicts}" SelectedValue="{Binding VerdictFilter}" SelectedValuePath="Key" DisplayMemberPath="Name" Width="200" Margin="0,0,12,0"/>
            <CheckBox Content="{Binding L[feasrep.WithNames]}" IsChecked="{Binding WithNames}" ToolTip="{Binding L[feasrep.WithNamesTip]}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="{Binding L[feasrep.Pdf]}" Command="{Binding SavePdfCommand}" ToolTip="{Binding L[feasrep.PdfTip]}" ToolTipService.ShowOnDisabled="True" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
            <Button Content="{Binding L[feasrep.Excel]}" Command="{Binding SaveExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
            <Button Content="{Binding L[feasrep.CheckPast]}" Command="{Binding CheckPastCommand}" ToolTip="{Binding L[feasrep.CheckPastTip]}" Style="{StaticResource MaterialDesignFlatButton}"
                    Visibility="{Binding HasUnchecked, Converter={StaticResource BoolToVis}}"/>
        </WrapPanel>

        <StackPanel Grid.Row="2" Margin="0,8,0,6">
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#B26A00" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"/>
            <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" AlternationCount="2"
                  EnableRowVirtualization="True" Style="{StaticResource CustomDataGridStyle}" ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}" CellStyle="{StaticResource TripSelectionCellStyle}" Cursor="Hand">
            <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Date, StringFormat=\{0:MM/dd/yyyy\}}" Width="95" SortMemberPath="Date"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColDate], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding TripNumber}" Width="120"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColTrip], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FundingSource}" Width="140"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColSource], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding OriginText}" Width="130"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColOrigin], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding SpaceType}" Width="70"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColSpace], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding KindText}" Width="95"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColKind], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FromText}" Width="95" SortMemberPath="From"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColOriginal], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ToText}" Width="90"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColAppt], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding MissingText}" Width="120" SortMemberPath="Missing"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColMissing], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding SuggestedText}" Width="110"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColSuggested], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding NowText}" Width="95"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColNow], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding DifferenceText}" Width="80"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColDiff], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding StateText}" Width="120"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColState], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding HappenedText}" Width="160"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColHappened], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding BrokerText}" Width="130"><DataGridTextColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColBroker], Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header></DataGridTextColumn>
                    <DataGridTemplateColumn Width="*" MinWidth="170" SortMemberPath="Verdict">
                        <DataGridTemplateColumn.Header><TextBlock Text="{Binding Data.L[feasrep.ColVerdict], Source={StaticResource vmProxy}}"/></DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="Pill" CornerRadius="9" Padding="8,1" HorizontalAlignment="Center" Background="#ECEFF1" ToolTip="{Binding VerdictTip}">
                                    <TextBlock x:Name="PillText" Text="{Binding VerdictText}" FontWeight="SemiBold" Foreground="#455A64"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Verdict}" Value="FACTS"><Setter TargetName="Pill" Property="Background" Value="#E8F5E9"/><Setter TargetName="PillText" Property="Foreground" Value="#2E7D32"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Verdict}" Value="CALCULATION"><Setter TargetName="Pill" Property="Background" Value="#EDE7F6"/><Setter TargetName="PillText" Property="Foreground" Value="#4527A0"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Verdict}" Value="MANUAL"><Setter TargetName="Pill" Property="Background" Value="#ECEFF1"/><Setter TargetName="PillText" Property="Foreground" Value="#455A64"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Verdict}" Value="LOOSE"><Setter TargetName="Pill" Property="Background" Value="#E0F2F1"/><Setter TargetName="PillText" Property="Foreground" Value="#00695C"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Verdict}" Value="ARGUABLE"><Setter TargetName="Pill" Property="Background" Value="#FFF3E0"/><Setter TargetName="PillText" Property="Foreground" Value="#B26A00"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- The proof of the selected trip -->
        <Border Grid.Row="4" DataContext="{Binding Selected}" Background="#F4F1FA" BorderBrush="#D1C4E9" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,8,0,0">
            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Explain}" TextWrapping="Wrap"/>
                    <Grid Height="9" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding AvailableWeight, Converter={StaticResource StarWidthConverter}}"/><ColumnDefinition Width="{Binding MissingWeight, Converter={StaticResource StarWidthConverter}}"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#7E57C2"/><Border Grid.Column="1" Background="#E53935"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Places}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Received}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding StateDetail}" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Happened}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding VerdictTip}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#4527A0" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="Raphael.Desktop.Views.RunConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="600" MaxHeight="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- RE-063. The route being saved clashes with another from today on: its driver already has a
         route, or its login is taken. One card per route in the way, each with what can be done. -->
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="AccountAlertOutline" Foreground="#E65100"
                                     Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" Style="{StaticResource MaterialDesignBody1TextBlock}" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BackButton" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Click="OnBack" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ConflictsPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>

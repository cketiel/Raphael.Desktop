<UserControl x:Class="Raphael.Desktop.Views.Admin.Billing.FundingSourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1300"
             helpers:HelpAssist.TopicId="desktop/admin/billing-rates">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}"/>

        <!-- Palette: the app's purple, quiet neutrals, and one colour per meaning. -->
        <SolidColorBrush x:Key="Accent" Color="#5E35B1"/>
        <SolidColorBrush x:Key="AccentDark" Color="#4527A0"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#EDE7F6"/>
        <SolidColorBrush x:Key="PageBg" Color="#F4F5F9"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Line" Color="#E6E8EF"/>
        <SolidColorBrush x:Key="Ink" Color="#1F2430"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
        <SolidColorBrush x:Key="Faint" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="WarnBg" Color="#FFF4E5"/>
        <SolidColorBrush x:Key="WarnInk" Color="#8A5300"/>
        <SolidColorBrush x:Key="Money" Color="#1B5E20"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="1" Direction="270" Opacity="0.08" Color="#1F2430"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Foreground" Value="{StaticResource AccentDark}"/>
            <Setter Property="BorderBrush" Value="#D1C4E9"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
        </Style>

        <!-- Status chip of a rate: default, extra, expired, future. -->
        <Style x:Key="StatusChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F1F2F6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="default">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="future">
                    <Setter Property="Background" Value="#EDE7F6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="default">
                    <Setter Property="Foreground" Value="#0D47A1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="future">
                    <Setter Property="Foreground" Value="#4527A0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A figure of the header. -->
        <Style x:Key="KpiTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Left: funding sources ================= -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="14,14,0,14" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding ExportFundingSourcesCommand}" ToolTip="{Binding ExcelExportToolTip}">
                            <materialDesign:PackIcon Kind="MicrosoftExcel" Foreground="#2E7D32"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding AddFundingSourceCommand}" ToolTip="{Binding TextAddFundingSource}">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Foreground="{StaticResource Accent}"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TextFundingSources}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <Border Background="{StaticResource AccentSoft}" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FundingSourcesCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <Border Background="{StaticResource PageBg}" CornerRadius="8" Padding="10,2" Margin="0,12,0,0">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="Magnify" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{Binding TextSearch}"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden" BorderThickness="0" Background="Transparent"/>
                        </DockPanel>
                    </Border>
                    <CheckBox Content="{Binding TextOnlyActive}" IsChecked="{Binding OnlyActive}" Margin="2,10,0,0" Foreground="{StaticResource Muted}"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Margin="14" Height="40" Command="{Binding ToggleExpiringPanelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#FFD08A" Background="{StaticResource WarnBg}"
                        materialDesign:ButtonAssist.CornerRadius="8" HorizontalContentAlignment="Stretch">
                    <DockPanel>
                        <materialDesign:PackIcon DockPanel.Dock="Right" Kind="ChevronRight" Foreground="{StaticResource WarnInk}" VerticalAlignment="Center"/>
                        <materialDesign:PackIcon Kind="CalendarClockOutline" Foreground="{StaticResource WarnInk}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TextExpiringButton}" Foreground="{StaticResource WarnInk}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>

                <ListBox ItemsSource="{Binding FundingSources}" SelectedItem="{Binding SelectedItem}" Margin="8,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" CornerRadius="8" Padding="10,8" Background="Transparent" Cursor="Hand">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#F5F3FB"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoft}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel ToolTip="{Binding WarningText}" ToolTipService.IsEnabled="{Binding HasWarnings}">
                                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="{StaticResource Accent}" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border DockPanel.Dock="Right" Background="{StaticResource WarnBg}" CornerRadius="10" Padding="5,2" VerticalAlignment="Center"
                                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                                    <materialDesign:PackIcon Kind="AlertOutline" Width="14" Height="14" Foreground="{StaticResource WarnInk}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Center"/>

        <!-- ================= Right ================= -->
        <Grid Grid.Column="2" Margin="0,14,14,14">

            <!-- Nothing chosen yet -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasSelection}" Value="False"/>
                                    <Condition Binding="{Binding IsExpiringPanelOpen}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CashMultiple" Width="34" Height="34" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding TextPickFundingSource}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,14,0,0"/>
            </StackPanel>

            <!-- The selected funding source -->
            <DockPanel Visibility="{Binding ShowGroups, Converter={StaticResource BoolToVis}}">

                <!-- Hero -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Command="{Binding ExportRatesCommand}" ToolTip="{Binding ExcelExportToolTip}">
                                    <materialDesign:PackIcon Kind="MicrosoftExcel" Foreground="#2E7D32"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding EditFundingSourceCommand}">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="PencilOutline" Margin="0,0,6,0"/><TextBlock Text="{Binding TextEditFundingSource}"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyRatesCommand}">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentCopy" Margin="0,0,6,0"/><TextBlock Text="{Binding TextCopyRates}"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddRateCommand}" CommandParameter="{x:Null}">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" Margin="0,0,6,0"/><TextBlock Text="{Binding TextAddRate}"/></StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource Accent}" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding SelectedInitials}" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedFundingSource.Name}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SelectedSummary}" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- Figures -->
                        <WrapPanel Margin="0,16,0,0">
                            <Border Style="{StaticResource KpiTile}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="#E8F5E9" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="CheckDecagramOutline" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding KpiRatesInForce}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <TextBlock Text="{Binding TextKpiRates}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource KpiTile}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="#E3F2FD" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="WheelchairAccessibility" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding KpiSpaceTypes}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <TextBlock Text="{Binding TextKpiSpaceTypes}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource KpiTile}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="{StaticResource WarnBg}" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="CalendarClockOutline" Foreground="{StaticResource WarnInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding KpiEndingSoon}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <TextBlock Text="{Binding TextKpiEnding}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource KpiTile}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="#FDECEA" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="AlertOutline" Foreground="#C62828" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding KpiWarnings}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                        <TextBlock Text="{Binding TextKpiWarnings}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <CheckBox Content="{Binding TextShowHistory}" IsChecked="{Binding DisplayExpired}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource Muted}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid>
                    <!-- No rates -->
                    <Border Style="{StaticResource Card}" Padding="32" VerticalAlignment="Top" Visibility="{Binding HasNoRates, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource WarnBg}" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CashRemove" Width="30" Height="30" Foreground="{StaticResource WarnInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding TextNoRatesTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding TextNoRatesBody}" Foreground="{StaticResource Muted}" Margin="0,4,0,16" TextWrapping="Wrap" TextAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CopyRatesCommand}">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentCopy" Margin="0,0,6,0"/><TextBlock Text="{Binding TextCopyRates}"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddRateCommand}" CommandParameter="{x:Null}">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" Margin="0,0,6,0"/><TextBlock Text="{Binding TextAddRate}"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="0">
                                        <StackPanel>
                                            <!-- Card header: click to fold or unfold the card -->
                                            <Border Background="#FAFAFD" CornerRadius="10,10,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,12,18,12"
                                                    Cursor="Hand" ToolTip="{Binding Data.TextToggleCard, Source={StaticResource vmProxy}}">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding ToggleExpandedCommand}"/>
                                                </Border.InputBindings>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="30"
                                                            Command="{Binding Data.AddRateCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0"/><TextBlock Text="{Binding Data.TextAddRate, Source={StaticResource vmProxy}}"/></StackPanel>
                                                    </Button>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="{Binding ChevronIcon}" Width="20" Height="20" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <Border Background="{StaticResource Accent}" CornerRadius="6" Padding="10,3">
                                                            <TextBlock Text="{Binding SpaceTypeName}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding RateCountText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                        <Border Background="{StaticResource WarnBg}" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="AlertOutline" Foreground="{StaticResource WarnInk}" Width="14" Height="14" Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource WarnInk}" FontSize="11"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">

                                            <!-- Column titles -->
                                            <Grid Margin="18,10,18,4" TextElement.Foreground="{StaticResource Faint}" TextElement.FontSize="11" TextElement.FontWeight="SemiBold">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="104"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Data.TextColItem, Source={StaticResource vmProxy}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Data.TextColRate, Source={StaticResource vmProxy}}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Data.TextColConditions, Source={StaticResource vmProxy}}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Data.TextColPeriod, Source={StaticResource vmProxy}}"/>
                                            </Grid>

                                            <!-- Rates -->
                                            <ItemsControl ItemsSource="{Binding Rows}" Margin="8,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="RateRow" CornerRadius="8" Padding="10,7" Background="Transparent">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2.2*"/>
                                                                    <ColumnDefinition Width="110"/>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="180"/>
                                                                    <ColumnDefinition Width="104"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoft}" Margin="0,0,10,0">
                                                                        <materialDesign:PackIcon Kind="{Binding KindIcon}" Foreground="{StaticResource Accent}" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    <Border Style="{StaticResource StatusChip}">
                                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusChipText}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding RateText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Money}"
                                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding ConditionsText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <materialDesign:PackIcon Kind="CalendarRange" Foreground="{StaticResource Faint}" Width="14" Height="14" Margin="0,0,4,0"/>
                                                                        <TextBlock Text="{Binding PeriodText}" FontSize="12" Foreground="{StaticResource Ink}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding UsedText}" FontSize="10" Foreground="{StaticResource Faint}" Margin="18,1,0,0"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource IconButton}" ToolTip="{Binding Data.TextApplyToDay, Source={StaticResource vmProxy}}"
                                                                            Command="{Binding Data.ApplyToDayCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}"
                                                                            Visibility="{Binding CanApplyToDay, Converter={StaticResource BoolToVis}}">
                                                                        <materialDesign:PackIcon Kind="CalendarPlus" Foreground="#1565C0"/>
                                                                    </Button>
                                                                    <Button Style="{StaticResource IconButton}" ToolTip="{Binding Data.TextEdit, Source={StaticResource vmProxy}}"
                                                                            Command="{Binding Data.EditRateCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}">
                                                                        <materialDesign:PackIcon Kind="PencilOutline" Foreground="#E65100"/>
                                                                    </Button>
                                                                    <Button Style="{StaticResource IconButton}" ToolTip="{Binding Data.TextRetire, Source={StaticResource vmProxy}}"
                                                                            Command="{Binding Data.RemoveRateCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}"
                                                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}">
                                                                        <materialDesign:PackIcon Kind="ArchiveArrowDownOutline" Foreground="#C62828"/>
                                                                    </Button>
                                                                    </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="RateRow" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RateRow" Property="Background" Value="#F7F6FC"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                <Setter TargetName="RateRow" Property="Opacity" Value="0.55"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Simulator -->
                                            <Border Background="#F7F5FD" CornerRadius="0,0,10,10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,12" Margin="0,8,0,0">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" Background="White" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,6" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="CancelOctagonOutline" Foreground="{StaticResource Faint}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding TextCancelled}" Foreground="{StaticResource Muted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding SimCancelledTotal}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="34" Height="34" CornerRadius="9" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,12,0">
                                                            <materialDesign:PackIcon Kind="CalculatorVariantOutline" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding TextSimulate}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding SimMiles, UpdateSourceTrigger=PropertyChanged}" Width="56" Margin="8,0" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding TextMiles}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                                <materialDesign:PackIcon Kind="ArrowRightThin" Foreground="{StaticResource Faint}" Margin="10,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding SimTotal}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Money}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SimDetail}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- Rates ending soon -->
            <DockPanel Visibility="{Binding IsExpiringPanelOpen, Converter={StaticResource BoolToVis}}">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleExpiringPanelCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ArrowLeft" Margin="0,0,6,0"/><TextBlock Text="{Binding TextBack}"/></StackPanel>
                        </Button>
                        <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12" Background="{StaticResource WarnBg}" Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="CalendarClockOutline" Width="24" Height="24" Foreground="{StaticResource WarnInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding TextExpiringTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="{Binding TextExpiringBody}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <TextBlock Text="{Binding TextExpiringEmpty}" Foreground="{StaticResource Muted}" Margin="12" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExpiringRates.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ExpiringRates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding FundingSourceName}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" Background="{StaticResource Accent}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SpaceTypeName}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding BillingItemDescription}" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Rate, StringFormat='${0:N2}'}" FontWeight="SemiBold" Foreground="{StaticResource Money}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="4" Background="{StaticResource WarnBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CalendarAlert" Width="14" Height="14" Foreground="{StaticResource WarnInk}" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding ToDate, StringFormat='{}{0:MM/dd/yyyy}'}" Foreground="{StaticResource WarnInk}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button Grid.Column="5" Style="{StaticResource PrimaryButton}" Content="{Binding Data.TextRenew, Source={StaticResource vmProxy}}"
                                                        Command="{Binding Data.RenewCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding RuleId}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>

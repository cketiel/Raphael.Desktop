<UserControl x:Class="Raphael.Desktop.Views.Admin.Billing.BillingItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:Raphael.Desktop.ViewModels"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}" />

    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Add button -->
        <Button Grid.Row="0"               
                Content="➕" 
                ToolTip="{Binding AddBillingItemToolTip}"
                Command="{Binding AddBillingItemCommand}"
                HorizontalAlignment="Left" 
                Margin="10" 
                Padding="10,5"/>

        <!-- Grid to display data -->
        <DataGrid x:Name="BillingItemsGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding GroupedBillingItems}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"                
                 AlternationCount="2"
                AlternatingRowBackground="White"                                    
                Style="{StaticResource CustomDataGridStyle}"
                ColumnHeaderStyle="{StaticResource CustomColumnHeaderStyle}"
                RowStyle="{StaticResource CustomRowStyle}"
                CellStyle="{StaticResource CustomCellStyle}"
                SelectionUnit="FullRow">
            <!-- One group per owner: the office first, then each clinic that keeps items from the
                 Booking Portal (RE-029). A group's items all share an owner, so the first one says
                 whose group it is. -->
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander IsExpanded="True" Margin="0,4,0,0" Background="#F8FAFC">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,8,0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="HospitalBuilding"/>
                                                                <Setter Property="Foreground" Value="#7C3AED"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Items[0].IsOfficeOwned}" Value="True">
                                                                        <Setter Property="Kind" Value="OfficeBuilding"/>
                                                                        <Setter Property="Foreground" Value="#2563EB"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <Border CornerRadius="9" Background="#E2E8F0" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ItemCount}" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsPresenter/>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.Columns>
                <!-- Column with edit button -->
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.EditBillingItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource MaterialDesignToolButton}"
                                    ToolTip="{Binding Data.EditBillingItemToolTip, Source={StaticResource vmProxy}}">
                                <materialDesign:PackIcon Kind="Pencil" Foreground="Orange"/>
                            </Button>
                            
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- BillingItem Object Columns -->
                <DataGridTextColumn 
                    Binding="{Binding Description}"
                    Header="{Binding Data.ColumnHeaderDescription, Source={StaticResource vmProxy}}"  Width="2*" />

                <DataGridTextColumn 
                    Binding="{Binding Unit.Abbreviation}"
                    Header="{Binding Data.ColumnHeaderUnit, Source={StaticResource vmProxy}}"  Width="Auto" />

                <DataGridTextColumn 
                    Binding="{Binding IsCopay}"
                    Header="{Binding Data.ColumnHeaderIsCopay, Source={StaticResource vmProxy}}"  Width="Auto" />

                <DataGridTextColumn 
                    Binding="{Binding ARAccount}"
                    Header="{Binding Data.ColumnHeaderARAccount, Source={StaticResource vmProxy}}"  Width="*" />

                <DataGridTextColumn 
                    Binding="{Binding ARSubAccount}"
                    Header="{Binding Data.ColumnHeaderARSubAccount, Source={StaticResource vmProxy}}"  Width="*" />

                <DataGridTextColumn 
                    Binding="{Binding ARCompany}"
                    Header="{Binding Data.ColumnHeaderARCompany, Source={StaticResource vmProxy}}"  Width="*" />

                <DataGridTextColumn 
                    Binding="{Binding APAccount}"
                    Header="{Binding Data.ColumnHeaderAPAccount, Source={StaticResource vmProxy}}"  Width="*" />

                <DataGridTextColumn 
                    Binding="{Binding APSubAccount}"
                    Header="{Binding Data.ColumnHeaderAPSubAccount, Source={StaticResource vmProxy}}"  Width="*" />

                <DataGridTextColumn 
                    Binding="{Binding APCompany}"
                    Header="{Binding Data.ColumnHeaderAPCompany, Source={StaticResource vmProxy}}"  Width="*" />
                
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
<Window x:Class="Raphael.Desktop.Views.Admin.ProviderEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Raphael.Desktop.Converters"
        Title="{Binding WindowTitle}" Height="760" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="{Binding HeadingText}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,20"/>

                <TextBox materialDesign:HintAssist.Hint="{Binding CompanyNameHint}" Text="{Binding Provider.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                <TextBox materialDesign:HintAssist.Hint="{Binding AddressHint}" Text="{Binding Provider.Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                <TextBox materialDesign:HintAssist.Hint="{Binding EmailHint}" Text="{Binding Provider.Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                <TextBox materialDesign:HintAssist.Hint="{Binding PhoneHint}" Text="{Binding Provider.Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>

                <!-- Added in RE-027. The provider row already had address, email, phone and
                     coordinates; these three were the ones missing when the job is to call
                     somebody and keep track of what was said. -->
                <TextBox materialDesign:HintAssist.Hint="{Binding WebsiteHint}" Text="{Binding Provider.Website, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                <TextBox materialDesign:HintAssist.Hint="{Binding ContactNameHint}" Text="{Binding Provider.ContactName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                <TextBox materialDesign:HintAssist.Hint="{Binding NotesHint}" Text="{Binding Provider.Comments, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

                <!-- What a pickup time means for this provider's trips. Not a display
                     preference: a trip at 09:15 is 09:15 here, whoever opens the screen. -->
                <ComboBox ItemsSource="{Binding TimeZones}"
                          SelectedItem="{Binding SelectedTimeZone, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          materialDesign:HintAssist.Hint="{Binding TimeZoneLabel}"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          Margin="0,0,0,4"/>

                <!-- The check that actually catches a wrong pick: if this hour does not
                     match the clock on that office wall, the choice is wrong. -->
                <Border Background="#E8F0FE" CornerRadius="4" Padding="10,6" Margin="0,0,0,6"
                        Visibility="{Binding HasTimeZonePreview, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16"
                                                 VerticalAlignment="Center" Foreground="#1A73E8"/>
                        <TextBlock Text="{Binding TimeZonePreview}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding TimeZoneHelpText}"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,15"/>

                <TextBlock Text="{Binding CompanyLogoText}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,10,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                    <Border Width="120" Height="120" CornerRadius="5" BorderThickness="1" BorderBrush="#DDD">
                        
                        <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"/>
                    </Border>
                    <Button Command="{Binding SelectLogoCommand}" 
                            Content="{Binding ChooseLogoText}" 
                            Margin="20,0,0,0" 
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>

                <!--<Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="{Binding LatitudeHint}" Text="{Binding Provider.Latitude, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                    <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="{Binding LongitudeHint}" Text="{Binding Provider.Longitude, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                </Grid>-->
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource MaterialDesignDivider}" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                <Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
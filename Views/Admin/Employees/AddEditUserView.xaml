<Window x:Class="Raphael.Desktop.Views.Admin.Employees.AddEditUserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:Raphael.Desktop.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
    mc:Ignorable="d"
    Title="Add/Edit User" Height="500" Width="400"
    WindowStartupLocation="CenterOwner" SizeToContent="Height"
    WindowStyle="ToolWindow"
        
    ResizeMode="NoResize">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Full Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding User.FullName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <Label Content="Username:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding User.Username, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <Label Content="Password:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
               Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisConverter}}"/>

        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" 
                     Grid.Row="2" Grid.Column="1" Margin="5"
                     Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisConverter}}"/>

        <Label Content="Email:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding User.Email}" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <Label Content="Phone:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding User.PhoneNumber}" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <Label Content="Address:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding User.Address}" Grid.Row="5" Grid.Column="1" Margin="5"/>

        <Label Content="Role:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="6" Grid.Column="1" Margin="5"
                  ItemsSource="{Binding AvailableRoles}"
                  DisplayMemberPath="RoleName"
                  SelectedValuePath="Id"
                  SelectedValue="{Binding User.RoleId}"/>

        <Label Content="Active:" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
        <CheckBox IsChecked="{Binding User.IsActive}" Grid.Row="7" Grid.Column="1" Margin="5" VerticalAlignment="Center"/>

        <!-- Integrator -->
        <Label Content="Integrator:" Visibility="{Binding ShowCompanyFields, Converter={StaticResource BoolToVisConverter}}" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox Visibility="{Binding ShowCompanyFields, Converter={StaticResource BoolToVisConverter}}" Grid.Row="8" Grid.Column="1" Margin="5"
              ItemsSource="{Binding AvailableIntegrators}"
              DisplayMemberPath="Name"
              SelectedValuePath="Id"
              SelectedValue="{Binding User.IntegratorId}"
              materialDesign:HintAssist.Hint="Select Integrator (Optional)"
              materialDesign:TextFieldAssist.HasClearButton="True"/>

        <!-- Provider -->
        <Label Content="Provider:" Visibility="{Binding ShowCompanyFields, Converter={StaticResource BoolToVisConverter}}" Grid.Row="9" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox Visibility="{Binding ShowCompanyFields, Converter={StaticResource BoolToVisConverter}}" Grid.Row="9" Grid.Column="1" Margin="5"
              ItemsSource="{Binding AvailableProviders}"
              DisplayMemberPath="Name"
              SelectedValuePath="Id"
              SelectedValue="{Binding User.ProviderId}"
              materialDesign:HintAssist.Hint="Select Provider (Optional)"
              materialDesign:TextFieldAssist.HasClearButton="True"/>

        <!-- RE-066: access to the MCP server (AI assistants). Help: desktop/admin/mcp-access -->
        <Label Content="AI access (MCP):" Visibility="{Binding ShowMcpFields, Converter={StaticResource BoolToVisConverter}}" Grid.Row="10" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox Visibility="{Binding ShowMcpFields, Converter={StaticResource BoolToVisConverter}}" Grid.Row="10" Grid.Column="1" Margin="5"
              ItemsSource="{Binding McpAccessOptions}"
              DisplayMemberPath="Label"
              SelectedValuePath="Value"
              SelectedValue="{Binding McpAccess}"
              IsEnabled="{Binding CanEditMcpAccess}"
              helpers:HelpAssist.TopicId="desktop/admin/mcp-access">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource MaterialDesignComboBoxItemStyle}">
                    <Setter Property="IsEnabled" Value="{Binding IsSelectable}"/>
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>

        <Label Content="BAA on record:" Visibility="{Binding ShowMcpBaa, Converter={StaticResource BoolToVisConverter}}" Grid.Row="11" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding McpBaaReference, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                 Visibility="{Binding ShowMcpBaa, Converter={StaticResource BoolToVisConverter}}" Grid.Row="11" Grid.Column="1" Margin="5"
                 materialDesign:HintAssist.Hint="Document and date of the BAA with the AI vendor"/>

        <TextBlock Visibility="{Binding ShowMcpBaa, Converter={StaticResource BoolToVisConverter}}" Grid.Row="12" Grid.Column="1" Margin="5,0,5,8"
                   TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                   Text="Detail sends patient names, addresses, phones, dates of birth and e-mails to the user's AI vendor. Grant it only with written evidence of that company's BAA with the vendor."/>

        <StackPanel Orientation="Horizontal" Grid.Row="14" Grid.Column="1" HorizontalAlignment="Right">
            <Button Content="Save" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,10,0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>
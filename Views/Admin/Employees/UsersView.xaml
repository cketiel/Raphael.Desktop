<UserControl x:Class="Raphael.Desktop.Views.Admin.Employees.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- A DataGrid column is not in the visual tree: headers and column visibility reach the ViewModel through it. -->
        <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- The tab strip: four radio buttons drawn as underlined tabs, with the count inside. -->
        <Style x:Key="UserTabButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#5B6B7C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="14,8,14,7" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="17" Height="17"
                                                         VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#F3EEFB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tab" Property="BorderBrush" Value="#673AB7"/>
                                <Setter Property="Foreground" Value="#4527A0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A line in the row's "more" menu -->
        <Style x:Key="MenuAction" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#1E2A36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Height" Value="36"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A pill: a soft background with its darker text -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Border BorderThickness="1" BorderBrush="#2196f3" Background="White" helpers:HelpAssist.TopicId="desktop/admin/employees">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ Toolbar: search, filters, count, actions ============ -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="#F5F7FA" CornerRadius="18" BorderBrush="#E3E8EF" BorderThickness="1" Padding="12,0,4,0" Height="36">
                    <DockPanel>
                        <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#7A8794" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignToolButton}" Padding="4" Height="28"
                                Command="{Binding ClearFiltersCommand}" ToolTip="{Binding L[users.ClearFilters]}">
                            <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="16" Height="16" Foreground="#7A8794"/>
                        </Button>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" Margin="8,0,4,0" VerticalAlignment="Center"
                                 BorderThickness="0" materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 materialDesign:HintAssist.Hint="{Binding L[users.SearchHint]}"
                                 materialDesign:HintAssist.IsFloating="False"/>
                    </DockPanel>
                </Border>

                <ComboBox Grid.Column="1" Width="200" Margin="14,0,0,0" VerticalAlignment="Center"
                          ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" DisplayMemberPath="Name"
                          Visibility="{Binding ShowProviderFilter, Converter={StaticResource BoolToVis}}"
                          materialDesign:HintAssist.Hint="{Binding L[users.ColProvider]}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding ActiveOnly}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                    <TextBlock Text="{Binding L[users.ActiveOnly]}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#3B4856"/>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding ShownText}" Foreground="#7A8794" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignToolButton}" Command="{Binding RefreshCommand}" ToolTip="{Binding L[users.Refresh]}" Margin="0,0,6,0">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="#5B6B7C"/>
                    </Button>
                    <Button Command="{Binding AddUserCommand}" ToolTip="{Binding AddUserToolTip}" Background="#673AB7" BorderBrush="#673AB7" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding L[users.New]}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ Tabs by kind of user ============ -->
            <Border Grid.Row="1" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource UserTabButton}" GroupName="UserTabs" Tag="AccountGroupOutline"
                                 IsChecked="{Binding IsTabAll}" Content="{Binding TabAllText}"/>
                    <RadioButton Style="{StaticResource UserTabButton}" GroupName="UserTabs" Tag="Steering"
                                 IsChecked="{Binding IsTabDrivers}" Content="{Binding TabDriversText}"/>
                    <RadioButton Style="{StaticResource UserTabButton}" GroupName="UserTabs" Tag="BadgeAccountHorizontalOutline"
                                 IsChecked="{Binding IsTabOffice}" Content="{Binding TabOfficeText}"/>
                    <RadioButton Style="{StaticResource UserTabButton}" GroupName="UserTabs" Tag="DomainSwitch"
                                 IsChecked="{Binding IsTabExternal}" Content="{Binding TabExternalText}"
                                 ToolTip="{Binding L[users.TabExternalTip]}"/>
                </StackPanel>
            </Border>

            <!-- ============ The list ============ -->
            <Grid Grid.Row="2">
                <!-- Exactly the Home trips grid: same base style, centred headers, banded rows, accent bar on
                     hover and selection. Named one by one: MaterialDesign sets these on the element. -->
                <DataGrid ItemsSource="{Binding UsersView}"
                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          Style="{StaticResource CustomDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                          RowStyle="{StaticResource ContentRowStyle}"
                          CellStyle="{StaticResource TripSelectionCellStyle}"
                          Cursor="Hand">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditUserCommand}"/>
                    </DataGrid.InputBindings>

                    <DataGrid.Columns>
                        <!-- Edit, and everything else behind "more" so the row stays readable -->
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding Data.EditUserCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}"
                                                Style="{StaticResource TripActionButtonStyle}"
                                                ToolTip="{Binding Data.EditUserToolTip, Source={StaticResource vmProxy}}">
                                            <materialDesign:PackIcon Kind="Pencil" Foreground="Orange"/>
                                        </Button>
                                        <materialDesign:PopupBox PlacementMode="BottomAndAlignLeftEdges" StaysOpen="False" Padding="0" Focusable="False">
                                            <materialDesign:PopupBox.ToggleContent>
                                                <materialDesign:PackIcon Kind="DotsVertical" Width="20" Height="20" Foreground="#5B6B7C" Margin="2,0"/>
                                            </materialDesign:PopupBox.ToggleContent>
                                            <StackPanel MinWidth="220" Margin="0,4">
                                                <Button Style="{StaticResource MenuAction}" CommandParameter="{Binding}"
                                                        Command="{Binding Data.PayRateCommand, Source={StaticResource vmProxy}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CashMultiple" Foreground="#673AB7" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Data.L[users.ActionPay], Source={StaticResource vmProxy}}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource MenuAction}" CommandParameter="{Binding}"
                                                        Command="{Binding Data.OpenDocumentsCommand, Source={StaticResource vmProxy}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Foreground="#2196F3" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Data.OpenDocumentsToolTip, Source={StaticResource vmProxy}}"/>
                                                    </StackPanel>
                                                </Button>
                                                <!-- RE-053: only one of the two applies at a time; the other collapses -->
                                                <Button Style="{StaticResource MenuAction}" CommandParameter="{Binding}"
                                                        Command="{Binding Data.OutOfServiceCommand, Source={StaticResource vmProxy}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CarOff" Foreground="#C62828" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Data.OutOfServiceToolTip, Source={StaticResource vmProxy}}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource MenuAction}" CommandParameter="{Binding}"
                                                        Command="{Binding Data.ReturnToServiceCommand, Source={StaticResource vmProxy}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Restore" Foreground="#2E7D32" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Data.ReturnToServiceToolTip, Source={StaticResource vmProxy}}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource MenuAction}" CommandParameter="{Binding}"
                                                        Command="{Binding Data.ChangePasswordCommand, Source={StaticResource vmProxy}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="KeyChange" Foreground="#1565C0" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Data.ChangePasswordToolTip, Source={StaticResource vmProxy}}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Separator Margin="0,4"/>
                                                <Button Style="{StaticResource MenuAction}" CommandParameter="{Binding}"
                                                        Command="{Binding Data.DeleteUserCommand, Source={StaticResource vmProxy}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="DeleteForever" Foreground="#C62828" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Data.DeleteUserToolTip, Source={StaticResource vmProxy}}" Foreground="#C62828"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </materialDesign:PopupBox>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Name with its initials; a driver's circle is purple, everybody else's grey -->
                        <DataGridTemplateColumn Width="2*" SortMemberPath="FullName">
                            <DataGridTemplateColumn.Header><TextBlock Text="{Binding Data.ColumnHeaderFullName, Source={StaticResource vmProxy}}"/></DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#ECEFF3"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsDriver}" Value="True"><Setter Property="Background" Value="#EDE7F6"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Initials}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#5B6B7C"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsDriver}" Value="True"><Setter Property="Foreground" Value="#4527A0"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding FullName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Binding="{Binding Username}" Width="*">
                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColumnHeaderUserName, Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!-- On the Drivers tab every row would say "Driver": the column steps aside -->
                        <DataGridTextColumn Binding="{Binding RoleName}" Width="*"
                                            Visibility="{Binding Data.IsNotDriversTab, Source={StaticResource vmProxy}, Converter={StaticResource BoolToVis}}">
                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColumnHeaderRole, Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding PhoneNumber}" Width="*">
                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColumnHeaderPhone, Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding Email}" Width="1.6*">
                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColumnHeaderEmail, Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding ProviderName}" Width="*"
                                            Visibility="{Binding Data.ShowProviderFilter, Source={StaticResource vmProxy}, Converter={StaticResource BoolToVis}}">
                            <DataGridTextColumn.Header><TextBlock Text="{Binding Data.ColumnHeaderProvider, Source={StaticResource vmProxy}}"/></DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <!-- RE-082: the rate in force; a click opens the driver's pay. Drivers tab, administrators only. -->
                        <DataGridTemplateColumn Width="120" SortMemberPath="PayRateText"
                                                Visibility="{Binding Data.ShowPayColumn, Source={StaticResource vmProxy}, Converter={StaticResource BoolToVis}}">
                            <DataGridTemplateColumn.Header><TextBlock Text="{Binding Data.ColumnHeaderPayRate, Source={StaticResource vmProxy}}"/></DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Cursor="Hand" ToolTip="{Binding Data.L[users.ActionPay], Source={StaticResource vmProxy}}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding Data.PayRateCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                <Setter Property="Background" Value="#E0F2FE"/>
                                                <Setter Property="BorderBrush" Value="#7DD3FC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPerMile}" Value="True">
                                                        <Setter Property="Background" Value="#EDE7F6"/><Setter Property="BorderBrush" Value="#B39DDB"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PayRateText}" Value="">
                                                        <Setter Property="Background" Value="#FFF4E0"/><Setter Property="BorderBrush" Value="#F5C27A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="ClockTimeFourOutline"/><Setter Property="Foreground" Value="#0369A1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPerMile}" Value="True"><Setter Property="Kind" Value="RoadVariant"/><Setter Property="Foreground" Value="#4527A0"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding PayRateText}" Value=""><Setter Property="Kind" Value="AlertOutline"/><Setter Property="Foreground" Value="#B26A00"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding PayRateText}"/>
                                                        <Setter Property="Foreground" Value="#0369A1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPerMile}" Value="True"><Setter Property="Foreground" Value="#4527A0"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding PayRateText}" Value="">
                                                                <Setter Property="Text" Value="{Binding Data.L[users.NoRate], Source={StaticResource vmProxy}}"/><Setter Property="Foreground" Value="#8A4B00"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- RE-053: in service, or out with since when and why in the tooltip. Drivers tab. -->
                        <DataGridTemplateColumn Width="110" SortMemberPath="IsOutOfService"
                                                Visibility="{Binding Data.IsDriversTab, Source={StaticResource vmProxy}, Converter={StaticResource BoolToVis}}">
                            <DataGridTemplateColumn.Header><TextBlock Text="{Binding Data.ColumnHeaderOutOfService, Source={StaticResource vmProxy}}"/></DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Style="{StaticResource Pill}" Background="#FFEBEE" BorderBrush="#EF9A9A" ToolTip="{Binding OutOfServiceText}"
                                                Visibility="{Binding IsOutOfService, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Data.OutOfServiceBadge, Source={StaticResource vmProxy}}" Foreground="#B71C1C" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Data.InServiceText, Source={StaticResource vmProxy}}" Foreground="#2E7D32" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsOutOfService}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- RE-065: where its documents stand; a click opens Docs on it. -->
                        <DataGridTemplateColumn Width="110" SortMemberPath="DocsState">
                            <DataGridTemplateColumn.Header><TextBlock Text="{Binding Data.ColumnHeaderDocuments, Source={StaticResource vmProxy}}"/></DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Cursor="Hand" ToolTip="{Binding Data.OpenDocumentsToolTip, Source={StaticResource vmProxy}}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding Data.OpenDocumentsCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                <Setter Property="Background" Value="#F5F5F5"/>
                                                <Setter Property="BorderBrush" Value="#BDBDBD"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DocsState}" Value="ok"><Setter Property="Background" Value="#E8F5E9"/><Setter Property="BorderBrush" Value="#81C784"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding DocsState}" Value="warn"><Setter Property="Background" Value="#FFF4E0"/><Setter Property="BorderBrush" Value="#F5C27A"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding DocsState}" Value="danger"><Setter Property="Background" Value="#FFEBEE"/><Setter Property="BorderBrush" Value="#EF9A9A"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding DocsState}" Value="info"><Setter Property="Background" Value="#E3F2FD"/><Setter Property="BorderBrush" Value="#90CAF9"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding DocsText}" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Active as a word, not a checkbox that looks editable -->
                        <DataGridTemplateColumn Width="90" SortMemberPath="IsActive">
                            <DataGridTemplateColumn.Header><TextBlock Text="{Binding Data.ColumnHeaderActive, Source={StaticResource vmProxy}}"/></DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                                <Setter Property="Background" Value="#ECEFF3"/><Setter Property="BorderBrush" Value="#CFD6DE"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#DCF2E3"/><Setter Property="BorderBrush" Value="#9AD3AE"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Data.L[users.Inactive], Source={StaticResource vmProxy}}"/>
                                                    <Setter Property="Foreground" Value="#5B6B7C"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="{Binding Data.L[users.Active], Source={StaticResource vmProxy}}"/><Setter Property="Foreground" Value="#1B7F3B"/>
                                                    </DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Over the grid's empty body, never catching the pointer -->
                <TextBlock Text="{Binding EmptyText}" Foreground="#9E9E9E" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>

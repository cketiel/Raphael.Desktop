<UserControl x:Class="Raphael.Desktop.Views.Admin.GoogleMapsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:Raphael.Desktop.ViewModels.Admin"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.DataContext>
        <vm:GoogleMapsAdminViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>

        <!-- ⚠️ DataGrid columns are not in the visual tree, so a column header cannot reach the
             view model with RelativeSource — it silently binds to nothing and the header comes
             out blank. This proxy is how the rest of the application does it; see RolesView. -->
        <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}" />

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#616161" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#37474F" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- The period a card is showing, under its title. Without it a screenshot of one chart
             says nothing about which dates produced it. -->
        <Style x:Key="SectionPeriod" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#1976D2" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#757575" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- Quick-period buttons. A pressed one stays visibly pressed: four identical buttons
             after a click leave the administrator guessing which dates are on screen. -->
        <Style x:Key="PeriodToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="BorderBrush" Value="#BDBDBD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#424242" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1976D2" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#1565C0" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="#E3F2FD" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chart-or-table switch, same shape as the period buttons so the screen has one idea
             of what a selected control looks like. -->
        <Style x:Key="ViewToggle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" CornerRadius="4" Background="White"
                                BorderBrush="#BDBDBD" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#37474F" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#263238" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Headers centred, and only on this tab's grids. The shared style aligns them left,
             which is right for the name columns everywhere else in the application; here every
             column but the first holds a figure, and a centred heading sits over its numbers
             instead of drifting away from them.

             Assigned directly on each DataGrid rather than through a Setter — see the note
             below for why a Setter would be ignored. -->
        <Style x:Key="CentredColumnHeader" TargetType="{x:Type DataGridColumnHeader}"
               BasedOn="{StaticResource CustomColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- ⚠️ There is deliberately no derived DataGrid style here any more.
             The first version wrapped the four shared styles in one Style with
             BasedOn="CustomDataGridStyle" and Setters for ColumnHeaderStyle, RowStyle and
             CellStyle. It did not work: the MaterialDesign theme sets those same properties, and
             a value that arrives that way beats a Setter in a derived style, so the headers were
             never ours and came out invisible. Every grid below applies the four directly, the
             way RolesView does — verbose, and correct. -->

    </UserControl.Resources>

    <Grid Background="#FAFAFA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================ period bar ============================ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                Padding="12,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="{Binding L[gmaps.Period]}" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,10,0" />

                <DatePicker SelectedDate="{Binding From, Mode=TwoWay}" Width="130"
                            VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker SelectedDate="{Binding To, Mode=TwoWay}" Width="130"
                            VerticalAlignment="Center" Margin="0,0,12,0" />

                <ToggleButton Style="{StaticResource PeriodToggle}"
                              Content="{Binding L[gmaps.ThisMonth]}"
                              IsChecked="{Binding IsThisMonth, Mode=OneWay}"
                              Command="{Binding ThisMonthCommand}" />
                <ToggleButton Style="{StaticResource PeriodToggle}"
                              Content="{Binding L[gmaps.LastMonth]}"
                              IsChecked="{Binding IsLastMonth, Mode=OneWay}"
                              Command="{Binding LastMonthCommand}" />
                <ToggleButton Style="{StaticResource PeriodToggle}"
                              Content="{Binding L[gmaps.Last30]}"
                              IsChecked="{Binding IsLast30Days, Mode=OneWay}"
                              Command="{Binding Last30DaysCommand}" />
                <ToggleButton Style="{StaticResource PeriodToggle}"
                              Content="{Binding L[gmaps.Last90]}"
                              IsChecked="{Binding IsLast90Days, Mode=OneWay}"
                              Command="{Binding Last90DaysCommand}" Margin="0,0,16,0" />

                <Button Content="{Binding L[gmaps.Refresh]}" Command="{Binding RefreshCommand}"
                        Padding="14,4" FontWeight="SemiBold" Margin="0,0,6,0" />
                <Button Content="{Binding L[gmaps.ExportCsv]}" Command="{Binding ExportCsvCommand}"
                        Padding="10,4" />

                <TextBlock Text="{Binding L[gmaps.Loading]}" VerticalAlignment="Center"
                           Margin="14,0,0,0" Foreground="#1976D2"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="8" Background="Transparent" BorderThickness="0">

            <!-- ================================================================== -->
            <TabItem Header="{Binding L[gmaps.TabSummary]}">
                <!-- F1 lands on the sub-tab in front, not on the panel in general. The topic is
                     declared on the content rather than on the TabItem because only the selected
                     tab's content is realised, while every TabItem header exists at once - a
                     topic on the header would answer for Summary whichever tab was open. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8"
                              helpers:HelpAssist.TopicId="desktop/admin/google-maps/summary">
                    <StackPanel>

                        <UniformGrid Rows="1" Columns="5">

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding L[gmaps.BoughtFromGoogle]}" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding BilledText}" Style="{StaticResource CardValue}"
                                               Foreground="#E53935" />
                                    <TextBlock Text="{Binding L[gmaps.BoughtHint]}" Style="{StaticResource HintText}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding L[gmaps.ServedFromCache]}" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding CachedText}" Style="{StaticResource CardValue}"
                                               Foreground="#2E7D32" />
                                    <TextBlock Text="{Binding L[gmaps.ServedHint]}" Style="{StaticResource HintText}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding L[gmaps.CacheHit]}" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding CacheHitPercentText}" Style="{StaticResource CardValue}"
                                               Foreground="#2E7D32" />
                                    <TextBlock Text="{Binding L[gmaps.CacheHitHint]}" Style="{StaticResource HintText}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding L[gmaps.EstimatedCost]}" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding EstimatedCostText}" Style="{StaticResource CardValue}" />
                                    <TextBlock Style="{StaticResource HintText}">
                                        <Run Text="{Binding L[gmaps.Projection], Mode=OneWay}" />
                                        <Run Text="{Binding ProjectedCostText, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Background="#E8F5E9"
                                    BorderBrush="#A5D6A7">
                                <StackPanel>
                                    <TextBlock Text="{Binding L[gmaps.AvoidedCost]}" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding AvoidedCostText}" Style="{StaticResource CardValue}"
                                               Foreground="#1B5E20" />
                                    <TextBlock Style="{StaticResource HintText}">
                                        <Run Text="{Binding SavingsRatioText, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding L[gmaps.OfWhatItWouldCost], Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                                CornerRadius="4" Padding="10,7" Margin="0,0,10,12">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#6D4C41">
                                <Run Text="{Binding L[gmaps.EstimateWarningTitle], Mode=OneWay}" FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="{Binding L[gmaps.EstimateWarningBody], Mode=OneWay}" />
                            </TextBlock>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Style="{StaticResource SectionTitle}"
                                                   Text="{Binding L[gmaps.DailyChartTitle]}" />
                                        <TextBlock Style="{StaticResource SectionPeriod}"
                                                   Text="{Binding PeriodLabel}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Top">
                                        <RadioButton Style="{StaticResource ViewToggle}" GroupName="DailyView"
                                                     Content="{Binding L[gmaps.Chart]}"
                                                     IsChecked="{Binding ShowDailyAsChart, Mode=OneWay}"
                                                     Checked="DailyChart_Checked" />
                                        <RadioButton Style="{StaticResource ViewToggle}" GroupName="DailyView"
                                                     Content="{Binding L[gmaps.Table]}"
                                                     IsChecked="{Binding ShowDailyAsTable, Mode=OneWay}"
                                                     Checked="DailyTable_Checked" />
                                    </StackPanel>
                                </DockPanel>

                                <lvc:CartesianChart Height="300"
                                                    Series="{Binding DailySeries}"
                                                    XAxes="{Binding DailyXAxes}"
                                                    YAxes="{Binding CountAxes}"
                                                    LegendPosition="Bottom"
                                                    TooltipPosition="Top"
                                                    Visibility="{Binding ShowDailyAsChart, Converter={StaticResource BoolToVis}}" />

                                <!-- HorizontalScrollBarVisibility="Disabled" makes the star widths
                                     fit the space instead of overflowing it. Without it the grid
                                     grew a horizontal bar it did not need, sitting over the last
                                     row and cutting it in half. -->
                                <DataGrid ItemsSource="{Binding DailyRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          AlternationCount="2"
                                          AlternatingRowBackground="White"
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="320"
                                          Style="{StaticResource CustomDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource CentredColumnHeader}"
                                          RowStyle="{StaticResource CustomRowStyle}"
                                          CellStyle="{StaticResource CustomCellStyle}"
                                          SelectionUnit="FullRow"
                                          Visibility="{Binding ShowDailyAsTable, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.Day], Source={StaticResource vmProxy}}"
                                                            Width="1.2*" Binding="{Binding Day, StringFormat=d}" />
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.ToGoogle], Source={StaticResource vmProxy}}"
                                                            Width="*" Binding="{Binding Billed, StringFormat=N0}" />
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.FromCache], Source={StaticResource vmProxy}}"
                                                            Width="*" Binding="{Binding Cached, StringFormat=N0}" />
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.Total], Source={StaticResource vmProxy}}"
                                                            Width="*" Binding="{Binding Total, StringFormat=N0}" />
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.CachePercent], Source={StaticResource vmProxy}}"
                                                            Width="*" Binding="{Binding CacheHitPercent, StringFormat={}{0:0.0} %}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{Binding L[gmaps.DailyChartHint]}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="{Binding L[gmaps.TrendTitle]}" />
                                <TextBlock Style="{StaticResource SectionPeriod}"
                                           Text="{Binding PeriodLabel}" />
                                <lvc:CartesianChart Height="220"
                                                    Series="{Binding HitRateSeries}"
                                                    XAxes="{Binding DailyXAxes}"
                                                    YAxes="{Binding PercentAxes}"
                                                    TooltipPosition="Top" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{Binding L[gmaps.TrendHint]}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================================== -->
            <TabItem Header="{Binding L[gmaps.TabDetail]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8"
                              helpers:HelpAssist.TopicId="desktop/admin/google-maps/detail">
                    <StackPanel>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="{Binding L[gmaps.LifetimeTotals]}" />
                                <TextBlock Text="{Binding TotalsText}" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Style="{StaticResource SectionTitle}"
                                                   Text="{Binding L[gmaps.BySkuTitle]}" />
                                        <TextBlock Style="{StaticResource SectionPeriod}"
                                                   Text="{Binding PeriodLabel}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                VerticalAlignment="Top">
                                        <RadioButton Style="{StaticResource ViewToggle}" GroupName="SkuView"
                                                     Content="{Binding L[gmaps.Table]}"
                                                     IsChecked="{Binding ShowSkuAsTable, Mode=OneWay}"
                                                     Checked="SkuTable_Checked" />
                                        <RadioButton Style="{StaticResource ViewToggle}" GroupName="SkuView"
                                                     Content="{Binding L[gmaps.Chart]}"
                                                     IsChecked="{Binding ShowSkuAsChart, Mode=OneWay}"
                                                     Checked="SkuChart_Checked" />
                                    </StackPanel>
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding BySku}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          AlternationCount="2"
                                          AlternatingRowBackground="White"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Style="{StaticResource CustomDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource CentredColumnHeader}"
                                          RowStyle="{StaticResource CustomRowStyle}"
                                          CellStyle="{StaticResource CustomCellStyle}"
                                          SelectionUnit="FullRow"
                                          Visibility="{Binding ShowSkuAsTable, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.Product], Source={StaticResource vmProxy}}"
                                                            Width="2.6*" Binding="{Binding DisplayName}" />
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.ToGoogle], Source={StaticResource vmProxy}}"
                                                            Width="*" Binding="{Binding Billed, StringFormat=N0}" />
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.FromCache], Source={StaticResource vmProxy}}"
                                                            Width="*" Binding="{Binding Cached, StringFormat=N0}" />
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.CachePercent], Source={StaticResource vmProxy}}"
                                                            Width="*" Binding="{Binding CacheHitPercent, StringFormat={}{0:0.0} %}" />
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.Cost], Source={StaticResource vmProxy}}"
                                                            Width="*" Binding="{Binding EstimatedCost, StringFormat=C2, ConverterCulture=en-US}" />
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.Avoided], Source={StaticResource vmProxy}}"
                                                            Width="*" Binding="{Binding AvoidedCost, StringFormat=C2, ConverterCulture=en-US}" />
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.FreePerMonth], Source={StaticResource vmProxy}}"
                                                            Width="*" Binding="{Binding FreeCapPerMonth, StringFormat=N0}" />
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.FreeRemaining], Source={StaticResource vmProxy}}"
                                                            Width="1.2*" Binding="{Binding FreeRemainingThisMonth, StringFormat=N0}" />
                                        <DataGridCheckBoxColumn Header="{Binding Data.L[gmaps.Reported], Source={StaticResource vmProxy}}"
                                                                Width="*" Binding="{Binding ReportedByClient}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <lvc:PieChart Height="300" Series="{Binding SkuSeries}"
                                              LegendPosition="Right"
                                              Visibility="{Binding ShowSkuAsChart, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{Binding L[gmaps.BySkuHint]}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================================== -->
            <TabItem Header="{Binding L[gmaps.TabSettings]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8"
                              helpers:HelpAssist.TopicId="desktop/admin/google-maps/settings">
                    <StackPanel>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="{Binding L[gmaps.TrafficMode]}" Margin="0,0,0,8" />

                                <ComboBox ItemsSource="{Binding TrafficModes}"
                                          SelectedItem="{Binding TrafficMode, Mode=TwoWay}"
                                          Width="220" HorizontalAlignment="Left" />

                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{Binding L[gmaps.TrafficModeHint]}" />

                                <Border Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1"
                                        CornerRadius="4" Padding="10,7" Margin="0,8,0,0"
                                        Visibility="{Binding IsPrecision, Converter={StaticResource BoolToVis}}">
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#E65100">
                                        <Run Text="{Binding L[gmaps.PrecisionWarningTitle], Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding L[gmaps.PrecisionWarningBody], Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="{Binding L[gmaps.Cache]}" Margin="0,0,0,8" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding L[gmaps.RetentionDays]}" Width="200"
                                               VerticalAlignment="Center" />
                                    <TextBox Text="{Binding CacheRetentionDays, Mode=TwoWay}" Width="90" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding L[gmaps.BufferPercent]}" Width="200"
                                               VerticalAlignment="Center" />
                                    <TextBox Text="{Binding BufferPercent, Mode=TwoWay}" Width="90" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{Binding L[gmaps.CacheHint]}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Button Content="{Binding L[gmaps.SaveSettings]}"
                                        Command="{Binding SaveSettingsCommand}"
                                        Padding="18,7" HorizontalAlignment="Left" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{Binding L[gmaps.SaveHint]}" />
                            </StackPanel>
                        </Border>

                        <!-- Google's own layout: one row per product, one column per band.
                             The database stores one row per band, which reads as thirty lines
                             repeating six product names. -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="{Binding L[gmaps.PricingTitle]}" />
                                <TextBlock Style="{StaticResource SectionPeriod}"
                                           Text="{Binding L[gmaps.PricingPer1000]}" Foreground="#757575" />

                                <DataGrid ItemsSource="{Binding PricingRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          AlternationCount="2"
                                          AlternatingRowBackground="White"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Style="{StaticResource CustomDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource CentredColumnHeader}"
                                          CellStyle="{StaticResource CustomCellStyle}"
                                          SelectionUnit="FullRow">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource CustomRowStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.Sku], Source={StaticResource vmProxy}}"
                                                            Width="2.4*" Binding="{Binding DisplayName}" />
                                        <DataGridTextColumn Header="{Binding Data.L[gmaps.FreePerMonth], Source={StaticResource vmProxy}}"
                                                            Width="*" Binding="{Binding FreeTier}" />
                                        <DataGridTextColumn Header="10k–100k" Width="*" Binding="{Binding Band10k}" />
                                        <DataGridTextColumn Header="100k–500k" Width="*" Binding="{Binding Band100k}" />
                                        <DataGridTextColumn Header="500k–1M" Width="*" Binding="{Binding Band500k}" />
                                        <DataGridTextColumn Header="1M–5M" Width="*" Binding="{Binding Band1M}" />
                                        <DataGridTextColumn Header="5M+" Width="*" Binding="{Binding Band5M}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Style="{StaticResource HintText}"
                                           Text="{Binding L[gmaps.PricingHint]}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ============================ messages ============================
             ⚠️ An overlay, deliberately, and not a row of its own.

             It used to sit in its own Auto row between the period bar and the tabs, which meant
             that saying "Saved" pushed the entire panel down and the summary cards went with it.
             A banner that reports the outcome of a click should not rearrange the screen the
             click was made on.

             It floats at the bottom instead, over the content and clear of everything that
             matters: the summary cards are at the top and are never covered, and neither are the
             sub-tabs — an overlay pinned to the top would have blocked switching tabs for as
             long as it was showing. Nothing moves at any point, and it dismisses itself after a
             few seconds, so nobody is left with a week-old "Saved" sitting over their figures.
        -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Panel.ZIndex="10" Margin="16,0,24,20" CornerRadius="4" MaxWidth="620"
                Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1" Padding="12,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
            </Border.Effect>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DismissMessageCommand}"
                        Background="Transparent" BorderThickness="0" Foreground="#B71C1C"
                        Cursor="Hand" Padding="8,0" FontSize="13" VerticalAlignment="Top" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B71C1C" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Panel.ZIndex="10" Margin="16,0,24,20" CornerRadius="4" MaxWidth="620"
                Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" Padding="12,8"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
            </Border.Effect>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DismissMessageCommand}"
                        Background="Transparent" BorderThickness="0" Foreground="#1B5E20"
                        Cursor="Hand" Padding="8,0" FontSize="13" VerticalAlignment="Top" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1B5E20" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

    </Grid>
</UserControl>

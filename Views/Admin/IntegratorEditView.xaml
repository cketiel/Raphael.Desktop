<Window x:Class="Raphael.Desktop.Views.Admin.IntegratorEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding WindowTitle}" 
        Height="700" 
        Width="760" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Contenido Principal con Scroll por si acaso -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25,20,25,0">
                <TextBlock Text="{Binding HeadingText}" 
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                           Margin="0,0,0,25"/>

                <!-- Nombre -->
                <TextBox materialDesign:HintAssist.Hint="{Binding NameHint}"
                         Text="{Binding Integrator.Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         Margin="0,0,0,20"/>

                <!-- NUEVO: Funding Source -->
                <ComboBox materialDesign:HintAssist.Hint="{Binding FundingSourceHint}"
                      ItemsSource="{Binding FundingSources}"
                      SelectedValue="{Binding Integrator.FundingSourceId}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="Name"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      materialDesign:TextFieldAssist.HasClearButton="True"
                      Margin="0,0,0,20"/>
                
                <!-- Estado -->
                <CheckBox Content="{Binding IsActiveText}" 
                          IsChecked="{Binding Integrator.IsActive}" 
                          Margin="0,0,0,20"/>

                <!-- Contact details, added in RE-027. Until now an integrator was a name and a
                     key: everything the API needs and nothing of what a person needs when they
                     have to call them. -->
                <TextBlock Text="{Binding ContactSectionText}"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           Margin="0,0,0,5"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             materialDesign:HintAssist.Hint="{Binding PhoneHint}"
                             Text="{Binding Integrator.Phone, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                    <TextBox Grid.Column="2"
                             materialDesign:HintAssist.Hint="{Binding EmailHint}"
                             Text="{Binding Integrator.Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                </Grid>

                <TextBox materialDesign:HintAssist.Hint="{Binding WebsiteHint}"
                         Text="{Binding Integrator.Website, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,20"/>

                <TextBox materialDesign:HintAssist.Hint="{Binding AddressHint}"
                         Text="{Binding Integrator.Address, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,20"/>

                <TextBox materialDesign:HintAssist.Hint="{Binding ContactNameHint}"
                         Text="{Binding Integrator.ContactName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,20"/>

                <TextBox materialDesign:HintAssist.Hint="{Binding NotesHint}"
                         Text="{Binding Integrator.Comments, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="70" VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,20"/>

                <!-- API Key -->
                <TextBlock Text="{Binding SecuritySectionText}" 
                           Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           Margin="0,0,0,5"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Añadido Padding="5,0,0,0" para que la "A" de API no se corte -->
                    <TextBox materialDesign:HintAssist.Hint="{Binding ApiKeyHint}"
                             Text="{Binding ApiKeyDisplay, Mode=OneWay}"
                             IsReadOnly="True"
                             Padding="5,4,0,4"
                             HorizontalScrollBarVisibility="Auto"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                    <Button Grid.Column="1" 
                            Command="{Binding RegenerateKeyCommand}"
                            Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource MaterialDesignIconButton}" 
                            ToolTip="{Binding RegenerateApiKeyText}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Bottom">
                        <materialDesign:PackIcon Kind="Refresh" Foreground="Orange" Width="24" Height="24"/>
                    </Button>
                </Grid>

                <!-- Who works with whom (PROVIDER_ACCESS_MODEL.md §3.6). Applied at once, not with Save. -->
                <StackPanel Visibility="{Binding IsExisting, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,20">
                    <TextBlock Text="{Binding CatalogSectionText}" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding CatalogStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="{Binding SearchCatalogIntegratorHint}"
                                 Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                        <Button Grid.Column="1" Content="{Binding SearchText}" Command="{Binding SearchCatalogCommand}" Style="{StaticResource MaterialDesignFlatButton}" VerticalAlignment="Bottom"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding CatalogCandidates}" SelectedItem="{Binding SelectedCatalogCandidate}" DisplayMemberPath="Name" Margin="8,0" VerticalAlignment="Bottom"/>
                        <Button Grid.Column="3" Content="{Binding LinkText}" Command="{Binding LinkCatalogCommand}" Style="{StaticResource MaterialDesignFlatButton}" VerticalAlignment="Bottom"/>
                        <Button Grid.Column="4" Content="{Binding UnlinkText}" Command="{Binding UnlinkCatalogCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#C62828" VerticalAlignment="Bottom"/>
                    </Grid>

                    <TextBlock Text="{Binding RelationsSectionText}" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding RelationsHelpText}" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                    <DataGrid ItemsSource="{Binding ContractedProviders}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="220" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.NameColumnText, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding WorkMode}" Width="90">
                                <DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.WorkModeText, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ActiveUsers}" Width="70">
                                <DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.ActiveUsersText, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <!-- Fixed width: with "Auto" the button fell outside the grid and was never seen. -->
                            <DataGridTemplateColumn Width="48">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                ToolTip="{Binding DataContext.RemoveText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MaterialDesignToolButton}">
                                            <materialDesign:PackIcon Kind="LinkOff" Foreground="#C62828"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="{Binding SearchCatalogProviderHint}"
                                 Text="{Binding ProviderSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                        <Button Grid.Column="1" Content="{Binding SearchText}" Command="{Binding SearchProvidersCommand}" Style="{StaticResource MaterialDesignFlatButton}" VerticalAlignment="Bottom"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding ProviderCandidates}" SelectedItem="{Binding SelectedProviderCandidate}" DisplayMemberPath="Name" Margin="8,0" VerticalAlignment="Bottom"/>
                        <Button Grid.Column="3" Content="{Binding AddText}" Command="{Binding AddProviderCommand}" Style="{StaticResource MaterialDesignRaisedButton}" VerticalAlignment="Bottom"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción fijos abajo -->
        <Border Grid.Row="1" Background="{DynamicResource MaterialDesignDivider}" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding CancelText}" 
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Margin="0,0,10,0"/>
                <Button Content="{Binding SaveText}" 
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
<UserControl x:Class="Raphael.Desktop.Views.Admin.IntegratorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
             xmlns:converters="clr-namespace:Raphael.Desktop.Converters"
             xmlns:services="clr-namespace:Raphael.Desktop.Services">

    <UserControl.Resources>
        <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" />
    </UserControl.Resources>

    <Border BorderThickness="1" BorderBrush="#2196f3" Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Command="{Binding AddCommand}"
                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}">
                <materialDesign:PackIcon Kind="Add" />
            </Button>

            <!-- The other half of the story: this tab holds who we work with, the catalog
                 holds who we could. RE-027. -->
            <Button Click="OpenCatalog_Click"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="12,0,0,0"
                    ToolTip="{Binding Source={x:Static services:LocalizationService.Instance},
                                      Path=[catalog.OpenCatalog]}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BookOpenVariant" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                               Text="{Binding Source={x:Static services:LocalizationService.Instance},
                                              Path=[catalog.Tab]}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Integrators}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  SelectionMode="Single"
                  Style="{StaticResource CustomDataGridStyle}"
                  AlternationCount="2"
                  AlternatingRowBackground="White"                                    
                  ColumnHeaderStyle="{StaticResource CustomColumnHeaderStyle}"
                  RowStyle="{StaticResource CustomRowStyle}"
                  CellStyle="{StaticResource CustomCellStyle}"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding Data.EditCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}" ToolTip="{Binding Data.EditText, Source={StaticResource vmProxy}}">
                                    <materialDesign:PackIcon Kind="Pencil" Foreground="Orange"/>
                                </Button>
                                <Button Command="{Binding Data.DeleteCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignToolButton}" ToolTip="{Binding Data.DeleteText, Source={StaticResource vmProxy}}">
                                    <materialDesign:PackIcon Kind="Delete" Foreground="Red"/>
                                </Button>
                                <!-- RE-056: uncontract or contract again; the form no longer does it. -->
                                <Button Command="{Binding Data.ToggleActiveCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        ToolTip="{Binding Data.UncontractText, Source={StaticResource vmProxy}}"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}">
                                    <materialDesign:PackIcon Kind="DomainRemove" Foreground="#B06000"/>
                                </Button>
                                <Button Command="{Binding Data.ToggleActiveCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignToolButton}"
                                        ToolTip="{Binding Data.RecontractText, Source={StaticResource vmProxy}}"
                                        Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <materialDesign:PackIcon Kind="DomainPlus" Foreground="Green"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{Binding Data.ColumnName, Source={StaticResource vmProxy}}" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="{Binding Data.ColumnFundingSource, Source={StaticResource vmProxy}}" Binding="{Binding FundingSourceName}" Width="*" />
                <DataGridTextColumn Header="{Binding Data.ColumnApiKey, Source={StaticResource vmProxy}}" Binding="{Binding ApiKey}" Width="2*" />
                <DataGridCheckBoxColumn Header="{Binding Data.ColumnActive, Source={StaticResource vmProxy}}" Binding="{Binding IsActive}" />
                <DataGridTextColumn Header="{Binding Data.ColumnCreated, Source={StaticResource vmProxy}}" Binding="{Binding Created, StringFormat=d}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
    </Border>
</UserControl>
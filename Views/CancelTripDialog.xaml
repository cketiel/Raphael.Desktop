<Window x:Class="Raphael.Desktop.Views.CancelTripDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
        helpers:HelpAssist.TopicId="desktop/home/cancel-trip"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" FontFamily="Segoe UI" Background="White"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- RE-091: cancelling asks why. One click for the usual ones, words only for "Other". -->
    <StackPanel>
        <Border Background="#C62828" Padding="18,13">
            <DockPanel>
                <materialDesign:PackIcon Kind="CalendarRemove" Width="28" Height="28" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock x:Name="HeadText" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TripText" Foreground="#FFCDD2" FontSize="12.5" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel Margin="18,12,18,16">
            <TextBlock x:Name="AskText" FontWeight="SemiBold" Foreground="#1E2A36" Margin="0,0,0,4"/>
            <ItemsControl x:Name="Reasons">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="why" Content="{Binding Label}" Tag="{Binding Code}" Margin="0,1" Padding="6,5" VerticalContentAlignment="Center"
                                     Style="{StaticResource MaterialDesignRadioButton}" Checked="OnChosen"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox x:Name="OtherBox" Visibility="Collapsed" Margin="26,4,0,0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxLength="300"
                     VerticalScrollBarVisibility="Auto" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            <TextBlock x:Name="ErrorText" Foreground="#C62828" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="KeepButton" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
                <Button x:Name="CancelTripButton" Style="{StaticResource MaterialDesignRaisedButton}" Background="#C62828" BorderBrush="#C62828" Foreground="White" Click="OnOk"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>

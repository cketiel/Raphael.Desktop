<Window x:Class="Raphael.Desktop.Views.GarageChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="640" MaxHeight="720" SizeToContent="Height" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- RE-052. What a new garage does to the days already planned on the route, worked out by the
         server before anything is saved: what changes, what cannot, and every hour that moves. -->
    <DockPanel Margin="20">
        <Border x:Name="NoticeBox" DockPanel.Dock="Top" Background="#FFF8E1" BorderBrush="#FFA000" BorderThickness="1"
                CornerRadius="4" Padding="10,6" Margin="0,0,0,10" Visibility="Collapsed">
            <DockPanel>
                <materialDesign:PackIcon DockPanel.Dock="Left" Kind="AlertOutline" Foreground="#E65100"
                                         Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#5D4037" />
            </DockPanel>
        </Border>

        <TextBlock x:Name="IntroText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                   Style="{StaticResource MaterialDesignBody1TextBlock}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0" Click="OnCancel" />
            <Button x:Name="OkButton" IsDefault="True" Style="{StaticResource MaterialDesignRaisedButton}" Click="OnOk" />
        </StackPanel>

        <TextBlock x:Name="FooterText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="#5D4037" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DaysPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>

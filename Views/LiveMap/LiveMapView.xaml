<UserControl x:Class="Raphael.Desktop.Views.LiveMap.LiveMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
             xmlns:conv="clr-namespace:Raphael.Desktop.Views.LiveMap"
             helpers:HelpAssist.TopicId="desktop/live-map/overview">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="LmBoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="LmInverseBoolToVis"/>
        <conv:RatioToWidthConverter x:Key="LmRatioToWidth"/>
        <conv:ZeroToVisibleConverter x:Key="LmZeroToVis"/>
        <conv:RatioToMarginConverter x:Key="LmRatioToMargin"/>
        <conv:MinusConverter x:Key="LmMinus"/>

        <!-- Panels: frosted light glass, after the God's Eye View windows but in a sober gray. -->
        <SolidColorBrush x:Key="LmPanelBg" Color="#EBF5F7F9"/>
        <SolidColorBrush x:Key="LmPanelBorder" Color="#1F0F1E2E"/>
        <SolidColorBrush x:Key="LmTitle" Color="#5B6B7C"/>
        <SolidColorBrush x:Key="LmText" Color="#1E2A36"/>
        <SolidColorBrush x:Key="LmDivider" Color="#260F1E2E"/>

        <Style x:Key="LmPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LmPanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LmPanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12" Color="#0F1E2E"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section with its title, a hairline and the +/- that folds it. -->
        <Style x:Key="LmSection" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <!-- Style x:Null: Material Design's ToggleButton style fixes a small
                                 width, which centred and cut the titles. -->
                            <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Style="{x:Null}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Cursor="Hand" Focusable="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent" Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                              TextElement.FontSize="11" TextElement.FontWeight="SemiBold"
                                                              TextElement.Foreground="{StaticResource LmTitle}"/>
                                            <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource LmDivider}" Margin="10,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Sign" Grid.Column="2" Text="–" Foreground="{StaticResource LmTitle}" FontSize="13"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Sign" Property="Text" Value="+"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Map / Satellite: a two-piece segmented control. -->
        <Style x:Key="LmSegment" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Padding="12,6" Background="Transparent">
                            <ContentPresenter x:Name="Txt" TextElement.Foreground="{StaticResource LmText}" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="On">
                                <Setter TargetName="Bg" Property="Background" Value="#1F6FD1"/>
                                <Setter TargetName="Txt" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Card illustrations, flat, side view. AMB: minivan. WCH: high van with the ramp down.
             STR: high-roof van with the rear doors open and a stretcher. -->
        <DataTemplate x:Key="LmArtAmb">
            <Viewbox>
                <Canvas Width="104" Height="58">
                    <Path Fill="#1F6FD1" Data="M6,38 L10,22 C12,16 16,14 24,14 L66,14 C74,14 80,18 86,26 L96,30 C99,31 100,33 100,36 L100,42 L6,42 Z"/>
                    <Path Fill="#E6F1FB" Data="M26,18 L44,18 L44,28 L18,28 Z M48,18 L64,18 C70,18 74,21 78,28 L48,28 Z"/>
                    <Ellipse Canvas.Left="16" Canvas.Top="35" Width="16" Height="16" Fill="#2C2C2A"/>
                    <Ellipse Canvas.Left="72" Canvas.Top="35" Width="16" Height="16" Fill="#2C2C2A"/>
                    <Ellipse Canvas.Left="20" Canvas.Top="39" Width="8" Height="8" Fill="#B4B2A9"/>
                    <Ellipse Canvas.Left="76" Canvas.Top="39" Width="8" Height="8" Fill="#B4B2A9"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="LmArtWch">
            <Viewbox>
                <Canvas Width="104" Height="58">
                    <Path Fill="#1F6FD1" Data="M14,42 L14,10 C14,7 16,6 19,6 L72,6 C80,6 86,12 90,22 L98,28 C100,30 100,32 100,35 L100,42 Z"/>
                    <Path Fill="#E6F1FB" Data="M22,12 L40,12 L40,24 L22,24 Z M46,12 L70,12 C76,12 80,16 84,24 L46,24 Z"/>
                    <Path Fill="#5F5E5A" Data="M14,40 L0,52 L4,54 L16,43 Z"/>
                    <Ellipse Canvas.Left="24" Canvas.Top="35" Width="16" Height="16" Fill="#2C2C2A"/>
                    <Ellipse Canvas.Left="74" Canvas.Top="35" Width="16" Height="16" Fill="#2C2C2A"/>
                    <Ellipse Canvas.Left="28" Canvas.Top="39" Width="8" Height="8" Fill="#B4B2A9"/>
                    <Ellipse Canvas.Left="78" Canvas.Top="39" Width="8" Height="8" Fill="#B4B2A9"/>
                    <materialDesign:PackIcon Canvas.Left="52" Canvas.Top="25" Kind="Wheelchair" Width="12" Height="12" Foreground="White"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="LmArtStr">
            <Viewbox>
                <Canvas Width="104" Height="58">
                    <Path Fill="#1F6FD1" Data="M12,42 L12,4 C12,2 13,1 16,1 L72,1 C80,1 86,10 90,22 L98,28 C100,30 100,32 100,35 L100,42 Z"/>
                    <Path Fill="#E6F1FB" Data="M58,8 L70,8 C76,8 80,14 84,24 L58,24 Z"/>
                    <Rectangle Canvas.Left="2" Canvas.Top="6" Width="9" Height="32" Fill="#185FA5"/>
                    <Rectangle Canvas.Left="20" Canvas.Top="18" Width="30" Height="4" Fill="White"/>
                    <Rectangle Canvas.Left="31" Canvas.Top="11" Width="8" Height="18" Fill="White"/>
                    <Ellipse Canvas.Left="22" Canvas.Top="35" Width="16" Height="16" Fill="#2C2C2A"/>
                    <Ellipse Canvas.Left="74" Canvas.Top="35" Width="16" Height="16" Fill="#2C2C2A"/>
                    <Ellipse Canvas.Left="26" Canvas.Top="39" Width="8" Height="8" Fill="#B4B2A9"/>
                    <Ellipse Canvas.Left="78" Canvas.Top="39" Width="8" Height="8" Fill="#B4B2A9"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>


        <!-- The vehicle as the map draws it: a disc in the group colour, white border, white van. -->
        <ControlTemplate x:Key="LmVehicleGlyph" TargetType="ContentControl">
            <Grid Width="22" Height="22">
                <Ellipse Fill="{TemplateBinding Background}" Stroke="White" StrokeThickness="2"/>
                <materialDesign:PackIcon Kind="VanPassenger" Width="13" Height="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </ControlTemplate>

        <!-- Small glyphs reused by the legend and the markers. -->
        <Geometry x:Key="LmVan">M 12,1 C 15.5,1 17,3 17,6 L 17,20 C 17,22 15.5,23 12,23 C 8.5,23 7,22 7,20 L 7,6 C 7,3 8.5,1 12,1 Z</Geometry>
        <Geometry x:Key="LmWindshield">M 8.6,7.2 C 10.6,6 13.4,6 15.4,7.2 L 14.6,9.6 C 13,9 11,9 9.4,9.6 Z</Geometry>
    </UserControl.Resources>

    <Grid ClipToBounds="True" Background="#E9ECEF">

        <!-- RE-080: Maps JavaScript in the composition WebView2, so the WPF panels and the card can sit
             on top of it (the classic WebView2 is a window of its own and would cover them). -->
        <wv2:WebView2CompositionControl x:Name="Map" DefaultBackgroundColor="#E9ECEF"/>

        <!-- Soft vignette: the eye goes to the middle without the black of God's Eye. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush RadiusX="0.75" RadiusY="0.8" Center="0.5,0.5" GradientOrigin="0.5,0.5">
                    <GradientStop Color="#00808A94" Offset="0.55"/>
                    <GradientStop Color="#4D7A848E" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Left: filters and legend -->
        <Border Style="{StaticResource LmPanel}" Width="276" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource LmMinus}, ConverterParameter=60}">
            <StackPanel>
                <Expander Style="{StaticResource LmSection}" Header="{Binding FiltersHeader}">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsOn}" Margin="0,3" Cursor="Hand">
                                    <Grid Width="180">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="11" Height="11" CornerRadius="3" Background="{Binding Brush}" Margin="2,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource LmText}" FontSize="12.5"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{StaticResource LmTitle}" FontSize="12"/>
                                    </Grid>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander Style="{StaticResource LmSection}" Header="{Binding LayersHeader}">
                    <StackPanel TextElement.FontSize="12.5" TextElement.Foreground="{StaticResource LmText}">

                        <!-- Routes in progress -->
                        <CheckBox IsChecked="{Binding ShowRoutes}" Content="{Binding LayerRoutesText}" Margin="0,3" Cursor="Hand" FontWeight="SemiBold"/>
                        <Border Visibility="{Binding ShowRoutes, Converter={StaticResource LmBoolToVis}}" Background="#F1F4F7" CornerRadius="8" Padding="8,6" Margin="22,2,0,8">
                            <StackPanel TextElement.FontSize="11.5" TextElement.Foreground="{StaticResource LmTitle}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Grid Width="40" Height="12" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Rectangle Height="8" Fill="White" RadiusX="4" RadiusY="4"/>
                                        <Rectangle Height="4" Fill="#2563EB" RadiusX="2" RadiusY="2" Margin="2,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding RoutesLegend1}" TextWrapping="Wrap" Width="150"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <!-- The finish flag the map draws at the end of each route -->
                                    <Viewbox Width="40" Height="30" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"><Canvas Width="24" Height="26">
                                        <Rectangle Canvas.Left="4" Canvas.Top="1" Width="2" Height="21" RadiusX="1" RadiusY="1" Fill="#1E2A36"/>
                                        <Path Canvas.Left="6" Canvas.Top="2" Data="M0,1 C3,-0.5 5.5,2.5 8.5,1 C10,0.3 11.5,0.1 13.5,0.6 L13.5,9.4 C11.5,8.9 10,9.1 8.5,9.8 C5.5,11.3 3,8.3 0,9.8 Z" Stroke="#1E2A36" StrokeThickness="0.8">
                                            <Path.Fill>
                                                <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
                                                    <DrawingBrush.Drawing>
                                                        <DrawingGroup>
                                                            <GeometryDrawing Brush="White" Geometry="M0,0 H2 V2 H0Z"/>
                                                            <GeometryDrawing Brush="#1E2A36" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z"/>
                                                        </DrawingGroup>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Path.Fill>
                                        </Path>
                                        <Ellipse Canvas.Left="1.5" Canvas.Top="18" Width="7" Height="7" Fill="#2563EB" Stroke="White" StrokeThickness="1.5"/>
                                    </Canvas></Viewbox>
                                    <TextBlock Text="{Binding RoutesLegend2}" TextWrapping="Wrap" Width="150"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RoutesLegend3}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,2"/>
                                <TextBlock Text="{Binding RoutesStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource LmText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Google traffic -->
                        <CheckBox IsChecked="{Binding ShowTraffic}" Content="{Binding LayerTrafficText}" Margin="0,3" Cursor="Hand" FontWeight="SemiBold"/>
                        <Border Visibility="{Binding ShowTraffic, Converter={StaticResource LmBoolToVis}}" Background="#F1F4F7" CornerRadius="8" Padding="8,6" Margin="22,2,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <Rectangle Width="18" Height="5" Fill="#63D668" RadiusX="2" RadiusY="2" Margin="0,0,3,0"/>
                                    <Rectangle Width="18" Height="5" Fill="#FF974D" RadiusX="2" RadiusY="2" Margin="0,0,3,0"/>
                                    <Rectangle Width="18" Height="5" Fill="#F23C32" RadiusX="2" RadiusY="2" Margin="0,0,3,0"/>
                                    <Rectangle Width="18" Height="5" Fill="#811F1F" RadiusX="2" RadiusY="2"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TrafficLegend}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource LmTitle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Delays on each route -->
                        <CheckBox IsChecked="{Binding ShowDelays}" Content="{Binding LayerDelaysText}" Margin="0,3" Cursor="Hand" FontWeight="SemiBold"/>
                        <Border Visibility="{Binding ShowDelays, Converter={StaticResource LmBoolToVis}}" Background="#F1F4F7" CornerRadius="8" Padding="8,6" Margin="22,2,0,6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <Rectangle Width="26" Height="6" Fill="#E8A33D" RadiusX="3" RadiusY="3" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <Rectangle Width="26" Height="6" Fill="#D93B3B" RadiusX="3" RadiusY="3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Border Background="#D93B3B" CornerRadius="8" Padding="5,0"><TextBlock Text="+7'" Foreground="White" FontSize="11" FontWeight="Bold"/></Border>
                                </StackPanel>
                                <TextBlock Text="{Binding DelaysLegend}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource LmTitle}"/>
                                <TextBlock Text="{Binding DelaysStatus}" TextWrapping="Wrap" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource LmText}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding LayerDelaysHint}" TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource LmTitle}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource LmSection}" Header="{Binding LegendHeader}">
                    <StackPanel TextElement.FontSize="12" TextElement.Foreground="{StaticResource LmText}">
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Grid Width="26" Height="26" Margin="0,0,8,0">
                                <Path Data="M13,0 L17,6 H9 Z" Fill="#1F6FD1" Stroke="White" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                <ContentControl Template="{StaticResource LmVehicleGlyph}" Background="#1F6FD1" Margin="0,3,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding LegendMoving}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Grid Width="26" Height="26" Margin="0,0,8,0">
                                <ContentControl Template="{StaticResource LmVehicleGlyph}" Background="#1F6FD1"/>
                                <Border Width="11" Height="11" CornerRadius="6" Background="#5B6B7C" BorderBrush="White" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <materialDesign:PackIcon Kind="Pause" Width="8" Height="8" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding LegendStopped}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Grid Width="26" Height="26" Margin="0,0,8,0">
                                <Ellipse Width="26" Height="26" Stroke="#D93B3B" StrokeThickness="2.5"/>
                                <ContentControl Template="{StaticResource LmVehicleGlyph}" Background="#1F6FD1"/>
                            </Grid>
                            <TextBlock Text="{Binding LegendSpeeding}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Grid Width="26" Height="26" Margin="0,0,8,0" Opacity="0.5">
                                <ContentControl Template="{StaticResource LmVehicleGlyph}" Background="#8A96A3"/>
                            </Grid>
                            <TextBlock Text="{Binding LegendStale}" TextWrapping="Wrap" MaxWidth="190" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right: what is on the map, and the window controls -->
        <Border Style="{StaticResource LmPanel}" Width="264" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Command="{Binding ToggleWindowCommand}" ToolTip="{Binding ToggleWindowText}"
                            Style="{StaticResource MaterialDesignToolButton}" Padding="2" Height="26">
                        <materialDesign:PackIcon Kind="{Binding ToggleWindowIcon}" Width="18" Height="18" Foreground="{StaticResource LmTitle}"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Command="{Binding ReloadCommand}"
                            Style="{StaticResource MaterialDesignToolButton}" Padding="2" Height="26">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Foreground="{StaticResource LmTitle}"/>
                    </Button>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource LmText}" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Today: Home's figures for the whole day -->
                <Expander Style="{StaticResource LmSection}" Header="{Binding TodayHeader}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Day.Tiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="8" Padding="8,5" Margin="0,0,6,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource LmTitle}"/>
                                            <TextBlock Text="{Binding Value}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource LmText}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Height="6" Margin="0,2,6,2">
                            <Border Background="#DFE5EA" CornerRadius="3"/>
                            <Border Background="#1F6FD1" CornerRadius="3" HorizontalAlignment="Left"
                                    Width="{Binding Day.DoneRatio, Converter={StaticResource LmRatioToWidth}, ConverterParameter=226}"/>
                        </Grid>
                        <TextBlock Text="{Binding Day.DoneText}" FontSize="11" Foreground="{StaticResource LmTitle}"/>
                    </StackPanel>
                </Expander>

                <!-- Drivers: hours, trips, miles; the bar is loaded/wait once the day is closed -->
                <Expander Style="{StaticResource LmSection}" Header="{Binding DriversHeader}">
                    <StackPanel>
                        <TextBlock Text="{Binding NoDriversText}" FontSize="12" Foreground="{StaticResource LmTitle}" TextWrapping="Wrap"
                                   Visibility="{Binding Drivers.Count, Converter={StaticResource LmZeroToVis}}"/>
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Drivers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,4,8" ToolTip="{Binding ShiftStartText}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding MilesText}" FontWeight="SemiBold" Foreground="{StaticResource LmText}" FontSize="12"/>
                                                <Border Width="8" Height="8" CornerRadius="2" Background="{Binding GroupBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock FontSize="12" Foreground="{StaticResource LmText}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding DriverName, Mode=OneWay}"/>
                                                    <Run Text="·" Foreground="#8A96A3"/>
                                                    <Run Text="{Binding ShiftText, Mode=OneWay}" Foreground="#5B6B7C"/>
                                                    <Run Text="·" Foreground="#8A96A3"/>
                                                    <Run Text="{Binding TripsText, Mode=OneWay}" Foreground="#5B6B7C"/>
                                                </TextBlock>
                                            </DockPanel>
                                            <Grid Height="5" Margin="0,4,0,0">
                                                <Border Background="#DFE5EA" CornerRadius="2.5"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#1F6FD1" CornerRadius="2.5"
                                                            Width="{Binding LoadedShare, Converter={StaticResource LmRatioToWidth}, ConverterParameter=226}"/>
                                                    <Border Background="#D98A12"
                                                            Width="{Binding WaitShare, Converter={StaticResource LmRatioToWidth}, ConverterParameter=226}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding DriversLegend}" FontSize="10.5" Foreground="{StaticResource LmTitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource LmSection}" Header="{Binding FleetHeader}" IsExpanded="False">
                    <ItemsControl ItemsSource="{Binding Summary}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" Foreground="{StaticResource LmText}"/>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource LmTitle}" FontSize="12.5"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <TextBlock Text="{Binding ErrorText}" Foreground="#C2410C" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Bottom right: map controls. Map / Satellite, labels on or off on both. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,18">
            <Border Style="{StaticResource LmPanel}" Padding="3" CornerRadius="10" VerticalAlignment="Bottom" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RoadMode" Tag="On" Click="Road_Click"
                            Content="{Binding MapRoadText}" Style="{StaticResource LmSegment}"/>
                    <Button x:Name="SatelliteMode" Click="Satellite_Click"
                            Content="{Binding MapSatelliteText}" Style="{StaticResource LmSegment}"/>
                    <CheckBox x:Name="LabelsToggle" IsChecked="True" Checked="MapType_Changed" Unchecked="MapType_Changed"
                              Content="{Binding MapLabelsText}" Margin="8,0,6,0" VerticalAlignment="Center"
                              Foreground="{StaticResource LmText}" FontSize="12"
                              Visibility="Visible"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource LmPanel}" Padding="3" CornerRadius="10">
                <StackPanel>
                    <Button Click="ZoomIn_Click" ToolTip="{Binding ZoomInText}" Style="{StaticResource MaterialDesignToolButton}" Height="30" Width="30" Padding="0">
                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="{StaticResource LmText}"/>
                    </Button>
                    <Rectangle Height="1" Fill="{StaticResource LmDivider}" Margin="4,0"/>
                    <Button Click="ZoomOut_Click" ToolTip="{Binding ZoomOutText}" Style="{StaticResource MaterialDesignToolButton}" Height="30" Width="30" Padding="0">
                        <materialDesign:PackIcon Kind="Minus" Width="18" Height="18" Foreground="{StaticResource LmText}"/>
                    </Button>
                    <Rectangle Height="1" Fill="{StaticResource LmDivider}" Margin="4,0"/>
                    <Button Click="Fit_Click" ToolTip="{Binding FitText}" Style="{StaticResource MaterialDesignToolButton}" Height="30" Width="30" Padding="0">
                        <materialDesign:PackIcon Kind="FitToScreenOutline" Width="18" Height="18" Foreground="{StaticResource LmText}"/>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Bottom: is it live, how many, how fresh -->
        <Border Style="{StaticResource LmPanel}" Padding="14,6" Margin="0,0,0,18" HorizontalAlignment="Center" VerticalAlignment="Bottom" CornerRadius="10">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LiveDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#2FB37A"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLive}" Value="False">
                                    <Setter Property="Fill" Value="#C2410C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding LastFixText}" FontSize="12" Foreground="{StaticResource LmText}"/>
            </StackPanel>
        </Border>



        <!-- ===== Selection bar (RE-080): a click on a vehicle selects it =====
             Its route is drawn whatever the layers say; the switch picks the trip in progress or the
             whole day; Details opens the card. A double click goes straight to the card. -->
        <Border Style="{StaticResource LmPanel}" Padding="10,6" CornerRadius="12" Margin="0,16,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding SelectionVisibility}">
            <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="12" Height="12" CornerRadius="6" Background="{Binding Selected.RouteBrush}" BorderBrush="White" BorderThickness="2" Margin="2,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectionTitle}" FontWeight="SemiBold" Foreground="{StaticResource LmText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border Background="#E9EDF1" CornerRadius="8" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding SelTripText}" Command="{Binding ShowTripOnlyCommand}" Tag="{Binding TripModeTag}" Style="{StaticResource LmSegment}"/>
                        <Button Content="{Binding SelDayText}" Command="{Binding ShowDayCommand}" Tag="{Binding DayModeTag}" Style="{StaticResource LmSegment}"/>
                    </StackPanel>
                </Border>
                <Button Command="{Binding OpenDetailsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="10,0" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CardAccountDetailsOutline" Margin="0,0,6,0"/><TextBlock Text="{Binding SelDetailsText}"/></StackPanel>
                </Button>
                <Button Command="{Binding ClearSelectionCommand}" ToolTip="{Binding SelCloseText}" Style="{StaticResource MaterialDesignToolButton}" Height="28" Width="28" Padding="0" Margin="4,0,0,0">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="{StaticResource LmTitle}"/>
                </Button>
            </StackPanel>
                <!-- What the selected route's drawing means: one legend per mode -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Center" TextElement.FontSize="11" TextElement.Foreground="{StaticResource LmTitle}"
                            Visibility="{Binding ShowWholeDay, Converter={StaticResource LmInverseBoolToVis}}">
                    <Path Data="M5,0 A5,5 0 0 0 0,5 C0,8.7 5,13 5,13 C5,13 10,8.7 10,5 A5,5 0 0 0 5,0 Z" Fill="#C0392B" Stroke="White" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding SelLegendPickup}" Margin="0,0,10,0"/>
                    <Path Data="M5,0 A5,5 0 0 0 0,5 C0,8.7 5,13 5,13 C5,13 10,8.7 10,5 A5,5 0 0 0 5,0 Z" Fill="#0A5C7E" Stroke="White" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding SelLegendDropoff}" Margin="0,0,12,0"/>
                    <Rectangle Width="22" Height="5" Fill="#525C6B" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding SelLegendDriven}" Margin="0,0,12,0"/>
                    <Rectangle Width="22" Height="6" Fill="{Binding Selected.RouteBrush}" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding SelLegendAhead}" Margin="0,0,12,0"/>
                    <!-- On its way to the pickup: the dotted approach -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Ellipse Width="5" Height="5" Fill="{Binding Selected.RouteBrush}" Margin="0,0,2,0"/>
                        <Ellipse Width="5" Height="5" Fill="{Binding Selected.RouteBrush}" Margin="0,0,2,0"/>
                        <Ellipse Width="5" Height="5" Fill="{Binding Selected.RouteBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SelLegendApproach}" Margin="0,0,12,0"/>
                    <materialDesign:PackIcon Kind="ArrowRightBold" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBlock Text="{Binding SelLegendDirection}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Center" TextElement.FontSize="11" TextElement.Foreground="{StaticResource LmTitle}"
                            Visibility="{Binding ShowWholeDay, Converter={StaticResource LmBoolToVis}}">
                    <Border Width="15" Height="15" CornerRadius="8" Background="Green" VerticalAlignment="Center" Margin="0,0,4,0"><TextBlock Text="1" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="{Binding SelLegendPickup}" Margin="0,0,10,0"/>
                    <Border Width="15" Height="15" CornerRadius="8" Background="Red" VerticalAlignment="Center" Margin="0,0,4,0"><TextBlock Text="2" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="{Binding SelLegendDropoff}" Margin="0,0,10,0"/>
                    <Border Width="15" Height="15" CornerRadius="8" Background="Purple" VerticalAlignment="Center" Margin="0,0,4,0"><TextBlock Text="3" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="{Binding SelLegendArrived}" Margin="0,0,12,0"/>
                    <Rectangle Width="22" Height="5" Fill="#525C6B" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding SelLegendDriven}" Margin="0,0,12,0"/>
                    <Rectangle Width="22" Height="6" Fill="{Binding Selected.RouteBrush}" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding SelLegendAhead}" Margin="0,0,12,0"/>
                    <Line X1="0" X2="22" Y1="2" Y2="2" Stroke="{Binding Selected.RouteBrush}" StrokeThickness="4" StrokeDashArray="1.2 1" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding SelLegendPlan}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Route card (RE-080): Details or a double click; centred on the screen =====
             About the line, never a patient. Esc, the X or a click outside closes it. -->
        <Grid DataContext="{Binding RouteCard}" Visibility="{Binding IsOpenVisibility}">
            <Border Background="#400F1E2E" MouseLeftButtonDown="CardBackdrop_MouseDown"/>
            <Border Width="500" Background="White" CornerRadius="16" Padding="22,18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#260F1E2E" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.25" Color="#0F1E2E"/>
                </Border.Effect>
                <StackPanel TextElement.Foreground="{StaticResource LmText}" TextElement.FontSize="12.5">

                    <!-- Header: illustration, name, vehicle, group, capacities -->
                    <DockPanel>
                        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding CloseCommand}" ToolTip="{Binding CloseText}"
                                Style="{StaticResource MaterialDesignToolButton}" Padding="2" Height="28" Width="28">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Foreground="{StaticResource LmTitle}"/>
                        </Button>
                        <Grid Width="104" Height="58" Margin="0,0,14,0" VerticalAlignment="Center">
                            <ContentControl Content="{Binding Kind}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource LmArtAmb}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="WCH">
                                                <Setter Property="ContentTemplate" Value="{StaticResource LmArtWch}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="STR">
                                                <Setter Property="ContentTemplate" Value="{StaticResource LmArtStr}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding VehicleLine}" Foreground="{StaticResource LmTitle}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Border CornerRadius="9" Padding="8,2" Background="{Binding GroupBrush}">
                                    <TextBlock Text="{Binding GroupName}" Foreground="White" FontSize="11"/>
                                </Border>
                                <Border CornerRadius="9" Padding="8,2" Margin="6,0,0,0" Background="#F1F3F5">
                                    <TextBlock Text="{Binding CapacityText}" Foreground="#444441" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>


                    <!-- Booking's pieces (RE-080): TripProgressBar and LiveEta (lg), the same markup and CSS as
                         Booking, rendered by Assets/live-eta.html in a small WebView. -->
                    <wv2:WebView2CompositionControl x:Name="EtaView" Height="232" Margin="0,14,0,0" DefaultBackgroundColor="White"
                                                    Visibility="{Binding ProgressVisibility}"/>

                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,10,0,0"
                                 Visibility="{Binding IsLoading, Converter={StaticResource LmBoolToVis}}"/>
                    <TextBlock Text="{Binding ErrorText}" Foreground="#C2410C" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <!-- Facts, two columns -->
                    <Rectangle Height="1" Fill="#E5E8EB" Margin="0,12,0,10"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="{Binding LabelDriver}" FontSize="11" Foreground="{StaticResource LmTitle}"/>
                            <TextBlock Text="{Binding DriverLine}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding LabelNow}" FontSize="11" Foreground="{StaticResource LmTitle}"/>
                            <TextBlock Text="{Binding NowLine}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="{Binding LabelTrips}" FontSize="11" Foreground="{StaticResource LmTitle}"/>
                            <TextBlock Text="{Binding TripsLine}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding LabelNext}" FontSize="11" Foreground="{StaticResource LmTitle}"/>
                            <TextBlock Text="{Binding NextStopLine}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="{Binding LabelShift}" FontSize="11" Foreground="{StaticResource LmTitle}"/>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding Vehicle.ShiftText, Mode=OneWay}"/>
                                <Run Text="·" Foreground="#8A96A3"/>
                                <Run Text="{Binding Vehicle.MilesText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding LabelCharges}" FontSize="11" Foreground="{StaticResource LmTitle}"/>
                            <TextBlock Text="{Binding ChargesLine}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,4">
                            <TextBlock Text="{Binding LabelVehicleDocs}" FontSize="11" Foreground="{StaticResource LmTitle}"/>
                            <TextBlock Text="{Binding VehicleComplianceLine}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding LabelDriverDocs}" FontSize="11" Foreground="{StaticResource LmTitle}"/>
                            <TextBlock Text="{Binding DriverComplianceLine}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{Binding CurrentTripLine}" Foreground="{StaticResource LmTitle}" Margin="0,6,0,0"
                               Visibility="{Binding HasCurrentTrip, Converter={StaticResource LmBoolToVis}}"/>

                    <!-- Links -->
                    <WrapPanel Margin="0,12,0,0">
                        <Button Command="{Binding OpenRouteCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,6" Height="30" Padding="10,0">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="TableClock" Margin="0,0,6,0"/><TextBlock Text="{Binding LinkRoute}"/></StackPanel>
                        </Button>
                        <Button Command="{Binding OpenTripCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,6" Height="30" Padding="10,0"
                                Visibility="{Binding HasCurrentTrip, Converter={StaticResource LmBoolToVis}}">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="HomeOutline" Margin="0,0,6,0"/><TextBlock Text="{Binding LinkTrip}"/></StackPanel>
                        </Button>
                        <Button Command="{Binding OpenVehicleDocsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,6" Height="30" Padding="10,0">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileCertificateOutline" Margin="0,0,6,0"/><TextBlock Text="{Binding LinkVehicle}"/></StackPanel>
                        </Button>
                        <Button Command="{Binding OpenDriverDocsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,6" Height="30" Padding="10,0">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountCardOutline" Margin="0,0,6,0"/><TextBlock Text="{Binding LinkDriver}"/></StackPanel>
                        </Button>
                        <Button Command="{Binding CopyPhoneCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,6,6" Height="30" Padding="10,0"
                                Visibility="{Binding HasPhone, Converter={StaticResource LmBoolToVis}}">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentCopy" Margin="0,0,6,0"/><TextBlock Text="{Binding LinkCopyPhone}"/></StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="3"
                     Visibility="{Binding IsLoading, Converter={StaticResource LmBoolToVis}}"/>
    </Grid>
</UserControl>

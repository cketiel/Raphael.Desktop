                    Loaded="TripsGrid_Loaded"

                    SelectionMode="Single"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    AlternationCount="2"

                    FrozenColumnCount="3"
                    RowHeight="{Binding GridRowHeight}"

                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"

                    Style="{StaticResource CustomDataGridStyle}"
                    ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}"

                    RowStyle="{StaticResource HomeTripRowStyle}"
                    CellStyle="{StaticResource TripSelectionCellStyle}"
                    SelectionUnit="FullRow"
                    Cursor="Hand">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ToggleFilterPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="{Binding DataContext.FiltersHeader, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{StaticResource TripActionButtonStyle}">
                                        <Grid>
                                            <materialDesign:PackIcon Kind="FilterSettings" Width="20" Height="20"/>
                                            <!-- The dot is the only thing that tells a dispatcher
                                                 the list is short because they filtered it. -->
                                            <Ellipse Width="7" Height="7" Fill="#D32F2F"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Margin="0,-1,-1,0"
                                                     Visibility="{Binding DataContext.Filters.HasActiveFilters,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                                                  Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">

                                        

                                        <!-- Cancel Button (Visible if not canceled) -->
                                        <Button Command="{Binding DataContext.CancelTripCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TripActionButtonStyle}"
                                            ToolTip="{Binding Data.CancelTripLabel, Source={StaticResource vmProxy}}">
                                            <Button.Visibility>
                                                <Binding Path="Status" Converter="{StaticResource StatusToVisibilityConverter}" ConverterParameter="NotCanceled" />
                                            </Button.Visibility>
                                            <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="20" Height="20" />
                                        </Button>

                                        <!-- Restore Button (Visible if YES is cancelled) -->
                                        <Button Command="{Binding DataContext.UncancelTripCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TripActionButtonStyle}"
                                            ToolTip="{Binding Data.UncancelTripLabel, Source={StaticResource vmProxy}}">
                                            <Button.Visibility>
                                                <Binding Path="Status" Converter="{StaticResource StatusToVisibilityConverter}" ConverterParameter="Canceled" />
                                            </Button.Visibility>
                                            <materialDesign:PackIcon Kind="Restore" Foreground="Green" Width="20" Height="20" />
                                        </Button>

                                        <!-- Edit button -->
                                        <Button Command="{Binding DataContext.EditTripCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TripActionButtonStyle}"
                                            ToolTip="{Binding Data.EditTripLabel, Source={StaticResource vmProxy}}">
                                            <materialDesign:PackIcon Kind="FileEdit" Foreground="Orange"/>
                                        </Button>

                                        <!-- NEW BUTTON: Change History -->
                                        <Button Command="{Binding DataContext.ShowHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TripActionButtonStyle}"
                                            ToolTip="{Binding Data.ChangeHistoryLabel, Source={StaticResource vmProxy}}">
                                            <materialDesign:PackIcon Kind="History" Foreground="Blue" Width="20" Height="20" />
                                        </Button>

                                        </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[Day], Source={StaticResource vmProxy}}"
                                        Binding="{Binding Day}"
                                        Header="{Binding Data.DayText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[Date], Source={StaticResource vmProxy}}"
                                        Binding="{Binding Date, StringFormat=\{0:MM/dd/yyyy\}}"
                                        Header="{Binding Data.DateText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[FromTime], Source={StaticResource vmProxy}}"
                                        Binding="{Binding FromTime, StringFormat=\{0:hh\\:mm\}}"
                                        Header="{Binding Data.FromTimeText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[ToTime], Source={StaticResource vmProxy}}"
                                        Binding="{Binding ToTime, StringFormat=\{0:hh\\:mm\}}"
                                        Header="{Binding Data.ToTimeText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[CustomerName], Source={StaticResource vmProxy}}"
                                        Binding="{Binding CustomerName}"
                                        Header="{Binding Data.CustomerNameText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[PickupAddress], Source={StaticResource vmProxy}}"
                                        Binding="{Binding PickupAddress}"
                                        Header="{Binding Data.PickupAddressText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[DropoffAddress], Source={StaticResource vmProxy}}"
                                        Binding="{Binding DropoffAddress}"
                                        Header="{Binding Data.DropoffAddressText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[SpaceTypeName], Source={StaticResource vmProxy}}"
                                        Binding="{Binding SpaceTypeName}"
                                        Header="{Binding Data.SpaceTypeNameText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[Charge], Source={StaticResource vmProxy}}"
                                        Binding="{Binding Charge}"
                                        Header="{Binding Data.ChargeText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[Paid], Source={StaticResource vmProxy}}"
                                        Binding="{Binding Paid}"
                                        Header="{Binding Data.PaidText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[PickupComment], Source={StaticResource vmProxy}}"
                                        Binding="{Binding PickupComment}"
                                        Header="{Binding Data.PickupCommentText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[DropoffComment], Source={StaticResource vmProxy}}"
                                        Binding="{Binding DropoffComment}"
                                        Header="{Binding Data.DropoffCommentText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[Type], Source={StaticResource vmProxy}}"
                                        Binding="{Binding Type}"
                                        Header="{Binding Data.TypeText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[Pickup], Source={StaticResource vmProxy}}"
                                        Binding="{Binding Pickup}"
                                        Header="{Binding Data.PickupText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[Dropoff], Source={StaticResource vmProxy}}"
                                        Binding="{Binding Dropoff}"
                                        Header="{Binding Data.DropoffText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[PickupPhone], Source={StaticResource vmProxy}}"
                                        Binding="{Binding PickupPhone}"
                                        Header="{Binding Data.PickupPhoneText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[DropoffPhone], Source={StaticResource vmProxy}}"
                                        Binding="{Binding DropoffPhone}"
                                        Header="{Binding Data.DropoffPhoneText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[TripId], Source={StaticResource vmProxy}}"
                                        Binding="{Binding TripId}"
                                        Header="{Binding Data.TripIdText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[Authorization], Source={StaticResource vmProxy}}"
                                        Binding="{Binding Authorization}"
                                        Header="{Binding Data.AuthorizationText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[FundingSourceName], Source={StaticResource vmProxy}}"
                                        Binding="{Binding FundingSourceName}"
                                        Header="{Binding Data.FundingSourceText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[Distance], Source={StaticResource vmProxy}}"
                                        Binding="{Binding Distance}"
                                        Header="{Binding Data.DistanceText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[RunName], Source={StaticResource vmProxy}}"
                                        Binding="{Binding RunName}"
                                        Header="{Binding Data.RunText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[PickupCity], Source={StaticResource vmProxy}}"
                                        Binding="{Binding PickupCity}"
                                        Header="{Binding Data.PickupCityText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[DropoffCity], Source={StaticResource vmProxy}}"
                                        Binding="{Binding DropoffCity}"
                                        Header="{Binding Data.DropoffCityText, Source={StaticResource vmProxy}}"/>

                        <DataGridTextColumn Visibility="{Binding Data.ColumnVisibility[DriverNoShowReason], Source={StaticResource vmProxy}}"
                                        Binding="{Binding DriverNoShowReason}"
                                        Header="{Binding Data.DriverNoShowReasonText, Source={StaticResource vmProxy}}"/>


                </DataGrid.Columns>

                </DataGrid>

                <!-- Footer. The three numbers a dispatcher otherwise counts by scrolling, plus
                     the way to choose which columns are on screen. -->
                <!-- ===== The status bar =====
                     A wash of the theme's purple at 12%, not a filled bar. A saturated fill would
                     have forced every icon on it to white, and the green of Excel and the purple
                     of import are how they are told apart at a glance - the colour IS the label
                     here. A tint keeps dark text and coloured icons both legible, and still gives
                     the bar the body it was missing.

                     The middle is a trial, not a decision: the same express bar that sits above
                     the list, and the same figures that ride the road. Seeing all of it at once is
                     the only way to judge where each belongs. Recommendation and reasoning are in
                     the slice note. -->
                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource MainBorderBrush}"
                        Background="#1F673AB7" Padding="8,4,8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentControl Style="{StaticResource NumberPlate}"
                                            Tag="{Binding PlateTripsCount}" Content="{Binding PlateTripsLabel}" />
                            <ContentControl Style="{StaticResource NumberPlate}"
                                            Tag="{Binding PlateCanceledCount}" Content="{Binding PlateCanceledLabel}" />
                            <ContentControl Style="{StaticResource NumberPlate}"
                                            Tag="{Binding PlateNoRunCount}" Content="{Binding PlateNoRunLabel}" />
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="16,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentControl Grid.Column="0" Content="{Binding}"
                                            ContentTemplate="{StaticResource ExpressFilterBar}" />

                            <!-- The same plate as the one on the road, deliberately identical, so
                                 the two candidates are being compared and not two designs. -->
                            <Border Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Height="18" CornerRadius="9" Padding="12,0,12,0"
                                    Background="{DynamicResource MaterialDesign.Brush.Primary}">
                                <TextBlock Text="{Binding DividerSummary}" VerticalAlignment="Center"
                                           Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Margin="0,0,8,0"
                                          IsChecked="{Binding IsCompactGrid}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          ToolTip="{Binding CompactGridToolTip}"/>

                            <Button Style="{StaticResource TripActionButtonStyle}"
                                    Command="{Binding ChooseColumnsCommand}"
                                    ToolTip="{Binding ChooseColumnsToolTip}" Padding="4,0,4,0">
                                <materialDesign:PackIcon Kind="ViewColumnOutline" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <Border Background="#80FFFFFF" 
                    Visibility="{Binding IsLoadingTrips, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                         Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Width="50" Height="50" />
                        <TextBlock Text="{Binding LoadingTripsLabel}"
                       Margin="0,15,0,0"
                       FontSize="16"
                       FontWeight="Bold" />
                    </StackPanel>
                </Border>

            </Grid>



        <!--<DataGrid Grid.Row="2" x:Name="GridRow2"
                          ItemsSource="{Binding TripsByDate}" 
                          SelectedItem="{Binding SelectedTrip, Mode=TwoWay}"
                          AutoGenerateColumns="false" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Day" Binding="{Binding Day}"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}"/>
                    <DataGridTextColumn Header="From Time" Binding="{Binding FromTime}"/>
                    <DataGridTextColumn Header="To Time" Binding="{Binding ToTime}"/>
                    <DataGridTextColumn Header="Patient" Binding="{Binding CustomerName}"/>
                    <DataGridTextColumn Header="Pickup Address" Binding="{Binding PickupAddress}"/>
                    <DataGridTextColumn Header="Dropoff Address" Binding="{Binding DropoffAddress}"/>
                    <DataGridTextColumn Header="{Binding Data.SpaceTypeNameText, Source={StaticResource vmProxy}}" Binding="{Binding SpaceTypeName}"/>
                    <DataGridTextColumn Header="Charge" Binding="{Binding Charge}"/>
                    <DataGridTextColumn Header="Paid" Binding="{Binding Paid}"/>
                    <DataGridTextColumn Header="Pickup Comment" Binding="{Binding PickupComment}"/>
                </DataGrid.Columns>
            </DataGrid>-->


                <!-- Sección de Importación de Viajes (Diseño Mejorado) -->
                <Grid Grid.Row="0" Grid.RowSpan="3" x:Name="ImportTripsGridRow"
                      Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}"
                      Background="{DynamicResource MaterialDesignPaper}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Encabezado con botón de Volver -->
                    <materialDesign:ColorZone Mode="PrimaryMid" Padding="16" materialDesign:ElevationAssist.Elevation="Dp3">
                        <DockPanel>
                            <Button  
                    Foreground="White"
                    Click="BackToHome_Click"
                    ToolTip="{Binding BackToHomeLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BackToHomeLabel}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="DatabaseImport" Width="24" Height="24" />
                                <TextBlock Text="{Binding ImportHeaderLabel}" Margin="12,0,0,0" Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                            </StackPanel>
                        </DockPanel>
                    </materialDesign:ColorZone>

                    <!-- Contenido Principal -->
                    <Grid Grid.Row="1" Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- Tarjeta de Configuración -->
                            <RowDefinition Height="*" />
                            <!-- Tarjeta del Grid -->
                        </Grid.RowDefinitions>

                        <!-- PASO 1: Selección de Fuente y Archivo -->
                        <materialDesign:Card Padding="16" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="FundingSourceImportComboBox"
                          Grid.Column="0"
                          ItemsSource="{Binding FundingSources}" 
                          SelectedItem="{Binding SelectedFundingSourceImport, Mode=TwoWay}" 
                          DisplayMemberPath="Name" 
                          SelectedValuePath="Id"
                          materialDesign:HintAssist.Hint="Seleccionar Funding Source"
                          materialDesign:TextFieldAssist.HasLeadingIcon="True"
                          materialDesign:TextFieldAssist.LeadingIcon="Finance"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,16,0" />

                                <Button x:Name="SelectCsvButton"
                        Grid.Column="1"
                        Height="50"
                        Click="SelectCsv_Click" 
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="5">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileCsv" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SelectCsvButtonContent}" />
                                    </StackPanel>
                                </Button>

                                <!-- Panel de Progreso -->
                                <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center" MinWidth="250">
                                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                                        <TextBlock x:Name="ProgressText" 
                                   Text="{Binding ProgressPanelText}" 
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                   HorizontalAlignment="Center" />
                                        <ProgressBar x:Name="ImportProgressBar" 
                                     Height="10" 
                                     IsIndeterminate="False" 
                                     />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <!-- PASO 2: Vista previa de datos -->
                        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Background="{DynamicResource MaterialDesignDivider}" Padding="12,8">
                                    <TextBlock Text="{Binding ImportResultsLabel}" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Opacity="0.6" />
                                </Border>

                                <DataGrid Grid.Row="1"
                          x:Name="PreviewGrid" 
                          AutoGenerateColumns="True" 
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource MaterialDesignDataGrid}">
                                </DataGrid>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </Grid>

                <!-- Import Trips-->
                <!--<Grid Grid.Row="0" x:Name="ImportTripsGridRow" Visibility="Collapsed" Margin="10">
                    <StackPanel>
                        <Button Content="{Binding SelectCsvButtonContent}" Click="SelectCsv_Click" Margin="0 0 0 10"/>
                        <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="True" Height="350"/>
                    </StackPanel>
                </Grid>-->
        
            



                <!-- ================= Floating helpers =================
                     The step guide and the patient's state used to be two rows inside the form.
                     They pushed the save button under the horizontal splitter, because the three
                     zones of this tab are sized against each other and every row taken is a row
                     the form no longer has.

                     They float instead, and the dispatcher drags them wherever they are least in
                     the way; where they end up is remembered. Popups rather than panels for the
                     same reason the filter panel is one: MapaWebView is an HWND and nothing WPF
                     draws over it inside the same window. -->

                <Popup IsOpen="{Binding IsStepsCardOpen, Mode=OneWay}"
                       PlacementTarget="{Binding ElementName=HomeRoot}" Placement="Relative"
                       HorizontalOffset="{Binding StepsCardX, Mode=OneWay}"
                       VerticalOffset="{Binding StepsCardY, Mode=OneWay}"
                       AllowsTransparency="True" StaysOpen="True">
                    <materialDesign:Card Margin="4" materialDesign:ElevationAssist.Elevation="Dp4" Width="210">
                        <StackPanel>
                            <Border Tag="steps" Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Padding="8,3,4,3" Cursor="SizeAll"
                                    MouseLeftButtonDown="HelperCard_DragStart"
                                    MouseMove="HelperCard_Drag"
                                    MouseLeftButtonUp="HelperCard_DragEnd">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Padding="1" Foreground="White"
                                            Style="{StaticResource MaterialDesignToolButton}"
                                            Command="{Binding HideHelperCardsCommand}">
                                        <materialDesign:PackIcon Kind="Close" Width="13" Height="13"/>
                                    </Button>
                                    <TextBlock Text="{Binding StepsCardTitle}" Foreground="White"
                                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <StackPanel Margin="8,6,8,8">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step1State}">
                                        <TextBlock Text="1" Style="{StaticResource StepBadgeTextStyle}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Step1Label}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step2State}">
                                        <TextBlock Text="2" Style="{StaticResource StepBadgeTextStyle}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Step2Label}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step3State}">
                                        <TextBlock Text="3" Style="{StaticResource StepBadgeTextStyle}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Step3Label}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step4State}">
                                        <TextBlock Text="4" Style="{StaticResource StepBadgeTextStyle}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Step4Label}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>

                                <Separator Margin="0,6,0,4"/>
                                <TextBlock Text="{Binding CreateTripHint}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Popup>

                <Popup IsOpen="{Binding IsPatientCardOpen, Mode=OneWay}"
                       PlacementTarget="{Binding ElementName=HomeRoot}" Placement="Relative"
                       HorizontalOffset="{Binding PatientCardX, Mode=OneWay}"
                       VerticalOffset="{Binding PatientCardY, Mode=OneWay}"
                       AllowsTransparency="True" StaysOpen="True">
                    <materialDesign:Card Margin="4" materialDesign:ElevationAssist.Elevation="Dp4" Width="240">
                        <StackPanel>
                            <Border Tag="patient" Padding="8,3,4,3" Cursor="SizeAll"
                                    MouseLeftButtonDown="HelperCard_DragStart"
                                    MouseMove="HelperCard_Drag"
                                    MouseLeftButtonUp="HelperCard_DragEnd">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#9E9E9E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CustomerStateTag}" Value="unsaved">
                                                <Setter Property="Background" Value="#E65100"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Padding="1" Foreground="White"
                                            Style="{StaticResource MaterialDesignToolButton}"
                                            Command="{Binding HideHelperCardsCommand}">
                                        <materialDesign:PackIcon Kind="Close" Width="13" Height="13"/>
                                    </Button>
                                    <TextBlock Text="{Binding CustomerStateLabel}" Foreground="White"
                                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>

                            <StackPanel Margin="8,6,8,8">
                                <TextBlock Text="{Binding CustomerValidationMessage}" FontSize="11" Foreground="#C62828"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding CustomerValidationMessage, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding DuplicateCustomerWarning}" FontSize="11" Foreground="#E65100"
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding DuplicateCustomerWarning, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                <Button Content="{Binding DiscardChangesLabel}" HorizontalAlignment="Left"
                                        Command="{Binding DiscardCustomerChangesCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}" FontSize="11" Padding="0,2,0,2"
                                        Visibility="{Binding HasCustomerChanges, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Popup>

                <!-- ================= The first-run tour (2.2c) =================
                     Four balloons, each anchored to the control its step is about. They read the
                     same TripCreationStep as the badges and the stepper and decide nothing of
                     their own, so any of the three can be switched off later without touching
                     logic. It runs by itself exactly once; after that it is the ? button.
                -->
                <!-- Balloon 1 -->
                <Popup IsOpen="{Binding IsTourStep1, Mode=OneWay}" PlacementTarget="{Binding ElementName=CustomersAutoSuggestBox}"
                       Placement="Bottom" AllowsTransparency="True" StaysOpen="True">
                    <materialDesign:Card Margin="6" Padding="12" MaxWidth="320"
                                         materialDesign:ElevationAssist.Elevation="Dp5">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Style="{StaticResource StepBadgeStyle}" Tag="current">
                                    <TextBlock Text="1" Style="{StaticResource StepBadgeTextStyle}"/>
                                </Border>
                                <TextBlock Text="{Binding Step1Label}" FontWeight="Bold" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TourBody1}" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding TourNextLabel}"
                                        Command="{Binding NextTourStepCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                                <Button HorizontalAlignment="Left" Content="✕"
                                        Command="{Binding EndTourCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"/>
                            </DockPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Popup>

                <!-- Balloon 2 -->
                <Popup IsOpen="{Binding IsTourStep2, Mode=OneWay}" PlacementTarget="{Binding ElementName=DropoffAddressTextBox}"
                       Placement="Right" AllowsTransparency="True" StaysOpen="True">
                    <materialDesign:Card Margin="6" Padding="12" MaxWidth="320"
                                         materialDesign:ElevationAssist.Elevation="Dp5">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Style="{StaticResource StepBadgeStyle}" Tag="current">
                                    <TextBlock Text="2" Style="{StaticResource StepBadgeTextStyle}"/>
                                </Border>
                                <TextBlock Text="{Binding Step2Label}" FontWeight="Bold" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TourBody2}" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding TourNextLabel}"
                                        Command="{Binding NextTourStepCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                                <Button HorizontalAlignment="Left" Content="✕"
                                        Command="{Binding EndTourCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"/>
                            </DockPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Popup>

                <!-- Balloon 3 -->
                <Popup IsOpen="{Binding IsTourStep3, Mode=OneWay}" PlacementTarget="{Binding ElementName=PickupTimePicker}"
                       Placement="Right" AllowsTransparency="True" StaysOpen="True">
                    <materialDesign:Card Margin="6" Padding="12" MaxWidth="320"
                                         materialDesign:ElevationAssist.Elevation="Dp5">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Style="{StaticResource StepBadgeStyle}" Tag="current">
                                    <TextBlock Text="3" Style="{StaticResource StepBadgeTextStyle}"/>
                                </Border>
                                <TextBlock Text="{Binding Step3Label}" FontWeight="Bold" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TourBody3}" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding TourNextLabel}"
                                        Command="{Binding NextTourStepCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                                <Button HorizontalAlignment="Left" Content="✕"
                                        Command="{Binding EndTourCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"/>
                            </DockPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Popup>

                <!-- Balloon 4 -->
                <Popup IsOpen="{Binding IsTourStep4, Mode=OneWay}" PlacementTarget="{Binding ElementName=SaveTab1FloatingButton}"
                       Placement="Top" AllowsTransparency="True" StaysOpen="True">
                    <materialDesign:Card Margin="6" Padding="12" MaxWidth="320"
                                         materialDesign:ElevationAssist.Elevation="Dp5">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Style="{StaticResource StepBadgeStyle}" Tag="current">
                                    <TextBlock Text="4" Style="{StaticResource StepBadgeTextStyle}"/>
                                </Border>
                                <TextBlock Text="{Binding Step4Label}" FontWeight="Bold" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TourBody4}" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding TourDoneLabel}"
                                        Command="{Binding EndTourCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                                <Button HorizontalAlignment="Left" Content="✕"
                                        Command="{Binding EndTourCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"/>
                            </DockPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Popup>

                <!-- ================= Complex filters (2.4) =================
                     It slides over the grid instead of pushing it aside: the list stays visible
                     and refilters as the ticks change, which is the only way to see whether a
                     filter did what you meant. Clicking anywhere outside closes it, and so does
                     Esc — see HomeView_PreviewKeyDown. -->
                <!-- ⚠️ A Popup, not a panel inside the layout, and that is the whole point.
                     MapaWebView is a WebView2: an HWND hosted inside WPF, which Windows always
                     draws on top of WPF content in the same window whatever the z-order says.
                     A Border laid over the map was simply not visible where it crossed it. A
                     Popup gets a top-level window of its own, so it draws above the map.

                     StaysOpen=False is what closes it on a click outside; IsOpen binds two ways
                     so that closing itself is reported back. Esc is handled in the code-behind,
                     which still sees the key because a Popup's content stays in the logical tree. -->
                <Popup IsOpen="{Binding IsFilterPanelOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=HomeRoot}"
                       Placement="Right" HorizontalOffset="-380"
                       StaysOpen="False" AllowsTransparency="True" Focusable="True">
                    <Border Width="380"
                            Height="{Binding ActualHeight, ElementName=HomeRoot}"
                            Background="{DynamicResource MaterialDesignPaper}"
                            BorderBrush="{StaticResource MainBorderBrush}" BorderThickness="1,0,0,0"
                            materialDesign:ElevationAssist.Elevation="Dp4">

                        <DockPanel>

                            <!-- Header: how much is getting through, and the way out of all of it -->
                            <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryMid" Padding="14,10,8,10"
                                                      materialDesign:ElevationAssist.Elevation="Dp2">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignToolForegroundButton}"
                                            Command="{Binding CloseFilterPanelCommand}" Padding="2"
                                            VerticalAlignment="Top">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="FilterVariant"
                                                             Width="22" Height="22" Margin="0,1,10,0"
                                                             VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FiltersHeader}" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="{Binding GridSummary}" FontSize="11" Opacity=".85" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </materialDesign:ColorZone>

                            <!-- Footer: clear everything, and keep this set under a name -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,0"
                                        Background="{DynamicResource MaterialDesignPaper}">
                                <Separator Margin="0" Opacity=".5"/>
                                <StackPanel Margin="12,10,12,12">
                                <Button Content="{Binding ClearAllFiltersLabel}"
                                        Command="{Binding Filters.ClearAllCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,10" Height="30" FontSize="12"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{Binding SaveViewLabel}"
                                            Command="{Binding Filters.SaveViewCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}" FontSize="12"/>
                                    <TextBox Text="{Binding Filters.NewViewName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="{Binding MyFiltersHint}" FontSize="12"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Filters.SavedViews}" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Margin="0,0,4,4" Padding="8,1,2,1"
                                                    Background="{DynamicResource MaterialDesignChipBackground}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{Binding}" Padding="0"
                                                            Style="{StaticResource MaterialDesignToolButton}"
                                                            Command="{Binding DataContext.Filters.ApplyViewCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource MaterialDesignToolButton}" Padding="2"
                                                            Command="{Binding DataContext.Filters.DeleteViewCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Close" Width="12" Height="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Tinted a few percent so the section cards read as sitting on a
                                 surface rather than floating on the same sheet they are drawn on. -->
                            <Border Background="#0A000000">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10,12,4">
                                    <StackPanel>
                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="True" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Wheelchair" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding SpaceTypeFilterText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Filters.SpaceTypes}" Margin="26,2,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                                                  Style="{StaticResource FilterOptionCheckBox}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CashMultiple" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding FundingSourceText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Filters.FundingSources}" Margin="26,2,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                                                  Style="{StaticResource FilterOptionCheckBox}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FlagVariant" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding StatusFilterText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Filters.Statuses}" Margin="26,2,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                                                  Style="{StaticResource FilterOptionCheckBox}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="SwapHorizontal" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding TypeText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Filters.Types}" Margin="26,2,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                                                  Style="{StaticResource FilterOptionCheckBox}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CityVariantOutline" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding CitiesFilterText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Margin="26,2,0,4">
                                                <TextBlock Text="{Binding CityScopeText}" Style="{StaticResource FilterSubLabel}" Margin="0,0,0,3"/>
                                                <UniformGrid Columns="3" Margin="0,0,0,4">
                                                    <RadioButton Content="{Binding ScopeBothText}" GroupName="CityScope" FontSize="11"
                                                                 IsChecked="{Binding Filters.CityScope, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Both}"/>
                                                    <RadioButton Content="{Binding PickupText}" GroupName="CityScope" FontSize="11"
                                                                 IsChecked="{Binding Filters.CityScope, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Pickup}"/>
                                                    <RadioButton Content="{Binding DropoffText}" GroupName="CityScope" FontSize="11"
                                                                 IsChecked="{Binding Filters.CityScope, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Dropoff}"/>
                                                </UniformGrid>
                                                <Separator Margin="0,2,0,4" Opacity=".4"/>
                                                <ItemsControl ItemsSource="{Binding Filters.Cities}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                                                      Style="{StaticResource FilterOptionCheckBox}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ClockOutline" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding PickupWindowText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Margin="26,4,0,4">
                                                <materialDesign:TimePicker Is24Hours="True" FontSize="12"
                                                    SelectedTime="{Binding Filters.PickupFrom, Converter={StaticResource TimeSpanToDateConverter}, Mode=TwoWay}"
                                                    materialDesign:HintAssist.Hint="{Binding FromTimeText}"/>
                                                <materialDesign:TimePicker Is24Hours="True" Margin="0,10,0,0" FontSize="12"
                                                    SelectedTime="{Binding Filters.PickupTo, Converter={StaticResource TimeSpanToDateConverter}, Mode=TwoWay}"
                                                    materialDesign:HintAssist.Hint="{Binding ToTimeText}"/>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="True" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="TuneVariant" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding OtherFiltersText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Margin="26,2,0,4">
                                                <TextBlock Text="{Binding WillCallLabel}" Style="{StaticResource FilterSubLabel}"/>
                                                <UniformGrid Columns="3">
                                                    <RadioButton Content="{Binding FlagAnyText}" GroupName="WillCallFilter" FontSize="11"
                                                                 IsChecked="{Binding Filters.WillCall, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Any}"/>
                                                    <RadioButton Content="{Binding FlagYesText}" GroupName="WillCallFilter" FontSize="11"
                                                                 IsChecked="{Binding Filters.WillCall, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Yes}"/>
                                                    <RadioButton Content="{Binding FlagNoText}" GroupName="WillCallFilter" FontSize="11"
                                                                 IsChecked="{Binding Filters.WillCall, Converter={StaticResource EnumMatchConverter}, ConverterParameter=No}"/>
                                                </UniformGrid>

                                                <TextBlock Text="{Binding RunText}" Style="{StaticResource FilterSubLabel}"/>
                                                <UniformGrid Columns="3">
                                                    <RadioButton Content="{Binding FlagAnyText}" GroupName="RunFilter" FontSize="11"
                                                                 IsChecked="{Binding Filters.HasRoute, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Any}"/>
                                                    <RadioButton Content="{Binding FlagYesText}" GroupName="RunFilter" FontSize="11"
                                                                 IsChecked="{Binding Filters.HasRoute, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Yes}"/>
                                                    <RadioButton Content="{Binding FlagNoText}" GroupName="RunFilter" FontSize="11"
                                                                 IsChecked="{Binding Filters.HasRoute, Converter={StaticResource EnumMatchConverter}, ConverterParameter=No}"/>
                                                </UniformGrid>

                                                <Separator Margin="0,8,0,4" Opacity=".4"/>
                                                <CheckBox IsChecked="{Binding Filters.OnlyMissingCoordinates}"
                                                          Content="{Binding MissingCoordinatesText}"
                                                          Style="{StaticResource FilterOptionCheckBox}"/>
                                                <TextBlock Text="{Binding MissingCoordinatesHint}" FontSize="10" Opacity=".7"
                                                           TextWrapping="Wrap" Margin="26,0,0,0"/>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="MapMarkerOutline" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding ZipStateText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Margin="26,4,0,4">
                                                <TextBlock Text="{Binding ZipStateWarning}" FontSize="10" Opacity=".7"
                                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <TextBox Text="{Binding Filters.Zip, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                         materialDesign:HintAssist.Hint="{Binding ZipHint}" FontSize="12"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                <TextBox Margin="0,10,0,0"
                                                         Text="{Binding Filters.State, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                         materialDesign:HintAssist.Hint="{Binding StateHint}" FontSize="12"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Border>
                </Popup>

            </Grid>

        </Border>

    </materialDesign:DialogHost>
    
</UserControl>

<UserControl x:Class="Raphael.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Raphael.Desktop.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"  
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/shared"
             xmlns:domain="clr-namespace:Raphael.Desktop.Validations"
             xmlns:vm="clr-namespace:Raphael.Desktop.ViewModels"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers" 
             xmlns:converters="clr-namespace:Raphael.Desktop.Converters"
             helpers:HelpAssist.TopicId="desktop/home/overview"
             PreviewKeyDown="HomeView_PreviewKeyDown"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    
    
    <UserControl.Resources>
        <!-- vmProxy “captures” the current DataContext (HomeViewModel) -->
        <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <converters:EnumMatchConverter x:Key="EnumMatchConverter" />
        <converters:TimeSpanToDateConverter x:Key="TimeSpanToDateConverter" />
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter" />
        <helpers:MinutesToTimeStringConverter x:Key="MinutesConverter" />
        <converters:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter" />

        <!--
            ⚠️ The stripe is a trigger here and NOT the DataGrid's AlternatingRowBackground.
            That property is applied by coercion and beats both setters and triggers, which in
            RE-008 left one row in every two with no status colour at all. Everything that paints
            a row has to come from this one style, in order, or half the rows lie.
        -->
        <!--
            The numbered badge over each key control. Its whole state is one string from the
            ViewModel — "done", "current" or "pending" — so the badges, the stepper and the tour
            cannot disagree with each other about where the dispatcher is.

            The pulse animates the badge's own Opacity, which is why it is allowed to live inside
            a Style at all: a Storyboard declared here cannot name another element.
        -->
        <!-- ===== The filter panel's furniture =====
             The sections used to be bare Expanders on a flat sheet: nothing told the eye where one
             filter ended and the next began, so a panel with eight of them read as one long list
             of controls floating in space. Each section is a card now — its own surface, its own
             hairline, its own breathing room — and the body behind them is tinted a few percent
             darker so the cards sit ON something instead of in the air. -->
        <Style x:Key="FilterSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10,2,10,6" />
        </Style>

        <Style x:Key="FilterSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="FilterSectionIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
        </Style>

        <Style x:Key="FilterOptionCheckBox" TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FilterSubLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value=".7" />
            <Setter Property="Margin" Value="0,6,0,3" />
        </Style>

        <Style x:Key="StepBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#BDBDBD" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="done">
                    <Setter Property="Background" Value="#2E7D32" />
                </Trigger>
                <Trigger Property="Tag" Value="current">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="StepPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.4" Duration="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="StepPulse" />
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HomeTripRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="{StaticResource EvenRowBackgroundBrush}"/>
            <Style.Triggers>

                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="White" />
                </Trigger>

                <!-- Status is said in the TEXT, never in the row's background. Two rules already
                     carry it: red type when a driver reported a no-show, grey italic when the
                     office cancelled. A tint on top of that says the same thing a third time and
                     costs the alternating banding - the plain white every other row - which is
                     what lets the eye track one trip across twenty columns.

                     The alternation trigger above is therefore the only thing that paints an
                     unselected row. Hover and selection come after it and win, which is the whole
                     point of the ordering. -->

                <DataTrigger Binding="{Binding Status}" Value="Canceled">
                    <Setter Property="Foreground" Value="Red" />
                    <Setter Property="ToolTip" Value="{Binding Data.CanceledByDriverToolTip, Source={StaticResource vmProxy}}" />
                </DataTrigger>

                <!-- ⚠️ Hover and selection have to be declared here, not left to the row
                     template. The Background setter at the top of this style is a style value
                     and beats a template trigger, which is exactly why the Schedule grid's
                     selection was invisible until it was moved here. Same brushes, on purpose:
                     the two grids show the same kind of row and must read the same. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverTripRowBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedTripRowBrush}" />
                    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                </Trigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Canceled" />
                        <Condition Binding="{Binding DriverNoShowReason, TargetNullValue={x:Null}}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="Gray" />
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="ToolTip" Value="{Binding Data.CanceledByOfficeToolTip, Source={StaticResource vmProxy}}" />
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Canceled" />
                        <Condition Binding="{Binding DriverNoShowReason}" Value="" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="Gray" />
                    <Setter Property="ToolTip" Value="{Binding Data.CanceledByOfficeToolTip, Source={StaticResource vmProxy}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        
    </UserControl.Resources>

    <materialDesign:DialogHost x:Name="RootDialogHost" Identifier="RootDialogHost">
        
    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource MainBorderBrush}">

            <Grid x:Name="HomeRoot" Margin="5" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TopRow" Height="4.5*" /> <!-- 45% Upper area -->
                    <RowDefinition Height="18" />  <!-- Horizontal GridSplitter, and the day's figures -->
                    <RowDefinition x:Name="BottomRow" Height="5.5*" /> <!-- 55% Lower area (DataGrid) -->
                </Grid.RowDefinitions>

                <!-- Top row: Client, Billing, Splitter, Map -->
                <Grid Grid.Row="0" x:Name="GridRow0"
                      Visibility="{Binding IsImporting, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="CustomerColumn" Width="1*" />  <!-- Customer and Trip data area (initially hidden) -->
                        <ColumnDefinition Width="12" />    <!-- Vertical GridSplitter: the rings -->
                        <ColumnDefinition x:Name="BillingColumn" Width="0" />  <!-- Billing (initially hidden) -->
                        <ColumnDefinition Width="12" />    <!-- Vertical GridSplitter: the seam -->
                        <ColumnDefinition x:Name="MapColumn" Width="2*" />    <!-- Map -->
                    </Grid.ColumnDefinitions>

                    <!-- Customer data area -->
                <Grid Grid.Column="0"  Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>

                        <!-- 👤 Customer Search & Info -->

                        <StackPanel Grid.Row="0" Background="Transparent">

                            <!-- 🔎 Customer Search Section -->

                            <StackPanel Margin="2" Background="Transparent">

                                <materialDesign:ColorZone Padding="10,3,10,3" Mode="PrimaryMid"
                                                          materialDesign:ElevationAssist.Elevation="Dp1"
                                                          ClipToBounds="False"
                                                          CornerRadius="5">

                                    <!-- ⚠️ A Grid, not a DockPanel wrapped round one long
                                         StackPanel. Neither of those makes anything give way: a
                                         StackPanel hands every child the width it asks for and
                                         lets the row run off the end, which is why new patient was
                                         drawn half off and the three buttons after it were nowhere
                                         at all. Everything is packed left in Auto columns and the
                                         slack sits in the last one, so the buttons follow the
                                         search box instead of being pushed to the far edge. -->
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- (1) Who is travelling. The number goes on the control
                                             it names, which costs no layout at all — it was the
                                             ROW of numbers that had to go, not the numbers. -->
                                        <Border Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step1State}">
                                            <TextBlock Text="1" Style="{StaticResource StepBadgeTextStyle}"/>
                                        </Border>

                                                <StackPanel Grid.Column="1" materialDesign:RippleAssist.IsCentered="True"
                                                            Orientation="Horizontal">

                                                    <TextBlock 
                                                        Text="{Binding SearchPassengerByLabel}"
                                                        VerticalAlignment="Center">
                                                    
                                                    </TextBlock>

                                                    <materialDesign:ColorZone Margin="5,2,0,2"
                                                                            Padding="8,4,8,4"
                                                                            Panel.ZIndex="1"
                                                                            materialDesign:ElevationAssist.Elevation="Dp2"
                                                                            CornerRadius="2"
                                                                            Mode="Standard" Cursor="">        

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Button Style="{StaticResource MaterialDesignToolButton}">
                                                                <materialDesign:PackIcon Kind="Search" Opacity=".56" />
                                                            </Button>

                                                            <!-- AutoSuggestBox -->
                                                            <materialDesign:AutoSuggestBox
                                                                x:Name="CustomersAutoSuggestBox"
                                                                Grid.Column="1"
                                                                MinWidth="150"            
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0"
                                                                materialDesign:TextFieldAssist.HasClearButton="True"
                                                                materialDesign:HintAssist.Hint="{Binding AutoSuggestBoxHint}"
                                                                Suggestions="{Binding FilteredCustomers}"
                                                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                    
    
                                                                ValueMember="Id"
                                                                SuggestionChosen="CustomersAutoSuggestBox_SuggestionChosen" TextChanged="CustomersAutoSuggestBox_TextChanged">

                                                                <materialDesign:AutoSuggestBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border  BorderThickness="0,0,0,1"
                                                                                BorderBrush="#bbdefb"
                                                                   
                                                                                HorizontalAlignment="Stretch"
                                                                                VerticalAlignment="Stretch">
                                                                            <StackPanel Orientation="Vertical">
                                                                                <TextBlock FontWeight="Bold" Text="{Binding FullName}"/>
                                                                                <TextBlock Margin="5 0 0 0" Text="{Binding Address}"/>
                                                                                <StackPanel Margin="5 0 0 0" Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding PhoneTextBoxHint}" Margin="0 0 8 0" FontWeight="Bold"/>
                                                                                    <TextBlock Text="{Binding Phone}"/>
                                                                                </StackPanel>
                                                                                <StackPanel Margin="5 0 0 0" Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding ClientCodeTextBoxHint}" Margin="0 0 8 0" FontWeight="Bold"/>
                                                                                    <TextBlock Text="{Binding ClientCode}"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </materialDesign:AutoSuggestBox.ItemTemplate>
                                                            </materialDesign:AutoSuggestBox>

                                                            <Button 
                                                                Grid.Column="2"
                                                                Style="{StaticResource MaterialDesignToolButton}">
                                                            
                                                                <materialDesign:PackIcon
                                                                    Margin="8,0,0,0"
                                                                    Kind="Microphone"
                                                                    Opacity=".56" />
                                                            </Button>

                                                        </Grid>
                                                    </materialDesign:ColorZone>
                                                </StackPanel>

                                                <!-- The buttons follow the search box.
                                                     The 50px gap was doing nothing but
                                                     pushing the last three off the row. -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center">

                                                <Button Padding="3,0,3,0"
                                                    Margin="2,0,0,0"
                                                
                                                    ToolTip="{Binding SaveCustomerToolTip}"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                    Command="{Binding SaveCustomerCommand}" Click="OnSaveCustomerClick">

                                                    <materialDesign:PackIcon Kind="ContentSave" Width="21" Height="21" />
                                                </Button>

                                            <Button Padding="3,0,3,0"
                                                    Margin="2,0,0,0"
                                                
                                                    ToolTip="{Binding NewCustomerToolTip}"
                                                    Visibility="{Binding CanStartNewPatient, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                    Command="{Binding NewCustomerCommand}" Click="OnNewCustomerClick">

                                                <materialDesign:PackIcon Kind="AccountMultiplePlus" Width="21" Height="21"/>
                                            </Button>

                                            <!-- The way out of the trip form. -->
                                            <Button Padding="3,0,3,0" Margin="2,0,0,0"
                                                    ToolTip="{Binding CloseTripFormToolTip}"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                    Click="CloseTripForm_Click"
                                                    Visibility="{Binding IsTripFormOpen, Converter={StaticResource BoolToVisibility}}">
                                                <materialDesign:PackIcon Kind="Close" Width="21" Height="21"/>
                                            </Button>

                                            <!-- ⚠️ In the row, not docked to its right edge. A
                                                 DockPanel hands its docked children their edge
                                                 first and lets the LAST child fill what is left;
                                                 that last child is this StackPanel, which is
                                                 wider than what remained, so save and new patient
                                                 simply ran underneath these three. -->
                                            <Button Padding="3,0,3,0" Margin="2,0,0,0"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                    Command="{Binding StartTourCommand}"
                                                    ToolTip="{Binding TourHelpToolTip}">
                                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="21" Height="21"/>
                                            </Button>

                                            <Button Padding="3,0,3,0" Margin="2,0,0,0"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                    Command="{Binding ToggleHelperCardsCommand}"
                                                    ToolTip="{Binding HelperCardsToolTip}">
                                                <materialDesign:PackIcon Kind="InformationOutline" Width="21" Height="21"/>
                                            </Button>


                                        </StackPanel>
                                    </Grid>
                                </materialDesign:ColorZone>

                            </StackPanel>


                            <!-- 🧾 Customer Info Section -->
                            <!-- <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0">-->                        
                        
                            <StackPanel Margin="2"
                                    Orientation="Vertical" 
                                    Background="{DynamicResource MaterialDesignPaper}" >

                        
                                    <materialDesign:Card Padding="4" Background="{DynamicResource MaterialDesignCardBackground}">
                                        <StackPanel>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Column -->
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="FullNameTextBox"
                                                             Text="{Binding SelectedCustomer.FullName}"
                                                             materialDesign:TextFieldAssist.HasClearButton="True"
                                                     
                                                             materialDesign:HintAssist.Hint="{Binding FullNameTextBoxHint}"
                                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                             materialDesign:TextFieldAssist.LeadingIcon="TextUser"
                                                             Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2">

                                                    <!--<TextBox.Text>
                                                        <Binding Path="SelectedCustomer.FullName" UpdateSourceTrigger="PropertyChanged">
                                                            <Binding.ValidationRules>
                                                                <domain:NotEmptyValidationRule ValidatesOnTargetUpdated="True"/>      
                                                            </Binding.ValidationRules>
                                                        </Binding>
                                                    </TextBox.Text>-->
                                                        
                                                    </TextBox>
                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="ClientCodeTextBox"
                                                             Text="{Binding SelectedCustomer.ClientCode}" 
                                                             materialDesign:HintAssist.Hint="{Binding ClientCodeTextBoxHint}" 
                                                             materialDesign:TextFieldAssist.HasClearButton="True"
                                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                             materialDesign:TextFieldAssist.LeadingIcon="Barcode"
                                                             Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>
                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="PhoneTextBox"
                                                                Text="{Binding SelectedCustomer.Phone}" 
                                                                 materialDesign:HintAssist.Hint="{Binding PhoneTextBoxHint}" 
                                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                 materialDesign:TextFieldAssist.LeadingIcon="Phone"
                                                                 Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>
                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="MobilePhoneTextBox"
                                                                Text="{Binding SelectedCustomer.MobilePhone}" 
                                                                 materialDesign:HintAssist.Hint="{Binding MobilePhoneTextBoxHint}" 
                                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                 materialDesign:TextFieldAssist.LeadingIcon="MobilePhone"
                                                                 Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>

                                                    <ComboBox   x:Name="SpaceTypeComboBox"
                                                                ItemsSource="{Binding SpaceTypes}" 
                                                                SelectedItem="{Binding SelectedSpaceType, Mode=TwoWay}" 
                                                                DisplayMemberPath="ShowNameDescription" 
                                                                SelectedValuePath="Id"
                                                                Style="{StaticResource MaterialDesignFilledComboBox}"
                                                                materialDesign:TextFieldAssist.HasClearButton="True"
                                                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                materialDesign:TextFieldAssist.LeadingIcon="HumanWheelchair"
                                                                Margin="0,0,0,2"
                                                                materialDesign:HintAssist.Hint="{Binding SpaceTypeComboBoxHint}" />

                                                    <ComboBox x:Name="FundingSourceComboBox"
                                                            ItemsSource="{Binding FundingSources}" 
                                                            SelectedItem="{Binding SelectedFundingSource, Mode=TwoWay}" 
                                                            DisplayMemberPath="Name" 
                                                            SelectedValuePath="Id"
                                                            Style="{StaticResource MaterialDesignFilledComboBox}"
                                                            materialDesign:TextFieldAssist.HasClearButton="True"
                                                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                            materialDesign:TextFieldAssist.LeadingIcon="Finance"
                                                            Margin="0,0,0,2"
                                                            materialDesign:HintAssist.Hint="{Binding FundingSourceComboBoxHint}" />

                                                </StackPanel>

                                                <!-- Right Column -->
                                                <StackPanel Grid.Column="1">

                                                    <Grid>
                                                        
                                                        <Button x:Name="GeolocateFloatingButton" Width="30" Height="30"
                                                                Panel.ZIndex="100"
                                                                Margin="8,6,16,-20"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                ToolTip="{Binding GeolocateFloatingButtonToolTip}"
                                                                Style="{StaticResource MaterialDesignFloatingActionMiniButton}" MouseEnter="GeolocateFloatingButton_MouseEnter" MouseLeave="GeolocateFloatingButton_MouseLeave" Click="GeolocateFloatingButton_Click">
                                                            <materialDesign:PackIcon Kind="AddressMarker" />
                                                        </Button>
                                                        
                                                        <TextBox x:Name="GooglePlacesInput" Text="{Binding SelectedCustomer.Address}"
                                                                 materialDesign:HintAssist.Hint="{Binding GooglePlacesInputHint}"
                                                    
                                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                 materialDesign:TextFieldAssist.LeadingIcon="AddressMarker"
                                                                 Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"
                                                                 TextChanged="GooglePlacesInput_TextChanged" />
                                                        
                                                    </Grid>

                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="City" Text="{Binding SelectedCustomer.City}" 
                                                                 materialDesign:HintAssist.Hint="{Binding CityHint}" 
                                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                 materialDesign:TextFieldAssist.LeadingIcon="City"
                                                                 Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>
                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="State" Text="{Binding SelectedCustomer.State}" 
                                                                 materialDesign:HintAssist.Hint="{Binding StateHint}" 
                                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                 materialDesign:TextFieldAssist.LeadingIcon="Estate"
                                                                 Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>
                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="Zip" Text="{Binding SelectedCustomer.Zip}" 
                                                                 materialDesign:HintAssist.Hint="{Binding ZipHint}" 
                                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                 materialDesign:TextFieldAssist.LeadingIcon="EnvelopeBox"
                                                                 Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>


                                                    <DatePicker SelectedDateChanged="CustomerDate_Changed" x:Name="DOBDatePicker" SelectedDate="{Binding SelectedCustomer.DOB}" 
                                                                materialDesign:HintAssist.Hint="{Binding DOBDatePickerHint}" 
                                                                materialDesign:TextFieldAssist.HasClearButton="True"
                                                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                materialDesign:TextFieldAssist.LeadingIcon="CalendarRange"
                                                                Style="{StaticResource MaterialDesignFilledDatePicker}" Margin="0,0,0,2"/>

                                                    <StackPanel 
                                                        Orientation="Horizontal" Margin="0,15,0,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">

                                                        <RadioButton x:Name="MaleRadioButton" Content="{Binding MaleRadioButtonContent}"
                                                                         GroupName="GenderRadioButtonGroup"
                                                                         IsChecked="{Binding GenderMale}" 
                                                                         Style="{StaticResource MaterialDesignRadioButton}" Margin="0,0,10,0"/>
                                                        <RadioButton x:Name="FemaleRadioButton" Content="{Binding FemaleRadioButtonContent}"
                                                                         GroupName="GenderRadioButtonGroup"
                                                                         IsChecked="{Binding GenderFemale}" 
                                                                         Style="{StaticResource MaterialDesignRadioButton}"/>
                                                    </StackPanel>

                                                </StackPanel>

                                            </Grid>

                                        </StackPanel>
                                    </materialDesign:Card>
                        
                            </StackPanel>
                        
                            <!-- </ScrollViewer> -->

                        </StackPanel>
                        
                        
                        <!-- 📅 Trip Filters -->
                        
                        <!-- The -12 is not a fudge: it is exactly what the divider below grew
                             by, 6px to 18px, and that height came out of this row. Without it the
                             date, Show Canceled and the two buttons are cut off at the bottom. -->
                        <!-- ===== Where the form ends and the day's controls begin =====
                             These two read as one surface until something says otherwise: same
                             paper, same corner radius, no gap - and the negative margin below puts
                             them physically on top of each other, so a dispatcher could not tell
                             where the trip they were filling in stopped and the filters started.

                             Three things separate them now, and it takes all three. The kerb along
                             the top is the theme's primary, the same purple as the road forty
                             pixels down, so the eye files them as the same kind of edge. The
                             elevation puts this bar on a plane ABOVE the form rather than beside
                             it, which is what the overlap was always implying. The corner radius
                             finishes the bar as its own object.

                             The -12 stays: it is exactly what the road grew by, 6px to 18px, and
                             that height came out of this row. Without it the date, Show Canceled
                             and the two buttons are cut off at the bottom. -->
                        <materialDesign:Card Margin="2,-12,2,2"
                            Grid.Row="1"
                            Padding="0"
                            UniformCornerRadius="8"
                            ClipToBounds="True"
                            materialDesign:ElevationAssist.Elevation="Dp4"
                            Background="{DynamicResource MaterialDesignCardBackground}">
                          <Border BorderThickness="0,4,0,0"
                                  BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                                  Padding="10">
                            
                            <StackPanel x:Name="TripFilterPanel"
                                        Visibility="{Binding IsTripFormOpen, Converter={StaticResource InverseBoolToVisibility}}">

                                
                                <Grid Margin="5" Background="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />                                       
                                        <RowDefinition Height="*" />                                      
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Date. One control: it reads a day, or the two ends of
                                             a span, and opens the same popup either way. -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,0,8,0">

                                            <Button x:Name="DateSpanButton"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Command="{Binding OpenDatePopupCommand}"
                                                    ToolTip="{Binding DatePickerToolTip}"
                                                    Padding="10,2,10,2" MinWidth="120">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CalendarMonth" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding DateSpanLabel}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- The way back to a single day. Without it a range is
                                                 a state people get stuck in. -->
                                            <Border Margin="6,0,0,0" CornerRadius="10" Padding="8,1,4,1"
                                                    Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Visibility="{Binding IsDateRange, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding RangeChipText}" Foreground="White"
                                                               VerticalAlignment="Center" FontSize="11"/>
                                                    <Button Style="{StaticResource MaterialDesignToolButton}"
                                                            Command="{Binding ClearDateRangeCommand}"
                                                            ToolTip="{Binding ClearRangeToolTip}"
                                                            Foreground="White" Padding="2" Margin="4,0,0,0">
                                                        <materialDesign:PackIcon Kind="Close" Width="13" Height="13"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <Popup IsOpen="{Binding IsDatePopupOpen, Mode=TwoWay}"
                                                   PlacementTarget="{Binding ElementName=DateSpanButton}"
                                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                                <materialDesign:Card Margin="4" Padding="10"
                                                                     materialDesign:ElevationAssist.Elevation="Dp4">
                                                    <StackPanel MinWidth="250">

                                                        <!-- One day is where this starts, every time. -->
                                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                                            <RadioButton Content="{Binding SingleDayLabel}"
                                                                         GroupName="DateSpanMode"
                                                                         IsChecked="{Binding RangeMode, Converter={StaticResource InverseBoolConverter}}"
                                                                         Command="{Binding UseSingleDayCommand}"
                                                                         Style="{StaticResource MaterialDesignTabRadioButton}"/>
                                                            <RadioButton Content="{Binding RangeLabel}"
                                                                         GroupName="DateSpanMode"
                                                                         IsChecked="{Binding RangeMode, Mode=OneWay}"
                                                                         Command="{Binding UseRangeCommand}"
                                                                         Style="{StaticResource MaterialDesignTabRadioButton}"/>
                                                        </UniformGrid>

                                                        <TextBlock Text="{Binding RangePickHint}" FontStyle="Italic"
                                                                   Margin="0,0,0,4" TextWrapping="Wrap" Opacity=".8"/>

                                                        <Calendar SelectedDate="{Binding PickedDate, Mode=TwoWay}"
                                                                  HorizontalAlignment="Center"/>

                                                        <Separator Margin="0,6,0,6"/>

                                                        <UniformGrid Columns="2">
                                                            <Button Content="{Binding PresetTodayLabel}" Command="{Binding PresetTodayCommand}"
                                                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch"/>
                                                            <Button Content="{Binding PresetTomorrowLabel}" Command="{Binding PresetTomorrowCommand}"
                                                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch"/>
                                                            <Button Content="{Binding PresetThisWeekLabel}" Command="{Binding PresetThisWeekCommand}"
                                                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch"/>
                                                            <Button Content="{Binding PresetNextSevenLabel}" Command="{Binding PresetNextSevenCommand}"
                                                                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch"/>
                                                        </UniformGrid>
                                                    </StackPanel>
                        </materialDesign:Card>
                                            </Popup>
                                        </StackPanel>

                                        <!-- The broker's trip id only. It is the number a
                                             dispatcher is holding when they reach for this, and
                                             it is the only one that fits on this row. -->
                                        <TextBox Grid.Column="1" Width="130" Height="26"
                                            Text="{Binding TripSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                            materialDesign:HintAssist.Hint="{Binding TripSearchHint}"
                                            materialDesign:TextFieldAssist.HasClearButton="True"
                                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                            materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                            materialDesign:TextFieldAssist.TextBoxViewMargin="1,0,1,0"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            FontSize="12" Padding="4,0,4,0"
                                            VerticalContentAlignment="Center"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="2"
                                            Content="{Binding ShowCanceledCheckBoxContent}"
                                            IsChecked="{Binding ShowCanceled}" 
                                            Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                        <!-- Buttons -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button 
                                                    ToolTip="{Binding ImportButtonToolTip}"
                                                    Command="{Binding ImportCommand}"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}" Margin="0,0,10,0">
                                                <materialDesign:PackIcon Kind="DatabaseImport" Width="25" Height="25" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                            </Button>

                                            <Button  
                                                ToolTip="{Binding ExportButtonToolTip}"
                                                Command="{Binding ExportCommand}"
                                                Style="{StaticResource MaterialDesignToolForegroundButton}">
                                                <materialDesign:PackIcon Kind="MicrosoftExcel" Width="25" Height="25" Foreground="Green"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0 5 0 0">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- What is hiding rows, on screen. This is what stops
                                                 "the list is empty and I do not know why". -->
                                            <ItemsControl ItemsSource="{Binding Filters.ActiveChips}" Margin="10,0,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="9" Margin="0,0,4,0" Padding="8,1,8,1"
                                                                Background="{DynamicResource MaterialDesignChipBackground}">
                                                            <TextBlock Text="{Binding}" FontSize="11"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="{Binding ClearAllFiltersLabel}"
                                                    Command="{Binding Filters.ClearAllCommand}"
                                                    Style="{StaticResource MaterialDesignToolButton}"
                                                    FontSize="11" Padding="6,0,6,0"
                                                    Visibility="{Binding Filters.HasActiveFilters, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                </Grid>
                            </StackPanel>
                          </Border>
                        </materialDesign:Card>

                        <!-- Trip Data Area-->                       

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="7*" />
                            </Grid.ColumnDefinitions>



                            <!-- ForDateCalendar -->

                            <!-- Adjusted calendar -->
                            <Calendar x:Name="ForDateCalendar"
                                  Visibility="{Binding IsTripFormOpen, Converter={StaticResource BoolToVisibility}}"
                                  Grid.Column="0"
                                  SelectedDate="{Binding TripDate, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Margin="0"
                                  materialDesign:ElevationAssist.Elevation="Dp2"
                                  >     
                                <Calendar.LayoutTransform>
                                    <ScaleTransform ScaleX="0.75" ScaleY="0.685"/>
                                </Calendar.LayoutTransform>
                            </Calendar>

                            <!-- Trips TabControl -->
                        
                            <TabControl x:Name="TripTabs" Grid.Column="1"
                                    Visibility="{Binding IsTripFormOpen, Converter={StaticResource BoolToVisibility}}"
                                    MinHeight="240"
                                    MaxHeight="240"
                                    HorizontalContentAlignment="Left"
                                
                                    materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                                
                                    TabStripPlacement="Top"
                                    materialDesign:NavigationRailAssist.SelectionCornerRadius="50 10 10 10">
                                <!-- Tab 1: Location and Time -->
                                <TabItem Header="{Binding TripTabsTabItem1Header}" >
                                    <Grid Margin="0,0,2,0" >
                                        
                                    <Grid.Background>
                                        <RadialGradientBrush GradientOrigin="0.5,0.5" 
                                            Center="0.5,0.5" 
                                            RadiusX="0.5" 
                                            RadiusY="0.5">  
                                            <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                            <!-- Blanco (100% opaco) -->
                                            <GradientStop Color="#D3FFD6" Offset="0.94"/>
                                            <!-- Verde en 94% -->
                                            <GradientStop Color="#D3FFD6" Offset="1.0"/>
                                            <!-- Verde en 100% -->
                                        </RadialGradientBrush>
                                    </Grid.Background>
                                        
                                    <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6*" />
                                            <ColumnDefinition Width="4*" />
                                        </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                    <!-- Left column -->

                                    <Button x:Name="InverterFloatingButton" Width="30" Height="30"
                                        Panel.ZIndex="100"
                                        Margin="12,9,16,-17"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        ToolTip="{Binding InverterFloatingButtonToolTip}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Click="InverterFloatingButton_Click" >
                                        <materialDesign:PackIcon x:Name="InverterIcon" Kind="AutorenewOff" />


                                    </Button>
                                        
                                    <TextBox
                                            x:Name="PickupAddressTextBox" Grid.Row="0" Grid.Column="0" Margin="0,3,0,2"
                                            Text="{Binding PickupAddress, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" 
                                            Background="#F5F5F5"
                                        
                                            materialDesign:HintAssist.Hint="{Binding PickupAddressTextBoxHint}"                                                    
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                            materialDesign:TextFieldAssist.LeadingIcon="HomeMapMarker"
                                            Style="{StaticResource MaterialDesignFilledTextBox}" 
                                            TextChanged="GooglePlacesInput_TextChanged"/>

                                        <!-- (2) Where they are going. -->
                                        <Border Grid.Row="1" Grid.Column="0" Panel.ZIndex="20"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,6,0"
                                                Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step2State}">
                                            <TextBlock Text="2" Style="{StaticResource StepBadgeTextStyle}"/>
                                        </Border>

                                        <TextBox
                                            x:Name="DropoffAddressTextBox" Grid.Row="1" Grid.Column="0" Margin="0,0,0,2"
                                            Text="{Binding DropoffAddress, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" 
                                            Background="#F5F5F5"
                                            
                                            materialDesign:HintAssist.Hint="{Binding DropoffAddressTextBoxHint}"                                                    
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                            materialDesign:TextFieldAssist.LeadingIcon="MapMarkerCheck"
                                            Style="{StaticResource MaterialDesignFilledTextBox}" 
                                            TextChanged="DropoffAddressTextBox_TextChanged"/>

                                    <!-- (2.2) Visible and grey with the reason beside it, never
                                         missing. A button that is not there teaches nobody
                                         anything; one that says "Missing: dropoff address"
                                         teaches the whole screen. The reason is the same list
                                         SaveTrip checks, in the same order. -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal"
                                                Panel.ZIndex="100" Margin="12,19,16,-17"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom">

                                        <!-- (4) And create it. -->
                                        <Border Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step4State}"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="4" Style="{StaticResource StepBadgeTextStyle}"/>
                                        </Border>

                                        <Button x:Name="SaveTab1FloatingButton" Width="30" Height="30"
                                            IsEnabled="{Binding CanCreateTrip}"
                                            ToolTip="{Binding CreateTripHint}"
                                            Command="{Binding SaveTripCommand}"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Click="SaveTab1FloatingButton_Click">
                                            <materialDesign:PackIcon  Kind="ContentSave" />
                                        </Button>

                                        <TextBlock Text="{Binding CreateTripHint}" VerticalAlignment="Center"
                                                   Margin="6,0,0,0" FontSize="11" TextWrapping="Wrap" MaxWidth="220"/>
                                    </StackPanel>


                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Margin="0,10,10,5">
                                            <RadioButton x:Name="RoundTripRadioButton" Content="{Binding RoundTripRadioButtonContent}" GroupName="TripType" IsChecked="{Binding IsRoundTrip}" Margin="0,0,10,0" Checked="RoundTripRadioButton_Checked"/>
                                            <RadioButton x:Name="OneWayRadioButton" Content="{Binding OneWayRadioButtonContent}" GroupName="TripType" IsChecked="{Binding IsOneWay}" Checked="OneWayRadioButton_Checked"/>
                                        </StackPanel>

                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Margin="0,10,10,5">
                                            <RadioButton x:Name="AppointmentRadioButton" Content="{Binding AppointmentRadioButtonContent}" GroupName="OneWayKind" IsChecked="{Binding IsAppointment}" Margin="0,0,10,0" Checked="AppointmentRadioButton_Checked"/>
                                            <RadioButton x:Name="ReturnRadioButton" Content="{Binding ReturnRadioButtonContent}" GroupName="OneWayKind" IsChecked="{Binding IsReturn}" Checked="ReturnRadioButton_Checked"/>
                                        </StackPanel>

                                        <!-- Right column -->                                   

                                        <!-- (3) When. -->
                                        <Border Grid.Row="0" Grid.Column="1" Panel.ZIndex="20"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,6,0"
                                                Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step3State}">
                                            <TextBlock Text="3" Style="{StaticResource StepBadgeTextStyle}"/>
                                        </Border>

                                        <materialDesign:TimePicker Grid.Row="0" Grid.Column="1"
                                            x:Name="PickupTimePicker"
                                            SelectedTime="{Binding PickupTimePicker, Mode=TwoWay}"
                                            VerticalAlignment="Bottom"
                                            Margin="10,0,0,0"
                                            materialDesign:HintAssist.Hint="{Binding PickupTimePickerHint}"
                                            materialDesign:TextFieldAssist.HasClearButton="True"
                                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                            materialDesign:TextFieldAssist.LeadingIcon="ClockTimeFour"
                                            Style="{StaticResource MaterialDesignFilledTimePicker}"
                                            Is24Hours="False"/>

                                        <materialDesign:TimePicker Grid.Row="1" Grid.Column="1"
                                            x:Name="ApptTimePicker"
                                            SelectedTime="{Binding ApptTimePicker, Mode=TwoWay}"              
                                            VerticalAlignment="Bottom"
                                            Margin="10,0,0,0"
                                            materialDesign:HintAssist.Hint="{Binding ApptTimePickerHint}"
                                            materialDesign:TextFieldAssist.HasClearButton="True"
                                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                            materialDesign:TextFieldAssist.LeadingIcon="CalendarClock"
                                            Style="{StaticResource MaterialDesignFilledTimePicker}"
                                            Is24Hours="False"/>

                                        <materialDesign:TimePicker Grid.Row="2" Grid.Column="1"
                                            x:Name="ReturnTimePicker"
                                            SelectedTime="{Binding ReturnTimePicker, Mode=TwoWay}" 
                                            VerticalAlignment="Bottom"
                                            Margin="10,0,0,0"
                                            materialDesign:HintAssist.Hint="{Binding ReturnTimePickerHint}"
                                            materialDesign:TextFieldAssist.HasClearButton="True"
                                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                            materialDesign:TextFieldAssist.LeadingIcon="ClockAlert"
                                            Style="{StaticResource MaterialDesignFilledTimePicker}"
                                            Is24Hours="False"/>

                                        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" Margin="10,10,0,5">
                                            <!-- ⚠️ Live only while booking. On an existing trip
                                                 Will Call moves through Activate / Back to Will
                                                 Call in Schedule, which leaves a record and tells
                                                 the patient; the server ignores it on every update
                                                 route, so a live box here would tick, save, and
                                                 change nothing without saying so. -->
                                            <CheckBox x:Name="WillCallCheckBox" Content="{Binding WillCallLabel}"
                                                      IsChecked="{Binding IsWillCall}"
                                                      IsEnabled="{Binding CanEditWillCall}"
                                                      ToolTip="{Binding WillCallLockedToolTip}"
                                                      ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>

                                <!-- Tab 2: Space Type -->
                                <TabItem Header="{Binding TripTabsTabItem2Header}">
                                    <Grid Margin="0" >

                                    <Grid.Background>
                                        <RadialGradientBrush GradientOrigin="0.5,0.5" 
                                            Center="0.5,0.5" 
                                            RadiusX="0.5" 
                                            RadiusY="0.5">          
                                            <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                            <!-- Blanco (100% opaco) -->
                                            <GradientStop Color="#D1ECF8" Offset="0.94"/>
                                            <!-- Verde en 94% -->
                                            <GradientStop Color="#D1ECF8" Offset="1.0"/>
                                            <!-- Verde en 100% -->
                                        </RadialGradientBrush>
                                    </Grid.Background>
                                    <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- ComboBox Space Type -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,00,0">

                                            <ComboBox   x:Name="TripSpaceTypeComboBox"
                                                ItemsSource="{Binding SpaceTypes}" 
                                                SelectedItem="{Binding SelectedSpaceType, Mode=TwoWay}" 
                                                DisplayMemberPath="ShowNameDescription" 
                                                SelectedValuePath="Id"
                                                Style="{StaticResource MaterialDesignFilledComboBox}"
                                                materialDesign:TextFieldAssist.HasClearButton="True"
                                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                materialDesign:TextFieldAssist.LeadingIcon="HumanWheelchair"
                                                Margin="0,0,0,2"
                                                materialDesign:HintAssist.Hint="{Binding TripSpaceTypeComboBoxHint}" />
                                        </StackPanel>

                                        <!-- DataGrid Additional Passengers -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding AdditionalPassengersLabel}" Margin="0,0,0,5"/>
                                            <DataGrid x:Name="AdditionalPassengersDataGrid" AutoGenerateColumns="False" Height="200">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{Binding Data.SpaceTypeNameText, Source={StaticResource vmProxy}}" Binding="{Binding Space}" Width="*"/>
                                                    <DataGridTextColumn Header="{Binding Data.ChargesDescriptionText, Source={StaticResource vmProxy}}" Binding="{Binding Description}" Width="2*"/>
                                                    <DataGridTextColumn Header="{Binding Data.CountLabel, Source={StaticResource vmProxy}}" Binding="{Binding Count}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>

                                <!-- Tab 3: Pickup -->
                                <TabItem Header="{Binding TripTabsTabItem3Header}">
                                    <Grid Margin="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6*" />
                                            <ColumnDefinition Width="4*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Name and Phone -->
                                        <TextBox x:Name="PickupNameTextBox" Grid.Row="0" Grid.Column="0"
                                             Text="{Binding PickupName}"
                                             materialDesign:TextFieldAssist.HasClearButton="True"
 
                                             materialDesign:HintAssist.Hint="{Binding PickupNameTextBoxHint}"
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                             materialDesign:TextFieldAssist.LeadingIcon="TextUser"
                                             Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>

                                        <TextBox x:Name="PickupPhoneTextBox" Grid.Row="0" Grid.Column="1"
                                             Text="{Binding PickupPhone}"
                                             materialDesign:TextFieldAssist.HasClearButton="True"
 
                                             materialDesign:HintAssist.Hint="{Binding PickupPhoneTextBoxHint}"
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                             materialDesign:TextFieldAssist.LeadingIcon="Phone"
                                             Style="{StaticResource MaterialDesignFilledTextBox}" Margin="10,0,2,2"/>

                                        <!-- Comment -->
                                        <TextBox x:Name="PickupCommentTextBox" Grid.Row="1" Grid.ColumnSpan="2" 
                                                 Margin="2,10,4,2"
                                                 Text="{Binding PickupComment}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 materialDesign:HintAssist.Hint="{Binding PickupCommentTextBoxHint}"/>
                                    </Grid>
                                </TabItem>

                                <!-- Tab 4: Dropoff -->
                                <TabItem Header="{Binding TripTabsTabItem4Header}">
                                <Grid Margin="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6*" />
                                        <ColumnDefinition Width="4*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Name and Phone -->
                                    <TextBox x:Name="DropoffNameTextBox" Grid.Row="0" Grid.Column="0"
                                         Text="{Binding DropoffName}"
                                         materialDesign:TextFieldAssist.HasClearButton="True"
 
                                         materialDesign:HintAssist.Hint="Name"
                                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                         materialDesign:TextFieldAssist.LeadingIcon="TextUser"
                                         Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>

                                    <TextBox x:Name="DropoffPhoneTextBox" Grid.Row="0" Grid.Column="1"
                                         Text="{Binding DropoffPhone}"
                                         materialDesign:TextFieldAssist.HasClearButton="True"
 
                                         materialDesign:HintAssist.Hint="Phone"
                                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                         materialDesign:TextFieldAssist.LeadingIcon="Phone"
                                         Style="{StaticResource MaterialDesignFilledTextBox}" Margin="10,0,2,2"/>

                                    <!-- Comment -->
                                    <TextBox x:Name="DropoffCommentTextBox" Grid.Row="1" Grid.ColumnSpan="2" 
                                         Margin="2,10,4,2"
                                             Text="{Binding DropoffComment}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         materialDesign:HintAssist.Hint="Comment"/>
                                    
                                </Grid>
                            </TabItem>

                            </TabControl>

                        </Grid>


                    </Grid>

                <!-- ===== Vertical divider, candidate A: THE RINGS =====
                     A spiral binding seen head-on: two sheets held together by wire loops. It says
                     "these two areas are bound to each other", where a grey bar says nothing.

                     Drawn, not decorated: the pattern is a tiled DrawingBrush on a Border BEHIND
                     the splitter, and the splitter itself stays transparent and does nothing but
                     drag. Painting it onto GridSplitter.Background does not work - the control
                     draws its own mouse-over and focus states straight over its background, which
                     is exactly what washed the horizontal band out before it was built this way. -->
                    <Border Grid.Column="1" Background="{DynamicResource MaterialDesignPaper}" />

                    <Rectangle Grid.Column="1" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Stretch="Fill"
                                          Viewport="0,0,12,26" ViewportUnits="Absolute"
                                          Viewbox="0,0,12,26" ViewboxUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>

                                        <!-- The gutter: darker at both edges, so the two panels
                                             read as sheets and this reads as the gap between. -->
                                        <GeometryDrawing>
                                            <GeometryDrawing.Brush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Offset="0"    Color="#1F000000" />
                                                    <GradientStop Offset="0.35" Color="#00000000" />
                                                    <GradientStop Offset="0.65" Color="#00000000" />
                                                    <GradientStop Offset="1"    Color="#1F000000" />
                                                </LinearGradientBrush>
                                            </GeometryDrawing.Brush>
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,12,26" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>

                                        <!-- The two punched holes the wire passes through. -->
                                        <GeometryDrawing Brush="#38000000">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <EllipseGeometry Center="1.6,13" RadiusX="1.3" RadiusY="1.3" />
                                                    <EllipseGeometry Center="10.4,13" RadiusX="1.3" RadiusY="1.3" />
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>

                                        <!-- The wire loop. Lit from above, like every other
                                             elevated thing in Material. -->
                                        <GeometryDrawing>
                                            <GeometryDrawing.Brush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0"   Color="#FFD8DCE3" />
                                                    <GradientStop Offset="0.5" Color="#FF9AA2AF" />
                                                    <GradientStop Offset="1"   Color="#FF6E7683" />
                                                </LinearGradientBrush>
                                            </GeometryDrawing.Brush>
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0.6,9.4,10.8,7.2" RadiusX="3.6" RadiusY="3.6" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>

                                        <!-- The highlight along the top of the wire. -->
                                        <GeometryDrawing Brush="#99FFFFFF">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="2.2,10.4,7.6,1.5" RadiusX="0.8" RadiusY="0.8" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>

                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <GridSplitter Grid.Column="1"
                                  Width="12"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ShowsPreview="True"
                                  Cursor="SizeWE" />
                    
                <!-- Panel Billing (initially hidden) -->
                <Border  Grid.Column="2" BorderThickness="1,1,1,1" BorderBrush="{StaticResource MainBorderBrush}">
                    <StackPanel Grid.Column="2" x:Name="BillingPanel"
                                Visibility="{Binding IsTripFormOpen, Converter={StaticResource BoolToVisibility}}"
                                Margin="10"
                                
                                Background="Transparent">

                    
                        <TabControl  
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">

                            <TabItem x:Name="BillingSectionTabItem" Header="{Binding TextHeaderBillingSection}">

                                <TabControl  
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">

                                    <TabItem x:Name="ChargesTabItem" Header="{Binding Charges}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                    
                                        <StackPanel Grid.Row="0" Margin="5 10 0 5" Orientation="Horizontal">
                                            <TextBlock Text="{Binding TotalTripChargeTextLabel}" Margin="0 0 0 0" FontWeight="Bold" Foreground="Green"/>
                                            <TextBlock Text=": " Margin="0 0 8 0" FontWeight="Bold" Foreground="Green"/>
                                            <TextBlock Text="{Binding TotalTripCharge}" Margin="0 0 40 0" FontWeight="Bold" Foreground="Green"/>
                                            <TextBlock x:Name="TripTypeTextBlock" Text="{Binding TripType}" Margin="0 0 8 0" FontWeight="Bold"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Row="1" Margin="5 10 0 0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding DistanceTextLabel}" Margin="0 0 0 0" FontWeight="Bold"/>
                                            <TextBlock Text=": " Margin="0 0 8 0" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Distance}" Margin="0 0 8 0" FontWeight="Bold"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Row="2"
                                            Orientation="Horizontal" Margin="10,10,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                            
                                            <RadioButton x:Name="ImportedRadioButton" Content="{Binding Imported}"
                                                 GroupName="OriginRadioButtonGroup"
                                                 IsChecked="{Binding OriginImported}" 
                                                 Style="{StaticResource MaterialDesignRadioButton}" Margin="0,0,10,0"/>     
                                            <RadioButton x:Name="RoutedRadioButton" Content="{Binding Routed}"
                                                 GroupName="OriginRadioButtonGroup"
                                                 IsChecked="{Binding OriginRouted}" 
                                                 Style="{StaticResource MaterialDesignRadioButton}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Row="3" Margin="5 10 0 5" Orientation="Horizontal">
                                            <TextBlock Text="{Binding SelectedChargesTextLabel}" Margin="0 0 15 0" FontWeight="Bold"/>
                                            <CheckBox x:Name="AllowUdateCheckBox" Content="{Binding AllowUpdateText}"/>
                                        </StackPanel>
                                        
                                        <Border Grid.Row="4" BorderThickness="1,1,1,1" 
                                                BorderBrush="{StaticResource MainBorderBrush}"
                                                Background="White">

                                            <Grid Margin="4"
                                                VerticalAlignment="Stretch"
                                                HorizontalAlignment="Stretch">

                                                <!-- DATAGRID -->
                                                <DataGrid x:Name="SelectedChargesDataGrid"          
                                                      ItemsSource="{Binding SelectedCharges}"                                                      
                                                      SelectionMode="Single"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      AlternationCount="2"
                                                      AlternatingRowBackground="White"   
          
                                                      Style="{StaticResource CustomDataGridStyle}"
                                                      ColumnHeaderStyle="{StaticResource CustomColumnHeaderStyle}"
                                                      RowStyle="{StaticResource CustomRowStyle}"
                                                      CellStyle="{StaticResource CustomCellStyle}"
                                                      SelectionUnit="FullRow">

                                                    <DataGrid.Columns>
                                                        
                                                        <DataGridTextColumn 
                                                            Binding="{Binding BillingItem.Description}"
                                                            Header="{Binding Data.ChargesDescriptionText, Source={StaticResource vmProxy}}"/>
                                                        
                                                        <DataGridTextColumn 
                                                            Binding="{Binding Rate}"
                                                            Header="{Binding Data.ChargesRateText, Source={StaticResource vmProxy}}"/>

                                                        <DataGridTextColumn 
                                                            Binding="{Binding Qty}"
                                                            Header="{Binding Data.ChargesQtyText, Source={StaticResource vmProxy}}"/>

                                                        <DataGridTextColumn 
                                                            Binding="{Binding Per}"
                                                            Header="{Binding Data.ChargesPerText, Source={StaticResource vmProxy}}"/>

                                                        <DataGridTextColumn 
                                                            Binding="{Binding ProcedureCode}"
                                                            Header="{Binding Data.ChargesProcedureCodeText, Source={StaticResource vmProxy}}"/>

                                                        <DataGridTextColumn 
                                                            Binding="{Binding Cost}"
                                                            Header="{Binding Data.ChargesCostText, Source={StaticResource vmProxy}}"/>

                                                    </DataGrid.Columns>
                                                    
                                                </DataGrid>

                                            </Grid>

                                        </Border>

                                        <Grid Grid.Row="5" Margin="2 10 2 10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Column -->
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <ComboBox x:Name="FundingSourceBillingComboBox"
                                                    ItemsSource="{Binding FundingSources}" 
                                                    SelectedItem="{Binding SelectedFundingSource, Mode=TwoWay}" 
                                                    DisplayMemberPath="Name" 
                                                    SelectedValuePath="Id"
                                                    Style="{StaticResource MaterialDesignFilledComboBox}"
                                                    materialDesign:TextFieldAssist.HasClearButton="True"
                                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                    materialDesign:TextFieldAssist.LeadingIcon="Finance"
                                                    Margin="0,0,0,2"
                                                    materialDesign:HintAssist.Hint="{Binding FundingSourceText}" />  

                                            </StackPanel>

                                            <!-- Right Column -->
                                            <StackPanel Grid.Column="1">
                                                <TextBox x:Name="BillingAuthorization" Text="{Binding Authorization}" 
                                                     materialDesign:HintAssist.Hint="{Binding AuthorizationText}" 
                                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                     materialDesign:TextFieldAssist.LeadingIcon="KeyVariant"
                                                     Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>
                                            </StackPanel>

                                        </Grid>

                                        <StackPanel Grid.Row="6" Margin="5 10 0 5" Orientation="Horizontal">
                                            <TextBlock Text="{Binding NonDefaultChargesTextLabel}" Margin="0 0 0 0" FontWeight="Bold"/>
                                            
                                        </StackPanel>

                                        <Border Grid.Row="7" BorderThickness="1,1,1,1" 
                                            BorderBrush="{StaticResource MainBorderBrush}"
                                            Background="White">

                                            <Grid Margin="4"
                                                VerticalAlignment="Stretch"
                                                HorizontalAlignment="Stretch">

                                                <!-- DATAGRID -->
                                                <DataGrid x:Name="NonDefaultChargesDataGrid"          
                                                      ItemsSource="{Binding NonDefaultCharges}"                                                      
                                                      SelectionMode="Single"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      AlternationCount="2"
                                                      AlternatingRowBackground="White"   
          
                                                      Style="{StaticResource CustomDataGridStyle}"
                                                      ColumnHeaderStyle="{StaticResource CustomColumnHeaderStyle}"
                                                      RowStyle="{StaticResource CustomRowStyle}"
                                                      CellStyle="{StaticResource CustomCellStyle}"
                                                      SelectionUnit="FullRow">

                                                    <DataGrid.Columns>

                                                        <DataGridTextColumn 
                                                            Binding="{Binding BillingItem.Description}"
                                                            Header="{Binding Data.ChargesDescriptionText, Source={StaticResource vmProxy}}"/>   

                                                        <DataGridTextColumn 
                                                            Binding="{Binding Rate}"
                                                            Header="{Binding Data.ChargesRateText, Source={StaticResource vmProxy}}"/>

                                                        <DataGridTextColumn 
                                                            Binding="{Binding Per}"
                                                            Header="{Binding Data.ChargesPerText, Source={StaticResource vmProxy}}"/>

                                                        <DataGridCheckBoxColumn Binding="{Binding IsDefault}"
                                                            Header="{Binding Data.IsDefaultText, Source={StaticResource vmProxy}}"                       
                                                            IsReadOnly="True"/>
                                                        
                                                        <DataGridTextColumn 
                                                            Binding="{Binding ProcedureCode}"
                                                            Header="{Binding Data.ChargesProcedureCodeText, Source={StaticResource vmProxy}}"/>

                                                    </DataGrid.Columns>

                                                </DataGrid>

                                            </Grid>

                                        </Border>

                                    </Grid>
                                    
                                </TabItem>
                                
                                    <TabItem x:Name="HistoryTabItem" Header="{Binding History}">

                                    </TabItem>
                                    <TabItem x:Name="SignatureTabItem" Header="{Binding Signature}">

                                    </TabItem>


                                </TabControl>
                                
                            </TabItem>

                        </TabControl>
                        
                    
                        
                </StackPanel>

                </Border>
                    
                <!-- ===== Vertical divider, candidate B: THE SEAM =====
                     The other reading of the same problem: not two sheets bolted together but two
                     panels SEWN together. A hairline for the seam itself and a whip stitch over
                     it, in the theme's own purple rather than a metal that belongs to no palette.

                     Quieter than the rings and says nothing about the business - which is the
                     trade-off to look at with all three on screen at once. -->
                    <Border Grid.Column="3" Background="{DynamicResource MaterialDesignPaper}" />

                    <Rectangle Grid.Column="3" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Stretch="Fill"
                                          Viewport="0,0,12,18" ViewportUnits="Absolute"
                                          Viewbox="0,0,12,18" ViewboxUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>

                                        <!-- The seam the stitches close. -->
                                        <GeometryDrawing Brush="#1F000000">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="5.6,0,0.8,18" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>

                                        <!-- The thread, crossing back and forth over it. -->
                                        <GeometryDrawing>
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#B3673AB7" Thickness="1.7"
                                                     StartLineCap="Round" EndLineCap="Round" />
                                            </GeometryDrawing.Pen>
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <LineGeometry StartPoint="2.6,1.5" EndPoint="9.4,7" />
                                                    <LineGeometry StartPoint="9.4,10.5" EndPoint="2.6,16" />
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>

                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <GridSplitter Grid.Column="3" x:Name="BillingGridSplitter"
                                  Width="12"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ShowsPreview="True"
                                  Cursor="SizeWE" />

                    <!-- WebView2 con el mapa -->
                    <wv2:WebView2 Grid.Column="4" x:Name="MapaWebView" Loaded="WebView_Loaded"
                                  Visibility="{Binding IsMapVisible, Converter={StaticResource BoolToVisibility}}" />

                    <!-- ===== What stands in for the map until there is a reason to load one =====
                         Creating a Google map is a billed Dynamic Map, and opening this tab bought
                         one every time to show an empty view of Miami. The guard that actually
                         saves the money is in LoadMap; this fills the space it leaves.

                         The plate is DRAWN, not photographed. A captured screenshot of a real map
                         would be Google content stored indefinitely, it would blur the moment the
                         splitter resized this panel, and - worst of it - a realistic map invites a
                         dispatcher to drag and zoom something that cannot move. This is deliberately
                         a diagram: legible as "a map goes here", never mistakable for one.

                         Every colour is alpha over the theme's own paper, so the plate works in
                         light and dark without a second copy. The dashed route with a red dot and a
                         blue pin is the live map's legend, taught before a map is ever loaded. -->
                    <Grid Grid.Column="4"
                          Visibility="{Binding IsMapVisible, Converter={StaticResource InverseBoolToVisibility}}">

                        <Border Background="{DynamicResource MaterialDesignPaper}" />

                        <Rectangle>
                            <Rectangle.Fill>
                                <DrawingBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"
                                              Viewbox="0,0,400,300" ViewboxUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>

                                            <!-- Water, east. Miami's own geography, roughly. -->
                                            <GeometryDrawing Brush="#2642A5F5">
                                                <GeometryDrawing.Geometry>
                                                    <PathGeometry Figures="M328,0 L400,0 L400,300 L300,300 C322,232 316,170 320,104 C322,64 324,32 328,0 Z" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>

                                            <!-- A park, so the grid is not uniform. Cities never are. -->
                                            <GeometryDrawing Brush="#264CAF50">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="150,150,58,54" RadiusX="6" RadiusY="6" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>

                                            <!-- The street grid. Grey with alpha, never black: the
                                                 same drawing has to read on a dark theme too. -->
                                            <GeometryDrawing>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#26808080" Thickness="3" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <LineGeometry StartPoint="0,42"  EndPoint="330,42" />
                                                        <LineGeometry StartPoint="0,96"  EndPoint="324,96" />
                                                        <LineGeometry StartPoint="0,150" EndPoint="320,150" />
                                                        <LineGeometry StartPoint="0,204" EndPoint="318,204" />
                                                        <LineGeometry StartPoint="0,258" EndPoint="308,258" />
                                                        <LineGeometry StartPoint="46,0"  EndPoint="46,300" />
                                                        <LineGeometry StartPoint="102,0" EndPoint="102,300" />
                                                        <LineGeometry StartPoint="150,0" EndPoint="150,300" />
                                                        <LineGeometry StartPoint="208,0" EndPoint="208,300" />
                                                        <LineGeometry StartPoint="262,0" EndPoint="262,300" />
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>

                                            <!-- One avenue on the diagonal and one causeway out to
                                                 the water. Without them it is graph paper. -->
                                            <GeometryDrawing>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#33808080" Thickness="7" StartLineCap="Round" EndLineCap="Round" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup>
                                                        <LineGeometry StartPoint="-10,288" EndPoint="316,20" />
                                                        <LineGeometry StartPoint="262,124" EndPoint="400,116" />
                                                    </GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>

                                            <!-- The route: the same purple and the same two colours
                                                 the live map uses, so the legend is already learnt. -->
                                            <GeometryDrawing>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#807E57C2" Thickness="5"
                                                         StartLineCap="Round" EndLineCap="Round" LineJoin="Round"
                                                         DashCap="Round">
                                                        <Pen.DashStyle>
                                                            <DashStyle Dashes="1.6,1.4" />
                                                        </Pen.DashStyle>
                                                    </Pen>
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <PathGeometry Figures="M78,244 L78,178 L176,178 L176,110 L246,110 L246,66" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>

                                            <!-- Pickup: red, where the patient waits. -->
                                            <GeometryDrawing Brush="#CCD32F2F">
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#B3FFFFFF" Thickness="2.4" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="78,244" RadiusX="7" RadiusY="7" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>

                                            <!-- Dropoff: blue, and the same teardrop as the map. -->
                                            <GeometryDrawing Brush="#CC1565C0">
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#B3FFFFFF" Thickness="1.6" />
                                                </GeometryDrawing.Pen>
                                                <GeometryDrawing.Geometry>
                                                    <PathGeometry Figures="M246,42 C240.2,42 235.5,46.7 235.5,52.5 C235.5,60.4 246,72 246,72 C246,72 256.5,60.4 256.5,52.5 C256.5,46.7 251.8,42 246,42 Z M246,56.3 A3.75,3.75 0 1 1 246,48.8 A3.75,3.75 0 0 1 246,56.3 Z" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>

                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- The message sits on its own surface. Text straight onto the plate is
                             legible right up until the panel is resized and a street runs under a
                             word. -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="320" CornerRadius="12" Padding="26,20,26,20"
                                Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                                materialDesign:ElevationAssist.Elevation="Dp3">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="MapSearchOutline" Width="42" Height="42"
                                                         HorizontalAlignment="Center" Opacity=".5"
                                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                <TextBlock Text="{Binding MapNotLoadedHint}" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,10,0,14"
                                           FontSize="12" Opacity=".8"/>
                                <Button Content="{Binding ShowMapLabel}" Command="{Binding ShowMapCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Center" Height="30" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Horizontal GridSplitter. The figures ride on top of it rather than in a row
                     of their own: this band is already there, it is exactly where the form ends
                     and the list begins, and it costs the layout nothing to read it. The text is
                     IsHitTestVisible=False so the whole band still drags. -->
                <!-- ⚠️ The colour is on a Border behind the splitter, not on the splitter.
                     A GridSplitter paints its own visual states over its Background, so unfocused
                     it washed out — and white figures on a washed-out purple are figures nobody
                     can read. The Border is always the theme's primary; the splitter above it is
                     transparent and does nothing but drag. -->
                <Border Grid.Row="1"
                        Visibility="{Binding IsImporting, Converter={StaticResource InverseBoolToVisibility}}"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}" />

                <!-- ===== The road =====
                     The band was already there and already purple. A dashed centre line turns it
                     from a bar into a stretch of road, which is the one thing this business
                     actually does - and it costs the layout nothing, because the height was
                     already spent.

                     The dashes are a tiled brush rather than a StrokeDashArray so they can be
                     SCROLLED, and that is the loading animation: traffic moves while the trips
                     are coming and stops when they have arrived.

                     Two details make it work. The strip hangs 30px past each end of the band -
                     exactly one tile - so sliding it a whole tile leaves no gap at either edge,
                     and the Border clips the overhang. And it moves the RECTANGLE, not the brush:
                     animating a brush's Transform through a property path works right up until
                     something freezes the brush, and then it throws where nothing can catch it.
                     RenderTransform on the element is the boring version, and this band is drawn
                     on every single tab open. -->
                <Border Grid.Row="1" ClipToBounds="True" Panel.ZIndex="1" IsHitTestVisible="False"
                        Visibility="{Binding IsImporting, Converter={StaticResource InverseBoolToVisibility}}">
                    <Rectangle Height="3" VerticalAlignment="Center" Margin="-30,0,-30,0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform />
                        </Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Stretch="Fill"
                                          Viewport="0,0,30,3" ViewportUnits="Absolute"
                                          Viewbox="0,0,30,3" ViewboxUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="#66FFFFFF">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,17,3" RadiusX="1.5" RadiusY="1.5" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoadingTrips}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="TrafficFlow">
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                        From="0" To="30" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="TrafficFlow" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                </Border>

                <GridSplitter x:Name="GridRow1" Grid.Row="1"
                      Visibility="{Binding IsImporting, Converter={StaticResource InverseBoolToVisibility}}"
                      Height="18"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="True"
                      Cursor="SizeNS" />

                <!-- ⚠️ The figures are a SIBLING of the splitter in the same cell, never its
                     parent or its child. A GridSplitter decides which rows it resizes by looking
                     at the Grid it sits in: wrapped in a Grid of its own it had no siblings to
                     move, and the band stopped dragging altogether. Overlapping two children in
                     one cell keeps the splitter where it belongs and still puts the text on top.

                     IsHitTestVisible=False so the whole band, text included, drags. -->
                <Border Grid.Row="1" Panel.ZIndex="2"
                        Visibility="{Binding IsImporting, Converter={StaticResource InverseBoolToVisibility}}"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Height="16" CornerRadius="8" Padding="12,0,12,0"
                        Background="#33000000" BorderBrush="#4DFFFFFF" BorderThickness="1">
                    <TextBlock Text="{Binding DividerSummary}" VerticalAlignment="Center"
                               Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>

                <!-- Bottom DataGrid -->


            <Grid Grid.Row="2" x:Name="GridRow2"
                  Visibility="{Binding IsImporting, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- DATAGRID -->
                <DataGrid x:Name="TripsGrid"
                    Grid.Row="0"
                    ItemsSource="{Binding TripsView}"
                    SelectedItem="{Binding SelectedTrip, Mode=TwoWay}"

                    MouseDoubleClick="TripsGrid_MouseDoubleClick"
                    Sorting="TripsGrid_Sorting"
                    Loaded="TripsGrid_Loaded"

                    SelectionMode="Single"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    AlternationCount="2"

                    FrozenColumnCount="3"
                    RowHeight="{Binding GridRowHeight}"

                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"

                    Style="{StaticResource CustomDataGridStyle}"
                    ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}"

                    RowStyle="{StaticResource HomeTripRowStyle}"
                    CellStyle="{StaticResource TripSelectionCellStyle}"
                    SelectionUnit="FullRow"
                    Cursor="Hand">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ToggleFilterPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="{Binding DataContext.FiltersHeader, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{StaticResource TripActionButtonStyle}">
                                        <Grid>
                                            <materialDesign:PackIcon Kind="FilterSettings" Width="20" Height="20"/>
                                            <!-- The dot is the only thing that tells a dispatcher
                                                 the list is short because they filtered it. -->
                                            <Ellipse Width="7" Height="7" Fill="#D32F2F"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Margin="0,-1,-1,0"
                                                     Visibility="{Binding DataContext.Filters.HasActiveFilters,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                                                  Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">

                                        

                                        <!-- Cancel Button (Visible if not canceled) -->
                                        <Button Command="{Binding DataContext.CancelTripCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TripActionButtonStyle}"
                                            ToolTip="{Binding Data.CancelTripLabel, Source={StaticResource vmProxy}}">
                                            <Button.Visibility>
                                                <Binding Path="Status" Converter="{StaticResource StatusToVisibilityConverter}" ConverterParameter="NotCanceled" />
                                            </Button.Visibility>
                                            <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="20" Height="20" />
                                        </Button>

                                        <!-- Restore Button (Visible if YES is cancelled) -->
                                        <Button Command="{Binding DataContext.UncancelTripCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TripActionButtonStyle}"
                                            ToolTip="{Binding Data.UncancelTripLabel, Source={StaticResource vmProxy}}">
                                            <Button.Visibility>
                                                <Binding Path="Status" Converter="{StaticResource StatusToVisibilityConverter}" ConverterParameter="Canceled" />
                                            </Button.Visibility>
                                            <materialDesign:PackIcon Kind="Restore" Foreground="Green" Width="20" Height="20" />
                                        </Button>

                                        <!-- Edit button -->
                                        <Button Command="{Binding DataContext.EditTripCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TripActionButtonStyle}"
                                            ToolTip="{Binding Data.EditTripLabel, Source={StaticResource vmProxy}}">
                                            <materialDesign:PackIcon Kind="FileEdit" Foreground="Orange"/>

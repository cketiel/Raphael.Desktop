                    <wv2:WebView2 Grid.Column="4" x:Name="MapaWebView" Loaded="WebView_Loaded" />
                </Grid>

                <!-- Horizontal GridSplitter. The figures ride on top of it rather than in a row
                     of their own: this band is already there, it is exactly where the form ends
                     and the list begins, and it costs the layout nothing to read it. The text is
                     IsHitTestVisible=False so the whole band still drags. -->
                <!-- ⚠️ The colour is on a Border behind the splitter, not on the splitter.
                     A GridSplitter paints its own visual states over its Background, so unfocused
                     it washed out — and white figures on a washed-out purple are figures nobody
                     can read. The Border is always the theme's primary; the splitter above it is
                     transparent and does nothing but drag. -->
                <Border Grid.Row="1"
                        Visibility="{Binding IsImporting, Converter={StaticResource InverseBoolToVisibility}}"
                        Background="{DynamicResource MaterialDesign.Brush.Primary}" />

                <GridSplitter x:Name="GridRow1" Grid.Row="1"
                      Visibility="{Binding IsImporting, Converter={StaticResource InverseBoolToVisibility}}"
                      Height="18"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="True"
                      Cursor="SizeNS" />

                <!-- ⚠️ The figures are a SIBLING of the splitter in the same cell, never its
                     parent or its child. A GridSplitter decides which rows it resizes by looking
                     at the Grid it sits in: wrapped in a Grid of its own it had no siblings to
                     move, and the band stopped dragging altogether. Overlapping two children in
                     one cell keeps the splitter where it belongs and still puts the text on top.

                     IsHitTestVisible=False so the whole band, text included, drags. -->
                <TextBlock Grid.Row="1" Text="{Binding DividerSummary}" Panel.ZIndex="1"
                           Visibility="{Binding IsImporting, Converter={StaticResource InverseBoolToVisibility}}"
                           IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center"

<UserControl x:Class="Raphael.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Raphael.Desktop.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"  
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/shared"
             xmlns:domain="clr-namespace:Raphael.Desktop.Validations"
             xmlns:vm="clr-namespace:Raphael.Desktop.ViewModels"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers" 
             xmlns:converters="clr-namespace:Raphael.Desktop.Converters"
             helpers:HelpAssist.TopicId="desktop/home/overview"
             PreviewKeyDown="HomeView_PreviewKeyDown"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    
    
    <UserControl.Resources>
        <!-- vmProxy “captures” the current DataContext (HomeViewModel) -->
        <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <converters:EnumMatchConverter x:Key="EnumMatchConverter" />
        <converters:TimeSpanToDateConverter x:Key="TimeSpanToDateConverter" />
        <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter" />
        <helpers:MinutesToTimeStringConverter x:Key="MinutesConverter" />
        <converters:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter" />

        <!--
            ⚠️ The stripe is a trigger here and NOT the DataGrid's AlternatingRowBackground.
            That property is applied by coercion and beats both setters and triggers, which in
            RE-008 left one row in every two with no status colour at all. Everything that paints
            a row has to come from this one style, in order, or half the rows lie.
        -->
        <!--
            The numbered badge over each key control. Its whole state is one string from the
            ViewModel — "done", "current" or "pending" — so the badges, the stepper and the tour
            cannot disagree with each other about where the dispatcher is.

            The pulse animates the badge's own Opacity, which is why it is allowed to live inside
            a Style at all: a Storyboard declared here cannot name another element.
        -->
        <!-- ===== The filter panel's furniture =====
             The sections used to be bare Expanders on a flat sheet: nothing told the eye where one
             filter ended and the next began, so a panel with eight of them read as one long list
             of controls floating in space. Each section is a card now — its own surface, its own
             hairline, its own breathing room — and the body behind them is tinted a few percent
             darker so the cards sit ON something instead of in the air. -->
        <Style x:Key="FilterSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10,2,10,6" />
        </Style>

        <Style x:Key="FilterSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="FilterSectionIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
        </Style>

        <Style x:Key="FilterOptionCheckBox" TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FilterSubLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value=".7" />
            <Setter Property="Margin" Value="0,6,0,3" />
        </Style>

        <Style x:Key="StepBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#BDBDBD" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="done">
                    <Setter Property="Background" Value="#2E7D32" />
                </Trigger>
                <Trigger Property="Tag" Value="current">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="StepPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.4" Duration="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="StepPulse" />
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HomeTripRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="{StaticResource EvenRowBackgroundBrush}"/>
            <Style.Triggers>

                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="White" />
                </Trigger>

                <!-- Status is said in the TEXT, never in the row's background. Two rules already
                     carry it: red type when a driver reported a no-show, grey italic when the
                     office cancelled. A tint on top of that says the same thing a third time and
                     costs the alternating banding - the plain white every other row - which is
                     what lets the eye track one trip across twenty columns.

                     The alternation trigger above is therefore the only thing that paints an
                     unselected row. Hover and selection come after it and win, which is the whole
                     point of the ordering. -->

                <DataTrigger Binding="{Binding Status}" Value="Canceled">
                    <Setter Property="Foreground" Value="Red" />
                    <Setter Property="ToolTip" Value="{Binding Data.CanceledByDriverToolTip, Source={StaticResource vmProxy}}" />
                </DataTrigger>

                <!-- ⚠️ Hover and selection have to be declared here, not left to the row
                     template. The Background setter at the top of this style is a style value
                     and beats a template trigger, which is exactly why the Schedule grid's
                     selection was invisible until it was moved here. Same brushes, on purpose:
                     the two grids show the same kind of row and must read the same. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverTripRowBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedTripRowBrush}" />
                    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                </Trigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Canceled" />
                        <Condition Binding="{Binding DriverNoShowReason, TargetNullValue={x:Null}}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="Gray" />
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="ToolTip" Value="{Binding Data.CanceledByOfficeToolTip, Source={StaticResource vmProxy}}" />
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Canceled" />
                        <Condition Binding="{Binding DriverNoShowReason}" Value="" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="Gray" />
                    <Setter Property="ToolTip" Value="{Binding Data.CanceledByOfficeToolTip, Source={StaticResource vmProxy}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- ===== The map plate =====
             ⚠️ 640x200, and the numbers matter. This panel is about 3.2:1 - the map column is two
             thirds of the width, the top row is 45% of the height - and the brush is UniformToFill,
             so whatever the drawing does not match in aspect gets CROPPED, not letterboxed. The
             first version was drawn 4:3 and the second 2.8:1, and both times the bottom of the
             drawing was cut off with the pickup pin on it.

             Two rules follow, and everything below obeys them.

             SAFE AREA - x 100..540, y 29..171. That rectangle survives panel ratios from 2.2:1 to
             4.5:1, which is as narrow and as wide as the splitter can reasonably make this. Every
             pin, the compass, the clinic and the whole route live inside it. Blocks, water and the
             island are outside it on purpose: they are texture, and losing an edge of them costs
             nothing.

             CARD FOOTPRINT - about x 253..387, y 52..148 at the sizes the card is set to. Nothing
             that has to be read goes there. Compass and roundabout to its left, pickup and the
             route below it, clinic and dropoff to its right.

             The base is a brush; the route and the pins are real elements on a Canvas over it, so
             they can carry tooltips and an animation. A brush can do neither. -->
        <DrawingBrush x:Key="MapPlateBrush" Stretch="Fill"
                      Viewbox="0,0,640,200" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>

                    <!-- Land. -->
                    <GeometryDrawing Brush="#FFF4EFE4">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,640,200" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- The bay, with the coastline drawn as a line of its own: without it the
                         water is a flat shape, with it it is a shore. -->
                    <GeometryDrawing Brush="#FF9CCFE8">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FF7FB8D4" Thickness="1.6" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M580,0 C587,34 573,62 579,90 C585,118 571,148 577,176 C580,190 579,196 578,200 L640,200 L640,0 Z" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- An island out in the bay, which is what this city looks like from above. -->
                    <GeometryDrawing Brush="#FFF4EFE4">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="596,100,36,28" RadiusX="8" RadiusY="8" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- Parks. -->
                    <GeometryDrawing Brush="#FFC7E3B4">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="104,98,58,30" RadiusX="6" RadiusY="6" />
                                <RectangleGeometry Rect="394,122,44,28" RadiusX="6" RadiusY="6" />
                                <RectangleGeometry Rect="604,106,20,16" RadiusX="4" RadiusY="4" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- City blocks: texture, so the space between the streets is not bare paper. -->
                    <GeometryDrawing Brush="#FFE9E2D4">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                            <RectangleGeometry Rect="16,4,72,22" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="186,4,98,22" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="316,4,58,22" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="406,4,48,22" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="490,4,58,22" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="16,38,72,42" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="186,38,98,42" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="316,38,58,42" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="186,98,98,44" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="316,98,58,44" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="16,166,72,28" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="110,166,44,28" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="186,166,98,28" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="316,166,58,28" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="406,166,48,28" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="490,166,58,28" RadiusX="2" RadiusY="2" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- The clinic the route ends at. -->
                    <GeometryDrawing Brush="#FFF6DEDE">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="428,50,84,58" RadiusX="3" RadiusY="3" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- Streets: a warm casing first, white on top. One flat line is a wireframe;
                         two are a road. -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FFE3DBCA" Thickness="8" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,30"  EndPoint="578,30" />
                                <LineGeometry StartPoint="0,88"  EndPoint="574,88" />
                                <LineGeometry StartPoint="0,158" EndPoint="576,158" />
                                <LineGeometry StartPoint="100,0" EndPoint="100,200" />
                                <LineGeometry StartPoint="170,0" EndPoint="170,200" />
                                <LineGeometry StartPoint="300,0" EndPoint="300,200" />
                                <LineGeometry StartPoint="390,0" EndPoint="390,200" />
                                <LineGeometry StartPoint="470,0" EndPoint="470,200" />
                                <LineGeometry StartPoint="560,0" EndPoint="560,200" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FFFFFFFF" Thickness="6" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,30"  EndPoint="578,30" />
                                <LineGeometry StartPoint="0,88"  EndPoint="574,88" />
                                <LineGeometry StartPoint="0,158" EndPoint="576,158" />
                                <LineGeometry StartPoint="100,0" EndPoint="100,200" />
                                <LineGeometry StartPoint="170,0" EndPoint="170,200" />
                                <LineGeometry StartPoint="300,0" EndPoint="300,200" />
                                <LineGeometry StartPoint="390,0" EndPoint="390,200" />
                                <LineGeometry StartPoint="470,0" EndPoint="470,200" />
                                <LineGeometry StartPoint="560,0" EndPoint="560,200" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- Arterials and the causeway out to the island. Amber is what every map in
                         the world uses for the road you are meant to take. -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FFE0BE63" Thickness="13" StartLineCap="Round" EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,112" EndPoint="576,112" />
                                <LineGeometry StartPoint="210,0" EndPoint="210,200" />
                                <LineGeometry StartPoint="580,140" EndPoint="640,136" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FFFBDD8A" Thickness="10" StartLineCap="Round" EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,112" EndPoint="576,112" />
                                <LineGeometry StartPoint="210,0" EndPoint="210,200" />
                                <LineGeometry StartPoint="580,140" EndPoint="640,136" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- The roundabout where the two arterials meet. Left of centre on purpose:
                         dead centre it would sit under the card. -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FFE0BE63" Thickness="13" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="210,112" RadiusX="15" RadiusY="15" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#FFC7E3B4">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FFFBDD8A" Thickness="10" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="210,112" RadiusX="15" RadiusY="15" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- The clinic marker. A white disc with a red cross reads as a hospital in
                         every country, which a tinted rectangle did not. -->
                    <GeometryDrawing Brush="#FFFFFFFF">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FFD9534F" Thickness="2" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="444,68" RadiusX="12" RadiusY="12" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#FFD9534F">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="436.5,65.5,15,5" RadiusX="1.2" RadiusY="1.2" />
                                <RectangleGeometry Rect="441.5,60.5,5,15" RadiusX="1.2" RadiusY="1.2" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <!-- A compass, because real maps have one. -->
                    <GeometryDrawing Brush="#FFFFFFFF">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#FFD8D0BE" Thickness="1.5" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="140,50" RadiusX="14" RadiusY="14" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#FFD9534F">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M140,39 L145,50 L140,47.4 L135,50 Z" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#FFB9B0A0">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M140,61 L135,50 L140,52.6 L145,50 Z" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ===== The figures under the list, on number plates =====
             A dispatcher's day is measured in vehicles, so the three counts are set the way a
             registration plate is set: the number large because that is the information, the
             fleet name and the strapline tiny because they are furniture. It is the one place on
             this screen where the decoration says what the company does.

             Fixed width on all three, like real plates, so they line up as a set rather than as
             three labels of different lengths.

             Tag carries the count and Content the word, because the plate prints them at two
             different sizes and one string could only ever be one size. The spaced-out letters
             are the poor-man's letter-spacing: WPF has no such property on TextBlock. -->
        <Style x:Key="NumberPlate" TargetType="ContentControl">
            <Setter Property="Width" Value="126" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="5" Padding="2"
                                Background="{DynamicResource MaterialDesign.Brush.Primary}">
                            <Border CornerRadius="3.5" Padding="5,1,5,1"
                                    Background="{DynamicResource MaterialDesignPaper}">
                                <StackPanel>
                                    <TextBlock Text="R A P H A E L" HorizontalAlignment="Center"
                                               FontSize="6" FontWeight="Bold" Margin="0,0,0,-1"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{TemplateBinding Tag}"
                                                   FontSize="16" FontWeight="Bold"
                                                   LineHeight="17" LineStackingStrategy="BlockLineHeight"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   FontSize="9.5" Opacity=".75" Margin="3,0,0,2"
                                                   VerticalAlignment="Bottom" />
                                    </StackPanel>

                                    <TextBlock Text="D R I V I N G   H E A L T H" HorizontalAlignment="Center"
                                               FontSize="5" FontWeight="Bold" Margin="0,-1,0,0" Opacity=".8"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The date lives on its own so it can be shown once while the bar around it is
             shown twice. It also settles the duplicate calendar: there is exactly one
             popup now, anchored to the one button that opens it. -->
        <DataTemplate x:Key="TripDatePicker">
                            <!-- Date. One control: it reads a day, or the two ends of
                                 a span, and opens the same popup either way. -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,8,0">

                                <Button x:Name="DateSpanButton"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding OpenDatePopupCommand}"
                                        ToolTip="{Binding DatePickerToolTip}"
                                        Padding="10,2,10,2" MinWidth="120">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarMonth" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding DateSpanLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- The way back to a single day. Without it a range is
                                     a state people get stuck in. -->
                                <Border Margin="6,0,0,0" CornerRadius="10" Padding="8,1,4,1"
                                        Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                        Visibility="{Binding IsDateRange, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding RangeChipText}" Foreground="White"
                                                   VerticalAlignment="Center" FontSize="11"/>
                                        <Button Style="{StaticResource MaterialDesignToolButton}"
                                                Command="{Binding ClearDateRangeCommand}"
                                                ToolTip="{Binding ClearRangeToolTip}"
                                                Foreground="White" Padding="2" Margin="4,0,0,0">
                                            <materialDesign:PackIcon Kind="Close" Width="13" Height="13"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Popup IsOpen="{Binding IsDatePopupOpen, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=DateSpanButton}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <materialDesign:Card Margin="4" Padding="10"
                                                         materialDesign:ElevationAssist.Elevation="Dp4">
                                        <StackPanel MinWidth="250">

                                            <!-- One day is where this starts, every time. -->
                                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                                <RadioButton Content="{Binding SingleDayLabel}"
                                                             GroupName="DateSpanMode"
                                                             IsChecked="{Binding RangeMode, Converter={StaticResource InverseBoolConverter}}"
                                                             Command="{Binding UseSingleDayCommand}"
                                                             Style="{StaticResource MaterialDesignTabRadioButton}"/>
                                                <RadioButton Content="{Binding RangeLabel}"
                                                             GroupName="DateSpanMode"
                                                             IsChecked="{Binding RangeMode, Mode=OneWay}"
                                                             Command="{Binding UseRangeCommand}"
                                                             Style="{StaticResource MaterialDesignTabRadioButton}"/>
                                            </UniformGrid>

                                            <TextBlock Text="{Binding RangePickHint}" FontStyle="Italic"
                                                       Margin="0,0,0,4" TextWrapping="Wrap" Opacity=".8"/>

                                            <Calendar SelectedDate="{Binding PickedDate, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"/>

                                            <Separator Margin="0,6,0,6"/>

                                            <UniformGrid Columns="2">
                                                <Button Content="{Binding PresetTodayLabel}" Command="{Binding PresetTodayCommand}"
                                                        Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch"/>
                                                <Button Content="{Binding PresetTomorrowLabel}" Command="{Binding PresetTomorrowCommand}"
                                                        Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch"/>
                                                <Button Content="{Binding PresetThisWeekLabel}" Command="{Binding PresetThisWeekCommand}"
                                                        Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch"/>
                                                <Button Content="{Binding PresetNextSevenLabel}" Command="{Binding PresetNextSevenCommand}"
                                                        Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch"/>
                                            </UniformGrid>
                                        </StackPanel>
            </materialDesign:Card>
                                </Popup>
                            </StackPanel>
        </DataTemplate>

        <!-- ===== The express filter bar, defined once =====
             It is on screen twice on purpose, and only for as long as it takes to decide where it
             belongs: above the list, where it is now, or down in the status bar. Two COPIES of
             this markup would have been two things to keep in step and one of them would have
             drifted before the question was settled, so there is one definition and two renders
             of it, and deciding means deleting a ContentControl.

             WARNING while both are up: the date popup is bound to one property on the view model,
             so opening the calendar opens BOTH of them, one under each date button. That is the
             cost of showing the same bar twice, not a bug in the bar, and it goes when one of the
             two renders is removed. x:Name inside a DataTemplate is fine - each render gets its
             own namescope, so the two DateSpanButtons never collide. -->
        <DataTemplate x:Key="ExpressFilterBar">
                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- The broker's trip id only. It is the number a
                                 dispatcher is holding when they reach for this, and
                                 it is the only one that fits on this row. -->
                            <TextBox Grid.Column="1" Width="130" Height="26"
                                Text="{Binding TripSearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                materialDesign:HintAssist.Hint="{Binding TripSearchHint}"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                materialDesign:TextFieldAssist.TextBoxViewMargin="1,0,1,0"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                FontSize="12" Padding="4,0,4,0"
                                VerticalContentAlignment="Center"
                                VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <!-- Checkbox -->
                            <CheckBox Grid.Column="2"
                                Content="{Binding ShowCanceledCheckBoxContent}"
                                IsChecked="{Binding ShowCanceled}" 
                                Style="{StaticResource MaterialDesignCheckBox}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <!-- Buttons -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button 
                                        ToolTip="{Binding ImportButtonToolTip}"
                                        Command="{Binding ImportCommand}"
                                        Style="{StaticResource TripActionButtonStyle}" Margin="0,0,10,0">
                                    <materialDesign:PackIcon Kind="DatabaseImport" Width="25" Height="25" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                </Button>

                                <Button  
                                    ToolTip="{Binding ExportButtonToolTip}"
                                    Command="{Binding ExportCommand}"
                                    Style="{StaticResource TripActionButtonStyle}">
                                    <materialDesign:PackIcon Kind="MicrosoftExcel" Width="25" Height="25" Foreground="Green"/>
                                </Button>
                            </StackPanel>
                        </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <materialDesign:DialogHost x:Name="RootDialogHost" Identifier="RootDialogHost">
        
    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource MainBorderBrush}">

            <Grid x:Name="HomeRoot" Margin="5" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TopRow" Height="4.5*" /> <!-- 45% Upper area -->
                    <RowDefinition Height="18" />  <!-- Horizontal GridSplitter, and the day's figures -->
                    <RowDefinition x:Name="BottomRow" Height="5.5*" /> <!-- 55% Lower area (DataGrid) -->
                </Grid.RowDefinitions>

                <!-- Top row: Client, Billing, Splitter, Map -->
                <Grid Grid.Row="0" x:Name="GridRow0"
                      Visibility="{Binding IsImporting, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="CustomerColumn" Width="1*" />  <!-- Customer and Trip data area (initially hidden) -->
                        <ColumnDefinition Width="6" />     <!-- Vertical GridSplitter -->
                        <ColumnDefinition x:Name="BillingColumn" Width="0" />  <!-- Billing (initially hidden) -->
                        <ColumnDefinition Width="6" />     <!-- Vertical GridSplitter -->
                        <ColumnDefinition x:Name="MapColumn" Width="2*" />    <!-- Map -->
                    </Grid.ColumnDefinitions>

                    <!-- Customer data area -->
                <!-- Paper, not Transparent. Everything in this column is a rounded card, and a
                     rounded card shows its parent at the corners: transparent meant the window's
                     own shade, a hair off the card's, and every corner read as a grey nick. The
                     column and the cards on it are painted with the SAME brush, so the corners
                     cannot show anything at all. -->
                <Grid Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>

                        <!-- 👤 Customer Search & Info -->

                        <StackPanel Grid.Row="0" Background="Transparent">

                            <!-- 🔎 Customer Search Section -->

                            <StackPanel Margin="2" Background="Transparent">

                                <materialDesign:ColorZone Padding="10,3,10,3" Mode="PrimaryMid"
                                                          materialDesign:ElevationAssist.Elevation="Dp1"
                                                          ClipToBounds="False"
                                                          CornerRadius="5">

                                    <!-- ⚠️ A Grid, not a DockPanel wrapped round one long
                                         StackPanel. Neither of those makes anything give way: a
                                         StackPanel hands every child the width it asks for and
                                         lets the row run off the end, which is why new patient was
                                         drawn half off and the three buttons after it were nowhere
                                         at all. Everything is packed left in Auto columns and the
                                         slack sits in the last one, so the buttons follow the
                                         search box instead of being pushed to the far edge. -->
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- (1) Who is travelling. The number goes on the control
                                             it names, which costs no layout at all — it was the
                                             ROW of numbers that had to go, not the numbers. -->
                                        <Border Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step1State}">
                                            <TextBlock Text="1" Style="{StaticResource StepBadgeTextStyle}"/>
                                        </Border>

                                                <StackPanel Grid.Column="1" materialDesign:RippleAssist.IsCentered="True"
                                                            Orientation="Horizontal">

                                                    <TextBlock 
                                                        Text="{Binding SearchPassengerByLabel}"
                                                        VerticalAlignment="Center">
                                                    
                                                    </TextBlock>

                                                    <materialDesign:ColorZone Margin="5,2,0,2"
                                                                            Padding="8,4,8,4"
                                                                            Panel.ZIndex="1"
                                                                            materialDesign:ElevationAssist.Elevation="Dp2"
                                                                            CornerRadius="2"
                                                                            Mode="Standard" Cursor="">        

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Button Style="{StaticResource MaterialDesignToolButton}">
                                                                <materialDesign:PackIcon Kind="Search" Opacity=".56" />
                                                            </Button>

                                                            <!-- AutoSuggestBox -->
                                                            <materialDesign:AutoSuggestBox
                                                                x:Name="CustomersAutoSuggestBox"
                                                                Grid.Column="1"
                                                                MinWidth="150"            
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0"
                                                                materialDesign:TextFieldAssist.HasClearButton="True"
                                                                materialDesign:HintAssist.Hint="{Binding AutoSuggestBoxHint}"
                                                                Suggestions="{Binding FilteredCustomers}"
                                                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                    
    
                                                                ValueMember="Id"
                                                                SuggestionChosen="CustomersAutoSuggestBox_SuggestionChosen" TextChanged="CustomersAutoSuggestBox_TextChanged">

                                                                <materialDesign:AutoSuggestBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border  BorderThickness="0,0,0,1"
                                                                                BorderBrush="#bbdefb"
                                                                   
                                                                                HorizontalAlignment="Stretch"
                                                                                VerticalAlignment="Stretch">
                                                                            <StackPanel Orientation="Vertical">
                                                                                <TextBlock FontWeight="Bold" Text="{Binding FullName}"/>
                                                                                <TextBlock Margin="5 0 0 0" Text="{Binding Address}"/>
                                                                                <StackPanel Margin="5 0 0 0" Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding PhoneTextBoxHint}" Margin="0 0 8 0" FontWeight="Bold"/>
                                                                                    <TextBlock Text="{Binding Phone}"/>
                                                                                </StackPanel>
                                                                                <StackPanel Margin="5 0 0 0" Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding ClientCodeTextBoxHint}" Margin="0 0 8 0" FontWeight="Bold"/>
                                                                                    <TextBlock Text="{Binding ClientCode}"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </materialDesign:AutoSuggestBox.ItemTemplate>
                                                            </materialDesign:AutoSuggestBox>

                                                            <Button 
                                                                Grid.Column="2"
                                                                Style="{StaticResource MaterialDesignToolButton}">
                                                            
                                                                <materialDesign:PackIcon
                                                                    Margin="8,0,0,0"
                                                                    Kind="Microphone"
                                                                    Opacity=".56" />
                                                            </Button>

                                                        </Grid>
                                                    </materialDesign:ColorZone>
                                                </StackPanel>

                                                <!-- The buttons follow the search box.
                                                     The 50px gap was doing nothing but
                                                     pushing the last three off the row. -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center">

                                                <Button Padding="3,0,3,0"
                                                    Margin="2,0,0,0"
                                                
                                                    ToolTip="{Binding SaveCustomerToolTip}"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                    Command="{Binding SaveCustomerCommand}" Click="OnSaveCustomerClick">

                                                    <materialDesign:PackIcon Kind="ContentSave" Width="21" Height="21" />
                                                </Button>

                                            <Button Padding="3,0,3,0"
                                                    Margin="2,0,0,0"
                                                
                                                    ToolTip="{Binding NewCustomerToolTip}"
                                                    Visibility="{Binding CanStartNewPatient, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                    Command="{Binding NewCustomerCommand}" Click="OnNewCustomerClick">

                                                <materialDesign:PackIcon Kind="AccountMultiplePlus" Width="21" Height="21"/>
                                            </Button>

                                            <!-- The way out of the trip form. -->
                                            <Button Padding="3,0,3,0" Margin="2,0,0,0"
                                                    ToolTip="{Binding CloseTripFormToolTip}"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                    Click="CloseTripForm_Click"
                                                    Visibility="{Binding IsTripFormOpen, Converter={StaticResource BoolToVisibility}}">
                                                <materialDesign:PackIcon Kind="Close" Width="21" Height="21"/>
                                            </Button>

                                            <!-- ⚠️ In the row, not docked to its right edge. A
                                                 DockPanel hands its docked children their edge
                                                 first and lets the LAST child fill what is left;
                                                 that last child is this StackPanel, which is
                                                 wider than what remained, so save and new patient
                                                 simply ran underneath these three. -->
                                            <Button Padding="3,0,3,0" Margin="2,0,0,0"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                    Command="{Binding StartTourCommand}"
                                                    ToolTip="{Binding TourHelpToolTip}">
                                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="21" Height="21"/>
                                            </Button>

                                            <Button Padding="3,0,3,0" Margin="2,0,0,0"
                                                    Style="{StaticResource MaterialDesignToolForegroundButton}"
                                                    Command="{Binding ToggleHelperCardsCommand}"
                                                    ToolTip="{Binding HelperCardsToolTip}">
                                                <materialDesign:PackIcon Kind="InformationOutline" Width="21" Height="21"/>
                                            </Button>


                                        </StackPanel>
                                    </Grid>
                                </materialDesign:ColorZone>

                            </StackPanel>


                            <!-- 🧾 Customer Info Section -->
                            <!-- <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0">-->                        
                        
                            <StackPanel Margin="2"
                                    Orientation="Vertical" 
                                    Background="{DynamicResource MaterialDesignPaper}" >

                        
                                    <!-- The form is the biggest thing on this screen and had
                                         nothing round it: card paper on window paper, no edge, so
                                         where it started and stopped was a guess. The line is the
                                         theme's own purple - the same one on the road and on the
                                         filter bar's kerb - so the three read as one system rather
                                         than three unrelated decorations.

                                         The border goes INSIDE the Card rather than on it: Card's
                                         template is MaterialDesign's, and what it does with
                                         BorderBrush is theirs to change. A Border of our own is
                                         ours. -->
                                    <!-- A line, not a relief. The elevation that was here cast a
                                         grey halo round the corners, which is the other half of
                                         the same complaint the Transparent column caused: on a
                                         white screen, every soft shadow reads as dirt. -->
                                    <materialDesign:Card Padding="0" UniformCornerRadius="4"
                                                         Background="{DynamicResource MaterialDesignPaper}">
                                      <Border BorderThickness="1" CornerRadius="4" Padding="4"
                                              BorderBrush="{StaticResource MainBorderBrush}">
                                        <StackPanel>
                                            
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Column -->
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="FullNameTextBox"
                                                             Text="{Binding SelectedCustomer.FullName}"
                                                             materialDesign:TextFieldAssist.HasClearButton="True"
                                                     
                                                             materialDesign:HintAssist.Hint="{Binding FullNameTextBoxHint}"
                                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                             materialDesign:TextFieldAssist.LeadingIcon="TextUser"
                                                             Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2">

                                                    <!--<TextBox.Text>
                                                        <Binding Path="SelectedCustomer.FullName" UpdateSourceTrigger="PropertyChanged">
                                                            <Binding.ValidationRules>
                                                                <domain:NotEmptyValidationRule ValidatesOnTargetUpdated="True"/>      
                                                            </Binding.ValidationRules>
                                                        </Binding>
                                                    </TextBox.Text>-->
                                                        
                                                    </TextBox>
                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="ClientCodeTextBox"
                                                             Text="{Binding SelectedCustomer.ClientCode}" 
                                                             materialDesign:HintAssist.Hint="{Binding ClientCodeTextBoxHint}" 
                                                             materialDesign:TextFieldAssist.HasClearButton="True"
                                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                             materialDesign:TextFieldAssist.LeadingIcon="Barcode"
                                                             Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>
                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="PhoneTextBox"
                                                                Text="{Binding SelectedCustomer.Phone}" 
                                                                 materialDesign:HintAssist.Hint="{Binding PhoneTextBoxHint}" 
                                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                 materialDesign:TextFieldAssist.LeadingIcon="Phone"
                                                                 Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>
                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="MobilePhoneTextBox"
                                                                Text="{Binding SelectedCustomer.MobilePhone}" 
                                                                 materialDesign:HintAssist.Hint="{Binding MobilePhoneTextBoxHint}" 
                                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                 materialDesign:TextFieldAssist.LeadingIcon="MobilePhone"
                                                                 Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>

                                                    <ComboBox   x:Name="SpaceTypeComboBox"
                                                                ItemsSource="{Binding SpaceTypes}" 
                                                                SelectedItem="{Binding SelectedSpaceType, Mode=TwoWay}" 
                                                                DisplayMemberPath="ShowNameDescription" 
                                                                SelectedValuePath="Id"
                                                                Style="{StaticResource MaterialDesignFilledComboBox}"
                                                                materialDesign:TextFieldAssist.HasClearButton="True"
                                                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                materialDesign:TextFieldAssist.LeadingIcon="HumanWheelchair"
                                                                Margin="0,0,0,2"
                                                                materialDesign:HintAssist.Hint="{Binding SpaceTypeComboBoxHint}" />

                                                    <ComboBox x:Name="FundingSourceComboBox"
                                                            ItemsSource="{Binding FundingSources}" 
                                                            SelectedItem="{Binding SelectedFundingSource, Mode=TwoWay}" 
                                                            DisplayMemberPath="Name" 
                                                            SelectedValuePath="Id"
                                                            Style="{StaticResource MaterialDesignFilledComboBox}"
                                                            materialDesign:TextFieldAssist.HasClearButton="True"
                                                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                            materialDesign:TextFieldAssist.LeadingIcon="Finance"
                                                            Margin="0,0,0,2"
                                                            materialDesign:HintAssist.Hint="{Binding FundingSourceComboBoxHint}" />

                                                </StackPanel>

                                                <!-- Right Column -->
                                                <StackPanel Grid.Column="1">

                                                    <Grid>
                                                        
                                                        <Button x:Name="GeolocateFloatingButton" Width="30" Height="30"
                                                                Panel.ZIndex="100"
                                                                Margin="8,6,16,-20"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                ToolTip="{Binding GeolocateFloatingButtonToolTip}"
                                                                Style="{StaticResource MaterialDesignFloatingActionMiniButton}" MouseEnter="GeolocateFloatingButton_MouseEnter" MouseLeave="GeolocateFloatingButton_MouseLeave" Click="GeolocateFloatingButton_Click">
                                                            <materialDesign:PackIcon Kind="AddressMarker" />
                                                        </Button>
                                                        
                                                        <TextBox x:Name="GooglePlacesInput" Text="{Binding SelectedCustomer.Address}"
                                                                 materialDesign:HintAssist.Hint="{Binding GooglePlacesInputHint}"
                                                    
                                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                 materialDesign:TextFieldAssist.LeadingIcon="AddressMarker"
                                                                 Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"
                                                                 TextChanged="GooglePlacesInput_TextChanged" />
                                                        
                                                    </Grid>

                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="City" Text="{Binding SelectedCustomer.City}" 
                                                                 materialDesign:HintAssist.Hint="{Binding CityHint}" 
                                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                 materialDesign:TextFieldAssist.LeadingIcon="City"
                                                                 Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>
                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="State" Text="{Binding SelectedCustomer.State}" 
                                                                 materialDesign:HintAssist.Hint="{Binding StateHint}" 
                                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                 materialDesign:TextFieldAssist.LeadingIcon="Estate"
                                                                 Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>
                                                    <TextBox TextChanged="CustomerField_Changed" x:Name="Zip" Text="{Binding SelectedCustomer.Zip}" 
                                                                 materialDesign:HintAssist.Hint="{Binding ZipHint}" 
                                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                 materialDesign:TextFieldAssist.LeadingIcon="EnvelopeBox"
                                                                 Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,2"/>


                                                    <DatePicker SelectedDateChanged="CustomerDate_Changed" x:Name="DOBDatePicker" SelectedDate="{Binding SelectedCustomer.DOB}" 
                                                                materialDesign:HintAssist.Hint="{Binding DOBDatePickerHint}" 
                                                                materialDesign:TextFieldAssist.HasClearButton="True"
                                                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                                materialDesign:TextFieldAssist.LeadingIcon="CalendarRange"
                                                                Style="{StaticResource MaterialDesignFilledDatePicker}" Margin="0,0,0,2"/>

                                                    <StackPanel 
                                                        Orientation="Horizontal" Margin="0,15,0,0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">

                                                        <RadioButton x:Name="MaleRadioButton" Content="{Binding MaleRadioButtonContent}"
                                                                         GroupName="GenderRadioButtonGroup"
                                                                         IsChecked="{Binding GenderMale}" 
                                                                         Style="{StaticResource MaterialDesignRadioButton}" Margin="0,0,10,0"/>
                                                        <RadioButton x:Name="FemaleRadioButton" Content="{Binding FemaleRadioButtonContent}"
                                                                         GroupName="GenderRadioButtonGroup"
                                                                         IsChecked="{Binding GenderFemale}" 
                                                                         Style="{StaticResource MaterialDesignRadioButton}"/>
                                                    </StackPanel>

                                                </StackPanel>

                                            </Grid>

                                        </StackPanel>
                                      </Border>
                                    </materialDesign:Card>
                        
                            </StackPanel>
                        
                            <!-- </ScrollViewer> -->

                        </StackPanel>
                        
                        
                        <!-- 📅 Trip Filters -->
                        
                        <!-- The -12 is not a fudge: it is exactly what the divider below grew
                             by, 6px to 18px, and that height came out of this row. Without it the
                             date, Show Canceled and the two buttons are cut off at the bottom. -->
                        <!-- ===== Where the form ends and the day's controls begin =====
                             These two read as one surface until something says otherwise: same
                             paper, same corner radius, no gap - and the negative margin below puts
                             them physically on top of each other, so a dispatcher could not tell
                             where the trip they were filling in stopped and the filters started.

                             Three things separate them now, and it takes all three. The kerb along
                             the top is the theme's primary, the same purple as the road forty
                             pixels down, so the eye files them as the same kind of edge. The
                             elevation puts this bar on a plane ABOVE the form rather than beside
                             it, which is what the overlap was always implying. The corner radius
                             finishes the bar as its own object.

                             The -12 stays: it is exactly what the road grew by, 6px to 18px, and
                             that height came out of this row. Without it the date, Show Canceled
                             and the two buttons are cut off at the bottom. -->
                        <materialDesign:Card Margin="2,-12,2,2"
                            Grid.Row="1"
                            Padding="0"
                            UniformCornerRadius="4"
                            Background="{DynamicResource MaterialDesignPaper}">
                          <!-- Framed on all four sides in the same hairline as the form above it,
                               and washed with the theme's purple at 8% so it has a body instead of
                               being a hole in the card. The wash is alpha over whatever is behind
                               it, so it stays a tint in either theme rather than a painted colour. -->
                          <Border BorderThickness="1" CornerRadius="4"
                                  BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                                  Background="#14673AB7"
                                  Padding="10">
                            
                            <StackPanel x:Name="TripFilterPanel"
                                        Visibility="{Binding IsTripFormOpen, Converter={StaticResource InverseBoolToVisibility}}">

                                
                                <Grid Margin="5" Background="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />                                       
                                        <RowDefinition Height="*" />                                      
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ContentControl Grid.Column="0" Content="{Binding}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        ContentTemplate="{StaticResource TripDatePicker}" />

                                        <ContentControl Grid.Column="1" Content="{Binding}"
                                                        ContentTemplate="{StaticResource ExpressFilterBar}" />
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0 5 0 0">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- What is hiding rows, on screen. This is what stops
                                                 "the list is empty and I do not know why". -->
                                            <ItemsControl ItemsSource="{Binding Filters.ActiveChips}" Margin="10,0,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="9" Margin="0,0,4,0" Padding="8,1,8,1"
                                                                Background="{DynamicResource MaterialDesignChipBackground}">
                                                            <TextBlock Text="{Binding}" FontSize="11"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="{Binding ClearAllFiltersLabel}"
                                                    Command="{Binding Filters.ClearAllCommand}"
                                                    Style="{StaticResource MaterialDesignToolButton}"
                                                    FontSize="11" Padding="6,0,6,0"
                                                    Visibility="{Binding Filters.HasActiveFilters, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                </Grid>
                            </StackPanel>
                          </Border>
                        </materialDesign:Card>

                        <!-- Trip Data Area-->                       

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="7*" />
                            </Grid.ColumnDefinitions>



                            <!-- ForDateCalendar -->

                            <!-- Adjusted calendar -->
                            <Calendar x:Name="ForDateCalendar"
                                  Visibility="{Binding IsTripFormOpen, Converter={StaticResource BoolToVisibility}}"
                                  Grid.Column="0"
                                  SelectedDate="{Binding TripDate, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Margin="0"
                                  materialDesign:ElevationAssist.Elevation="Dp2"
                                  >     
                                <Calendar.LayoutTransform>
                                    <ScaleTransform ScaleX="0.75" ScaleY="0.685"/>
                                </Calendar.LayoutTransform>
                            </Calendar>

                            <!-- Trips TabControl -->
                        
                            <TabControl x:Name="TripTabs" Grid.Column="1"
                                    Visibility="{Binding IsTripFormOpen, Converter={StaticResource BoolToVisibility}}"
                                    MinHeight="240"
                                    MaxHeight="240"
                                    HorizontalContentAlignment="Left"
                                
                                    materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                                
                                    TabStripPlacement="Top"
                                    materialDesign:NavigationRailAssist.SelectionCornerRadius="50 10 10 10">
                                <!-- Tab 1: Location and Time -->
                                <TabItem Header="{Binding TripTabsTabItem1Header}" >
                                    <Grid Margin="0,0,2,0" >
                                        
                                    <Grid.Background>
                                        <RadialGradientBrush GradientOrigin="0.5,0.5" 
                                            Center="0.5,0.5" 
                                            RadiusX="0.5" 
                                            RadiusY="0.5">  
                                            <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                            <!-- Blanco (100% opaco) -->
                                            <GradientStop Color="#D3FFD6" Offset="0.94"/>
                                            <!-- Verde en 94% -->
                                            <GradientStop Color="#D3FFD6" Offset="1.0"/>
                                            <!-- Verde en 100% -->
                                        </RadialGradientBrush>
                                    </Grid.Background>
                                        
                                    <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6*" />
                                            <ColumnDefinition Width="4*" />
                                        </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>

                                    <!-- Left column -->

                                    <Button x:Name="InverterFloatingButton" Width="30" Height="30"
                                        Panel.ZIndex="100"
                                        Margin="12,9,16,-17"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        ToolTip="{Binding InverterFloatingButtonToolTip}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Click="InverterFloatingButton_Click" >
                                        <materialDesign:PackIcon x:Name="InverterIcon" Kind="AutorenewOff" />


                                    </Button>
                                        
                                    <TextBox
                                            x:Name="PickupAddressTextBox" Grid.Row="0" Grid.Column="0" Margin="0,3,0,2"
                                            Text="{Binding PickupAddress, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" 
                                            Background="#F5F5F5"
                                        
                                            materialDesign:HintAssist.Hint="{Binding PickupAddressTextBoxHint}"                                                    
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                            materialDesign:TextFieldAssist.LeadingIcon="HomeMapMarker"
                                            Style="{StaticResource MaterialDesignFilledTextBox}" 
                                            TextChanged="GooglePlacesInput_TextChanged"/>

                                        <!-- (2) Where they are going. -->
                                        <Border Grid.Row="1" Grid.Column="0" Panel.ZIndex="20"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,6,0"
                                                Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step2State}">
                                            <TextBlock Text="2" Style="{StaticResource StepBadgeTextStyle}"/>
                                        </Border>

                                        <TextBox
                                            x:Name="DropoffAddressTextBox" Grid.Row="1" Grid.Column="0" Margin="0,0,0,2"
                                            Text="{Binding DropoffAddress, UpdateSourceTrigger=PropertyChanged}"
                                            IsReadOnly="True" 
                                            Background="#F5F5F5"
                                            
                                            materialDesign:HintAssist.Hint="{Binding DropoffAddressTextBoxHint}"                                                    
                                            materialDesign:TextFieldAssist.HasClearButton="False"
                                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                            materialDesign:TextFieldAssist.LeadingIcon="MapMarkerCheck"
                                            Style="{StaticResource MaterialDesignFilledTextBox}" 
                                            TextChanged="DropoffAddressTextBox_TextChanged"/>

                                    <!-- (2.2) Visible and grey with the reason beside it, never
                                         missing. A button that is not there teaches nobody
                                         anything; one that says "Missing: dropoff address"
                                         teaches the whole screen. The reason is the same list
                                         SaveTrip checks, in the same order. -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal"
                                                Panel.ZIndex="100" Margin="12,19,16,-17"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom">

                                        <!-- (4) And create it. -->
                                        <Border Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step4State}"
                                                Margin="0,0,6,0">
                                            <TextBlock Text="4" Style="{StaticResource StepBadgeTextStyle}"/>
                                        </Border>

                                        <Button x:Name="SaveTab1FloatingButton" Width="30" Height="30"
                                            IsEnabled="{Binding CanCreateTrip}"
                                            ToolTip="{Binding CreateTripHint}"
                                            Command="{Binding SaveTripCommand}"
                                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Click="SaveTab1FloatingButton_Click">
                                            <materialDesign:PackIcon  Kind="ContentSave" />
                                        </Button>

                                        <TextBlock Text="{Binding CreateTripHint}" VerticalAlignment="Center"
                                                   Margin="6,0,0,0" FontSize="11" TextWrapping="Wrap" MaxWidth="220"/>
                                    </StackPanel>


                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Margin="0,10,10,5">
                                            <RadioButton x:Name="RoundTripRadioButton" Content="{Binding RoundTripRadioButtonContent}" GroupName="TripType" IsChecked="{Binding IsRoundTrip}" Margin="0,0,10,0" Checked="RoundTripRadioButton_Checked"/>
                                            <RadioButton x:Name="OneWayRadioButton" Content="{Binding OneWayRadioButtonContent}" GroupName="TripType" IsChecked="{Binding IsOneWay}" Checked="OneWayRadioButton_Checked"/>
                                        </StackPanel>

                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Margin="0,10,10,5">
                                            <RadioButton x:Name="AppointmentRadioButton" Content="{Binding AppointmentRadioButtonContent}" GroupName="OneWayKind" IsChecked="{Binding IsAppointment}" Margin="0,0,10,0" Checked="AppointmentRadioButton_Checked"/>
                                            <RadioButton x:Name="ReturnRadioButton" Content="{Binding ReturnRadioButtonContent}" GroupName="OneWayKind" IsChecked="{Binding IsReturn}" Checked="ReturnRadioButton_Checked"/>
                                        </StackPanel>

                                        <!-- Right column -->                                   

                                        <!-- (3) When. -->
                                        <Border Grid.Row="0" Grid.Column="1" Panel.ZIndex="20"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,6,0"
                                                Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step3State}">
                                            <TextBlock Text="3" Style="{StaticResource StepBadgeTextStyle}"/>
                                        </Border>

                                        <materialDesign:TimePicker Grid.Row="0" Grid.Column="1"
                                            x:Name="PickupTimePicker"
                                            SelectedTime="{Binding PickupTimePicker, Mode=TwoWay}"
                                            VerticalAlignment="Bottom"
                                            Margin="10,0,0,0"
                                            materialDesign:HintAssist.Hint="{Binding PickupTimePickerHint}"
                                            materialDesign:TextFieldAssist.HasClearButton="True"
                                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                            materialDesign:TextFieldAssist.LeadingIcon="ClockTimeFour"
                                            Style="{StaticResource MaterialDesignFilledTimePicker}"
                                            Is24Hours="False"/>

                                        <materialDesign:TimePicker Grid.Row="1" Grid.Column="1"
                                            x:Name="ApptTimePicker"
                                            SelectedTime="{Binding ApptTimePicker, Mode=TwoWay}"              
                                            VerticalAlignment="Bottom"
                                            Margin="10,0,0,0"
                                            materialDesign:HintAssist.Hint="{Binding ApptTimePickerHint}"
                                            materialDesign:TextFieldAssist.HasClearButton="True"
                                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                            materialDesign:TextFieldAssist.LeadingIcon="CalendarClock"
                                            Style="{StaticResource MaterialDesignFilledTimePicker}"
                                            Is24Hours="False"/>

                                        <materialDesign:TimePicker Grid.Row="2" Grid.Column="1"
                                            x:Name="ReturnTimePicker"
                                            SelectedTime="{Binding ReturnTimePicker, Mode=TwoWay}" 
                                            VerticalAlignment="Bottom"
                                            Margin="10,0,0,0"
                                            materialDesign:HintAssist.Hint="{Binding ReturnTimePickerHint}"
                                            materialDesign:TextFieldAssist.HasClearButton="True"
                                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                            materialDesign:TextFieldAssist.LeadingIcon="ClockAlert"
                                            Style="{StaticResource MaterialDesignFilledTimePicker}"
                                            Is24Hours="False"/>

                                        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" Margin="10,10,0,5">
                                            <!-- ⚠️ Live only while booking. On an existing trip
                                                 Will Call moves through Activate / Back to Will
                                                 Call in Schedule, which leaves a record and tells
                                                 the patient; the server ignores it on every update
                                                 route, so a live box here would tick, save, and
                                                 change nothing without saying so. -->
                                            <CheckBox x:Name="WillCallCheckBox" Content="{Binding WillCallLabel}"
                                                      IsChecked="{Binding IsWillCall}"
                                                      IsEnabled="{Binding CanEditWillCall}"
                                                      ToolTip="{Binding WillCallLockedToolTip}"
                                                      ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>

                                <!-- Tab 2: Space Type -->
                                <TabItem Header="{Binding TripTabsTabItem2Header}">
                                    <Grid Margin="0" >

                                    <Grid.Background>
                                        <RadialGradientBrush GradientOrigin="0.5,0.5" 
                                            Center="0.5,0.5" 
                                            RadiusX="0.5" 
                                            RadiusY="0.5">          
                                            <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                            <!-- Blanco (100% opaco) -->
                                            <GradientStop Color="#D1ECF8" Offset="0.94"/>
                                            <!-- Verde en 94% -->
                                            <GradientStop Color="#D1ECF8" Offset="1.0"/>
                                            <!-- Verde en 100% -->
                                        </RadialGradientBrush>
                                    </Grid.Background>
                                    <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>


                                    </Border>
                                    <TextBlock Text="{Binding Step1Label}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step2State}">
                                        <TextBlock Text="2" Style="{StaticResource StepBadgeTextStyle}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Step2Label}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step3State}">
                                        <TextBlock Text="3" Style="{StaticResource StepBadgeTextStyle}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Step3Label}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource StepBadgeStyle}" Tag="{Binding Step4State}">
                                        <TextBlock Text="4" Style="{StaticResource StepBadgeTextStyle}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Step4Label}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>

                                <Separator Margin="0,6,0,4"/>
                                <TextBlock Text="{Binding CreateTripHint}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Popup>

                <Popup IsOpen="{Binding IsPatientCardOpen, Mode=OneWay}"
                       PlacementTarget="{Binding ElementName=HomeRoot}" Placement="Relative"
                       HorizontalOffset="{Binding PatientCardX, Mode=OneWay}"
                       VerticalOffset="{Binding PatientCardY, Mode=OneWay}"
                       AllowsTransparency="True" StaysOpen="True">
                    <materialDesign:Card Margin="4" materialDesign:ElevationAssist.Elevation="Dp4" Width="240">
                        <StackPanel>
                            <Border Tag="patient" Padding="8,3,4,3" Cursor="SizeAll"
                                    MouseLeftButtonDown="HelperCard_DragStart"
                                    MouseMove="HelperCard_Drag"
                                    MouseLeftButtonUp="HelperCard_DragEnd">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#9E9E9E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CustomerStateTag}" Value="unsaved">
                                                <Setter Property="Background" Value="#E65100"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Padding="1" Foreground="White"
                                            Style="{StaticResource MaterialDesignToolButton}"
                                            Command="{Binding HideHelperCardsCommand}">
                                        <materialDesign:PackIcon Kind="Close" Width="13" Height="13"/>
                                    </Button>
                                    <TextBlock Text="{Binding CustomerStateLabel}" Foreground="White"
                                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>

                            <StackPanel Margin="8,6,8,8">
                                <TextBlock Text="{Binding CustomerValidationMessage}" FontSize="11" Foreground="#C62828"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding CustomerValidationMessage, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding DuplicateCustomerWarning}" FontSize="11" Foreground="#E65100"
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding DuplicateCustomerWarning, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                                <Button Content="{Binding DiscardChangesLabel}" HorizontalAlignment="Left"
                                        Command="{Binding DiscardCustomerChangesCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}" FontSize="11" Padding="0,2,0,2"
                                        Visibility="{Binding HasCustomerChanges, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Popup>

                <!-- ================= The first-run tour (2.2c) =================
                     Four balloons, each anchored to the control its step is about. They read the
                     same TripCreationStep as the badges and the stepper and decide nothing of
                     their own, so any of the three can be switched off later without touching
                     logic. It runs by itself exactly once; after that it is the ? button.
                -->
                <!-- Balloon 1 -->
                <Popup IsOpen="{Binding IsTourStep1, Mode=OneWay}" PlacementTarget="{Binding ElementName=CustomersAutoSuggestBox}"
                       Placement="Bottom" AllowsTransparency="True" StaysOpen="True">
                    <materialDesign:Card Margin="6" Padding="12" MaxWidth="320"
                                         materialDesign:ElevationAssist.Elevation="Dp5">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Style="{StaticResource StepBadgeStyle}" Tag="current">
                                    <TextBlock Text="1" Style="{StaticResource StepBadgeTextStyle}"/>
                                </Border>
                                <TextBlock Text="{Binding Step1Label}" FontWeight="Bold" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TourBody1}" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding TourNextLabel}"
                                        Command="{Binding NextTourStepCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                                <Button HorizontalAlignment="Left" Content="✕"
                                        Command="{Binding EndTourCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"/>
                            </DockPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Popup>

                <!-- Balloon 2 -->
                <Popup IsOpen="{Binding IsTourStep2, Mode=OneWay}" PlacementTarget="{Binding ElementName=DropoffAddressTextBox}"
                       Placement="Right" AllowsTransparency="True" StaysOpen="True">
                    <materialDesign:Card Margin="6" Padding="12" MaxWidth="320"
                                         materialDesign:ElevationAssist.Elevation="Dp5">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Style="{StaticResource StepBadgeStyle}" Tag="current">
                                    <TextBlock Text="2" Style="{StaticResource StepBadgeTextStyle}"/>
                                </Border>
                                <TextBlock Text="{Binding Step2Label}" FontWeight="Bold" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TourBody2}" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding TourNextLabel}"
                                        Command="{Binding NextTourStepCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                                <Button HorizontalAlignment="Left" Content="✕"
                                        Command="{Binding EndTourCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"/>
                            </DockPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Popup>

                <!-- Balloon 3 -->
                <Popup IsOpen="{Binding IsTourStep3, Mode=OneWay}" PlacementTarget="{Binding ElementName=PickupTimePicker}"
                       Placement="Right" AllowsTransparency="True" StaysOpen="True">
                    <materialDesign:Card Margin="6" Padding="12" MaxWidth="320"
                                         materialDesign:ElevationAssist.Elevation="Dp5">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Style="{StaticResource StepBadgeStyle}" Tag="current">
                                    <TextBlock Text="3" Style="{StaticResource StepBadgeTextStyle}"/>
                                </Border>
                                <TextBlock Text="{Binding Step3Label}" FontWeight="Bold" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TourBody3}" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding TourNextLabel}"
                                        Command="{Binding NextTourStepCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                                <Button HorizontalAlignment="Left" Content="✕"
                                        Command="{Binding EndTourCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"/>
                            </DockPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Popup>

                <!-- Balloon 4 -->
                <Popup IsOpen="{Binding IsTourStep4, Mode=OneWay}" PlacementTarget="{Binding ElementName=SaveTab1FloatingButton}"
                       Placement="Top" AllowsTransparency="True" StaysOpen="True">
                    <materialDesign:Card Margin="6" Padding="12" MaxWidth="320"
                                         materialDesign:ElevationAssist.Elevation="Dp5">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Style="{StaticResource StepBadgeStyle}" Tag="current">
                                    <TextBlock Text="4" Style="{StaticResource StepBadgeTextStyle}"/>
                                </Border>
                                <TextBlock Text="{Binding Step4Label}" FontWeight="Bold" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TourBody4}" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding TourDoneLabel}"
                                        Command="{Binding EndTourCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                                <Button HorizontalAlignment="Left" Content="✕"
                                        Command="{Binding EndTourCommand}"
                                        Style="{StaticResource MaterialDesignToolButton}"/>
                            </DockPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Popup>

                <!-- ================= Complex filters (2.4) =================
                     It slides over the grid instead of pushing it aside: the list stays visible
                     and refilters as the ticks change, which is the only way to see whether a
                     filter did what you meant. Clicking anywhere outside closes it, and so does
                     Esc — see HomeView_PreviewKeyDown. -->
                <!-- ⚠️ A Popup, not a panel inside the layout, and that is the whole point.
                     MapaWebView is a WebView2: an HWND hosted inside WPF, which Windows always
                     draws on top of WPF content in the same window whatever the z-order says.
                     A Border laid over the map was simply not visible where it crossed it. A
                     Popup gets a top-level window of its own, so it draws above the map.

                     StaysOpen=False is what closes it on a click outside; IsOpen binds two ways
                     so that closing itself is reported back. Esc is handled in the code-behind,
                     which still sees the key because a Popup's content stays in the logical tree. -->
                <Popup IsOpen="{Binding IsFilterPanelOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=HomeRoot}"
                       Placement="Right" HorizontalOffset="-380"
                       StaysOpen="False" AllowsTransparency="True" Focusable="True">
                    <Border Width="380"
                            Height="{Binding ActualHeight, ElementName=HomeRoot}"
                            Background="{DynamicResource MaterialDesignPaper}"
                            BorderBrush="{StaticResource MainBorderBrush}" BorderThickness="1,0,0,0"
                            materialDesign:ElevationAssist.Elevation="Dp4">

                        <DockPanel>

                            <!-- Header: how much is getting through, and the way out of all of it -->
                            <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryMid" Padding="14,10,8,10"
                                                      materialDesign:ElevationAssist.Elevation="Dp2">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignToolForegroundButton}"
                                            Command="{Binding CloseFilterPanelCommand}" Padding="2"
                                            VerticalAlignment="Top">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                                    </Button>
                                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="FilterVariant"
                                                             Width="22" Height="22" Margin="0,1,10,0"
                                                             VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FiltersHeader}" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="{Binding GridSummary}" FontSize="11" Opacity=".85" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </materialDesign:ColorZone>

                            <!-- Footer: clear everything, and keep this set under a name -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,0"
                                        Background="{DynamicResource MaterialDesignPaper}">
                                <Separator Margin="0" Opacity=".5"/>
                                <StackPanel Margin="12,10,12,12">
                                <Button Content="{Binding ClearAllFiltersLabel}"
                                        Command="{Binding Filters.ClearAllCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,10" Height="30" FontSize="12"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{Binding SaveViewLabel}"
                                            Command="{Binding Filters.SaveViewCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}" FontSize="12"/>
                                    <TextBox Text="{Binding Filters.NewViewName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="{Binding MyFiltersHint}" FontSize="12"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Filters.SavedViews}" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Margin="0,0,4,4" Padding="8,1,2,1"
                                                    Background="{DynamicResource MaterialDesignChipBackground}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{Binding}" Padding="0"
                                                            Style="{StaticResource MaterialDesignToolButton}"
                                                            Command="{Binding DataContext.Filters.ApplyViewCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource MaterialDesignToolButton}" Padding="2"
                                                            Command="{Binding DataContext.Filters.DeleteViewCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Close" Width="12" Height="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Tinted a few percent so the section cards read as sitting on a
                                 surface rather than floating on the same sheet they are drawn on. -->
                            <Border Background="#0A000000">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10,12,4">
                                    <StackPanel>
                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="True" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Wheelchair" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding SpaceTypeFilterText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Filters.SpaceTypes}" Margin="26,2,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                                                  Style="{StaticResource FilterOptionCheckBox}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CashMultiple" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding FundingSourceText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Filters.FundingSources}" Margin="26,2,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                                                  Style="{StaticResource FilterOptionCheckBox}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FlagVariant" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding StatusFilterText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Filters.Statuses}" Margin="26,2,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                                                  Style="{StaticResource FilterOptionCheckBox}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="SwapHorizontal" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding TypeText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Filters.Types}" Margin="26,2,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                                                  Style="{StaticResource FilterOptionCheckBox}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CityVariantOutline" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding CitiesFilterText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Margin="26,2,0,4">
                                                <TextBlock Text="{Binding CityScopeText}" Style="{StaticResource FilterSubLabel}" Margin="0,0,0,3"/>
                                                <UniformGrid Columns="3" Margin="0,0,0,4">
                                                    <RadioButton Content="{Binding ScopeBothText}" GroupName="CityScope" FontSize="11"
                                                                 IsChecked="{Binding Filters.CityScope, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Both}"/>
                                                    <RadioButton Content="{Binding PickupText}" GroupName="CityScope" FontSize="11"
                                                                 IsChecked="{Binding Filters.CityScope, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Pickup}"/>
                                                    <RadioButton Content="{Binding DropoffText}" GroupName="CityScope" FontSize="11"
                                                                 IsChecked="{Binding Filters.CityScope, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Dropoff}"/>
                                                </UniformGrid>
                                                <Separator Margin="0,2,0,4" Opacity=".4"/>
                                                <ItemsControl ItemsSource="{Binding Filters.Cities}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                                                      Style="{StaticResource FilterOptionCheckBox}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ClockOutline" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding PickupWindowText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Margin="26,4,0,4">
                                                <materialDesign:TimePicker Is24Hours="True" FontSize="12"
                                                    SelectedTime="{Binding Filters.PickupFrom, Converter={StaticResource TimeSpanToDateConverter}, Mode=TwoWay}"
                                                    materialDesign:HintAssist.Hint="{Binding FromTimeText}"/>
                                                <materialDesign:TimePicker Is24Hours="True" Margin="0,10,0,0" FontSize="12"
                                                    SelectedTime="{Binding Filters.PickupTo, Converter={StaticResource TimeSpanToDateConverter}, Mode=TwoWay}"
                                                    materialDesign:HintAssist.Hint="{Binding ToTimeText}"/>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="True" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="TuneVariant" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding OtherFiltersText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Margin="26,2,0,4">
                                                <TextBlock Text="Will Call" Style="{StaticResource FilterSubLabel}"/>
                                                <UniformGrid Columns="3">
                                                    <RadioButton Content="{Binding FlagAnyText}" GroupName="WillCallFilter" FontSize="11"
                                                                 IsChecked="{Binding Filters.WillCall, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Any}"/>
                                                    <RadioButton Content="{Binding FlagYesText}" GroupName="WillCallFilter" FontSize="11"
                                                                 IsChecked="{Binding Filters.WillCall, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Yes}"/>
                                                    <RadioButton Content="{Binding FlagNoText}" GroupName="WillCallFilter" FontSize="11"
                                                                 IsChecked="{Binding Filters.WillCall, Converter={StaticResource EnumMatchConverter}, ConverterParameter=No}"/>
                                                </UniformGrid>

                                                <TextBlock Text="{Binding RunText}" Style="{StaticResource FilterSubLabel}"/>
                                                <UniformGrid Columns="3">
                                                    <RadioButton Content="{Binding FlagAnyText}" GroupName="RunFilter" FontSize="11"
                                                                 IsChecked="{Binding Filters.HasRoute, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Any}"/>
                                                    <RadioButton Content="{Binding FlagYesText}" GroupName="RunFilter" FontSize="11"
                                                                 IsChecked="{Binding Filters.HasRoute, Converter={StaticResource EnumMatchConverter}, ConverterParameter=Yes}"/>
                                                    <RadioButton Content="{Binding FlagNoText}" GroupName="RunFilter" FontSize="11"
                                                                 IsChecked="{Binding Filters.HasRoute, Converter={StaticResource EnumMatchConverter}, ConverterParameter=No}"/>
                                                </UniformGrid>

                                                <Separator Margin="0,8,0,4" Opacity=".4"/>
                                                <CheckBox IsChecked="{Binding Filters.OnlyMissingCoordinates}"
                                                          Content="{Binding MissingCoordinatesText}"
                                                          Style="{StaticResource FilterOptionCheckBox}"/>
                                                <TextBlock Text="{Binding MissingCoordinatesHint}" FontSize="10" Opacity=".7"
                                                           TextWrapping="Wrap" Margin="26,0,0,0"/>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border Style="{StaticResource FilterSectionCard}">
                                        <Expander IsExpanded="False" Background="Transparent" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="MapMarkerOutline" Style="{StaticResource FilterSectionIcon}"/>
                                                    <TextBlock Text="{Binding ZipStateText}" Style="{StaticResource FilterSectionHeader}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Margin="26,4,0,4">
                                                <TextBlock Text="{Binding ZipStateWarning}" FontSize="10" Opacity=".7"
                                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <TextBox Text="{Binding Filters.Zip, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                         materialDesign:HintAssist.Hint="{Binding ZipHint}" FontSize="12"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                <TextBox Margin="0,10,0,0"
                                                         Text="{Binding Filters.State, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                         materialDesign:HintAssist.Hint="{Binding StateHint}" FontSize="12"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </DockPanel>
                    </Border>
                </Popup>

            </Grid>

        </Border>

    </materialDesign:DialogHost>
    
</UserControl>

<UserControl x:Class="Raphael.Desktop.Views.Schedules.CallCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Raphael.Desktop.Converters"
             xmlns:services="clr-namespace:Raphael.Desktop.Services"
             xmlns:notifications="clr-namespace:Raphael.Desktop.Views.Notifications">

    <!-- DataContext: CallCardViewModel. The call being handled, on top of the driver's route:
         the number, how long they waited, the stop they are on, and the buttons to close the case,
         so nobody switches screens while the driver is on the line. -->

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <SolidColorBrush x:Key="Accent" Color="#673AB7" />
        <SolidColorBrush x:Key="Muted" Color="#5F6368" />

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Margin" Value="0 0 8 0" />
            <Setter Property="Padding" Value="12 2" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Margin" Value="0 0 8 0" />
            <Setter Property="Padding" Value="14 2" />
            <Setter Property="Height" Value="30" />
        </Style>
    </UserControl.Resources>

    <Border Background="#F5F2FB" BorderBrush="#B39DDB" BorderThickness="1" CornerRadius="6"
            Padding="12 8" Margin="0 4 0 6">
        <StackPanel>

            <!-- Who, the number, and the way back to the queue. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PhoneInTalk" Width="20" Height="20" VerticalAlignment="Center"
                                             Foreground="{StaticResource Accent}" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="8 0 0 0" VerticalAlignment="Center">
                        <Run Text="{Binding Item.DriverName, Mode=OneWay}" />
                        <Run Text="  ·  " Foreground="{StaticResource Muted}" FontWeight="Normal" />
                        <Run Text="{Binding Item.RouteText, Mode=OneWay}" Foreground="{StaticResource Muted}" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock Text="{Binding Detail.VehicleText}" Foreground="{StaticResource Muted}" Margin="10 0 0 0"
                               VerticalAlignment="Center" />

                    <TextBox Text="{Binding Detail.PhoneText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             FontSize="16" FontWeight="SemiBold" Margin="18 0 4 0" VerticalAlignment="Center"
                             Background="Transparent" />
                    <Button Command="{Binding CopyPhoneCommand}" Style="{StaticResource MaterialDesignIconButton}"
                            Width="28" Height="28" VerticalAlignment="Center"
                            ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestCopyPhone]}">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15" />
                    </Button>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Click="Help_Click" Tag="desktop/notifications/call-requests"
                            Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28"
                            ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestHelp]}">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16" />
                    </Button>
                    <Button Command="{Binding OpenInQueueCommand}" Style="{StaticResource MaterialDesignIconButton}"
                            Width="28" Height="28"
                            ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestOpenInQueue]}">
                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="16" Height="16" />
                    </Button>
                    <Button Command="{Binding CloseCommand}" Style="{StaticResource MaterialDesignIconButton}"
                            Width="28" Height="28"
                            ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestCloseCard]}">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- When they asked, how long, how many times; and where the day stands. -->
            <WrapPanel Margin="28 4 0 0">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestAskedAt], Mode=OneWay}" />
                    <Run Text="{Binding Item.RequestedAtText, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Text="{Binding Item.WaitingText}" Foreground="{Binding Item.WaitingBrush}" Margin="10 0 0 0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Item.ReminderTooltip}" Foreground="#B3261E" Margin="10 0 0 0" VerticalAlignment="Center"
                           Visibility="{Binding Item.HasReminders, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Item.NumberOfDayText}" Foreground="{StaticResource Accent}" Margin="10 0 0 0"
                           VerticalAlignment="Center"
                           Visibility="{Binding Item.IsRepeatOfDay, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Item.StatusText}" Foreground="{Binding Item.StatusBrush}" FontWeight="SemiBold"
                           Margin="16 0 0 0" VerticalAlignment="Center" />
            </WrapPanel>

            <WrapPanel Margin="28 4 0 0" Visibility="{Binding Detail.HasRouteContext, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestNow]}"
                           FontWeight="SemiBold" Margin="0 0 6 0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Detail.NextStopText}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Detail.NextStopLatenessText}" Foreground="{Binding Detail.NextStopLatenessBrush}"
                           FontWeight="SemiBold" Margin="8 0 0 0" VerticalAlignment="Center"
                           Visibility="{Binding Detail.HasNextStopLateness, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Detail.ProgressText}" Foreground="{StaticResource Muted}" Margin="16 0 0 0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Detail.LastPositionText}" Foreground="{StaticResource Muted}" Margin="16 0 0 0"
                           VerticalAlignment="Center" />
            </WrapPanel>

            <!-- What changed that the dispatcher must not miss. -->
            <TextBlock Text="{Binding Item.AttemptsText}" Foreground="#B3261E" Margin="28 4 0 0"
                       Visibility="{Binding Item.HasMissedCall, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Item.DriverCanTalkText}" Foreground="#137333" FontWeight="SemiBold" Margin="28 4 0 0"
                       Visibility="{Binding Item.DriverCanTalk, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestRouteUnavailable]}"
                       Foreground="#B06000" Margin="28 4 0 0" TextWrapping="Wrap"
                       Visibility="{Binding RouteUnavailable, Converter={StaticResource BoolToVis}}" />

            <!-- Opened to look, not yet taken. -->
            <StackPanel Orientation="Horizontal" Margin="28 8 0 0"
                        Visibility="{Binding Item.IsWaiting, Converter={StaticResource BoolToVis}}">
                <Button Command="{Binding AttendCommand}" Style="{StaticResource PrimaryButton}"
                        Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestAttend]}" />
                <Button Command="{Binding StartResolveCommand}" Style="{StaticResource ActionButton}"
                        Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestResolve]}" />
            </StackPanel>

            <!-- Mine and open: work it. -->
            <StackPanel Orientation="Horizontal" Margin="28 8 0 0"
                        Visibility="{Binding Item.IsMine, Converter={StaticResource BoolToVis}}">
                <Button Command="{Binding NoAnswerCommand}" Style="{StaticResource ActionButton}"
                        Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestNoAnswer]}" />
                <Button Command="{Binding StartResolveCommand}" Style="{StaticResource PrimaryButton}"
                        Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestResolve]}" />
                <Button Command="{Binding ReleaseCommand}" Style="{StaticResource ActionButton}"
                        Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestRelease]}" />
            </StackPanel>

            <!-- Somebody else has it now. -->
            <StackPanel Orientation="Horizontal" Margin="28 8 0 0"
                        Visibility="{Binding Item.IsHeldByOther, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding HeldByOtherText}" VerticalAlignment="Center" Margin="0 0 12 0" />
                <Button Command="{Binding TakeOverCommand}" Style="{StaticResource ActionButton}"
                        Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestTakeOver]}" />
            </StackPanel>

            <!-- Closed: say how, and offer the next one. -->
            <StackPanel Orientation="Horizontal" Margin="28 8 0 0"
                        Visibility="{Binding Item.IsClosed, Converter={StaticResource BoolToVis}}">
                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" Foreground="#188038"
                                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding ClosedText}" VerticalAlignment="Center" Margin="6 0 16 0" />
                <Button Command="{Binding AttendNextCommand}" Style="{StaticResource PrimaryButton}"
                        Content="{Binding AttendNextText}" />
                <Button Command="{Binding CloseCommand}" Style="{StaticResource ActionButton}"
                        Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[CallRequestCloseCard]}" />
            </StackPanel>

            <notifications:CallResolveForm DataContext="{Binding Resolve}" Margin="28 0 0 0" />

        </StackPanel>
    </Border>

</UserControl>

<UserControl x:Class="Raphael.Desktop.Views.Schedules.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Raphael.Desktop.Views.Schedules"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Raphael.Desktop.Converters"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
             xmlns:maps="clr-namespace:Raphael.Desktop.Helpers.Maps"
             xmlns:models="clr-namespace:Raphael.Desktop.Models"
             xmlns:gmaps="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
             xmlns:gong="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
             
             mc:Ignorable="d" 
             xmlns:vm="clr-namespace:Raphael.Desktop.ViewModels"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:EtaViolationConverter x:Key="EtaViolationConverter"/>
        <converters:LocationToPointConverter x:Key="LocationToPointConverter"/>
        <converters:ColumnVisibilityConverter x:Key="ColumnVisibilityConverter"/>
        <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}" />
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter" />
        <converters:DirectionToAngleConverter x:Key="DirectionToAngleConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:NullToBooleanConverter x:Key="NullToBoolConverter"/>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>
        
        <SolidColorBrush x:Key="StoppedBlueBrush" Color="#A9D0F5"/>
        <SolidColorBrush x:Key="NormalSpeedBlueBrush" Color="#0078D7"/>
        <SolidColorBrush x:Key="SpeedingBlueBrush" Color="#003366"/>


        <!-- WE INSTANT AND CONFIGURE OUR SMART CONVERTER -->
        <converters:SpeedToBrushConverter x:Key="SmartSpeedToBrushConverter"
                                      StoppedThreshold="2.0"
                                      SpeedingThreshold="65.0"
                                      StoppedBrush="{StaticResource StoppedBlueBrush}"
                                      NormalSpeedBrush="{StaticResource NormalSpeedBlueBrush}"
                                      SpeedingBrush="{StaticResource SpeedingBlueBrush}" />
        
        <!-- ===== Action buttons in a grid row =====
             Feedback that does not depend on the button template. MaterialDesignToolButton
             paints its own hover, but inside a dense grid row it is too faint to tell the
             dispatcher which of seven icons they are about to press — and pressing the wrong
             one here cancels somebody's ride. Scale and cursor read on any template: the icon
             grows under the pointer and presses in when held.

             Focusable=false on purpose. The row, not the button, should keep keyboard focus,
             and a button that takes focus makes the grid spend a click handing it over. -->
        <Style x:Key="TripActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Centred header text for the trips grid. Declared here and not in
             CustomColumnHeaderStyle because that style is shared by every grid in the
             application, and this is a decision about this screen. -->
        <Style x:Key="CenteredColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CustomColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- ===== The accent bar, painted and not laid out =====
             The bar used to be a 4px left BorderThickness on the row. A border insets the row's
             content, so every column in the body slid four pixels away from its own header and
             the dividing lines stopped meeting. These brushes draw the same bar inside the row's
             background instead: MappingMode="Absolute" makes the gradient measure in pixels, so
             the first 4px are solid accent and everything past them is the wash. Nothing moves,
             and the column lines run unbroken from the header to the last row.

             The wash is deliberately far lighter than the bar — the bar says WHICH row, the wash
             says the row is selected, and they must not compete. -->
        <LinearGradientBrush x:Key="SelectedTripRowBrush"
                             MappingMode="Absolute" StartPoint="0,0" EndPoint="8,0" SpreadMethod="Pad">
            <GradientStop Color="#FF673AB7" Offset="0"/>
            <GradientStop Color="#FF673AB7" Offset="0.499"/>
            <GradientStop Color="#38673AB7" Offset="0.5"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HoverTripRowBrush"
                             MappingMode="Absolute" StartPoint="0,0" EndPoint="8,0" SpreadMethod="Pad">
            <GradientStop Color="#80673AB7" Offset="0"/>
            <GradientStop Color="#80673AB7" Offset="0.499"/>
            <GradientStop Color="#14673AB7" Offset="0.5"/>
        </LinearGradientBrush>

        <!-- Same reason as UnscheduledTripCellStyle below: a selected cell that fills itself
             hides the row underneath, and on this grid what it hides is the warning that the
             driver will be late. -->
        <Style x:Key="ScheduleEventCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource CustomCellStyle}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ⚠️ Cells stop painting their own selection colour.
             With SelectionUnit="FullRow" every cell of the row becomes selected and the default
             cell style fills it, covering the row's background — so the accent bar and the wash
             were only visible while the pointer was over the row, which is the one state cells
             do not paint. Handing the selected cell a transparent background lets the row show
             through. Foreground is left alone on purpose: the row sets it, and a cancelled trip
             has to stay red even while it is the selected one. -->
        <Style x:Key="UnscheduledTripCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource CustomCellStyle}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UnscheduledTripRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="{StaticResource EvenRowBackgroundBrush}"/>
            <Style.Triggers>
                <!-- ⚠️ Row striping is done HERE and the grid's AlternatingRowBackground is left
                     unset. That property is applied by coercion, which is the last step of the
                     WPF value pipeline: it beats setters AND triggers, so every second row kept
                     its white and never showed selection, hover, or any state colour at all.
                     AlternationCount stays on the grid — it is what numbers the rows — but the
                     colour comes from this trigger, which the ones below can override.
                     This must stay first: everything after it is allowed to win. -->
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="White"/>
                </Trigger>

                <!-- ⚠️ Hover and selection have to be declared here. The Background setter above
                     is a style value, and the row template paints selection from a template
                     trigger, which loses to it — which is why the dispatcher could not tell
                     which trip they had selected. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverTripRowBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedTripRowBrush}"/>
                    <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                </Trigger>

                <DataTrigger Binding="{Binding Status}" Value="Canceled">
                    <Setter Property="Foreground" Value="Red" />
                    <Setter Property="ToolTip" Value="Canceled: Driver No-Show reported." />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Canceled" />
                        <Condition Binding="{Binding DriverNoShowReason, TargetNullValue={x:Null}}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="Gray" />
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="ToolTip" Value="This trip was canceled by the office." />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="Canceled" />
                        <Condition Binding="{Binding DriverNoShowReason}" Value="" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="Gray" />
                    <Setter Property="ToolTip" Value="This trip was canceled by the office." />
                </MultiDataTrigger>

                <!-- ===== The row is leaving =====
                     The trip was cancelled somewhere else while this dispatcher had the
                     tab open. The row is already unroutable by now (Status carries the
                     cancellation, and the trigger further down kills the schedule button);
                     this is what makes them see WHICH row went, instead of finding one
                     row fewer the next time they look.

                     Timed against DepartureLife in SchedulesViewModel: the row must be
                     gone by 8.2 s, while the live alert explaining it is still up. Move
                     one and move the other.

                     MaxHeight rather than Height: an auto-sized row has no numeric height
                     to animate from. Opacity only fades at the very end, once there is
                     nothing left to read. -->
                <DataTrigger Binding="{Binding IsDeparting}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                 From="36" To="0"
                                                 BeginTime="0:0:7.0" Duration="0:0:1.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 BeginTime="0:0:7.0" Duration="0:0:1.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- HEARTBEAT STORYBOARD  -->
        <Storyboard x:Key="HeartbeatStoryboard" RepeatBehavior="Forever">
            <!-- Animation for horizontal scale (ScaleX) -->
            <DoubleAnimationUsingKeyFrames 
        Storyboard.TargetName="DriverMarkerVisual"  
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">

                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.3">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- Animation for vertical scale (ScaleY) -->
            <DoubleAnimationUsingKeyFrames 
        Storyboard.TargetName="DriverMarkerVisual"  
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">

                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.3">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

    </UserControl.Resources>

    <materialDesign:DialogHost Identifier="ScheduleRootDialogHost">
        <Border BorderThickness="1,1,1,1" BorderBrush="{StaticResource MainBorderBrush}">
            <Grid Margin="4 0 4 4">
                <!-- No IsEnabled binding here. It used to read "{Binding !IsLoading}", which is
                     Avalonia syntax: WPF resolves it as a property path, the binding fails and
                     IsEnabled is never applied. It is also redundant — the loading overlay at the
                     bottom of this file is a Grid with a Background, so it already swallows every
                     click while the screen loads. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <DatePicker SelectedDate="{Binding SelectedDate}" Margin="5"/>

                        <!-- COMBOBOX DE GRUPOS CON INDICADOR DE COLOR -->
                        <ComboBox ItemsSource="{Binding VehicleGroups}" 
              SelectedItem="{Binding SelectedVehicleGroup}" 
              Width="200" Margin="5">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Círculo de color -->
                                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Background="{Binding Color, Converter={StaticResource StringToBrushConverter}}"
                            BorderBrush="Gray" BorderThickness="0.5"/>
                                        <!-- Nombre del grupo -->
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- COMBOBOX DE RUTAS (CON FONDO DE COLOR) -->
                        <ComboBox ItemsSource="{Binding VehicleRoutes}" 
              SelectedItem="{Binding SelectedVehicleRoute}" 
              Width="220" Margin="5">
                            <!-- Template para el item seleccionado -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                            <!-- Estilo para los items de la lista desplegable -->
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource MaterialDesignComboBoxItemStyle}">
                                    <!-- Pintamos el fondo del color del grupo de la ruta -->
                                    <Setter Property="Background" Value="{Binding Vehicle.VehicleGroup.Color, Converter={StaticResource StringToBrushConverter}}"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Style.Triggers>
                                        <!-- Si el color es oscuro, podrías cambiar el Foreground a blanco aquí con más triggers -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <!--<ComboBox ItemsSource="{Binding VehicleRoutes}" SelectedItem="{Binding SelectedVehicleRoute}" DisplayMemberPath="Name" Width="200" Margin="5"/>
                        <ComboBox ItemsSource="{Binding VehicleGroups}" SelectedItem="{Binding SelectedVehicleGroup}" DisplayMemberPath="Name" Width="200" Margin="5"/>-->
                        <TextBlock Text="{Binding RouteSummaryText}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Black" FontStyle="Italic"/>

                        <Button Grid.Column="0"
                            Command="{Binding ManualRefreshCommand}"                                                    
                            Margin="35,0"
                            Visibility="{Binding IsLiveTrackingMode, Converter={StaticResource BoolToVis}}" Cursor="Hand">
                            
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    
                    <CheckBox Margin="10,0,0,5" Grid.Row="1"
                          Content="Show Performed Events"
                          IsChecked="{Binding DisplayPerformedEvents}"
                          Visibility="{Binding ShowFilterControls, Converter={StaticResource BoolToVis}}"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <!-- No ScrollViewer around this grid. One wrapping it gives the grid an
                                 infinite height to measure against, so every row is realised and
                                 virtualisation is silently off no matter what the grid declares.
                                 The DataGrid scrolls itself. -->
                                <DataGrid ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.IsVirtualizing="True" FrozenColumnCount="2" IsReadOnly="True" AlternationCount="2" Style="{StaticResource CustomDataGridStyle}" ColumnHeaderStyle="{StaticResource CustomColumnHeaderStyle}" CellStyle="{StaticResource ScheduleEventCellStyle}" SelectionUnit="FullRow" gong:DragDrop.IsDragSource="True" gong:DragDrop.IsDropTarget="True" gong:DragDrop.DropHandler="{Binding}">
                                    <DataGrid.RowStyle>
                                        <!-- ⚠️ Trigger order in THIS list is what decides the row's
                                             background, and the late-ETA ones are last on purpose.
                                             CustomRowStyle, the base, paints selection and hover over
                                             Background; a row that was late AND under the pointer, or
                                             late AND selected, therefore lost its warning colour —
                                             exactly when a dispatcher was looking at it. Hover and
                                             selection are restated here, before the warning, so the
                                             warning always wins and still darkens under the pointer.
                                             Do not reorder. -->
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource CustomRowStyle}">
                                            <Style.Resources>
                                                <SolidColorBrush x:Key="EtaViolationBrush" Color="#FFFAA0A0"/>
                                                <SolidColorBrush x:Key="EtaViolationActiveBrush" Color="#FFF07070"/>
                                            </Style.Resources>
                                            <Style.Triggers>
                                                <!-- ⚠️ Striping done here, not with the grid's
                                                     AlternatingRowBackground: that one is applied by
                                                     coercion, the last step of the value pipeline, so
                                                     it beat every trigger below and every second row
                                                     stayed white — including a row whose driver was
                                                     going to arrive hours late. Must stay first. -->
                                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                    <Setter Property="Background" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                                                </Trigger>

                                                <!-- Late: the ETA is past the promised hour by more
                                                     than the fifteen-minute window. -->
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EtaViolationConverter}">
                                                            <Binding Path="EventType" />
                                                            <Binding Path="ETA" />
                                                            <Binding Path="Pickup" />
                                                            <Binding Path="Appt" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{StaticResource EtaViolationBrush}" />
                                                    <Setter Property="Foreground" Value="Black" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Value="True">
                                                            <Condition.Binding>
                                                                <MultiBinding Converter="{StaticResource EtaViolationConverter}">
                                                                    <Binding Path="EventType" />
                                                                    <Binding Path="ETA" />
                                                                    <Binding Path="Pickup" />
                                                                    <Binding Path="Appt" />
                                                                </MultiBinding>
                                                            </Condition.Binding>
                                                        </Condition>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{StaticResource EtaViolationActiveBrush}" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Value="True">
                                                            <Condition.Binding>
                                                                <MultiBinding Converter="{StaticResource EtaViolationConverter}">
                                                                    <Binding Path="EventType" />
                                                                    <Binding Path="ETA" />
                                                                    <Binding Path="Pickup" />
                                                                    <Binding Path="Appt" />
                                                                </MultiBinding>
                                                            </Condition.Binding>
                                                        </Condition>
                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{StaticResource EtaViolationActiveBrush}" />
                                                </MultiDataTrigger>

                                                <DataTrigger Binding="{Binding Status}" Value="Canceled">
                                                    <Setter Property="Foreground" Value="Red" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="Auto">
                                            <DataGridTemplateColumn.HeaderTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.OpenColumnSelectorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" Style="{StaticResource TripActionButtonStyle}" ToolTip="{Binding Data.SelectFieldsToDisplayToolTip, Source={StaticResource vmProxy}}">
                                                        <materialDesign:PackIcon Kind="Cog" Width="20" Height="20"/>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.HeaderTemplate>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                        <!-- CONTAINER FOR STATE FLAG -->
                                                        <!-- This StackPanel will only be visible if we are in the Dispatch context -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    Visibility="{Binding DataContext.AllowUnperformAction, 
                                                                    RelativeSource={RelativeSource AncestorType=DataGrid}, 
                                                                    Converter={StaticResource BoolToVis}}">

                                                            <!-- Green Flag (Arrive) -->
                                                            <!-- Visible only if the 'Arrive' property has a value (not null) -->
                                                            <materialDesign:PackIcon Kind="Flag" 
                                                                 Foreground="Green"
                                                                 ToolTip="Arrive"
                                                                 Margin="2,6"
                                                                 Visibility="{Binding Arrive, Converter={StaticResource NullToVis}}"/>

                                                            <!-- Purple Flag (Perform) -->
                                                            <!-- Visible only if the 'Perform' property has a value (not null) -->
                                                            <materialDesign:PackIcon Kind="Flag" 
                                                                 Foreground="Purple"
                                                                 ToolTip="Perform"
                                                                 Margin="2,6"
                                                                 Visibility="{Binding Perform, Converter={StaticResource NullToVis}}"/>
                                                        </StackPanel>


                                                        <!-- We use a Grid as a container so that the buttons overlap in the same space -->
                                                        <Grid Margin="5,0,0,0">
                                                            <!-- BUTTON 1: "Unschedule" (Visible if the event is NOT done) -->
                                                            <Button Command="{Binding Data.CancelRouteCommand, Source={StaticResource vmProxy}}" 
                                                                    CommandParameter="{Binding}"
                                                                    VerticalAlignment="Center" 
                                                                    ToolTip="{Binding Data.UnscheduleToolTip, Source={StaticResource vmProxy}}"
                                                                    Visibility="{Binding Performed, Converter={StaticResource InverseBoolToVis}}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource TripActionButtonStyle}">
                                                                        <Style.Triggers>

                                                                            <DataTrigger Binding="{Binding Name}" Value="Pull-out">
                                                                                <Setter Property="IsEnabled" Value="False" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Name}" Value="Pull-in">
                                                                                <Setter Property="IsEnabled" Value="False" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <materialDesign:PackIcon Kind="SortClockAscendingOutline" Width="20" Height="20" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                            </Button>

                                                            <!-- BUTTON 2: "Un-perform" (Visible if the event IS performed) -->
                                                            <Button Command="{Binding Data.UnperformEventCommand, Source={StaticResource vmProxy}}"
                                                                CommandParameter="{Binding}"
                                                                VerticalAlignment="Center" 
                                                                ToolTip="Un-arrive/perform">
                                                                <Button.Style>
                                                                    <!-- We combine the base style with our visibility and state logic -->
                                                                    <Style TargetType="Button" BasedOn="{StaticResource TripActionButtonStyle}">
                                                                        <!-- By default the button is hidden -->
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <!-- Logic to disable it in Pull-in/out -->
                                                                            <DataTrigger Binding="{Binding Name}" Value="Pull-out">
                                                                                <Setter Property="IsEnabled" Value="False" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Name}" Value="Pull-in">
                                                                                <Setter Property="IsEnabled" Value="False" />
                                                                            </DataTrigger>

                                                                            <!-- CONDITIONAL VISIBILITY LOGIC -->
                                                                            <!-- The button will only be visible if ALL of the following conditions are true -->
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <!-- Condition 1: The event must be perform -->
                                                                                    <Condition Binding="{Binding Performed}" Value="True" />
                                                                                    <!-- Condition 2: The action must be allowed by the ViewModel -->                                                                                   
                                                                                    <Condition Binding="{Binding DataContext.AllowUnperformAction, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <!-- If both conditions are met, we make the button visible -->
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <materialDesign:PackIcon Kind="UndoVariant" Width="20" Height="20" Foreground="OrangeRed" />
                                                            </Button>
                                                        </Grid>

                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Name}" Width="250" IsReadOnly="True" Header="{Binding Data.ColumnHeaderName, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Name}"/>
                                        <DataGridTextColumn Binding="{Binding Pickup, StringFormat=\{0:hh\\:mm\}}" Width="80" Header="{Binding Data.ColumnHeaderPickup, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Pickup}"/>
                                        <DataGridTextColumn Binding="{Binding Appt, StringFormat=\{0:hh\\:mm\}}" Width="80" Header="{Binding Data.ColumnHeaderAppt, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Appt}"/>
                                        <DataGridTextColumn Binding="{Binding ETA, StringFormat=\{0:hh\\:mm\}}" Width="80" IsReadOnly="True" Header="{Binding Data.ColumnHeaderETA, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=ETA}"/>
                                        <DataGridTemplateColumn Width="25" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border Width="20" Height="20" ToolTip="{Binding Name}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="10"/>
                                                                    <Setter Property="Background" Value="Gray"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Name}" Value="Pull-out">
                                                                            <Setter Property="Background" Value="Green"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Name}" Value="Pull-in">
                                                                            <Setter Property="Background" Value="Red"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding EventType}" Value="{x:Static models:ScheduleEventType.Pickup}">
                                                                            <Setter Property="Background" Value="Green"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding EventType}" Value="{x:Static models:ScheduleEventType.Dropoff}">
                                                                            <Setter Property="Background" Value="Red"/>
                                                                        </DataTrigger>

                                                                        <DataTrigger Binding="{Binding Arrive, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                                                            <Setter Property="Background" Value="Purple" />
                                                                        </DataTrigger>
                                                                        
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsSelectedForMap}" Value="True"/>
                                                                                <Condition Binding="{Binding EventType}" Value="{x:Static models:ScheduleEventType.Pickup}"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Background" Value="Black"/>
                                                                            <Setter Property="CornerRadius" Value="2"/>
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsSelectedForMap}" Value="True"/>
                                                                                <Condition Binding="{Binding EventType}" Value="{x:Static models:ScheduleEventType.Dropoff}"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Background" Value="Black"/>
                                                                            <Setter Property="CornerRadius" Value="2"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <ContentControl Content="{Binding}">
                                                                <ContentControl.Resources>
                                                                    <DataTemplate x:Key="SequenceTemplate">
                                                                        <TextBlock Text="{Binding Sequence}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                    <DataTemplate x:Key="CarTemplate">
                                                                        <materialDesign:PackIcon Kind="Car" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Width="18" Height="18"/>
                                                                    </DataTemplate>
                                                                    <DataTemplate x:Key="SelectedPickupTemplate">
                                                                        <materialDesign:PackIcon Kind="ArrowTopRight" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                    <DataTemplate x:Key="SelectedDropoffTemplate">
                                                                        <materialDesign:PackIcon Kind="ArrowBottomRight" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </DataTemplate>
                                                                </ContentControl.Resources>
                                                                <ContentControl.Style>
                                                                    <Style TargetType="ContentControl">
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource SequenceTemplate}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Name}" Value="Pull-out">
                                                                                <Setter Property="ContentTemplate" Value="{StaticResource CarTemplate}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Name}" Value="Pull-in">
                                                                                <Setter Property="ContentTemplate" Value="{StaticResource CarTemplate}"/>
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsSelectedForMap}" Value="True"/>
                                                                                    <Condition Binding="{Binding EventType}" Value="{x:Static models:ScheduleEventType.Pickup}"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="ContentTemplate" Value="{StaticResource SelectedPickupTemplate}"/>
                                                                            </MultiDataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsSelectedForMap}" Value="True"/>
                                                                                    <Condition Binding="{Binding EventType}" Value="{x:Static models:ScheduleEventType.Dropoff}"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="ContentTemplate" Value="{StaticResource SelectedDropoffTemplate}"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ContentControl.Style>
                                                            </ContentControl>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding Distance}" Width="80" IsReadOnly="True" Header="{Binding Data.ColumnHeaderDistance, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Distance}"/>
                                        <DataGridTextColumn Binding="{Binding Travel}" Width="80" IsReadOnly="True" Header="{Binding Data.ColumnHeaderTravel, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Travel}"/>
                                        <DataGridTextColumn Binding="{Binding On}" Width="50" IsReadOnly="True" Header="{Binding Data.ColumnHeaderOn, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=On}"/>
                                        <DataGridTextColumn Binding="{Binding SpaceType}" Width="80" Header="{Binding Data.ColumnHeaderSpace, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=SpaceTypeName}"/>
                                        <DataGridTextColumn Binding="{Binding Address}" Width="250" Header="{Binding Data.ColumnHeaderAddress, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Address}"/>
                                        <DataGridTextColumn Binding="{Binding Comment}" Width="200" IsReadOnly="True" Header="{Binding Data.ColumnHeaderComment, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Comment}"/>
                                        <DataGridTextColumn Binding="{Binding Phone}" Width="120" IsReadOnly="True" Header="{Binding Data.ColumnHeaderPhone, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Phone}"/>
                                        <DataGridTextColumn Binding="{Binding Arrive, StringFormat=\{0:hh\\:mm\}}" Width="80" IsReadOnly="True" Header="{Binding Data.ColumnHeaderArrive, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Arrive}"/>
                                        <DataGridTextColumn Binding="{Binding Perform, StringFormat=\{0:hh\\:mm\}}" Width="80" IsReadOnly="True" Header="{Binding Data.ColumnHeaderPerform, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Perform}"/>
                                        <DataGridTextColumn Binding="{Binding ArriveDist}" Width="80" IsReadOnly="True" Header="{Binding Data.ColumnHeaderArriveDist, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=ArriveDist}"/>
                                        <DataGridTextColumn Binding="{Binding PerformDist}" Width="80" IsReadOnly="True" Header="{Binding Data.ColumnHeaderPerformDist, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=PerformDist}"/>
                                        <DataGridTextColumn Binding="{Binding Driver}" Width="150" IsReadOnly="True" Header="{Binding Data.ColumnHeaderDriver, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Driver}"/>
                                        <DataGridTextColumn Binding="{Binding GPSArrive}" Width="120" IsReadOnly="True" Header="{Binding Data.ColumnHeaderGPSArrive, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=GPSArrive}"/>
                                        <DataGridTextColumn Binding="{Binding Odometer}" Width="100" IsReadOnly="True" Header="{Binding Data.ColumnHeaderOdometer, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Odometer}"/>
                                        <DataGridTextColumn Binding="{Binding AuthNo}" Width="120" IsReadOnly="True" Header="{Binding Data.ColumnHeaderAuthNo, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=AuthNo}"/>
                                        <DataGridTextColumn Binding="{Binding FundingSource}" Header="{Binding Data.ColumnHeaderFundingSource, Source={StaticResource vmProxy}}" Visibility="{Binding Data.ColumnConfigurations, Source={StaticResource vmProxy}, Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=FundingSource}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="LightGray" ShowsPreview="True"/>

                        <!-- ======================================================================= -->
                        <!-- Columna 2: Map Panel  -->
                        <!-- ======================================================================= -->
                        <Grid Grid.Column="2" Margin="5" ClipToBounds="True">
                            <gmaps:GMapControl x:Name="MapView" MinZoom="2" MaxZoom="20"
                                               Zoom="{Binding MapZoom, Mode=TwoWay}"
                                               Position="{Binding MapCenter, Mode=TwoWay}">

                                <gmaps:GMapControl.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Mapa Normal" Click="SetNormalMap_Click" />
                                        <MenuItem Header="Satélite (Híbrido)" Click="SetHybridMap_Click" />
                                        <MenuItem Header="Satélite" Click="SetSatelliteMap_Click" />
                                    </ContextMenu>
                                </gmaps:GMapControl.ContextMenu>
                                
                            </gmaps:GMapControl>

                            <!-- Mini Floating Control over the map -->
                            <Border VerticalAlignment="Top" HorizontalAlignment="Right" 
                                Margin="10" Background="White" CornerRadius="4" Padding="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Normal Map Button -->
                                    <Button Content="Mapa" 
                                        Click="SetNormalMap_Click" 
                                        Style="{StaticResource MaterialDesignFlatButton}" 
                                        Height="30" Padding="10,0"/>

                                    <!-- SEPARATOR -->
                                    <Rectangle Width="1" Fill="#DADCE0" Margin="2,5" VerticalAlignment="Stretch"/>

                                    <!-- Satellite Button -->
                                    <Button Content="Satélite" 
                                        Click="SetHybridMap_Click" 
                                        Style="{StaticResource MaterialDesignFlatButton}" 
                                        Height="30" Padding="10,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Positions come from MapMarkerLayer, not from a MultiBinding per
                                 marker: one pass over the layer when the map moves, instead of
                                 fourteen coordinate conversions per marker per wheel tick. -->
                            <ItemsControl ItemsSource="{Binding Schedules}"
                                          maps:MapMarkerLayer.Map="{Binding ElementName=MapView}"
                                          maps:MapMarkerLayer.RefreshTick="{Binding MapRefreshTick}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Border Width="20" Height="20" ToolTip="{Binding Name}" MouseLeftButtonDown="ScheduleMarker_MouseLeftButtonDown" Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="12"/>
                                                        <Setter Property="Background" Value="Gray"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="Pull-out">
                                                                <Setter Property="Background" Value="Green"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Pull-in">
                                                                <Setter Property="Background" Value="Red"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EventType}" Value="{x:Static models:ScheduleEventType.Pickup}">
                                                                <Setter Property="Background" Value="Green"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EventType}" Value="{x:Static models:ScheduleEventType.Dropoff}">
                                                                <Setter Property="Background" Value="Red"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Arrive, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                                                <Setter Property="Background" Value="Purple" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelectedForMap}" Value="True"/>
                                                                    <Condition Binding="{Binding EventType}" Value="{x:Static models:ScheduleEventType.Pickup}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="Black"/>
                                                                <Setter Property="CornerRadius" Value="2"/>
                                                                <Setter Property="Width" Value="18"/>
                                                                <Setter Property="Height" Value="18"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelectedForMap}" Value="True"/>
                                                                    <Condition Binding="{Binding EventType}" Value="{x:Static models:ScheduleEventType.Dropoff}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="Black"/>
                                                                <Setter Property="CornerRadius" Value="2"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ContentControl Content="{Binding}">
                                                    <ContentControl.Resources>
                                                        <DataTemplate x:Key="SequenceTemplate">
                                                            <TextBlock Text="{Binding Sequence}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                        <DataTemplate x:Key="CarTemplate">
                                                            <materialDesign:PackIcon Kind="Car" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                        <DataTemplate x:Key="SelectedPickupTemplate">
                                                            <materialDesign:PackIcon Kind="ArrowTopRight" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                        <DataTemplate x:Key="SelectedDropoffTemplate">
                                                            <materialDesign:PackIcon Kind="ArrowBottomRight" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </ContentControl.Resources>
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource SequenceTemplate}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Name}" Value="Pull-out">
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource CarTemplate}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Name}" Value="Pull-in">
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource CarTemplate}"/>
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsSelectedForMap}" Value="True"/>
                                                                        <Condition Binding="{Binding EventType}" Value="{x:Static models:ScheduleEventType.Pickup}"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource SelectedPickupTemplate}"/>
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsSelectedForMap}" Value="True"/>
                                                                        <Condition Binding="{Binding EventType}" Value="{x:Static models:ScheduleEventType.Dropoff}"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource SelectedDropoffTemplate}"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding SelectedUnscheduledTripPoints}"
                                          maps:MapMarkerLayer.Map="{Binding ElementName=MapView}"
                                          maps:MapMarkerLayer.RefreshTick="{Binding MapRefreshTick}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="18" Height="18" Background="Black" CornerRadius="2">
                                            <materialDesign:PackIcon Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="ArrowUp"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Dropoff">
                                                                <Setter Property="Kind" Value="ArrowDown"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>


                            <Canvas>
                              
                                <!-- Bound to the DRAWN position, not the reported one. The driver's
                                     app reports about every thirty seconds; drawn straight from
                                     each report the vehicle stands still and then teleports,
                                     which reads as a broken map. The view model interpolates
                                     between reports and these two follow that. The tooltip and
                                     the speed colour below stay on DriverLastKnownLocation,
                                     because those must say what the driver actually sent. -->
                                <Grid Visibility="{Binding HasVehiclePosition, Converter={StaticResource BoolToVis}}">
                                    <Canvas.Left>
                                        <MultiBinding Converter="{StaticResource LocationToPointConverter}">
                                            <Binding ElementName="MapView"/>
                                            <Binding Path="VehicleDisplayLatitude"/>
                                            <Binding Path="VehicleDisplayLongitude"/>
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                            <Binding Path="Zoom" ElementName="MapView"/>
                                            <Binding Path="Position" ElementName="MapView"/>
                                        </MultiBinding>
                                    </Canvas.Left>
                                    <Canvas.Top>
                                        <MultiBinding Converter="{StaticResource LocationToPointConverter}" ConverterParameter="Y">
                                            <Binding ElementName="MapView"/>
                                            <Binding Path="VehicleDisplayLatitude"/>
                                            <Binding Path="VehicleDisplayLongitude"/>
                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                            <Binding Path="Zoom" ElementName="MapView"/>
                                            <Binding Path="Position" ElementName="MapView"/>
                                        </MultiBinding>
                                    </Canvas.Top>

                                    <!-- Rotation follows VehicleHeading: 0° is north, and the icon
                                         inside points north when unrotated, so the two agree with
                                         no offset. The view model turns through the shorter way
                                         round, so a vehicle correcting ten degrees does not spin
                                         three hundred and fifty, and it holds the last known
                                         heading when the driver's app reports none. -->
                                    <Grid RenderTransformOrigin="0.5, 0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="{Binding VehicleHeading}"/>
                                        </Grid.RenderTransform>

                                        <!-- El visual del marcador (Círculo + Icono) -->
                                        <Grid x:Name="DriverMarkerVisual" Width="28" Height="28">
                                            <Grid.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" CenterX="14" CenterY="14"/>
                                            </Grid.RenderTransform>

                                            <Grid.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard Storyboard="{StaticResource HeartbeatStoryboard}" />
                                                </EventTrigger>
                                            </Grid.Triggers>

                                            <Grid.Effect>
                                                <DropShadowEffect ShadowDepth="2" BlurRadius="4" Opacity="0.5"/>
                                            </Grid.Effect>

                                            <Grid.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="Bold" Text="{Binding SelectedVehicleRoute.Name}"/>
                                                        <TextBlock>
                            <Run Text="Last update:"/>
                            <Run Text="{Binding DriverLastKnownLocation.DateTime, StringFormat='{}{0:hh:mm:ss tt}'}"/>
                                                        </TextBlock>
                                                        <TextBlock>
                            <Run Text="Speed:"/>
                            <Run Text="{Binding DriverLastKnownLocation.Speed, StringFormat='{}{0:N1} mph'}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Grid.ToolTip>

                                            
                                            <Ellipse Fill="{Binding DriverLastKnownLocation.Speed, Converter={StaticResource SmartSpeedToBrushConverter}}" 
                     Stroke="White" 
                     StrokeThickness="2"/>

                                            <!-- ⚠️ This icon must be one drawn as seen FROM ABOVE, with
                                                 its point at the top. It is rotated by the compass
                                                 heading, so anything drawn in profile ends up lying
                                                 on its side: a car seen from the side and turned to
                                                 head east shows its nose pointing down and its wheels
                                                 to the left. There is no top-down vehicle in this
                                                 icon set, so it is the navigation arrow — the same
                                                 one every map application uses for exactly this.
                                                 If you change it, change it for another top-down
                                                 shape that points up.

                                                 One icon in every state. A stopped vehicle keeps the
                                                 heading it last drove — a van parked facing south is
                                                 still facing south — and that it is stopped is said
                                                 by the colour of the circle, which is its speed.
                                                 Saying it twice, with a second icon, only invites
                                                 the two to disagree. -->
                                            <materialDesign:PackIcon Kind="Navigation" Width="20" Height="20"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Foreground="White"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                                
                            </Canvas>

                        </Grid>
                    </Grid>

                    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="LightGray" ShowsPreview="True"/>

                    <!-- Virtualisation on, all three axes. This grid holds the whole operating
                         day — 300 to 400 trips — with 24 columns and an action column of seven
                         buttons and two storyboards per row. Realising every one of them is what
                         made the tab open in slow motion.

                         Standard mode and not Recycling, deliberately. The rows here run the
                         departure storyboards that play when a cancelled trip is retired, and a
                         recycled container can carry a running animation to whatever row it is
                         next used for. Standard still only builds the rows on screen — which is
                         the whole win — and builds a fresh container for each. -->
                    <DataGrid x:Name="UnscheduledTripsGrid" Grid.Row="4" PreviewMouseLeftButtonDown="UnscheduledTripsGrid_PreviewMouseLeftButtonDown" ItemsSource="{Binding UnscheduledTrips}" SelectedItem="{Binding SelectedUnscheduledTrip}" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" SelectionMode="Single" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FrozenColumnCount="0" IsReadOnly="True" AlternationCount="2" Style="{StaticResource CustomDataGridStyle}" ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}" RowStyle="{StaticResource UnscheduledTripRowStyle}" CellStyle="{StaticResource UnscheduledTripCellStyle}" SelectionUnit="FullRow" AutoGenerateColumns="False" CanUserAddRows="False" Cursor="Hand">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="165">
                                <!-- The backlog counter lives in the header of the action column:
                                     the header stays put when the dispatcher scrolls down through
                                     four hundred trips, so the count is always in view, and it
                                     costs no vertical space in a screen whose whole layout is
                                     about giving space to whichever area is being worked on. -->
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Data.UnscheduledSummaryText, Source={StaticResource vmProxy}}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="Trips with no route assigned, and how many of them are Will Call"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                      <Grid>
                                        <StackPanel x:Name="ActionButtons" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0">
                                            <Button Command="{Binding Data.CancelTripCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}" Style="{StaticResource TripActionButtonStyle}" VerticalAlignment="Center" ToolTip="{Binding Data.CancelTripToolTip, Source={StaticResource vmProxy}}">
                                                <Button.Visibility>
                                                    <Binding Path="Status" Converter="{StaticResource StatusToVisibilityConverter}" ConverterParameter="NotCanceled" />
                                                </Button.Visibility>
                                                <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="20" Height="20" />
                                            </Button>
                                            <Button Command="{Binding DataContext.UncancelTripCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource TripActionButtonStyle}" ToolTip="Uncancel trip">
                                                <Button.Visibility>
                                                    <Binding Path="Status" Converter="{StaticResource StatusToVisibilityConverter}" ConverterParameter="Canceled" />
                                                </Button.Visibility>
                                                <materialDesign:PackIcon Kind="Restore" Foreground="Green" Width="20" Height="20" />
                                            </Button>
                                            <Button Command="{Binding DataContext.EditTripCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource TripActionButtonStyle}" ToolTip="{Binding Data.EditTripToolTip, Source={StaticResource vmProxy}}">
                                                <materialDesign:PackIcon Kind="FileEdit" Foreground="Orange"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.RouteTripCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="{Binding Data.ScheduleTripToolTip, Source={StaticResource vmProxy}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource TripActionButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Canceled">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="SortClockDescending" Foreground="Green"/>
                                            </Button>
                                            <!-- ===== Will Call =====
                                                 The only door in the application to Trip.WillCall.
                                                 A trip waiting on its patient can be activated; one
                                                 that is not can be turned back into a Will Call. Both
                                                 hidden on a cancelled trip: there is nothing to
                                                 promise anybody. -->
                                            <Button Command="{Binding Data.WillCallCommand, Source={StaticResource vmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{Binding Data.ActivateWillCallToolTip, Source={StaticResource vmProxy}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource TripActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding WillCall}" Value="True" />
                                                                    <Condition Binding="{Binding IsCanceled}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="ClockStart" Foreground="Green" Width="20" Height="20" />
                                            </Button>

                                            <Button Command="{Binding Data.WillCallCommand, Source={StaticResource vmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{Binding Data.RevertWillCallToolTip, Source={StaticResource vmProxy}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource TripActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding WillCall}" Value="False" />
                                                                    <Condition Binding="{Binding IsCanceled}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="PhonePaused" Foreground="#B06000" Width="20" Height="20" />
                                            </Button>

                                            <Button Command="{Binding Data.ShowHistoryCommand, Source={StaticResource vmProxy}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TripActionButtonStyle}"
                                                ToolTip="Change History">
                                                <materialDesign:PackIcon Kind="History" Foreground="Blue" Width="20" Height="20" />
                                            </Button>
                                        </StackPanel>

                                        <!-- ===== The row is leaving =====
                                             Takes the place of the buttons while the row
                                             plays out its removal: there is nothing left
                                             to do to a trip that no longer exists, and an
                                             enabled button on a departing row is an
                                             invitation to click it.

                                             ⚠️ The ScaleTransform is declared right here,
                                             on an icon this template owns. It must never
                                             become an implicit PackIcon style: that is
                                             what animated RenderTransform.ScaleX onto the
                                             RotateTransform of MaterialDesign's own icons
                                             and closed the application. See the C3 entry
                                             in _meta/BACKLOG.md. -->
                                        <Border x:Name="DepartingBadge"
                                                Visibility="Collapsed"
                                                CornerRadius="3"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Background>
                                                <SolidColorBrush Color="#FFD32F2F" />
                                            </Border.Background>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CloseOctagon"
                                                                         Width="20" Height="20"
                                                                         Foreground="White"
                                                                         VerticalAlignment="Center"
                                                                         RenderTransformOrigin="0.5,0.5">
                                                    <materialDesign:PackIcon.RenderTransform>
                                                        <ScaleTransform x:Name="DepartingIconScale" ScaleX="0.6" ScaleY="0.6" />
                                                    </materialDesign:PackIcon.RenderTransform>
                                                </materialDesign:PackIcon>
                                                <TextBlock Text="{Binding Data.TripCancelledRowLabel, Source={StaticResource vmProxy}}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                      </Grid>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDeparting}" Value="True">
                                                <Setter TargetName="ActionButtons" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="DepartingBadge" Property="Visibility" Value="Visible" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <!-- Burst at 0 → 0.6 s, then three slow beats to 3.0 s.
                                                             One key-frame timeline per axis rather than a burst
                                                             animation plus a repeating one: two animations on the
                                                             same property leave the hand-over between them up to
                                                             composition order.

                                                             ⚠️ Nothing here animates a brush. A brush written
                                                             inline in a DataTemplate is frozen by WPF so the
                                                             template can be shared, and animating a frozen brush
                                                             throws at runtime — the same family of failure as the
                                                             PackIcon crash (C3). Scale only, on a transform this
                                                             template declares itself.

                                                             Neither this nor the row collapse blocks anything:
                                                             the dispatcher keeps selecting and routing other
                                                             trips while it plays. -->
                                                        <Storyboard>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DepartingIconScale"
                                                                                          Storyboard.TargetProperty="ScaleX">
                                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1.4">
                                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                                </EasingDoubleKeyFrame>
                                                                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="1.1" />
                                                                <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="1.4" />
                                                                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="1.1" />
                                                                <EasingDoubleKeyFrame KeyTime="0:0:2.2" Value="1.4" />
                                                                <EasingDoubleKeyFrame KeyTime="0:0:2.6" Value="1.1" />
                                                                <EasingDoubleKeyFrame KeyTime="0:0:3.0" Value="1.4" />
                                                            </DoubleAnimationUsingKeyFrames>

                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DepartingIconScale"
                                                                                          Storyboard.TargetProperty="ScaleY">
                                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1.4">
                                                                    <EasingDoubleKeyFrame.EasingFunction>
                                                                        <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                                    </EasingDoubleKeyFrame.EasingFunction>
                                                                </EasingDoubleKeyFrame>
                                                                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="1.1" />
                                                                <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="1.4" />
                                                                <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="1.1" />
                                                                <EasingDoubleKeyFrame KeyTime="0:0:2.2" Value="1.4" />
                                                                <EasingDoubleKeyFrame KeyTime="0:0:2.6" Value="1.1" />
                                                                <EasingDoubleKeyFrame KeyTime="0:0:3.0" Value="1.4" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Date, StringFormat=\{0:MM/dd/yyyy\}}" Width="100" Header="{Binding Data.ColumnHeaderDate, Source={StaticResource vmProxy}}"/>
                            <DataGridTextColumn Binding="{Binding FromTime, StringFormat=\{0:hh\\:mm\}}" Width="90" Header="{Binding Data.ColumnHeaderFromTime, Source={StaticResource vmProxy}}"/>
                            <DataGridTextColumn Binding="{Binding ToTime, StringFormat=\{0:hh\\:mm\}}" Width="90" Header="{Binding Data.ColumnHeaderToTime, Source={StaticResource vmProxy}}"/>
                            <DataGridTextColumn Binding="{Binding PickupCity}" Width="120" Header="{Binding Data.ColumnHeaderPickupCity, Source={StaticResource vmProxy}}"/>
                            <DataGridTextColumn Binding="{Binding CustomerName}" Width="160" Header="{Binding Data.ColumnHeaderPatient, Source={StaticResource vmProxy}}"/>
                            
                            <DataGridTextColumn Binding="{Binding PickupAddress}" Width="250" Header="{Binding Data.ColumnHeaderPickupAddress, Source={StaticResource vmProxy}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding PickupAddress}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding DropoffAddress}" Width="250" Header="{Binding Data.ColumnHeaderDropoffAddress, Source={StaticResource vmProxy}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding DropoffAddress}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <!--<DataGridTextColumn Binding="{Binding PickupAddress}" Header="{Binding Data.ColumnHeaderPickupAddress, Source={StaticResource vmProxy}}"/>
                            <DataGridTextColumn Binding="{Binding DropoffAddress}" Header="{Binding Data.ColumnHeaderDropoffAddress, Source={StaticResource vmProxy}}"/>-->
                            <DataGridTextColumn Binding="{Binding SpaceType}" Width="100" Header="{Binding Data.ColumnHeaderSpace, Source={StaticResource vmProxy}}"/>
                            <DataGridTextColumn Binding="{Binding FundingSource}" Width="150" Header="{Binding Data.ColumnHeaderFundingSource, Source={StaticResource vmProxy}}"/>
                            <DataGridTextColumn Binding="{Binding Type}" Width="100" Header="{Binding Data.ColumnHeaderType, Source={StaticResource vmProxy}}"/>
                            <DataGridTextColumn Binding="{Binding TripId}" Width="100" Header="{Binding Data.ColumnHeaderTripId, Source={StaticResource vmProxy}}"/>

                            <!-- Deliberately unbound. UnscheduledTripDto has no NotificationStatus
                                 and the API never sent one, so the old binding failed once per row
                                 — four hundred failed resolutions on every load — and the column
                                 rendered empty anyway. It is kept, still empty, so the dispatcher's
                                 column layout does not shift under them; give it a binding the day
                                 the backend has something to put in it. -->
                            <DataGridTextColumn Width="100" Header="{Binding Data.ColumnHeaderNotificationStatus, Source={StaticResource vmProxy}}"/>


                            <DataGridTextColumn Binding="{Binding Charge}" Width="80" Header="{Binding Data.ColumnHeaderCharge, Source={StaticResource vmProxy}}"/>
                            <DataGridTextColumn Binding="{Binding Paid}" Width="80" Header="{Binding Data.ColumnHeaderPaid, Source={StaticResource vmProxy}}"/>

                            <DataGridTextColumn Binding="{Binding PickupComment}" Width="250" Header="{Binding Data.ColumnHeaderPickupComment, Source={StaticResource vmProxy}}"/>
                            <DataGridTextColumn Binding="{Binding DropoffComment}" Width="250" Header="{Binding Data.ColumnHeaderDropoffComment, Source={StaticResource vmProxy}}"/>

                            <DataGridTextColumn Binding="{Binding Pickup}" Width="100" Header="{Binding Data.ColumnHeaderPickup, Source={StaticResource vmProxy}}"/>
                            <DataGridTextColumn Binding="{Binding Dropoff}" Width="100" Header="{Binding Data.ColumnHeaderDropoff, Source={StaticResource vmProxy}}"/>
                            <DataGridTextColumn Binding="{Binding PickupPhone}" Width="100" Header="{Binding Data.ColumnHeaderPickupPhone, Source={StaticResource vmProxy}}"/>
                            <DataGridTextColumn Binding="{Binding DropoffPhone}" Width="100" Header="{Binding Data.ColumnHeaderDropoffPhone, Source={StaticResource vmProxy}}"/>

                            <DataGridTextColumn Binding="{Binding Authorization}" Width="80" Header="{Binding Data.ColumnHeaderAuthorization, Source={StaticResource vmProxy}}"/>

                            <DataGridTextColumn Binding="{Binding Distance}" Width="80" Header="{Binding Data.ColumnHeaderDistance, Source={StaticResource vmProxy}}"/>

                            <DataGridTextColumn Binding="{Binding DropoffCity}" Width="120" Header="{Binding Data.ColumnHeaderDropoffCity, Source={StaticResource vmProxy}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid Background="#80FFFFFF"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="50" Height="50" />
                        <TextBlock Text="Loading, please wait..." Margin="0,15,0,0" FontSize="16" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </materialDesign:DialogHost>
</UserControl>
<UserControl x:Class="Raphael.Desktop.Views.Schedules.RoutingSuggestionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BindingProxy x:Key="vmProxy" Data="{Binding}"/>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="#D1C4E9" BorderThickness="1" CornerRadius="8" helpers:HelpAssist.TopicId="desktop/schedules/routing-suggestions">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="90"/><RowDefinition Height="5"/><RowDefinition Height="1.1*"/>
            </Grid.RowDefinitions>

            <Border Background="#4527A0" CornerRadius="7,7,0,0" Padding="12,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding ReloadCommand}" ToolTip="{Binding L[assist.Reload]}" Style="{StaticResource MaterialDesignIconForegroundButton}" Width="28" Height="28" Foreground="White">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                        </Button>
                        <Button Command="{Binding CloseCommand}" ToolTip="{Binding L[assist.Close]}" Style="{StaticResource MaterialDesignIconForegroundButton}" Width="28" Height="28" Foreground="White">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Heading}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubjectText}" Foreground="#D1C4E9" TextTrimming="CharacterEllipsis" ToolTip="{Binding SubjectText}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Grid.Row="1" Margin="8,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding BudgetText}" Foreground="#7A8794" FontSize="11" VerticalAlignment="Center" ToolTip="{Binding L[assist.BudgetTip]}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding L[assist.TabLines]}" Command="{Binding ShowLinesCommand}" Height="26" Padding="10,0" FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                <Style.Triggers><DataTrigger Binding="{Binding IsLines}" Value="True"><Setter Property="Background" Value="#EDE7F6"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{Binding L[assist.TabTrips]}" Command="{Binding ShowTripsCommand}" Height="26" Padding="10,0" FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                <Style.Triggers><DataTrigger Binding="{Binding IsTrips}" Value="True"><Setter Property="Background" Value="#EDE7F6"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </DockPanel>

            <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" BorderThickness="0,1,0,0" BorderBrush="#E3E8EF" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Why}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="74"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Position}" FontWeight="Bold" Foreground="#4527A0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#5B6B7C" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Background="{Binding GroupBack}" CornerRadius="8" Padding="7,1"><TextBlock Text="{Binding GroupText}" Foreground="{Binding GroupColor}" FontSize="11" FontWeight="SemiBold"/></Border>
                                    <materialDesign:PackIcon Kind="{Binding PrecisionIcon}" Foreground="{Binding PrecisionColor}" Width="14" Height="14" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Precision}" FontSize="11" Foreground="{Binding PrecisionColor}" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="AlertDecagramOutline" Foreground="#C62828" Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center"
                                                             Visibility="{Binding IsUrgent, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Arrives}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ArrivesDetail}" FontSize="11" Foreground="#5B6B7C" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Miles}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding MilesDetail}" FontSize="11" Foreground="#5B6B7C"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#5B6B7C" TextAlignment="Center" VerticalAlignment="Center" Margin="24"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"/>
            <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

            <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#E3E8EF"/>

            <DockPanel Grid.Row="4" DataContext="{Binding Selected}" Visibility="{Binding DataContext.HasSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <Button DockPanel.Dock="Bottom" Content="{Binding RouteText}" Command="{Binding Data.RouteCommand, Source={StaticResource vmProxy}}" CommandParameter="{Binding}"
                        Background="#673AB7" BorderBrush="#673AB7" Margin="10,6" Height="34"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,6">
                        <TextBlock Text="{Binding Where}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Why}" Foreground="#4527A0" TextWrapping="Wrap" Margin="0,2,0,4" Visibility="{Binding HasWhy, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Facts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" Foreground="{Binding Color}" Width="16" Height="16" Margin="0,1,6,0"/>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Data.L[assist.HowItLooks], Source={StaticResource vmProxy}}" FontWeight="SemiBold" Margin="0,8,0,2"/>
                        <ItemsControl ItemsSource="{Binding Stops}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="4" Padding="6,2" Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon x:Name="Icon" Kind="Garage" Width="15" Height="15" Foreground="#5B6B7C" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Eta}" FontSize="12"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="#7A8794"/>
                                            </StackPanel>
                                            <TextBlock x:Name="Change" Grid.Column="3" Text="{Binding Change}" FontSize="11" Foreground="#5B6B7C" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="PICKUP"><Setter TargetName="Icon" Property="Kind" Value="AccountArrowUp"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="DROPOFF"><Setter TargetName="Icon" Property="Kind" Value="AccountArrowDown"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsNew}" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDE7F6"/><Setter TargetName="Icon" Property="Foreground" Value="#673AB7"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsWorse}" Value="True"><Setter TargetName="Change" Property="Foreground" Value="#C62828"/><Setter TargetName="Change" Property="FontWeight" Value="Bold"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="Raphael.Desktop.Views.Dispatch.EditTripDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Raphael.Desktop.Views.Dispatch"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel Margin="16" MaxWidth="460">
        <TextBlock Text="{Binding Title}" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,16"/>

        <!-- RE-051: a routed trip. Why the framed fields are locked, and the way out: take the
             trip back to the open list in Schedule. Folds into one line for someone who only
             came to change a phone number. -->
        <Border Background="#FFF8E1" BorderBrush="#FFA000" BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,12"
                Visibility="{Binding ShowRoutedLockHighlight, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel>
                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="LockOutline" Foreground="#E65100"
                                             Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Top"/>
                    <Button DockPanel.Dock="Right" Content="{Binding RoutedLockHide}" Command="{Binding HideRoutedLockCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E65100"
                            Padding="6,0" MinWidth="0" Height="22" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding RoutedLockTitle}" FontWeight="Bold" Foreground="#5D4037" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock Text="{Binding RoutedLockWhy}" Foreground="#5D4037" TextWrapping="Wrap" Margin="24,4,0,0"/>
                <TextBlock Text="{Binding RoutedLockHowToFix}" Foreground="#5D4037" TextWrapping="Wrap" Margin="24,4,0,0"/>
                <Button Content="{Binding RoutedLockShowInSchedule}" Command="{Binding ShowInScheduleCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#E65100" BorderBrush="#FFA000"
                        HorizontalAlignment="Left" Margin="24,8,0,0" Height="26" Padding="10,0"/>
            </StackPanel>
        </Border>

        <Border Background="#FFF8E1" CornerRadius="4" Padding="8,3" Margin="0,0,0,12"
                Visibility="{Binding IsRoutedLockCollapsed, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <materialDesign:PackIcon DockPanel.Dock="Left" Kind="LockOutline" Foreground="#E65100" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="{Binding RoutedLockShow}" Command="{Binding ShowRoutedLockCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#E65100" Padding="6,0" MinWidth="0" Height="22"/>
                <TextBlock Text="{Binding RoutedLockCollapsedText}" Foreground="#5D4037" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,8"
                    IsEnabled="{Binding CanEditRoutedFields}"
                    helpers:LockHighlight.IsOn="{Binding ShowRoutedLockHighlight}"
                    ToolTip="{Binding RoutedLockFieldToolTip}" ToolTipService.ShowOnDisabled="True"
                    ToolTipService.IsEnabled="{Binding IsRouted}">
            <!--<TextBlock Text="Type:" VerticalAlignment="Center" Width="120"/>-->
            <RadioButton Content="Appointment" IsChecked="{Binding IsAppointmentType}"/>
            <RadioButton Content="Return" Margin="10,0,0,0" IsChecked="{Binding IsReturnType}"/>
        </StackPanel>

        <materialDesign:TimePicker Text="Pickup Time" Style="{StaticResource MaterialDesignFloatingHintTimePicker}"
                                   SelectedTime="{Binding FromTime}" Margin="0,8"
                                   IsEnabled="{Binding CanEditRoutedFields}"
                                   helpers:LockHighlight.IsOn="{Binding ShowRoutedLockHighlight}"
                                   ToolTip="{Binding RoutedLockFieldToolTip}" ToolTipService.ShowOnDisabled="True"
                                   ToolTipService.IsEnabled="{Binding IsRouted}"/>

        <!-- ⚠️ Will Call is not edited here, and must not come back.
             It governs a promise to a patient — an hour to get a vehicle to them — and it
             now has exactly one door: the two buttons on the open-trips grid of Schedule,
             which record who moved it and tell the patient. A checkbox on a form opened
             from four screens flipped it with nobody the wiser. The server ignores the
             field on this route as well. -->

        <!-- Phones and comments stay editable on a routed trip. The server copies the phones onto
             its two stops; the stops read the comments from the trip (RE-054). -->
        <TextBox materialDesign:HintAssist.Hint="Pickup Phone" Text="{Binding PickupPhone}" Margin="0,8"/>
        <Grid Margin="0,8">
            <TextBox materialDesign:HintAssist.Hint="Pickup Comment" Text="{Binding PickupComment}" TextWrapping="Wrap" VerticalAlignment="Top" Height="60" Padding="0,0,30,0"/>
            <!-- RE-054: the notes window, in the field's corner so the dialog keeps its size. -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="26" Height="26" Padding="0"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Command="{Binding OpenNotesCommand}" CommandParameter="Pickup" ToolTip="{Binding NotesOpenText}">
                <materialDesign:PackIcon Kind="ArrowExpand" Width="16" Height="16" />
            </Button>
        </Grid>

        <TextBox materialDesign:HintAssist.Hint="Dropoff Phone" Text="{Binding DropoffPhone}" Margin="0,8"/>
        <Grid Margin="0,8">
            <TextBox materialDesign:HintAssist.Hint="Dropoff Comment" Text="{Binding DropoffComment}" TextWrapping="Wrap" VerticalAlignment="Top" Height="60" Padding="0,0,30,0"/>
            <!-- RE-054: the notes window, in the field's corner so the dialog keeps its size. -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="26" Height="26" Padding="0"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Command="{Binding OpenNotesCommand}" CommandParameter="Dropoff" ToolTip="{Binding NotesOpenText}">
                <materialDesign:PackIcon Kind="ArrowExpand" Width="16" Height="16" />
            </Button>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="CANCEL" Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    CommandParameter="{Binding WasCancelled}"/>
            <Button Content="SAVE" Margin="8,0,0,0"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    CommandParameter="{Binding WasSaved}"/>
        </StackPanel>
    </StackPanel>
</UserControl>

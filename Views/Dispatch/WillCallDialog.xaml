<UserControl x:Class="Raphael.Desktop.Views.Dispatch.WillCallDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Raphael.Desktop.Converters"
             mc:Ignorable="d"
             MinWidth="420" MaxWidth="460">

    <!--
        Activating a Will Call, and putting a trip back to waiting for its patient.

        Both on one screen because they are the same decision from either side. The warning
        explains the office's convention and then gets out of the way: a dispatcher on the
        phone with a clinic knows things the rule does not.
    -->

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <StackPanel Margin="20">

        <TextBlock Text="{Binding Title}"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                   TextWrapping="Wrap" Margin="0,0,0,4" />

        <TextBlock Text="{Binding PatientLabel}"
                   FontSize="14" FontWeight="SemiBold" Foreground="#3B3357"
                   TextWrapping="Wrap" Margin="0,8,0,0" />

        <TextBlock Text="{Binding TripLabel}"
                   FontSize="12" Opacity="0.7" Margin="0,2,0,0" />

        <TextBlock Text="{Binding Explanation}"
                   FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                   Margin="0,14,0,0" />

        <materialDesign:TimePicker Style="{StaticResource MaterialDesignFloatingHintTimePicker}"
                                   materialDesign:HintAssist.Hint="{Binding PickupTimeHint}"
                                   SelectedTime="{Binding PickupTime, UpdateSourceTrigger=PropertyChanged}"
                                   Is24Hours="False"
                                   Margin="0,18,0,0" />

        <TextBlock Text="{Binding OperationNowText}"
                   FontSize="11" Opacity="0.65" Margin="0,6,0,0" />

        <!-- Warns, never blocks. -->
        <Border Background="#FEF7E0" BorderBrush="#F1E0AE" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18"
                                         Foreground="#B06000" VerticalAlignment="Top"
                                         Margin="0,2,0,0" />
                <TextBlock Text="{Binding WarningText}" Margin="10,0,0,0"
                           FontSize="12" Foreground="#7A5300" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="CANCEL" Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    CommandParameter="{Binding WasCancelled}" />
            <Button Content="{Binding ConfirmText}" Margin="8,0,0,0"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    CommandParameter="{Binding WasSaved}" />
        </StackPanel>

    </StackPanel>

</UserControl>

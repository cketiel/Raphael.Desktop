<UserControl x:Class="Raphael.Desktop.Views.ImportTripsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Raphael.Desktop.Converters"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
             helpers:HelpAssist.TopicId="desktop/home/import-trips"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- A DataGrid's columns are not in the visual tree, so a header bound with RelativeSource
             finds nothing and renders blank. That is exactly what happened: the repair grid came
             up with seven nameless columns. Everything a column header needs goes through this. -->
        <helpers:BindingProxy x:Key="vm" Data="{Binding}" />

        <!-- The tiles' rules. Real brushes rather than colour strings in Tag: a string would be
             leaning on the binding engine's type conversion, and a rule that silently fails to
             appear is a rule nobody notices is missing. -->
        <SolidColorBrush x:Key="TileGood" Color="#FF2E7D32" />
        <SolidColorBrush x:Key="TileTheme" Color="#FF673AB7" />
        <SolidColorBrush x:Key="TileBad" Color="#FFC62828" />
        <SolidColorBrush x:Key="TileCareful" Color="#FFB26A00" />
        <SolidColorBrush x:Key="TileQuiet" Color="#FF9AA0AA" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <converters:EnumMatchConverter x:Key="EnumMatch" />
        <converters:EmptyStringToVisibilityConverter x:Key="TextToVisibility" />
        <converters:ImportSeverityToBrushConverter x:Key="SeverityBrush" />
        <converters:NotNullToVisibilityConverter x:Key="NotNull" />
        <converters:IsNullToVisibilityConverter x:Key="IsNull" />
        <converters:TimeSpanToTextConverter x:Key="TimeText" />

        <!-- ===== The stepper =====
             The current step used to be a white chip on a purple header, and the text inherited
             the header's white: white on white, invisible. The chip that is on now flips BOTH -
             white ground, purple type - and TextElement.Foreground is inheritable, so setting it
             on the Border reaches the TextBlock inside it. -->
        <Style x:Key="StepChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="13,3,15,3" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="TextElement.Foreground" Value="#B3FFFFFF" />
        </Style>

        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="StageNumber" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="StageNumberText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3,0,8" />
        </Style>

        <!-- ===== The figures =====
             A coloured rule down the left rather than a coloured number. The number is the thing
             being read and it reads best in the type colour; the rule is what makes the six of
             them a set, and it survives being glanced at from across a desk. Tag carries the
             colour so one style serves all six. -->
        <!-- A ContentControl, not a Border: a Border has no Template, so the coloured rule has to
             live in a control that can be given one. Six tiles, one definition. -->
        <Style x:Key="ResultTile" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="MinWidth" Value="98" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="8" ClipToBounds="True"
                                Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0"
                                           Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter Grid.Column="1" Margin="12,8,16,8" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultFigure" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ResultCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value=".7" />
        </Style>

        <Style x:Key="ProblemRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="{StaticResource EvenRowBackgroundBrush}" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="White" />
                </Trigger>

                <!-- A row that has gone in says so in the type, never in the background: the
                     banding is what lets the eye track one row across the grid. Same rule as
                     Home. -->
                <DataTrigger Binding="{Binding IsImported}" Value="True">
                    <Setter Property="Foreground" Value="#FF2E7D32" />
                    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                </DataTrigger>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverTripRowBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedTripRowBrush}" />
                    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== The bench's fields =====
             Every field of the trip, always, filled in with what it actually holds. Showing only
             the field the server complained about left a dispatcher staring at one empty box with
             no idea which trip it belonged to, which is worse than showing nothing at all.

             What marks the problem is colour, not absence: Tag carries "is this the field in
             question" and one style turns it red. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value=".6" />
            <Setter Property="Margin" Value="0,9,0,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="#FFC62828" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,3,6,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFC62828" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One request's own bar. -->
        <DataTemplate x:Key="RequestStepTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}"
                           FontSize="11.5" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Progress}"
                           FontSize="11" Opacity=".6" FontFamily="Consolas" />

                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="6" Margin="0,4,0,0"
                             Minimum="0"
                             Maximum="{Binding Total, Mode=OneWay}"
                             Value="{Binding Completed, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}" />

                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Summary}"
                           FontSize="10.5" Opacity=".65" Margin="0,3,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Summary, Converter={StaticResource TextToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- The running account. Kept after the run: it is the evidence of what happened. -->
        <DataTemplate x:Key="LogLineTemplate">
            <StackPanel Orientation="Horizontal" Margin="10,1,10,1">
                <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11"
                           Opacity=".45" Width="58" />
                <TextBlock Text="{Binding Stage}" FontFamily="Consolas" FontSize="11"
                           Opacity=".55" Width="74" />
                <TextBlock Text="{Binding Text}" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header and stepper -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="14,10,16,10"
                                  materialDesign:ElevationAssist.Elevation="Dp3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- The title is centred on the WINDOW, not on the space left over between the two
                     controls: it is laid over the whole row rather than put in a column of its own,
                     because a column would centre it between a back button and a stepper of
                     different widths, which is centred on nothing. -->
                <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <materialDesign:PackIcon Kind="DatabaseImport" Width="22" Height="22"
                                             Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HeaderLabel}" Margin="10,0,0,0" Foreground="White"
                               VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>

                <Button Grid.Column="0" Foreground="White" Click="Back_Click"
                        IsEnabled="{Binding CanLeave}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        ToolTip="{Binding BackLabel}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BackLabel}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="Prepare">
                                        <Setter Property="Background" Value="#FFFFFFFF" />
                                        <Setter Property="TextElement.Foreground"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StepChooseLabel}" Style="{StaticResource StepText}" />
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="Running">
                                        <Setter Property="Background" Value="#FFFFFFFF" />
                                        <Setter Property="TextElement.Foreground"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StepRunLabel}" Style="{StaticResource StepText}" />
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StepChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="Review">
                                        <Setter Property="Background" Value="#FFFFFFFF" />
                                        <Setter Property="TextElement.Foreground"
                                                Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StepReviewLabel}" Style="{StaticResource StepText}" />
                    </Border>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- step 1: choose -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVisibility}}">
            <Border MaxWidth="880" Margin="24" CornerRadius="6" Padding="24"
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{StaticResource MainBorderBrush}" BorderThickness="1"
                    VerticalAlignment="Top">
                <StackPanel>

                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource StageNumber}">
                            <TextBlock Text="1" Style="{StaticResource StageNumberText}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding FundingSourceHint}" Style="{StaticResource StageTitle}" />
                            <ComboBox ItemsSource="{Binding FundingSources}"
                                      SelectedItem="{Binding SelectedFundingSource, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      materialDesign:HintAssist.Hint="{Binding FundingSourceHint}"
                                      materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                      materialDesign:TextFieldAssist.LeadingIcon="Finance"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      HorizontalAlignment="Left" MinWidth="320" />
                        </StackPanel>
                    </DockPanel>

                    <Separator Margin="0,22,0,18" Opacity=".4" />

                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource StageNumber}">
                            <TextBlock Text="2" Style="{StaticResource StageNumberText}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding NoFileLabel}" Style="{StaticResource StageTitle}" />

                            <!-- Reading is quick, but quick is not instant on a few thousand rows,
                                 and a screen that does nothing for two seconds after a click is a
                                 screen people think has hung. -->
                            <Border CornerRadius="6" Padding="14" Margin="0,0,0,10"
                                    Background="#0A673AB7"
                                    Visibility="{Binding IsInspectingFile, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 IsIndeterminate="True" Width="20" Height="20"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding InspectingLabel}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="6" Padding="24" BorderThickness="1.4"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    Background="#08000000"
                                    Visibility="{Binding HasFile, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FileDelimitedOutline" Width="34" Height="34"
                                                             Opacity=".45" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding NoFileHint}" Margin="0,8,0,12" FontSize="12"
                                               Opacity=".75" TextAlignment="Center" TextWrapping="Wrap"
                                               MaxWidth="380" />
                                    <Button Content="{Binding BrowseLabel}" Click="Browse_Click"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            HorizontalAlignment="Center" Height="32" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="6" Padding="14" BorderThickness="1"
                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Background="#0A673AB7"
                                    Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="FileDelimited"
                                                             Width="30" Height="30" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />

                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding FileSizeText}" Margin="8,0,0,0"
                                                       FontSize="11" Opacity=".6" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding FileSummary}" FontSize="11.5" Opacity=".8"
                                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding ChangeFileLabel}" Click="Browse_Click"
                                                Style="{StaticResource MaterialDesignFlatButton}" FontSize="11" />
                                        <Button Command="{Binding ClearCommand}"
                                                Style="{StaticResource TripActionButtonStyle}" Margin="4,0,0,0">
                                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- The warning that was missing. The engine held these rows back
                                 correctly, but only after Import had been pressed, so the promise
                                 of "before anything is sent" was true of the requests and false of
                                 the person. The file is checked on opening now. -->
                            <Border CornerRadius="6" Padding="12,10,12,10" Margin="0,12,0,0"
                                    Background="#14B26A00" BorderThickness="1" BorderBrush="#40B26A00"
                                    Visibility="{Binding HasPreflightFindings, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AlertOutline" Width="18" Height="18"
                                                                 Foreground="#FFB26A00" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding PreflightSummary}" Margin="8,0,0,0" FontSize="12"
                                                   TextWrapping="Wrap" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding PreflightRows}" Margin="26,8,0,0"
                                                  MaxHeight="160">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                                    <TextBlock Text="{Binding SourceIndex}" FontFamily="Consolas"
                                                               FontSize="11" Width="42" Opacity=".6" />
                                                    <TextBlock Text="{Binding PatientName}" FontSize="11.5"
                                                               Width="180" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Problem.Title}" FontSize="11.5"
                                                               Foreground="#FF9A5A00" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="6" Padding="12,9,12,9" Margin="0,12,0,0"
                                    Background="#14C62828" BorderThickness="1" BorderBrush="#40C62828"
                                    Visibility="{Binding Blocker, Converter={StaticResource TextToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18"
                                                             Foreground="#FFC62828" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding Blocker}" Margin="8,0,0,0" FontSize="12"
                                               TextWrapping="Wrap" Foreground="#FFA02020" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <Separator Margin="0,22,0,18" Opacity=".4" />

                    <Border CornerRadius="6" Padding="12,9,12,9" Background="#0F2E7D32">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18"
                                                     Foreground="#FF2E7D32" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding SafeToRepeatLabel}" Margin="8,0,0,0" FontSize="12"
                                       TextWrapping="Wrap" Opacity=".9" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding ImportCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            HorizontalAlignment="Right" Margin="0,20,0,0" Height="38" MinWidth="180"
                            materialDesign:ButtonAssist.CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseImport" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ImportNowLabel}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ===== steps 2 and 3, which are one screen =====
             They used to be two panels and the layout changed underneath the reader the instant the
             import finished: bars out, tiles and a grid in. Now the tiles are there from the first
             second and fill in, the bar keeps its place and runs to 100%, the detail appears line
             by line as it happens, and the only thing that arrives at the end is the grid of rows
             that need a hand - underneath everything that was already there.

             The shape is the one every operation panel has settled on, from Windows copying files
             to WinRAR: one figure you can trust at a glance, and everything else behind a
             disclosure that does not move the page when it opens. -->
        <Grid Grid.Row="1" Margin="20,16,20,16"
              Visibility="{Binding IsWorkingOrDone, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- the figures, present from the start -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <ContentControl Style="{StaticResource ResultTile}" Tag="{StaticResource TileGood}">
                    <StackPanel>
                        <TextBlock Text="{Binding CreatedCount}" Style="{StaticResource ResultFigure}" />
                        <TextBlock Text="{Binding ResultCreatedLabel}" Style="{StaticResource ResultCaption}" />
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource ResultTile}" Tag="{StaticResource TileTheme}">
                    <StackPanel>
                        <TextBlock Text="{Binding UpdatedCount}" Style="{StaticResource ResultFigure}" />
                        <TextBlock Text="{Binding ResultUpdatedLabel}" Style="{StaticResource ResultCaption}" />
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource ResultTile}" Tag="{StaticResource TileBad}">
                    <StackPanel>
                        <TextBlock Text="{Binding FailedCount}" Style="{StaticResource ResultFigure}" />
                        <TextBlock Text="{Binding ResultFailedLabel}" Style="{StaticResource ResultCaption}" />
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource ResultTile}" Tag="{StaticResource TileCareful}">
                    <StackPanel>
                        <TextBlock Text="{Binding WarningCount}" Style="{StaticResource ResultFigure}" />
                        <TextBlock Text="{Binding ResultWarningsLabel}" Style="{StaticResource ResultCaption}" />
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource ResultTile}" Tag="{StaticResource TileQuiet}">
                    <StackPanel>
                        <TextBlock Text="{Binding RequestCount}" Style="{StaticResource ResultFigure}" />
                        <TextBlock Text="{Binding ResultRequestsLabel}" Style="{StaticResource ResultCaption}" />
                    </StackPanel>
                </ContentControl>
                <ContentControl Style="{StaticResource ResultTile}" Tag="{StaticResource TileQuiet}">
                    <StackPanel>
                        <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource ResultFigure}" />
                        <TextBlock Text="{Binding ResultElapsedLabel}" Style="{StaticResource ResultCaption}" />
                    </StackPanel>
                </ContentControl>

                <Button Command="{Binding StartOverCommand}" VerticalAlignment="Center" Margin="10,0,0,0"
                        IsEnabled="{Binding CanLeave}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restart" VerticalAlignment="Center" Width="17" Height="17" />
                        <TextBlock Text="{Binding StartOverLabel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- the operation panel: one figure, one bar, one line, and a disclosure -->
            <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="8" Padding="18,14,18,12"
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercentText}"
                                   FontSize="26" FontWeight="Bold" VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding OverallLabel}" FontSize="10.5" Opacity=".55"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding ProgressCaption}" FontSize="13" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>

                    <ProgressBar Height="12" Margin="0,12,0,0" Minimum="0"
                                 Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                 Value="{Binding ProgressValue, Mode=OneWay}" />

                    <TextBlock Text="{Binding ProgressSummary}" FontSize="11.5" Opacity=".75"
                               Margin="0,8,0,0" />

                    <!-- Collapsed to start. Opening it adds height below, and nothing above it
                         moves - which is the whole reason it is a disclosure and not a swap. -->
                    <Expander Margin="0,6,0,0" IsExpanded="{Binding ShowDetail, Mode=TwoWay}"
                              Header="{Binding SeeDetailLabel}" FontSize="11.5" Padding="0">
                        <Border CornerRadius="6" BorderThickness="1" Margin="0,10,0,2"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                Background="#07000000">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- one bar per request -->
                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                              MaxHeight="230" Padding="14,12,14,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RequestsLabel}" FontSize="10"
                                                   FontWeight="Bold" Opacity=".5" Margin="0,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding Steps}"
                                                      ItemTemplate="{StaticResource RequestStepTemplate}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource MaterialDesignDivider}" />

                                <!-- and the account, written as it happens -->
                                <ListBox Grid.Column="2" x:Name="LogList" ItemsSource="{Binding Log}"
                                         BorderThickness="0" Background="Transparent" MaxHeight="230"
                                         Padding="4,10,4,10"
                                         ItemTemplate="{StaticResource LogLineTemplate}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Focusable" Value="False" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" CornerRadius="8" Padding="16,12,16,12" Margin="0,16,0,0"
                    Background="#0F2E7D32" BorderThickness="1" BorderBrush="#332E7D32">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsReviewing}" Value="True" />
                                    <Condition Binding="{Binding HasProblems}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="22" Height="22"
                                             Foreground="#FF2E7D32" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding NoProblemsLabel}" Margin="10,0,0,0" FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- the repair bench, which is the only thing that arrives at the end -->
            <Grid Grid.Row="3" Margin="0,16,0,0"
                  Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding RetryAllCommand}" Height="30" FontSize="11.5"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Reload" VerticalAlignment="Center" Width="16" Height="16" />
                                <TextBlock Text="{Binding RetryAllLabel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="Export_Click" Height="30" FontSize="11.5"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExportOutline" VerticalAlignment="Center"
                                                         Width="16" Height="16" />
                                <TextBlock Text="{Binding ExportFailedLabel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProblemsHeader}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                        <RadioButton GroupName="RowFilter" FontSize="11.5" Margin="0,0,12,0"
                                     Content="{Binding FilterPendingLabel}"
                                     IsChecked="{Binding RowFilter, Converter={StaticResource EnumMatch}, ConverterParameter=Pending}" />
                        <RadioButton GroupName="RowFilter" FontSize="11.5" Margin="0,0,12,0"
                                     Content="{Binding FilterImportedLabel}"
                                     IsChecked="{Binding RowFilter, Converter={StaticResource EnumMatch}, ConverterParameter=Imported}" />
                        <RadioButton GroupName="RowFilter" FontSize="11.5"
                                     Content="{Binding FilterAllLabel}"
                                     IsChecked="{Binding RowFilter, Converter={StaticResource EnumMatch}, ConverterParameter=All}" />
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1" Grid.Column="0"
                          ItemsSource="{Binding RowsView}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          AlternationCount="2"
                          CanUserAddRows="False"
                          EnableRowVirtualization="True"
                          Style="{StaticResource CustomDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                          RowStyle="{StaticResource ProblemRowStyle}"
                          Cursor="Hand">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding Data.RetryRowCommand, Source={StaticResource vm}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanRetry}"
                                                Style="{StaticResource TripActionButtonStyle}"
                                                ToolTip="{Binding Data.RetryLabel, Source={StaticResource vm}}">
                                            <materialDesign:PackIcon Kind="Reload" Width="18" Height="18"
                                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        </Button>

                                        <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18"
                                                                 Margin="4,0,0,0" Foreground="#FF2E7D32"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding IsImported,
                                                                              Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Binding="{Binding SourceIndex}" Width="Auto"
                                            Header="{Binding Data.ColumnRowLabel, Source={StaticResource vm}}" />
                        <DataGridTextColumn Binding="{Binding TripId}" Width="Auto"
                                            Header="{Binding Data.ColumnTripIdLabel, Source={StaticResource vm}}" />
                        <DataGridTextColumn Binding="{Binding PatientName}" Width="*"
                                            Header="{Binding Data.ColumnPatientLabel, Source={StaticResource vm}}" />
                        <DataGridTextColumn Binding="{Binding Date, StringFormat=MM/dd/yyyy}" Width="Auto"
                                            Header="{Binding Data.ColumnDateLabel, Source={StaticResource vm}}" />
                        <DataGridTextColumn Binding="{Binding PickupAddress}" Width="*"
                                            Header="{Binding Data.ColumnPickupLabel, Source={StaticResource vm}}" />
                        <DataGridTextColumn Binding="{Binding DropoffAddress}" Width="*"
                                            Header="{Binding Data.ColumnDropoffLabel, Source={StaticResource vm}}" />
                        <DataGridTextColumn Binding="{Binding Problem.Title}" Width="1.4*"
                                            Header="{Binding Data.ColumnProblemLabel, Source={StaticResource vm}}" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1" Grid.Column="1" Width="6"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" ShowsPreview="True" Cursor="SizeWE" />

                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        Background="{DynamicResource MaterialDesignPaper}"
                        DataContext="{Binding SelectedRow}">
                  <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="26"
                                Visibility="{Binding Data.SelectedRow, Source={StaticResource vm},
                                             Converter={StaticResource IsNull}}">
                        <materialDesign:PackIcon Kind="GestureTapButton" Width="30" Height="30"
                                                 Opacity=".35" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Data.PickARowLabel, Source={StaticResource vm}}"
                                   Margin="0,10,0,0" FontSize="12" Opacity=".7"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16"
                                  Visibility="{Binding Data.SelectedRow, Source={StaticResource vm},
                                               Converter={StaticResource NotNull}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Problem.Title}" FontSize="13.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Foreground="#FFC62828" />

                            <Border CornerRadius="9" Padding="8,1,8,1" Margin="0,6,0,0"
                                    HorizontalAlignment="Left" Background="#1A673AB7"
                                    Visibility="{Binding CaughtBeforeSending, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Data.CaughtHereLabel, Source={StaticResource vm}}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            </Border>

                            <Border CornerRadius="6" Padding="10,8,10,8" Margin="0,10,0,0"
                                    Background="#0F673AB7">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="17" Height="17"
                                                             VerticalAlignment="Top"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    <TextBlock Text="{Binding Problem.Suggestion}" Margin="8,0,0,0"
                                               FontSize="11.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="6" Padding="10" Margin="0,10,0,0"
                                    Background="#0FC62828" BorderThickness="1" BorderBrush="#33C62828"
                                    Visibility="{Binding Conflict, Converter={StaticResource NotNull}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Data.ConflictHeader, Source={StaticResource vm}}"
                                               FontSize="10.5" FontWeight="Bold" Opacity=".7" />
                                    <TextBlock Text="{Binding Conflict.TripId}" FontSize="13" FontWeight="Bold"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Conflict.PatientName}" FontSize="11.5" Margin="0,2,0,0" />
                                    <TextBlock FontSize="11" Opacity=".8" Margin="0,2,0,0">
                                        <Run Text="{Binding Conflict.Date, StringFormat=MM/dd/yyyy, Mode=OneWay}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Conflict.FromTime, Converter={StaticResource TimeText}, Mode=OneWay}" />
                                        <Run Text="-" />
                                        <Run Text="{Binding Conflict.ToTime, Converter={StaticResource TimeText}, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Conflict.PickupAddress}" FontSize="11" Opacity=".8"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Conflict.DropoffAddress}" FontSize="11" Opacity=".8"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding ServerMessage}" FontSize="11" TextWrapping="Wrap"
                                       Opacity=".75" Margin="0,10,0,0"
                                       Visibility="{Binding ServerMessage, Converter={StaticResource TextToVisibility}}" />

                            <TextBlock Text="{Binding Data.SuggestionHeader, Source={StaticResource vm}}"
                                       FontSize="10.5" FontWeight="Bold" Opacity=".55" Margin="0,18,0,0" />

                            <TextBlock Text="TripId" Tag="{Binding TripIdIsProblem}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TripId, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding TripIdIsProblem}" Style="{StaticResource FieldBox}" />

                            <TextBlock Text="Date" Tag="{Binding DateIsProblem}" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}" FontSize="12" />

                            <TextBlock Text="Patient" Tag="{Binding PatientIsProblem}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding PatientIsProblem}" Style="{StaticResource FieldBox}" />

                            <TextBlock Text="Phone" Tag="{Binding PhoneIsProblem}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding PatientPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding PhoneIsProblem}" Style="{StaticResource FieldBox}" />

                            <TextBlock Text="Rider ID" Tag="{Binding RiderIdIsProblem}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RiderId, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding RiderIdIsProblem}" Style="{StaticResource FieldBox}" />

                            <TextBlock Text="Pickup" Tag="{Binding PickupIsProblem}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding PickupAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding PickupIsProblem}" Style="{StaticResource FieldBox}"
                                     TextWrapping="Wrap" />

                            <TextBlock Text="Dropoff" Tag="{Binding DropoffIsProblem}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DropoffAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding DropoffIsProblem}" Style="{StaticResource FieldBox}"
                                     TextWrapping="Wrap" />

                            <TextBlock Text="Space" Tag="{Binding SpaceTypeIsProblem}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SpaceTypeName, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding SpaceTypeIsProblem}" Style="{StaticResource FieldBox}" />

                            <TextBlock Text="{Binding Data.CannotFixHereLabel, Source={StaticResource vm}}"
                                       FontSize="11.5" TextWrapping="Wrap" Opacity=".8" Margin="0,12,0,0"
                                       Visibility="{Binding Problem.FixableHere, Converter={StaticResource InverseBoolToVisibility}}" />

                            <Button Command="{Binding Data.RetryRowCommand, Source={StaticResource vm}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanRetry}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="0,18,0,0" Height="34" FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Reload" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Data.RetryLabel, Source={StaticResource vm}}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Expander Header="{Binding Problem.Code}" Margin="0,16,0,0" FontSize="11">
                                <StackPanel Margin="4,6,4,4">
                                    <TextBlock Text="{Binding LastRetryMessage}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="#FFC62828"
                                               Visibility="{Binding LastRetryMessage, Converter={StaticResource TextToVisibility}}" />
                                    <TextBlock Text="{Binding CorrelationId}" FontFamily="Consolas" FontSize="10"
                                               Opacity=".5" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding CorrelationId, Converter={StaticResource TextToVisibility}}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</UserControl>

<Window x:Class="Raphael.Desktop.Views.Notifications.NotificationAlertSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">

    <!--
        Personal preference, not administration: every dispatcher gets to this, and it is
        kept on this machine next to their read state.
    -->

    <StackPanel Margin="22 18 22 18">

        <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
            <materialDesign:PackIcon Kind="BellCogOutline" Width="22" Height="22"
                                     VerticalAlignment="Center"
                                     Foreground="#673AB7" />
            <TextBlock x:Name="TitleText" Margin="10 0 0 0"
                       FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="#3B3357" />
        </StackPanel>

        <TextBlock x:Name="IntroText" TextWrapping="Wrap"
                   FontSize="12" Opacity="0.75" Margin="0 0 0 16" />

        <Border Background="#F5F2FB" BorderBrush="#DCD2F0" BorderThickness="1"
                CornerRadius="10" Padding="14 12">
            <StackPanel>

                <Grid Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ActionSound"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center"
                                  Checked="Preference_Changed"
                                  Unchecked="Preference_Changed" />
                    <TextBlock x:Name="ActionSoundText" Grid.Column="1" Margin="14 0 0 0"
                               VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" />
                </Grid>

                <Grid Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="AttentionSound"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center"
                                  Checked="Preference_Changed"
                                  Unchecked="Preference_Changed" />
                    <TextBlock x:Name="AttentionSoundText" Grid.Column="1" Margin="14 0 0 0"
                               VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="AmbientSound"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  VerticalAlignment="Center"
                                  Checked="Preference_Changed"
                                  Unchecked="Preference_Changed" />
                    <TextBlock x:Name="AmbientSoundText" Grid.Column="1" Margin="14 0 0 0"
                               VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" />
                </Grid>

            </StackPanel>
        </Border>

        <!-- For a long call or a bulk import. Everything keeps arriving at the bell. -->
        <Border Background="White" BorderBrush="#E6E1F0" BorderThickness="1"
                CornerRadius="10" Padding="14 12" Margin="0 12 0 0">
            <StackPanel>

                <TextBlock x:Name="MutedUntilText" FontSize="12" FontWeight="SemiBold"
                           Foreground="#B06000" TextWrapping="Wrap" Margin="0 0 0 8"
                           Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="MuteButton" Click="Mute_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#4527A0" BorderBrush="#673AB7" />

                    <Button x:Name="UnmuteButton" Click="Unmute_Click" Margin="8 0 0 0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Visibility="Collapsed" />
                </StackPanel>

                <TextBlock x:Name="MuteNoteText" TextWrapping="Wrap"
                           FontSize="11" Opacity="0.7" Margin="0 10 0 0" />

            </StackPanel>
        </Border>

        <Button x:Name="CloseButton" Click="Close_Click"
                Style="{StaticResource MaterialDesignRaisedButton}"
                HorizontalAlignment="Right" Margin="0 18 0 0" />

    </StackPanel>

</Window>

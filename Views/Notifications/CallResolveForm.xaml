<UserControl x:Class="Raphael.Desktop.Views.Notifications.CallResolveForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Raphael.Desktop.Converters">

    <!-- DataContext: CallResolveViewModel. Why the request is being closed, and a note only
         when the reason is "Other". The note is the one free-text field of the whole feature,
         so its hint says not to name the patient. -->

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Background="#F5F2FB" BorderBrush="#DCD2F0" BorderThickness="1" CornerRadius="6"
            Padding="12 10" Margin="0 8 0 0"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
        <StackPanel>

            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0 0 0 6" />

            <ItemsControl ItemsSource="{Binding Reasons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- No GroupName: the queue and a call card can both show this form in the
                             same window, and a shared group would untick one when the other is
                             ticked. The view model keeps a single reason selected. -->
                        <RadioButton Content="{Binding Label}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     Margin="0 2 14 2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="{Binding NoteMaxLength}"
                     materialDesign:HintAssist.Hint="{Binding NoteHint}"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     Margin="0 8 0 0"
                     Visibility="{Binding NoteRequired, Converter={StaticResource BoolToVis}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
                <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="0 0 8 0" />
                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>

<UserControl x:Class="Raphael.Desktop.Views.Notifications.CallResolveForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Raphael.Desktop.Converters">

    <!-- DataContext: CallResolveViewModel. Why the request is being closed, and a note only
         when the reason is "Other". The note is the one free-text field of the whole feature,
         so its hint says not to name the patient.

         The reasons are chips, one tap each, because a dispatcher closes a call with the driver
         still in their ear and a column of radio buttons is read, not seen. -->

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- A reason: a pill that fills with the application's purple when chosen. A RadioButton
             underneath, so it behaves like one for the keyboard and for screen readers. -->
        <Style x:Key="ReasonChipStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0 0 8 8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="16" Padding="14 6"
                                Background="White" BorderBrush="#DCD2F0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon x:Name="Tick" Kind="Check" Width="14" Height="14"
                                                         VerticalAlignment="Center" Margin="0 0 6 0"
                                                         Foreground="White" Visibility="Collapsed" />
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center"
                                                  TextElement.Foreground="#3B3357" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#EDE7F6" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#673AB7" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#5E35B1" />
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="White" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#4527A0" />
                                <Setter TargetName="Chip" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="#673AB7" BorderThickness="1" CornerRadius="10"
            Padding="16 14" Margin="0 0 0 12"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
        <StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18"
                                         VerticalAlignment="Center" Margin="0 0 8 0" Foreground="#673AB7" />
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#3B3357"
                           VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Reasons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- No GroupName: the queue and a call card can both show this form in the
                             same window, and a shared group would untick one when the other is
                             ticked. The view model keeps a single reason selected. -->
                        <RadioButton Content="{Binding Label}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     Style="{StaticResource ReasonChipStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="{Binding NoteMaxLength}"
                     materialDesign:HintAssist.Hint="{Binding NoteHint}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     Margin="0 6 0 0"
                     Visibility="{Binding NoteRequired, Converter={StaticResource BoolToVis}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
                <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="0 0 8 0" />
                <Button Command="{Binding ConfirmCommand}" Style="{StaticResource MaterialDesignRaisedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Check" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConfirmText}" Margin="6 0 0 0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>

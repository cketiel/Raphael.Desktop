<UserControl x:Class="Raphael.Desktop.Views.Notifications.NotificationToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Raphael.Desktop.Converters"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
             helpers:HelpAssist.TopicId="desktop/notifications/live-alerts"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             IsTabStop="False">

    <!--
        The live alert stack.

        Used in two places with the same template: inside the main window for everything
        that can wait, and inside the floating window for what cannot. Its DataContext is
        one NotificationToastLaneViewModel.
    -->

    <UserControl.Resources>

        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Quiet, icon-only, and it must not look like the card is a button. -->
        <Style x:Key="ToastIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#5F6368" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="11"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#22000000" />
                                <Setter Property="Foreground" Value="#202124" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <StackPanel>

        <!-- ===== What did not fit =====
             Never a silent drop: the ones pushed out are still in the inbox and still on
             the bell, and this opens the panel on them. -->
        <Button Command="{Binding OpenCenterCommand}"
                HorizontalAlignment="Right" Margin="0 0 0 8"
                Background="Transparent" BorderThickness="0" Cursor="Hand"
                Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVis}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Plate" CornerRadius="12" Background="White" Opacity="0.9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1"
                                                  Opacity="0.16" Color="#202124" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="12" BorderBrush="#1F000000" BorderThickness="1"
                                Padding="12 5">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BellOutline" Width="14" Height="14"
                                                         VerticalAlignment="Center"
                                                         Foreground="#5F6368" />
                                <TextBlock Text="{Binding OverflowLabel}" Margin="7 0 0 0"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="#3C4043" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- ===== The cards ===== -->
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Grid x:Name="Root" Width="380" Margin="0 8 0 0"
                          Background="Transparent" Cursor="Hand"
                          MouseEnter="Card_MouseEnter"
                          MouseLeave="Card_MouseLeave"
                          MouseLeftButtonUp="Card_Click">

                        <!-- Slides in from the edge instead of appearing on top of whatever
                             the dispatcher was reading.
                             ⚠️ A TranslateTransform declared here, on this element. Never a
                             transform coming from a shared style — see C3 in the backlog. -->
                        <Grid.RenderTransform>
                            <TranslateTransform X="44" />
                        </Grid.RenderTransform>

                        <!-- ===== The translucent plate =====
                             ⚠️ The transparency lives here and only here. Putting Opacity on
                             the card itself would fade the text too, and washed-out text is
                             harder to read than solid text — the opposite of the point. The
                             plate is a sibling of the content, so the message stays at full
                             strength on top of it. Solid while the pointer is on the card. -->
                        <Border x:Name="Plate" CornerRadius="10" Background="White">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0.91" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="ActionRequired">
                                            <Setter Property="Opacity" Value="0.95" />
                                        </DataTrigger>
                                        <!-- Last on purpose: hovering wins over the level. -->
                                        <DataTrigger Value="True"
                                                     Binding="{Binding IsMouseOver,
                                                               RelativeSource={RelativeSource AncestorType=Grid}}">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                                  Opacity="0.18" Color="#202124" />
                            </Border.Effect>
                        </Border>

                        <Border CornerRadius="10" BorderBrush="#1F000000" BorderThickness="1"
                                ClipToBounds="True">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Severity as a stripe, not as a painted card: the colour
                                     is the signal, the message is the content. -->
                                <Border Grid.RowSpan="2" Background="{Binding AccentBrush}" />

                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15"
                                        Margin="10 11 0 11" VerticalAlignment="Top"
                                        Background="{Binding IconBackground}">
                                    <materialDesign:PackIcon Kind="{Binding Icon}"
                                                             Width="17" Height="17"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{Binding AccentBrush}" />
                                </Border>

                                <StackPanel Grid.Column="2" Margin="10 11 6 11">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding EventName}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding AccentBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="·" Margin="6 0" Opacity="0.4" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasTrip, Converter={StaticResource BoolToVis}}" />

                                        <TextBlock Text="{Binding TripLabel}"
                                                   FontSize="12" Opacity="0.75"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasTrip, Converter={StaticResource BoolToVis}}" />

                                        <!-- "×4" — the same trip moving on, folded in. -->
                                        <Border Background="#1F000000" CornerRadius="8"
                                                Padding="6 1" Margin="7 0 0 0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="10" FontWeight="Bold"
                                                       Foreground="#3C4043">
                                                <Run Text="×" /><Run Text="{Binding Count, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>

                                    </StackPanel>

                                    <TextBlock Text="{Binding Body}"
                                               Margin="0 4 0 0" FontSize="13"
                                               Foreground="#202124"
                                               TextWrapping="Wrap" MaxHeight="40"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding ShowBody, Converter={StaticResource BoolToVis}}" />

                                    <!-- ⚠️ The hour the office has to get a vehicle to a
                                         patient who said they were ready. -->
                                    <StackPanel Orientation="Horizontal" Margin="0 7 0 0"
                                                Visibility="{Binding HasCountdown, Converter={StaticResource BoolToVis}}">
                                        <materialDesign:PackIcon Kind="ClockAlertOutline"
                                                                 Width="14" Height="14"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{Binding CountdownBrush}" />
                                        <TextBlock Text="{Binding CountdownText}" Margin="6 0 0 0"
                                                   FontSize="12" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding CountdownBrush}" />
                                    </StackPanel>

                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="0 8 8 0" VerticalAlignment="Top">

                                    <Button Style="{StaticResource ToastIconButtonStyle}"
                                            Command="{Binding CloseCommand}"
                                            HorizontalAlignment="Right"
                                            ToolTip="{Binding DataContext.CloseText,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                                    </Button>

                                    <TextBlock Text="{Binding TimeLabel}"
                                               FontSize="11" Opacity="0.6"
                                               Margin="0 2 4 0"
                                               HorizontalAlignment="Right" />

                                </StackPanel>

                                <!-- How much of its life the card has left. An alert that
                                     shows its own clock feels calm; one that just vanishes
                                     feels like something was taken away. -->
                                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                             Height="2" Minimum="0" Maximum="1"
                                             Value="{Binding Progress, Mode=OneWay}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{Binding AccentBrush}"
                                             Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" />

                            </Grid>
                        </Border>

                    </Grid>

                    <DataTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Root">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     To="0" Duration="0:0:0.16">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.16" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </DataTemplate.Triggers>

                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>

</UserControl>

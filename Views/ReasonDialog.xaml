<Window x:Class="Raphael.Desktop.Views.ReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Asks one thing: why. Used to reject a trip, where the clinic reads the answer. -->
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,12"
                   Style="{StaticResource MaterialDesignBody1TextBlock}" />
        <TextBox x:Name="ReasonBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxLength="500"
                 VerticalScrollBarVisibility="Auto"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
        <TextBlock x:Name="ErrorText" Foreground="#C62828" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0" Click="OnCancel" />
            <Button x:Name="OkButton" IsDefault="True" Style="{StaticResource MaterialDesignRaisedButton}" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>

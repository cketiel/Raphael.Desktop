<UserControl x:Class="Raphael.Desktop.Views.Compliance.ComplianceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:Raphael.Desktop.Services"
             xmlns:helpers="clr-namespace:Raphael.Desktop.Helpers"
             helpers:HelpAssist.TopicId="desktop/compliance/overview"
             x:Name="Root">

    <!--
        RE-065. Docs: every compliance document of the company, in the style of Users and Vehicles
        (blue frame, CustomDataGridStyle, a first column of coloured action icons). Users and Vehicles
        only show a status badge and link here; this is the one place documents are managed.
        Only an administrator approves or rejects; the office uploads, corrects what waits, renews.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="OkBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="OkSoft" Color="#E8F5E9"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#B26A00"/>
        <SolidColorBrush x:Key="WarnSoft" Color="#FFF4E0"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C62828"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#FFEBEE"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#1565C0"/>
        <SolidColorBrush x:Key="InfoSoft" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#757575"/>
        <SolidColorBrush x:Key="MutedSoft" Color="#F5F5F5"/>

        <!-- The badge of a document's state: the same shape as the Out of Service one in Users. -->
        <Style x:Key="StateBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource MutedSoft}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="valid"><Setter Property="Background" Value="{StaticResource OkSoft}"/><Setter Property="BorderBrush" Value="{StaticResource OkBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="soon"><Setter Property="Background" Value="{StaticResource WarnSoft}"/><Setter Property="BorderBrush" Value="{StaticResource WarnBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="expired"><Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="rejected"><Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="pending"><Setter Property="Background" Value="{StaticResource InfoSoft}"/><Setter Property="BorderBrush" Value="{StaticResource InfoBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateInk" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="valid"><Setter Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="soon"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="expired"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="rejected"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="pending"><Setter Property="Foreground" Value="{StaticResource InfoBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AttentionDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#BDBDBD"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Attention}" Value="ok"><Setter Property="Fill" Value="{StaticResource OkBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Attention}" Value="danger"><Setter Property="Fill" Value="{StaticResource DangerBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Attention}" Value="warn"><Setter Property="Fill" Value="{StaticResource WarnBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Attention}" Value="info"><Setter Property="Fill" Value="{StaticResource InfoBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A count in a list: bold and coloured when there is something, faint at zero. -->
        <Style x:Key="Count" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="0"><Setter Property="Opacity" Value="0.35"/><Setter Property="Foreground" Value="Black"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- Exactly the Home and Schedule trip grids: ContentDataGridStyle is that look in one key
             (centred headers, white every other row, the purple edge on hover and on the selected
             row). Nothing else is set here, so these grids cannot drift from those. -->
        <Style x:Key="Grid" TargetType="DataGrid" BasedOn="{StaticResource ContentDataGridStyle}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- The height a Home row has (its action icons give it): rows without icons are not squashed. -->
            <Setter Property="MinRowHeight" Value="24"/>
            <!-- Never the empty "new row": its {NewItemPlaceholder} would reach the row commands. -->
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
        </Style>
        <Style x:Key="Fab" TargetType="Button" BasedOn="{StaticResource MaterialDesignFloatingActionMiniButton}">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- The documents of one person or vehicle: the grid of People, Vehicles and My documents. -->
        <DataTemplate x:Key="DocsGrid">
            <DataGrid ItemsSource="{Binding}" Style="{StaticResource Grid}"
                      ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}" RowStyle="{StaticResource ContentRowStyle}" CellStyle="{StaticResource TripSelectionCellStyle}"
                      SelectedItem="{Binding DataContext.SelectedDoc, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource TripActionButtonStyle}" Visibility="{Binding CanView, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.View]}"
                                            Command="{Binding DataContext.ViewRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="EyeOutline" Foreground="#2196F3"/>
                                    </Button>
                                    <Button Style="{StaticResource TripActionButtonStyle}" Visibility="{Binding CanUpload, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding UploadToolTip}"
                                            Command="{Binding DataContext.UploadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="FileUploadOutline" Foreground="Orange"/>
                                    </Button>
                                    <Button Style="{StaticResource TripActionButtonStyle}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Edit]}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Pencil" Foreground="Orange"/>
                                    </Button>
                                    <Button Style="{StaticResource TripActionButtonStyle}" Visibility="{Binding CanReview, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Approve]}"
                                            Command="{Binding DataContext.ApproveRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="#2E7D32"/>
                                    </Button>
                                    <Button Style="{StaticResource TripActionButtonStyle}" Visibility="{Binding CanReview, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Reject]}"
                                            Command="{Binding DataContext.RejectRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="CloseCircleOutline" Foreground="Red"/>
                                    </Button>
                                    <Button Style="{StaticResource TripActionButtonStyle}" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.History]}"
                                            Command="{Binding DataContext.HistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="History" Foreground="#607D8B"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Document]}" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Status]}" Width="120" SortMemberPath="State">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StateBadge}">
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource StateInk}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Expires]}" Binding="{Binding ExpiresText}" Width="100"/>
                    <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Days]}" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource StateInk}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Files]}" Binding="{Binding FilesText}" Width="90"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Uploaded]}" Binding="{Binding UploadedText}" Width="1.5*"/>
                    <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Note]}" Binding="{Binding Note}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderThickness="0,1,0,0" BorderBrush="#2196f3" Background="White">
        <Grid Margin="10,4,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Legend, status and Refresh -->
            <DockPanel Margin="4,6,4,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Command="{Binding LoadAllCommand}"
                        ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Refresh]}">
                    <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource OkBrush}"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Valid]}" Margin="5,0,16,0"/>
                    <Ellipse Width="9" Height="9" Fill="{StaticResource WarnBrush}"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Expiring]}" Margin="5,0,16,0"/>
                    <Ellipse Width="9" Height="9" Fill="{StaticResource DangerBrush}"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.ExpiredOrRejected]}" Margin="5,0,16,0"/>
                    <Ellipse Width="9" Height="9" Fill="{StaticResource InfoBrush}"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.InReview]}" Margin="5,0,16,0"/>
                    <ProgressBar IsIndeterminate="True" Width="120" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}" Margin="12,0"/>
                    <TextBlock Text="{Binding Message}" Foreground="OrangeRed" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

                <!-- ============ TO REVIEW ============ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.TabReview]}"/>
                            <Border Background="{StaticResource InfoBrush}" CornerRadius="9" MinWidth="18" Height="18" Margin="6,0,0,0" Padding="5,0">
                                <TextBlock Text="{Binding PendingCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource InfoSoft}" CornerRadius="3" Padding="10,6" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmin}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.ReviewOnlyAdmin]}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Pending}" Style="{StaticResource Grid}"
                      ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}" RowStyle="{StaticResource ContentRowStyle}" CellStyle="{StaticResource TripSelectionCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource TripActionButtonStyle}"
                                                        ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.View]}"
                                                        Command="{Binding DataContext.ViewListRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="EyeOutline" Foreground="#2196F3"/>
                                                </Button>
                                                <Button Style="{StaticResource TripActionButtonStyle}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Approve]}"
                                                        Command="{Binding DataContext.ApproveListRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="#2E7D32"/>
                                                </Button>
                                                <Button Style="{StaticResource TripActionButtonStyle}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Reject]}"
                                                        Command="{Binding DataContext.RejectListRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="CloseCircleOutline" Foreground="Red"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Document]}" Binding="{Binding Doc.DocumentTypeName}" Width="2*"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Owner]}" Binding="{Binding Doc.SubjectName}" Width="2*"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Kind]}" Binding="{Binding SubjectKind}" Width="100"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Expires]}" Binding="{Binding ExpiresText}" Width="100"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Uploaded]}" Binding="{Binding UploadedText}" Width="160"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.By]}" Binding="{Binding Doc.UploadedByName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ============ EXPIRING ============ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.TabExpiring]}"/>
                            <Border Background="{StaticResource WarnBrush}" CornerRadius="9" MinWidth="18" Height="18" Margin="6,0,0,0" Padding="5,0">
                                <TextBlock Text="{Binding ExpiringCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Style="{StaticResource Fab}" Command="{Binding NotifyExpiringCommand}"
                                    ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.NotifySelected]}">
                                <materialDesign:PackIcon Kind="BellRingOutline" Width="22" Height="22"/>
                            </Button>
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Within]}" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding DayOptions}" SelectedItem="{Binding ExpiringDays}" Width="60" Margin="8,0"/>
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.DaysSuffix]}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.ExpiringHint]}" Opacity="0.6" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Expiring}" Style="{StaticResource Grid}"
                      ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}" RowStyle="{StaticResource ContentRowStyle}" CellStyle="{StaticResource TripSelectionCellStyle}" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TripActionButtonStyle}"
                                                    ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.View]}"
                                                    Command="{Binding DataContext.ViewListRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="EyeOutline" Foreground="#2196F3"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Document]}" Binding="{Binding Doc.DocumentTypeName}" Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Owner]}" Binding="{Binding Doc.SubjectName}" Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Kind]}" Binding="{Binding SubjectKind}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Expires]}" Binding="{Binding ExpiresText}" Width="100" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Days]}" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StateBadge}">
                                                <TextBlock Text="{Binding DaysText}" Style="{StaticResource StateInk}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ============ PEOPLE ============ -->
                <TabItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.TabPeople]}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Style="{StaticResource Fab}" Command="{Binding NotifyPeopleCommand}"
                                    ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.NotifySelected]}">
                                <materialDesign:PackIcon Kind="BellRingOutline" Width="22" Height="22"/>
                            </Button>
                            <TextBox Text="{Binding PeopleSearch, UpdateSourceTrigger=PropertyChanged}" Width="240" VerticalAlignment="Center"
                                     materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Search]}"/>
                            <ComboBox ItemsSource="{Binding RoleFilters}" SelectedIndex="{Binding RoleFilter}" Width="150" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.PeopleHint]}" Opacity="0.6" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}" Style="{StaticResource Grid}"
                      ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}" RowStyle="{StaticResource ContentRowStyle}" CellStyle="{StaticResource TripSelectionCellStyle}" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                      Visibility="{Binding CanNotify, Converter={StaticResource BoolToVis}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Ellipse Style="{StaticResource AttentionDot}"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Name]}" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Role]}" Binding="{Binding RoleText}" Width="110" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Valid]}" Width="80" SortMemberPath="Summary.Valid">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary.Valid}" Style="{StaticResource Count}" Foreground="{StaticResource OkBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Expiring]}" Width="90" SortMemberPath="Summary.Expiring">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary.Expiring}" Style="{StaticResource Count}" Foreground="{StaticResource WarnBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Expired]}" Width="80" SortMemberPath="Summary.Expired">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary.Expired}" Style="{StaticResource Count}" Foreground="{StaticResource DangerBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.InReview]}" Width="90" SortMemberPath="Summary.Pending">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary.Pending}" Style="{StaticResource Count}" Foreground="{StaticResource InfoBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Rejected]}" Width="90" SortMemberPath="Summary.Rejected">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary.Rejected}" Style="{StaticResource Count}" Foreground="{StaticResource DangerBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Missing]}" Width="80" SortMemberPath="Summary.Missing">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary.Missing}" Style="{StaticResource Count}" Foreground="{StaticResource MutedBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.NextExpiry]}" Binding="{Binding NextExpiryText}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Binding="{Binding ActiveText}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#E3F2FD"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,6">
                            <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Foreground="#2196F3" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PersonPanelTitle}" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.SelectOne]}" Opacity="0.6" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PersonPanelTitle}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <ContentControl Grid.Row="4" Content="{Binding PersonPanel}" ContentTemplate="{StaticResource DocsGrid}"/>
                    </Grid>
                </TabItem>

                <!-- ============ VEHICLES ============ -->
                <TabItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.TabVehicles]}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox Text="{Binding VehicleSearch, UpdateSourceTrigger=PropertyChanged}" Width="240" VerticalAlignment="Center"
                                     materialDesign:HintAssist.Hint="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Search]}"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}" Style="{StaticResource Grid}"
                      ColumnHeaderStyle="{StaticResource CenteredColumnHeaderStyle}" RowStyle="{StaticResource ContentRowStyle}" CellStyle="{StaticResource TripSelectionCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Ellipse Style="{StaticResource AttentionDot}"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Vehicle]}" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Valid]}" Width="80" SortMemberPath="Summary.Valid">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary.Valid}" Style="{StaticResource Count}" Foreground="{StaticResource OkBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Expiring]}" Width="90" SortMemberPath="Summary.Expiring">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary.Expiring}" Style="{StaticResource Count}" Foreground="{StaticResource WarnBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Expired]}" Width="80" SortMemberPath="Summary.Expired">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary.Expired}" Style="{StaticResource Count}" Foreground="{StaticResource DangerBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.InReview]}" Width="90" SortMemberPath="Summary.Pending">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary.Pending}" Style="{StaticResource Count}" Foreground="{StaticResource InfoBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Rejected]}" Width="90" SortMemberPath="Summary.Rejected">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary.Rejected}" Style="{StaticResource Count}" Foreground="{StaticResource DangerBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.Missing]}" Width="80" SortMemberPath="Summary.Missing">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary.Missing}" Style="{StaticResource Count}" Foreground="{StaticResource MutedBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.NextExpiry]}" Binding="{Binding NextExpiryText}" Width="120"/>
                                <DataGridTextColumn Binding="{Binding ActiveText}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#E3F2FD"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,6">
                            <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Foreground="#2196F3" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding VehiclePanelTitle}" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.SelectOne]}" Opacity="0.6" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VehiclePanelTitle}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <ContentControl Grid.Row="4" Content="{Binding VehiclePanel}" ContentTemplate="{StaticResource DocsGrid}"/>
                    </Grid>
                </TabItem>

                <!-- ============ MY DOCUMENTS ============ -->
                <TabItem Header="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[compliance.TabMine]}">
                    <ContentControl Margin="0,10,0,0" Content="{Binding MinePanel}" ContentTemplate="{StaticResource DocsGrid}"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Raphael.ico</ApplicationIcon>
	
	<!-- The four move together. AssemblyVersion is the one that reaches the screen:
	     VersionHelper reads Assembly.GetName().Version and the login and every window
	     title show it. If it does not match the tag, the tag lies. -->
	<Version>1.4.0</Version>
	<AssemblyVersion>1.4.0.0</AssemblyVersion>
	<FileVersion>1.4.0.0</FileVersion>
	<InformationalVersion>1.4.0-release.1</InformationalVersion>

	<!-- Stamped into the assembly at compile time and read back by VersionHelper.Build.
	     It used to be the file's last-write timestamp, which copying the folder rewrites:
	     a dispatcher handed a month-old build saw the day it landed on their machine and
	     read it as the day it was made.

	     Local time of the machine that compiles, not UTC. This is a label, not an instant:
	     nothing converts it at display time, so the only reader who can check it is whoever
	     produced the build. Stamping UTC made an evening build in Saltillo come out dated
	     tomorrow — true, and read as an error, which is the same trap as the old timestamp. -->
	<BuildDateStamp>$([System.DateTime]::Now.ToString("yyyy.MM.dd"))</BuildDateStamp>

	<!-- The configuration binder's source generator emits C# interceptors, and interceptors
	     only compile in namespaces the project opts into. The package registers its own,
	     but under a property Roslyn renamed along the way: InterceptorsPreviewNamespaces
	     became InterceptorsNamespaces.

	     Visual Studio and the dotnet CLI carry different Roslyn builds, so the registration
	     landed in one and not the other: `dotnet publish` succeeded while the publish
	     wizard failed with "the interceptors feature is not enabled in this namespace",
	     which is why v1.2.3 ended up being distributed straight out of bin\Debug.

	     Both names are declared. Whichever one a given compiler does not know, it ignores.
	     ⚠️ Only one call in the whole application goes through the generator, which is
	     ApiZonitelService's Get&lt;ZonitelSettings&gt;(). If this ever gets in the way again,
	     EnableConfigurationBindingGenerator=false is a legitimate way out: nothing here is
	     trimmed or AOT, which is the only thing the generator buys. -->
	<InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.Extensions.Configuration.Binder.SourceGeneration</InterceptorsNamespaces>
	<InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Microsoft.Extensions.Configuration.Binder.SourceGeneration</InterceptorsPreviewNamespaces>
  </PropertyGroup>

  <!-- ⚠️ Top level, never inside a Target: GenerateAssemblyInfo consumes AssemblyAttribute
       before CoreCompile, so an item declared later never reaches the assembly.
       The key is matched by name in Helpers/VersionHelper.cs. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$(BuildDateStamp)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\amazinggooglemap.html" />
    <None Remove="Assets\autocomplete.html" />
    <None Remove="Assets\basemap.html" />
    <None Remove="Assets\googlemap.html" />
    <None Remove="Assets\icons\dropoff.png" />
    <None Remove="Assets\icons\en.png" />
    <None Remove="Assets\icons\es.png" />
    <None Remove="Assets\icons\pickup.png" />
    <None Remove="Assets\Languages\en.json" />
    <None Remove="Assets\Languages\es.json" />
    <None Remove="Assets\logo.png" />
    <None Remove="Assets\map.html" />
    <None Remove="Assets\Mappings\Ride2md.json" />
    <None Remove="Assets\Mappings\SAFERIDE.json" />
    <None Remove="Assets\Mappings\SAFERIDE2.json" />
    <None Remove="Assets\no-image.png" />
  </ItemGroup>

  <!-- ===== Product help =====
       A compiled bundle, not source. It is written by `node help/build/build.js` in the ecosystem
       repository and committed here so this project still builds on a machine that does not have
       that repository beside it. `help.manifest.json` inside carries the version it covers and the
       commit it came from, and /ship step 4-bis fails when either has fallen behind.

       Do not edit anything under Assets\Help by hand: the next build overwrites it, and the topic
       it came from would then say something different. See _meta/HELP_POLICY.md. -->
  <ItemGroup>
    <Content Include="Assets\Help\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icons\dropoff.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Content Include="Assets\amazinggooglemap.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\autocomplete.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\basemap.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\googlemap.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Shared by every map page: the Google loader, the address autocomplete and the route drawing.
      Served to them from the maps virtual host, so it has to reach the output folder beside them.
    -->
    <Content Include="Assets\raphael-maps.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icons\en.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icons\es.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icons\pickup.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Languages\en.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Languages\es.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\map.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Mappings\Ride2md.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Mappings\SAFERIDE.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Mappings\SAFERIDE2.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\no-image.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Content Include="Raphael.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.7.25104.5739" />
    <PackageReference Include="GMap.NET.WinPresentation" Version="2.1.7" />
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="MaterialDesignColors" Version="5.2.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
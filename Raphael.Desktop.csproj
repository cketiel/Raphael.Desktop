<Project Sdk="Microsoft.NET.Sdk">
	
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Raphael.ico</ApplicationIcon>
	
	<!-- The four move together. AssemblyVersion is the one that reaches the screen:
	     VersionHelper reads Assembly.GetName().Version and the login and every window
	     title show it. If it does not match the tag, the tag lies. -->
	<Version>1.3.0</Version>
	<AssemblyVersion>1.3.0.0</AssemblyVersion>
	<FileVersion>1.3.0.0</FileVersion>
	<InformationalVersion>1.3.0-release.1</InformationalVersion>

	<!-- Stamped into the assembly at compile time and read back by VersionHelper.Build.
	     It used to be the file's last-write timestamp, which copying the folder rewrites:
	     a dispatcher handed a month-old build saw the day it landed on their machine and
	     read it as the day it was made.

	     Local time of the machine that compiles, not UTC. This is a label, not an instant:
	     nothing converts it at display time, so the only reader who can check it is whoever
	     produced the build. Stamping UTC made an evening build in Saltillo come out dated
	     tomorrow — true, and read as an error, which is the same trap as the old timestamp. -->
	<BuildDateStamp>$([System.DateTime]::Now.ToString("yyyy.MM.dd"))</BuildDateStamp>
  </PropertyGroup>

  <!-- ⚠️ Top level, never inside a Target: GenerateAssemblyInfo consumes AssemblyAttribute
       before CoreCompile, so an item declared later never reaches the assembly.
       The key is matched by name in Helpers/VersionHelper.cs. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$(BuildDateStamp)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\amazinggooglemap.html" />
    <None Remove="Assets\autocomplete.html" />
    <None Remove="Assets\basemap.html" />
    <None Remove="Assets\googlemap.html" />
    <None Remove="Assets\icons\dropoff.png" />
    <None Remove="Assets\icons\en.png" />
    <None Remove="Assets\icons\es.png" />
    <None Remove="Assets\icons\pickup.png" />
    <None Remove="Assets\Languages\en.json" />
    <None Remove="Assets\Languages\es.json" />
    <None Remove="Assets\logo.png" />
    <None Remove="Assets\map.html" />
    <None Remove="Assets\Mappings\Ride2md.json" />
    <None Remove="Assets\Mappings\SAFERIDE.json" />
    <None Remove="Assets\Mappings\SAFERIDE2.json" />
    <None Remove="Assets\no-image.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icons\dropoff.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Content Include="Assets\amazinggooglemap.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\autocomplete.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\basemap.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\googlemap.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icons\en.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icons\es.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\icons\pickup.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Languages\en.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Languages\es.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\map.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Mappings\Ride2md.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Mappings\SAFERIDE.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Mappings\SAFERIDE2.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\no-image.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Content Include="Raphael.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.7.25104.5739" />

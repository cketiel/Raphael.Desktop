<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Para toda los elementos materialDesign:PackIcon de la app -->
    <!--<Style TargetType="materialDesign:PackIcon" >

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style> -->

    <Style x:Key="IconsMouseOverForegroundPrimaryStyle" TargetType="materialDesign:PackIcon" >

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Hover Scale — SE APLICA A MANO, NUNCA COMO ESTILO IMPLÍCITO.

        ⚠️ Sin `x:Key` este estilo alcanzaba a TODOS los PackIcon de la aplicación,
        incluidos los que MaterialDesign crea dentro de sus propias plantillas. Varios de
        ellos (el chevron de un Expander, la flecha de un ComboBox, el icono de un
        DatePicker) ya traen su propio `RenderTransform`, y es un `RotateTransform`, que
        no tiene `ScaleX`. Al pasar el ratón por encima, la animación de abajo no podía
        resolver la ruta y WPF lanzaba:

            "No se pueden resolver todas las referencias de propiedad en la ruta a la
             propiedad RenderTransform.ScaleX."

        Eso es lo que cerraba la aplicación al abrir la administración del Centro de
        Notificaciones. Con la clave puesta, el efecto solo se aplica donde se pide.
    -->
    <Style x:Key="HoverScaleIconStyle"
           TargetType="materialDesign:PackIcon">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                Duration="0:0:0.3"
                                To="1.2"
                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                               />
                            <DoubleAnimation 
                                Duration="0:0:0.3"
                                To="1.2"
                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation 
                                Duration="0:0:0.3"
                                To="1"
                                Storyboard.TargetProperty="RenderTransform.ScaleX"
                                />
                            <DoubleAnimation 
                                Duration="0:0:0.3"
                                To="1"
                                Storyboard.TargetProperty="RenderTransform.ScaleY"
                                />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
    <!-- The drawing of a vehicle kind: Content is "AMB", "WCH", "STR" or null (nothing drawn). -->
    <Style x:Key="VehicleArtByKind" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Style.Triggers>
            <Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Hidden"/></Trigger>
            <Trigger Property="Content" Value="AMB"><Setter Property="ContentTemplate" Value="{StaticResource LmArtAmb}"/></Trigger>
            <Trigger Property="Content" Value="WCH"><Setter Property="ContentTemplate" Value="{StaticResource LmArtWch}"/></Trigger>
            <Trigger Property="Content" Value="STR"><Setter Property="ContentTemplate" Value="{StaticResource LmArtStr}"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- A pill for a vehicle kind. DataContext exposes Kind (AMB, WCH, STR or null) and KindText. An
         icon, not the drawing: a list draws dozens of them. -->
    <DataTemplate x:Key="VehicleKindPill">
        <Border CornerRadius="9" Padding="8,1" BorderThickness="1" HorizontalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF4E0"/><Setter Property="BorderBrush" Value="#F5C27A"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="AMB"><Setter Property="Background" Value="#E8F5E9"/><Setter Property="BorderBrush" Value="#A5D6A7"/></DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="WCH"><Setter Property="Background" Value="#E3F2FD"/><Setter Property="BorderBrush" Value="#90CAF9"/></DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="STR"><Setter Property="Background" Value="#EDE7F6"/><Setter Property="BorderBrush" Value="#B39DDB"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="AlertOutline"/><Setter Property="Foreground" Value="#B26A00"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="AMB"><Setter Property="Kind" Value="CarSide"/><Setter Property="Foreground" Value="#2E7D32"/></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="WCH"><Setter Property="Kind" Value="WheelchairAccessibility"/><Setter Property="Foreground" Value="#1565C0"/></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="STR"><Setter Property="Kind" Value="BedEmpty"/><Setter Property="Foreground" Value="#4527A0"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <TextBlock Text="{Binding KindText}" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#8A4B00"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="AMB"><Setter Property="Foreground" Value="#1B5E20"/></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="WCH"><Setter Property="Foreground" Value="#0D47A1"/></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="STR"><Setter Property="Foreground" Value="#4527A0"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A tab drawn as an underlined radio button (Vehicles); Tag = icon. -->
    <Style x:Key="VehicleTabButton" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#5B6B7C"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="14,8,14,7" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="17" Height="17"
                                                     VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="#F3EEFB"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tab" Property="BorderBrush" Value="#673AB7"/>
                            <Setter Property="Foreground" Value="#4527A0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VehicleMenuAction" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="#1E2A36"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
    </Style>

    <Style x:Key="VehiclePill" TargetType="Border">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- The vehicle as the map draws it: a disc in the group colour, white border, and the van seen
         from above (live-map.js, topVanSvg) with a stripe in the group colour. Tag = heading in degrees. -->
    <ControlTemplate x:Key="LmVehicleGlyph" TargetType="ContentControl">
        <Grid Width="22" Height="22">
            <Ellipse Fill="{TemplateBinding Background}" Stroke="White" StrokeThickness="2"/>
            <Viewbox Width="9" Height="16" RenderTransformOrigin="0.5,0.5">
                <Viewbox.RenderTransform><RotateTransform Angle="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/></Viewbox.RenderTransform>
                <Canvas Width="20" Height="36">
                    <Path Fill="#33414D" Data="M1.2,9.6 L0.2,10.2 L0.2,11.8 L1.6,11.8 Z M18.8,9.6 L19.8,10.2 L19.8,11.8 L18.4,11.8 Z"/>
                    <Path Stroke="#5D6B78" StrokeThickness="0.6" Data="M3.2,6.4 C3.2,3.4 6,1.6 10,1.6 C14,1.6 16.8,3.4 16.8,6.4 L16.8,32 C16.8,33.4 15.7,34.4 14.4,34.4 L5.6,34.4 C4.3,34.4 3.2,33.4 3.2,32 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#C4CCD4" Offset="0"/><GradientStop Color="#FFFFFF" Offset="0.22"/>
                                <GradientStop Color="#FFFFFF" Offset="0.78"/><GradientStop Color="#C4CCD4" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Fill="#FFF4C2" Data="M4.6,3.4 L6.4,2.5 L6.7,3.6 L4.8,4.2 Z M15.4,3.4 L13.6,2.5 L13.3,3.6 L15.2,4.2 Z"/>
                    <Path Fill="#1F2E3C" Data="M4.4,9.2 C5.6,7.6 7.6,7 10,7 C12.4,7 14.4,7.6 15.6,9.2 L14.8,12.6 L5.2,12.6 Z"/>
                    <Rectangle Canvas.Left="5" Canvas.Top="13.6" Width="10" Height="16.4" RadiusX="1.2" RadiusY="1.2" Fill="#F4F7FA" Stroke="#C9D1D9" StrokeThickness="0.5"/>
                    <Rectangle Canvas.Left="8.6" Canvas.Top="13.6" Width="2.8" Height="16.4" Fill="{TemplateBinding Background}"/>
                    <Path Fill="#1F2E3C" Data="M5.4,31 L14.6,31 L14.6,32.6 L5.4,32.6 Z"/>
                    <Path Fill="#D43C3C" Data="M3.4,32.6 L5,32.6 L5,34 L3.6,34 Z M15,32.6 L16.6,32.6 L16.4,34 L15,34 Z"/>
                </Canvas>
            </Viewbox>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>

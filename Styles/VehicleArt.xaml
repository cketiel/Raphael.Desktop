<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Vehicle illustrations (2026-11-22, moved here by RE-083): side views drawn in vectors. A white
         body lit from above, a blue livery stripe, tinted glass, door seams, lights, wheels, a soft
         shadow. AMB: minivan. WCH: high-roof van with the rear ramp down and the access symbol. STR:
         high-roof van with the rear doors open and the stretcher coming out. Front to the right. -->
    <LinearGradientBrush x:Key="LmArtBody" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F3F6F9" Offset="0.42"/>
        <GradientStop Color="#D6DDE4" Offset="0.78"/>
        <GradientStop Color="#A9B4BF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LmArtGlass" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7B96AF" Offset="0"/>
        <GradientStop Color="#2A3B4C" Offset="0.45"/>
        <GradientStop Color="#111B25" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LmArtStripe" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2E7FE0" Offset="0"/>
        <GradientStop Color="#1556A8" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="LmArtRim" GradientOrigin="0.38,0.32">
        <GradientStop Color="#F4F6F8" Offset="0"/>
        <GradientStop Color="#B9C1C9" Offset="0.55"/>
        <GradientStop Color="#5E666E" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LmArtShadow">
        <GradientStop Color="#73000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="LmArtLamp" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#FFF0B8" Offset="1"/>
    </LinearGradientBrush>


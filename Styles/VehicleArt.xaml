                <Path Fill="{StaticResource Tail}" Stroke="#5A0E0E" StrokeThickness="0.5" Data="M12.2,45 L22,42.6 L23.6,55.6 L12.2,58 Z"/>
                <Path Fill="{StaticResource LmArtLamp}" Stroke="#9AA6B0" StrokeThickness="0.5" Data="M181,56.6 L201,61.6 L199.6,66.2 L184,63.4 Z"/>
                <!-- bumpers and lower intake -->
                <Path Fill="#4A5763" Data="M186,72 L203,73 L203,82 C203,86 200,88 196,88 L184,88 Z"/>
                <Path Fill="#1B2229" Data="M190,75 L202,76 L202,80 L190,79.4 Z"/>
                <Path Fill="#4A5763" Data="M12,74 L24,74 L24,88 L18,88 C14,88 12,86 12,82 Z"/>
                <Path Fill="#C9444A" Data="M13,76 L17,76 L17,78 L13,78 Z"/>
                <!-- large alloys -->
                <ContentControl Canvas.Left="51" Canvas.Top="88" ContentTemplate="{StaticResource LmArtWheel}" Content="wheel">
                    <ContentControl.RenderTransform><ScaleTransform ScaleX="1.15" ScaleY="1.15"/></ContentControl.RenderTransform>

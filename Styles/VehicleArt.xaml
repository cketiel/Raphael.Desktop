    <DataTemplate x:Key="LmArtAmb">
        <!-- A modern MPV (after the user's reference, 2026-11-22): tall body, short bonnet, steep
             windscreen, near-vertical tailgate, one dark glasshouse with black pillars so the roof
             floats, a dark glass roof, roof rails, a chrome waist line, a rising shoulder crease, a
             wrap-round tail lamp and large alloys, in a light metallic blue-grey. -->
        <Viewbox>
            <Canvas Width="208" Height="116">
                <Canvas.Resources>
                    <LinearGradientBrush x:Key="Paint" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F2F7FB" Offset="0"/>
                        <GradientStop Color="#C9D9E7" Offset="0.35"/>
                        <GradientStop Color="#A9BFD3" Offset="0.62"/>
                        <GradientStop Color="#7F97AD" Offset="0.9"/>
                        <GradientStop Color="#647B90" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="Dlo" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4C5D6E" Offset="0"/>
                        <GradientStop Color="#1C2530" Offset="0.5"/>
                        <GradientStop Color="#0C1117" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="Tail" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#7A1414" Offset="0"/>
                        <GradientStop Color="#E0453F" Offset="0.6"/>
                        <GradientStop Color="#F58A82" Offset="1"/>
                    </LinearGradientBrush>
                </Canvas.Resources>
                <Ellipse Canvas.Left="14" Canvas.Top="96" Width="186" Height="16" Fill="{StaticResource LmArtShadow}"/>
                <!-- roof rails -->
                <Path Stroke="#C9CED3" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M34,23.4 L118,21.6"/>
                <Path Fill="#9AA2AA" Data="M36,23.4 L40,23.4 L41,26 L35,26 Z M112,21.8 L116,21.7 L117,24.6 L111,24.7 Z"/>
                <!-- body -->
                <Path Fill="{StaticResource Paint}" Stroke="#5E7286" StrokeThickness="0.7"
                      Data="M12,82 L12,58 C12,47 14,39 18,33 C20,29.5 24,27.5 30,27.5 L118,25.6 C128,25.6 136,29 144,35 L166,49.5 L192,55.5 C199,57.5 203,61.5 203,67.5 L203,82 C203,86 200,88 196,88 L182,88 A21,21 0 0 0 140,88 L72,88 A21,21 0 0 0 30,88 L18,88 C14,88 12,86 12,82 Z"/>
                <!-- glass roof and the glasshouse -->
                <Path Fill="#1A232D" Opacity="0.85" Data="M34,27 L118,25.4 C124,25.4 129,26.8 134,29.4 L36,30.6 Z"/>
                <Path Fill="{StaticResource Dlo}" Data="M21,37 C23,33.4 26,32.2 31,32.2 L116,30.6 C124.5,30.6 131,33.6 138,38.6 L157,51.6 L20.4,53.6 Z"/>
                <!-- black pillars: D at the tailgate, C, B; the A pillar runs into the screen -->
                <Path Fill="#0E1318" Data="M20.4,53.6 L21,37 C23,33.4 26,32.2 31,32.2 L33,32.2 L30,53.4 Z M70,31.4 L75,31.3 L74,53 L69,53.1 Z M110,30.7 L114.5,30.6 L114.2,52.4 L109.8,52.5 Z"/>
                <!-- reflections -->
                <Path Fill="#FFFFFF" Opacity="0.2" Data="M36,50 L52,34 L60,34 L44,50 Z M80,50 L94,33.4 L99,33.4 L86,50 Z M119,50 L128,34.4 L132,36 L124,50 Z"/>
                <!-- chrome waist line -->
                <Path Stroke="#E9EEF2" StrokeThickness="1.2" Data="M21,54.6 L157,52.6"/>
                <!-- shoulder crease: light above, shade below -->
                <Path Stroke="#FFFFFF" StrokeThickness="1.1" Opacity="0.8" Data="M24,62 C70,61 130,61.4 186,60.4"/>
                <Path Stroke="#5F7489" StrokeThickness="0.7" Opacity="0.7" Data="M24,63.6 C70,62.6 130,63 186,62"/>
                <!-- lower sill shade -->
                <Path Fill="#5A7084" Opacity="0.45" Data="M30,80 C40,79 60,79 72,80 L140,80 C150,79 170,79 182,80 L182,86 L140,86 L72,86 L30,86 Z"/>
                <!-- door seams, handles, mirror -->
                <Path Stroke="#61768A" StrokeThickness="0.8" Data="M74,53.4 L73,87 M114,52.6 L117,87 M117,87"/>
                <Path Fill="#DDE4EA" Stroke="#6B7F92" StrokeThickness="0.4" Data="M95,58.4 L104,58.2 L104,60.2 L95,60.4 Z M136,57.8 L145,57.6 L145,59.6 L136,59.8 Z"/>
                <Path Fill="#1C252E" Data="M150,46 L159,44 L162,50.6 L152.6,51.6 Z"/>
                <!-- Raphael livery: the logo and RAPHAEL in red -->
                <Image Canvas.Left="84" Canvas.Top="65" Width="9" Height="11.5" Source="{StaticResource LmLogo}"/>
                <TextBlock Canvas.Left="95" Canvas.Top="65.16000000000001" Text="RAPHAEL" FontSize="8" FontWeight="Black" FontFamily="Segoe UI" Foreground="#D62828"/>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Style for the DataGrid -->
    <Style x:Key="CustomDataGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="{StaticResource OddRowBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Vertical"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="12,8,12,8"/>
        <Setter Property="materialDesign:DataGridAssist.ColumnHeaderPadding" Value="12,8,12,8"/>

    </Style>

    <!-- Style for column headers -->
    <Style x:Key="CustomColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,8,12,8"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>

        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>

    </Style>

    <!-- Style for rows -->
    <Style x:Key="CustomRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">

        <Setter Property="SnapsToDevicePixels" Value="true"/>
        <Setter Property="MaxHeight" Value="30"/>
        <Setter Property="Background" Value="{StaticResource EvenRowBackgroundBrush}"/>
        
        <Style.Triggers>

            
            <!-- Selection maintains the color but without border -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
            
            
            
            <!-- Hover has top priority -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource HoverBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>

                <Setter Property="TextElement.FontWeight" Value="Bold"/>
            </Trigger>
            

        </Style.Triggers>
    </Style>

    <!-- Style for DataGrid cells -->
    <Style x:Key="CustomCellStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="MaxHeight" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      Margin="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Complete pre-configured style that combines all elements -->
    <Style x:Key="CustomDataGridStyles" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource CustomDataGridStyle}">
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource CustomColumnHeaderStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource CustomRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource CustomCellStyle}"/>
    </Style>

    <!-- ===== The accent bar, painted and not laid out =====
         Moved here out of ScheduleView so the Home grid can wear the same clothes. It was the
         one place in the application where a dispatcher could see which row they were on, and a
         second copy of it would have drifted the first time either screen was touched.

         The bar used to be a 4px left BorderThickness on the row. A border insets the row's
         content, so every column in the body slid four pixels away from its own header and the
         dividing lines stopped meeting. These brushes draw the same bar inside the row's
         background instead: MappingMode="Absolute" makes the gradient measure in pixels, so the
         first 4px are solid accent and everything past them is the wash. Nothing moves, and the
         column lines run unbroken from the header to the last row.

         The wash is deliberately far lighter than the bar — the bar says WHICH row, the wash says
         the row is selected, and they must not compete. -->
    <LinearGradientBrush x:Key="SelectedTripRowBrush"
                         MappingMode="Absolute" StartPoint="0,0" EndPoint="8,0" SpreadMethod="Pad">
        <GradientStop Color="#FF673AB7" Offset="0"/>
        <GradientStop Color="#FF673AB7" Offset="0.499"/>
        <GradientStop Color="#38673AB7" Offset="0.5"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HoverTripRowBrush"
                         MappingMode="Absolute" StartPoint="0,0" EndPoint="8,0" SpreadMethod="Pad">
        <GradientStop Color="#80673AB7" Offset="0"/>
        <GradientStop Color="#80673AB7" Offset="0.499"/>
        <GradientStop Color="#14673AB7" Offset="0.5"/>
    </LinearGradientBrush>

    <!-- ⚠️ Cells stop painting their own selection colour.
         With SelectionUnit="FullRow" every cell of the row becomes selected and the default cell
         style fills it, covering the row's background — so the accent bar and the wash were only
         visible while the pointer was over the row, which is the one state cells do not paint.
         Handing the selected cell a transparent background lets the row show through. Foreground
         is left alone on purpose: the row sets it, and a cancelled trip has to stay red even
         while it is the selected one. -->
    <Style x:Key="TripSelectionCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource CustomCellStyle}">
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Action buttons in a grid row =====
         Moved out of ScheduleView because the Home grid carries the same row of icons and has to
         behave the same. Feedback that does not depend on the button template: MaterialDesignToolButton
         paints its own hover, but inside a dense grid row it is too faint to tell the dispatcher
         which of several icons they are about to press — and pressing the wrong one cancels
         somebody's ride. Scale and cursor read on any template: the icon grows under the pointer
         and presses in when held.

         Focusable=false on purpose. The row, not the button, should keep keyboard focus, and a
         button that takes focus makes the grid spend a click handing it over. -->
    <Style x:Key="TripActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Centred header text for the trip grids. A separate key rather than a change to
         CustomColumnHeaderStyle, which every grid in the application uses: this is a decision
         about the two grids that list trips, not about all of them. -->
    <Style x:Key="CenteredColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CustomColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- ===== Rows that size to their content =====

         Lifted from HomeTripRowStyle, which lives in HomeView.xaml and carries trip-specific
         triggers on top of this. What is here is the part that is about reading a long list,
         and it is shared so the catalog grids read exactly like the Home grid.

         ⚠️ The point of these two is what they do NOT set. CustomRowStyle and CustomCellStyle
         both cap MaxHeight at 30, which is fine while nothing fixes RowHeight: the row simply
         takes the height it needs up to that. Pin RowHeight as well and the Material cell
         padding — 8 above and 8 below — no longer fits beside the text, and every row renders
         as a horizontal slice through the middle of its own letters. That is what the catalog
         grids looked like on their first outing. -->
    <Style x:Key="ContentRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Background" Value="{StaticResource EvenRowBackgroundBrush}"/>
        <Style.Triggers>

            <!-- The plain white every other row is what lets the eye track one entity across
                 nine columns. It is the only thing painting an unselected row. -->
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="White" />
            </Trigger>

            <!-- Declared here and not left to the row template, for the same reason HomeView
                 spells it out: the Background setter above is a style value and beats a
                 template trigger, so selection would otherwise be invisible. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverTripRowBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectedTripRowBrush}" />
                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            </Trigger>

        </Style.Triggers>
    </Style>

    <!-- The cell template of CustomCellStyle without the height cap, and left-aligned: a name,
         a city and an address read from the left. Numbers that want centring say so per column. -->
    <Style x:Key="ContentCellStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Margin="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- The row paints selection; a cell that painted it too would draw a box inside
                 the row. Same reasoning as TripSelectionCellStyle. -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- What a list of records wears: the base grid, left-aligned headers, rows that size to
         their content. The counterpart of CustomDataGridStyles, which caps row height. -->
    <Style x:Key="ContentDataGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource CustomDataGridStyle}">
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource CustomColumnHeaderStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource ContentRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource ContentCellStyle}"/>
    </Style>

</ResourceDictionary>